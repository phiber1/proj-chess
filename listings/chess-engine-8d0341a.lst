                        ; Total size: 8610 bytes
                        ; ==============================================================================
                        ; TRANSPOSITION TABLE FUNCTIONS
                        ; ==============================================================================
                        ; Provides Zobrist hashing and transposition table lookup/store.
                        ;
                        ; Functions:
                        ;   HASH_INIT   - Compute full hash from current board position
                        ;   TT_CLEAR    - Clear all TT entries
                        ;   TT_PROBE    - Look up position in TT
                        ;   TT_STORE    - Store position result in TT
                        ;
                        ; Hash is updated incrementally by MAKE_MOVE/UNMAKE_MOVE (in makemove.asm)
                        ; ==============================================================================
                        
                        ; ==============================================================================
                        ; HASH_INIT - Compute Zobrist hash from current board position
                        ; ==============================================================================
                        ; Scans the board and XORs all piece-square keys, plus side/castling/EP.
                        ; Result stored in HASH_HI/HASH_LO.
                        ;
                        ; Uses: R7 (hash accumulator), R8 (temp), R9 (square counter), R10 (pointer)
                        ; ==============================================================================
   56b3                 HASH_INIT:
                            ; Initialize hash to zero
   56b3   f8 00             LDI 0
   56b5   b7                PHI 7
   56b6   a7                PLO 7               ; R7 = 0 (hash accumulator)
                        
                            ; Scan all 64 valid squares (0x88 format)
   56b7   f8 00             LDI 0
   56b9   a9                PLO 9               ; R9.0 = square index (0x88 format)
                        
   56ba                 HASH_INIT_LOOP:
                            ; Check if square is valid (not off-board)
   56ba   89                GLO 9
   56bb   fa 88             ANI $88
   56bd   ca 57 1f          LBNZ HASH_INIT_NEXT_SQ  ; Off-board, skip
                        
                            ; Get piece at this square
   56c0   f8 60             LDI HIGH(BOARD)
   56c2   ba                PHI 10
   56c3   89                GLO 9
   56c4   aa                PLO 10              ; R10 = BOARD + square
   56c5   0a                LDN 10              ; D = piece at square
   56c6   c2 57 1f          LBZ HASH_INIT_NEXT_SQ   ; Empty square, skip
                        
                            ; Have a piece - compute Zobrist key offset
                            ; piece_index = (piece & 7) - 1 for white, + 6 for black
                            ; Piece encoding: 1-6 = white P/N/B/R/Q/K, 9-14 = black
   56c9   a8                PLO 8               ; R8.0 = piece
   56ca   fa 07             ANI $07             ; D = piece type (1-6)
   56cc   ff 01             SMI 1               ; D = piece_type - 1 (0-5)
   56ce   ad                PLO 13              ; R13.0 = piece index base
                        
   56cf   88                GLO 8               ; Get piece again
   56d0   fa 08             ANI $08             ; Check color bit
   56d2   c2 56 d9          LBZ HASH_INIT_WHITE
                            ; Black piece - add 6 to index
   56d5   8d                GLO 13
   56d6   fc 06             ADI 6
   56d8   ad                PLO 13
   56d9                 HASH_INIT_WHITE:
                        
                            ; Now compute square index (0-63 from 0x88)
                            ; sq64 = (sq88 >> 4) * 8 + (sq88 & 7) = rank*8 + file
   56d9   89                GLO 9               ; 0x88 square
   56da   fa 07             ANI $07             ; D = file (0-7)
   56dc   a8                PLO 8               ; R8.0 = file
   56dd   89                GLO 9
   56de   fa 70             ANI $70             ; D = rank * 16 (masked)
   56e0   f6                SHR                 ; D = rank * 8
   56e1   52                STR 2               ; Save rank*8
   56e2   88                GLO 8               ; D = file
   56e3   f4                ADD                 ; D = rank*8 + file = sq64
   56e4   a8                PLO 8               ; R8.0 = sq64 (0-63)
                        
                            ; Compute Zobrist table offset:
                            ; offset = piece_index * 128 + sq64 * 2
                            ; R13.0 = piece_index (0-11)
                            ; R8.0 = sq64 (0-63)
                        
                            ; First: piece_index * 128 = piece_index << 7
                            ; Since piece_index is 0-11, result fits in 16 bits
   56e5   8d                GLO 13              ; piece_index (0-11)
   56e6   fe                SHL                 ; x2
   56e7   fe                SHL                 ; x4
   56e8   fe                SHL                 ; x8
   56e9   fe                SHL                 ; x16
   56ea   fe                SHL                 ; x32
   56eb   fe                SHL                 ; x64
   56ec   b8                PHI 8               ; R8.1 = (piece_index * 64) = high part of offset
   56ed   f8 00             LDI 0
   56ef   c7                LSNF                ; Skip if no carry from last SHL
   56f0   f8 01             LDI 1               ; Carry into high byte
                            ; Actually, piece_index * 128: need one more shift
                            ; Let me reconsider: piece * 128 = piece << 7
                            ; For piece=11: 11 << 7 = 1408 = $580
                            ; High byte = piece >> 1, low byte = (piece & 1) << 7
                        
                            ; Restart: piece_index * 128
   56f2   8d                GLO 13              ; piece_index (0-11)
   56f3   f6                SHR                 ; D = piece_index >> 1
   56f4   b8                PHI 8               ; R8.1 = high byte of piece*128
   56f5   8d                GLO 13
   56f6   fa 01             ANI $01             ; D = piece_index & 1
   56f8   c2 57 00          LBZ HASH_INIT_EVEN_PIECE
   56fb   f8 80             LDI $80
   56fd   c0 57 02          LBR HASH_INIT_ADD_SQ
   5700                 HASH_INIT_EVEN_PIECE:
   5700   f8 00             LDI 0
   5702                 HASH_INIT_ADD_SQ:
                            ; D = low byte of piece*128 (0 or $80)
                            ; Now add sq64 * 2
   5702   ad                PLO 13              ; R13.0 = temp low
   5703   88                GLO 8               ; sq64
   5704   fe                SHL                 ; sq64 * 2
   5705   52                STR 2
   5706   8d                GLO 13
   5707   f4                ADD                 ; D = low + sq*2
   5708   ad                PLO 13              ; R13.0 = offset low
   5709   98                GHI 8               ; high byte of piece*128
   570a   7c 00             ADCI 0              ; add carry
   570c   bd                PHI 13              ; R13.1 = offset high
                        
                            ; Now add ZOBRIST_PIECE_SQ base address
   570d   8d                GLO 13
   570e   fc 49             ADI LOW(ZOBRIST_PIECE_SQ)
   5710   aa                PLO 10
   5711   9d                GHI 13
   5712   7c 59             ADCI HIGH(ZOBRIST_PIECE_SQ)
   5714   ba                PHI 10              ; R10 = address of Zobrist key
                        
                            ; XOR the 16-bit key into hash (R7)
   5715   4a                LDA 10              ; High byte of key
   5716   52                STR 2
   5717   97                GHI 7
   5718   f3                XOR
   5719   b7                PHI 7               ; hash_hi ^= key_hi
   571a   0a                LDN 10              ; Low byte of key
   571b   52                STR 2
   571c   87                GLO 7
   571d   f3                XOR
   571e   a7                PLO 7               ; hash_lo ^= key_lo
                        
   571f                 HASH_INIT_NEXT_SQ:
                            ; Next square
   571f   19                INC 9               ; R9.0++
   5720   89                GLO 9
   5721   fb 80             XRI $80             ; Check if we've passed square $7F
   5723   ca 56 ba          LBNZ HASH_INIT_LOOP
                        
                            ; Done with pieces. Now XOR side to move.
   5726   68 ca 60 80       RLDI 10, GAME_STATE
   572a   0a                LDN 10              ; D = side to move (0=white, 8=black)
   572b   c2 57 3c          LBZ HASH_SIDE_DONE
                            ; Black to move - XOR side key
   572e   68 ca 5f 49       RLDI 10, ZOBRIST_SIDE
   5732   4a                LDA 10
   5733   52                STR 2
   5734   97                GHI 7
   5735   f3                XOR
   5736   b7                PHI 7
   5737   0a                LDN 10
   5738   52                STR 2
   5739   87                GLO 7
   573a   f3                XOR
   573b   a7                PLO 7
   573c                 HASH_SIDE_DONE:
                        
                            ; XOR castling rights
                            ; Castling is at GAME_STATE + STATE_CASTLING ($6081)
   573c   68 ca 60 81       RLDI 10, GAME_STATE + STATE_CASTLING
   5740   0a                LDN 10              ; D = castling rights
   5741   a9                PLO 9               ; R9.0 = castling bits
                        
                            ; Check each castling bit
                            ; White kingside (bit 0)
   5742   89                GLO 9
   5743   fa 01             ANI CASTLE_WK
   5745   c2 57 4b          LBZ HASH_NO_WK
   5748   d4 57 92          CALL HASH_XOR_CASTLE_0
   574b                 HASH_NO_WK:
                            ; White queenside (bit 1)
   574b   89                GLO 9
   574c   fa 02             ANI CASTLE_WQ
   574e   c2 57 54          LBZ HASH_NO_WQ
   5751   d4 57 99          CALL HASH_XOR_CASTLE_1
   5754                 HASH_NO_WQ:
                            ; Black kingside (bit 2)
   5754   89                GLO 9
   5755   fa 04             ANI CASTLE_BK
   5757   c2 57 5d          LBZ HASH_NO_BK
   575a   d4 57 a2          CALL HASH_XOR_CASTLE_2
   575d                 HASH_NO_BK:
                            ; Black queenside (bit 3)
   575d   89                GLO 9
   575e   fa 08             ANI CASTLE_BQ
   5760   c2 57 66          LBZ HASH_NO_BQ
   5763   d4 57 ad          CALL HASH_XOR_CASTLE_3
   5766                 HASH_NO_BQ:
                        
                            ; XOR en passant file if set
   5766   68 ca 60 80       RLDI 10, GAME_STATE
   576a   1a                INC 10
   576b   1a                INC 10              ; Point to EP square
   576c   0a                LDN 10              ; D = EP square ($FF if none)
   576d   fb ff             XRI $FF
   576f   c2 57 88          LBZ HASH_NO_EP      ; No EP square
                            ; Have EP - get file (bits 0-2 of 0x88 square)
   5772   0a                LDN 10
   5773   fa 07             ANI $07             ; D = file (0-7)
   5775   fe                SHL                 ; D = file * 2 (offset into ZOBRIST_EP)
   5776   fc 53             ADI LOW(ZOBRIST_EP)
   5778   aa                PLO 10
   5779   f8 5f             LDI HIGH(ZOBRIST_EP)
   577b   7c 00             ADCI 0
   577d   ba                PHI 10              ; R10 = address of EP file key
   577e   4a                LDA 10
   577f   52                STR 2
   5780   97                GHI 7
   5781   f3                XOR
   5782   b7                PHI 7
   5783   0a                LDN 10
   5784   52                STR 2
   5785   87                GLO 7
   5786   f3                XOR
   5787   a7                PLO 7
   5788                 HASH_NO_EP:
                        
                            ; Store final hash
   5788   68 ca 64 b9       RLDI 10, HASH_HI
   578c   97                GHI 7
   578d   5a                STR 10
   578e   1a                INC 10
   578f   87                GLO 7
   5790   5a                STR 10
                        
   5791   d5                RETN
                        
                        ; Helper functions to XOR castling keys (avoids code duplication)
   5792                 HASH_XOR_CASTLE_0:
   5792   68 ca 5f 4b       RLDI 10, ZOBRIST_CASTLE
   5796   c0 57 b7          LBR HASH_XOR_CASTLE_DO
   5799                 HASH_XOR_CASTLE_1:
   5799   68 ca 5f 4b       RLDI 10, ZOBRIST_CASTLE
   579d   1a                INC 10
   579e   1a                INC 10
   579f   c0 57 b7          LBR HASH_XOR_CASTLE_DO
   57a2                 HASH_XOR_CASTLE_2:
   57a2   68 ca 5f 4b       RLDI 10, ZOBRIST_CASTLE
   57a6   1a                INC 10
   57a7   1a                INC 10
   57a8   1a                INC 10
   57a9   1a                INC 10
   57aa   c0 57 b7          LBR HASH_XOR_CASTLE_DO
   57ad                 HASH_XOR_CASTLE_3:
   57ad   68 ca 5f 4b       RLDI 10, ZOBRIST_CASTLE
   57b1   1a                INC 10
   57b2   1a                INC 10
   57b3   1a                INC 10
   57b4   1a                INC 10
   57b5   1a                INC 10
   57b6   1a                INC 10
   57b7                 HASH_XOR_CASTLE_DO:
   57b7   4a                LDA 10
   57b8   52                STR 2
   57b9   97                GHI 7
   57ba   f3                XOR
   57bb   b7                PHI 7
   57bc   0a                LDN 10
   57bd   52                STR 2
   57be   87                GLO 7
   57bf   f3                XOR
   57c0   a7                PLO 7
   57c1   d5                RETN
                        
                        ; ==============================================================================
                        ; TT_CLEAR - Clear all transposition table entries
                        ; ==============================================================================
                        ; Sets all TT entries to flag=TT_FLAG_NONE (0)
                        ; Should be called at start of new game or new position.
                        ;
                        ; Uses: R9 (counter), R10 (pointer)
                        ; ==============================================================================
   57c2                 TT_CLEAR:
   57c2   68 ca 68 00       RLDI 10, TT_TABLE
                        
                            ; Clear 256 entries × 8 bytes = 2048 bytes
                            ; Use R9 as 16-bit counter
   57c6   68 c9 08 00       RLDI 9, TT_ENTRIES * TT_ENTRY_SIZE
                        
   57ca   f8 00             LDI 0               ; Value to write
   57cc                 TT_CLEAR_LOOP:
   57cc   5a                STR 10
   57cd   1a                INC 10
   57ce   29                DEC 9
   57cf   99                GHI 9
   57d0   ca 57 cc          LBNZ TT_CLEAR_LOOP
   57d3   89                GLO 9
   57d4   ca 57 cc          LBNZ TT_CLEAR_LOOP
                        
   57d7   d5                RETN
                        
                        ; ==============================================================================
                        ; TT_PROBE - Look up current position in transposition table
                        ; ==============================================================================
                        ; Checks if current position (HASH_HI/LO) exists in TT.
                        ; If found and depth >= required, copies entry data to TT_* variables.
                        ;
                        ; Input:  D = required depth
                        ; Output: D = 1 if usable hit, 0 if miss
                        ;         If hit: TT_SCORE, TT_DEPTH, TT_FLAG, TT_MOVE populated
                        ;
                        ; Uses: R7 (hash), R8 (required depth), R10 (pointer)
                        ; ==============================================================================
   57d8                 TT_PROBE:
   57d8   a8                PLO 8               ; R8.0 = required depth
                        
   57d9   68 c9 64 1d       RLDI 9, TRACE_WHERE
   57dd   f8 b1             LDI $B1
   57df   59                STR 9              ; tracer: in TT_PROBE
                        
                            ; Clear TT_MOVE (prevents stale data if hash misses)
   57e0   68 c9 64 c0       RLDI 9, TT_MOVE_HI
   57e4   f8 00             LDI 0
   57e6   59                STR 9
   57e7   19                INC 9
   57e8   59                STR 9               ; TT_MOVE_HI/LO = 0
                        
                            ; Load current hash
   57e9   68 ca 64 b9       RLDI 10, HASH_HI
   57ed   4a                LDA 10
   57ee   b7                PHI 7
   57ef   0a                LDN 10
   57f0   a7                PLO 7               ; R7 = current hash
                        
                            ; Calculate TT entry address: TT_TABLE + (index * 8)
                            ; XOR-fold indexing (2026-05-15): index = (hash_hi XOR hash_lo) & $FF.
   57f1   97                GHI 7               ; hash_hi
   57f2   52                STR 2
   57f3   87                GLO 7               ; hash_lo
   57f4   f3                XOR                 ; D = hash_hi XOR hash_lo
   57f5   fa ff             ANI TT_INDEX_MASK   ; Mask to table size
   57f7   fe                SHL                 ; x2, carry into DF
   57f8   aa                PLO 10
   57f9   f8 00             LDI 0
   57fb   7e                SHLC                ; carry into D
   57fc   ba                PHI 10              ; R10.1 = high so far
   57fd   8a                GLO 10
   57fe   fe                SHL                 ; x4
   57ff   aa                PLO 10
   5800   9a                GHI 10
   5801   7e                SHLC
   5802   ba                PHI 10
   5803   8a                GLO 10
   5804   fe                SHL                 ; x8
   5805   aa                PLO 10
   5806   9a                GHI 10
   5807   7e                SHLC
   5808   ba                PHI 10              ; R10 = index * 8
                        
                            ; Add TT_TABLE base
   5809   8a                GLO 10
   580a   fc 00             ADI LOW(TT_TABLE)
   580c   aa                PLO 10
   580d   9a                GHI 10
   580e   7c 68             ADCI HIGH(TT_TABLE)
   5810   ba                PHI 10              ; R10 = TT entry address
                        
                            ; Check if entry matches (compare stored hash with current)
   5811   4a                LDA 10              ; Entry hash_hi
   5812   52                STR 2
   5813   97                GHI 7
   5814   f3                XOR
   5815   ca 58 61          LBNZ TT_PROBE_MISS
   5818   4a                LDA 10              ; Entry hash_lo
   5819   52                STR 2
   581a   87                GLO 7
   581b   f3                XOR
   581c   ca 58 61          LBNZ TT_PROBE_MISS
                        
                            ; Hash matches! Save move for ordering (even if depth insufficient)
                            ; R10 at offset 2 (score_hi). Move is at offset 6-7.
   581f   1a                INC 10              ; → 3
   5820   1a                INC 10              ; → 4 (depth)
   5821   1a                INC 10              ; → 5 (flag)
   5822   1a                INC 10              ; → 6 (move_hi)
   5823   4a                LDA 10              ; D = move_hi, R10 → 7
   5824   73                STXD                ; push move_hi
   5825   0a                LDN 10              ; D = move_lo
   5826   73                STXD                ; push move_lo
                        
                            ; Write to TT_MOVE_HI/LO
   5827   68 c9 64 c0       RLDI 9, TT_MOVE_HI
   582b   60                IRX
   582c   72                LDXA                ; D = move_lo
   582d   19                INC 9
   582e   59                STR 9               ; TT_MOVE_LO = move_lo
   582f   29                DEC 9
   5830   f0                LDX                 ; D = move_hi
   5831   59                STR 9               ; TT_MOVE_HI = move_hi
                        
                            ; Navigate back to depth (offset 4)
   5832   2a                DEC 10              ; → 6
   5833   2a                DEC 10              ; → 5
   5834   2a                DEC 10              ; → 4 (depth)
                        
                            ; Check depth
   5835   0a                LDN 10              ; Entry depth
   5836   52                STR 2
   5837   88                GLO 8               ; Required depth
   5838   f5                SD                  ; D = entry_depth - required_depth
   5839   cb 58 61          LBNF TT_PROBE_MISS  ; Borrow → depth insufficient (but TT_MOVE saved!)
                        
                            ; Usable hit! Copy entry data to TT_* variables
                            ; Back up to start of entry
   583c   2a                DEC 10
   583d   2a                DEC 10
   583e   2a                DEC 10
   583f   2a                DEC 10              ; R10 at entry start
                        
                            ; Copy to TT result variables
   5840   68 c9 64 bc       RLDI 9, TT_SCORE_HI
                        
   5844   1a                INC 10
   5845   1a                INC 10              ; Skip hash verification bytes
   5846   4a                LDA 10              ; score_hi
   5847   59                STR 9
   5848   19                INC 9
   5849   4a                LDA 10              ; score_lo
   584a   59                STR 9
   584b   19                INC 9
   584c   4a                LDA 10              ; depth
   584d   59                STR 9
   584e   19                INC 9
   584f   4a                LDA 10              ; flag
   5850   59                STR 9
   5851   19                INC 9
   5852   4a                LDA 10              ; move_hi
   5853   59                STR 9
   5854   19                INC 9
   5855   0a                LDN 10              ; move_lo
   5856   59                STR 9
                        
                            ; Set TT_HIT = 1
   5857   68 ca 64 bb       RLDI 10, TT_HIT
   585b   f8 01             LDI 1
   585d   5a                STR 10
                        
   585e   f8 01             LDI 1               ; Return hit
   5860   d5                RETN
                        
   5861                 TT_PROBE_MISS:
                            ; Set TT_HIT = 0
   5861   68 ca 64 bb       RLDI 10, TT_HIT
   5865   f8 00             LDI 0
   5867   5a                STR 10
                        
   5868   f8 00             LDI 0               ; Return miss
   586a   d5                RETN
                        
                        ; ==============================================================================
                        ; TT_STORE - Store position result in transposition table
                        ; ==============================================================================
                        ; Stores current position with score, depth, flag, and best move.
                        ; Always replaces existing entry (replace-always scheme).
                        ;
                        ; Input:  Stack contains (push order): score_hi, score_lo, depth, flag
                        ;         BEST_MOVE contains best move
                        ; Actually, let's use memory variables for simplicity:
                        ;         SCORE_HI/LO = score to store
                        ;         D = depth
                        ;         R8.0 = flag
                        ;
                        ; Uses: R7 (hash), R9 (temp), R10 (pointer)
                        ; ==============================================================================
   586b                 TT_STORE:
                            ; Save depth and flag
   586b   73                STXD                ; Push depth
   586c   88                GLO 8
   586d   73                STXD                ; Push flag
                        
   586e   68 ca 64 1d       RLDI 10, TRACE_WHERE
   5872   f8 b2             LDI $B2
   5874   5a                STR 10              ; tracer: in TT_STORE
                        
                            ; Load current hash
   5875   68 ca 64 b9       RLDI 10, HASH_HI
   5879   4a                LDA 10
   587a   b7                PHI 7
   587b   0a                LDN 10
   587c   a7                PLO 7               ; R7 = current hash
                        
                            ; Calculate TT entry address: TT_TABLE + (index * 8) — XOR-fold (must match TT_PROBE)
   587d   97                GHI 7               ; hash_hi
   587e   52                STR 2
   587f   87                GLO 7               ; hash_lo
   5880   f3                XOR                 ; D = hash_hi XOR hash_lo
   5881   fa ff             ANI TT_INDEX_MASK
   5883   fe                SHL                 ; x2, carry into DF
   5884   aa                PLO 10
   5885   f8 00             LDI 0
   5887   7e                SHLC
   5888   ba                PHI 10
   5889   8a                GLO 10
   588a   fe                SHL                 ; x4
   588b   aa                PLO 10
   588c   9a                GHI 10
   588d   7e                SHLC
   588e   ba                PHI 10
   588f   8a                GLO 10
   5890   fe                SHL                 ; x8
   5891   aa                PLO 10
   5892   9a                GHI 10
   5893   7e                SHLC
   5894   ba                PHI 10              ; R10 = index * 8
                        
                            ; Add TT_TABLE base
   5895   8a                GLO 10
   5896   fc 00             ADI LOW(TT_TABLE)
   5898   aa                PLO 10
   5899   9a                GHI 10
   589a   7c 68             ADCI HIGH(TT_TABLE)
   589c   ba                PHI 10              ; R10 = TT entry address
                        
                            ; Write entry
   589d   97                GHI 7               ; hash_hi
   589e   5a                STR 10
   589f   1a                INC 10
   58a0   87                GLO 7               ; hash_lo
   58a1   5a                STR 10
   58a2   1a                INC 10
                        
                            ; Score from SCORE_HI/LO
   58a3   68 c9 64 46       RLDI 9, SCORE_HI
   58a7   49                LDA 9               ; score_hi
   58a8   5a                STR 10
   58a9   1a                INC 10
   58aa   09                LDN 9               ; score_lo
   58ab   5a                STR 10
   58ac   1a                INC 10
                        
                            ; Depth and flag from stack
   58ad   60                IRX
   58ae   72                LDXA                ; flag
   58af   a8                PLO 8               ; Save temporarily
   58b0   f0                LDX                 ; depth
   58b1   5a                STR 10
   58b2   1a                INC 10
   58b3   88                GLO 8               ; flag
   58b4   5a                STR 10
   58b5   1a                INC 10
                        
                            ; Best move from NODE_BEST_MOVE[ply]
   58b6   68 c9 64 48       RLDI 9, CURRENT_PLY
   58ba   09                LDN 9               ; D = ply
   58bb   fe                SHL                 ; D = ply * 2
   58bc   a9                PLO 9               ; R9.0 = offset (NODE_BEST_MOVE base = $6700, low = $00)
   58bd   f8 67             LDI HIGH(NODE_BEST_MOVE)
   58bf   b9                PHI 9               ; R9 = $6700 + ply*2
   58c0   49                LDA 9               ; from
   58c1   5a                STR 10
   58c2   1a                INC 10
   58c3   09                LDN 9               ; to
   58c4   5a                STR 10
                        
   58c5   d5                RETN
                        
                        ; ==============================================================================
                        ; HASH_XOR_PIECE_SQ - XOR piece-square key into current hash
                        ; ==============================================================================
                        ; Used for incremental hash updates in MAKE_MOVE/UNMAKE_MOVE.
                        ;
                        ; Input:  R8.0 = piece (1-6 white, 9-14 black, or EMPTY=0 for no-op)
                        ;         R8.1 = square (0x88 format)
                        ; Output: HASH_HI/LO updated
                        ; Uses:   R7, R9, R10, R11, R13
                        ; ==============================================================================
   58c6                 HASH_XOR_PIECE_SQ:
                            ; Skip if piece is EMPTY
   58c6   88                GLO 8
   58c7   c2 59 28          LBZ HXPS_DONE
                        
                            ; Load current hash into R7
   58ca   68 ca 64 b9       RLDI 10, HASH_HI
   58ce   4a                LDA 10
   58cf   b7                PHI 7
   58d0   0a                LDN 10
   58d1   a7                PLO 7               ; R7 = current hash
                        
                            ; Compute piece index (0-11)
                            ; piece_index = (piece & 7) - 1 for white, + 6 for black
   58d2   88                GLO 8               ; piece
   58d3   fa 07             ANI $07             ; piece type (1-6)
   58d5   ff 01             SMI 1               ; piece_type - 1 (0-5)
   58d7   ad                PLO 13              ; R13.0 = base index
                        
   58d8   88                GLO 8               ; piece again
   58d9   fa 08             ANI $08             ; color bit
   58db   c2 58 e2          LBZ HXPS_WHITE
                            ; Black - add 6
   58de   8d                GLO 13
   58df   fc 06             ADI 6
   58e1   ad                PLO 13
   58e2                 HXPS_WHITE:
                        
                            ; Compute square index (0-63 from 0x88)
                            ; sq64 = (sq88 >> 4) * 8 + (sq88 & 7)
   58e2   98                GHI 8               ; 0x88 square
   58e3   fa 07             ANI $07             ; file
   58e5   a9                PLO 9               ; R9.0 = file
   58e6   98                GHI 8
   58e7   fa 70             ANI $70             ; rank * 16
   58e9   f6                SHR                 ; rank * 8
   58ea   ab                PLO 11              ; R11.0 = rank*8 (use R11, NOT R7 - R7 has hash!)
   58eb   89                GLO 9               ; file
   58ec   52                STR 2               ; temp store on stack
   58ed   8b                GLO 11              ; rank*8
   58ee   f4                ADD                 ; rank*8 + file = sq64
   58ef   a9                PLO 9               ; R9.0 = sq64
                        
                            ; Compute Zobrist offset: piece_index * 128 + sq64 * 2
                            ; piece * 128: high = piece >> 1, low = (piece & 1) << 7
   58f0   8d                GLO 13              ; piece_index
   58f1   f6                SHR                 ; piece >> 1
   58f2   bd                PHI 13              ; R13.1 = high byte of piece*128
   58f3   8d                GLO 13
   58f4   fe                SHL                 ; Restore, then check bit 0
   58f5   f6                SHR                 ; Back to original
   58f6   fa 01             ANI $01
   58f8   c2 59 00          LBZ HXPS_EVEN
   58fb   f8 80             LDI $80
   58fd   c0 59 02          LBR HXPS_ADD_SQ
   5900                 HXPS_EVEN:
   5900   f8 00             LDI 0
   5902                 HXPS_ADD_SQ:
                            ; D = low byte of piece*128 (0 or $80)
   5902   aa                PLO 10              ; R10.0 = temp low
   5903   89                GLO 9               ; sq64
   5904   fe                SHL                 ; sq64 * 2
   5905   52                STR 2
   5906   8a                GLO 10
   5907   f4                ADD                 ; low + sq*2
   5908   aa                PLO 10
   5909   9d                GHI 13              ; high of piece*128
   590a   7c 00             ADCI 0
   590c   ba                PHI 10              ; R10 = offset
                        
                            ; Add ZOBRIST_PIECE_SQ base
   590d   8a                GLO 10
   590e   fc 49             ADI LOW(ZOBRIST_PIECE_SQ)
   5910   aa                PLO 10
   5911   9a                GHI 10
   5912   7c 59             ADCI HIGH(ZOBRIST_PIECE_SQ)
   5914   ba                PHI 10              ; R10 = key address
                        
                            ; XOR key into hash
   5915   4a                LDA 10              ; key_hi
   5916   52                STR 2
   5917   97                GHI 7
   5918   f3                XOR
   5919   b7                PHI 7
   591a   0a                LDN 10              ; key_lo
   591b   52                STR 2
   591c   87                GLO 7
   591d   f3                XOR
   591e   a7                PLO 7
                        
                            ; Store updated hash
   591f   68 ca 64 b9       RLDI 10, HASH_HI
   5923   97                GHI 7
   5924   5a                STR 10
   5925   1a                INC 10
   5926   87                GLO 7
   5927   5a                STR 10
                        
   5928                 HXPS_DONE:
   5928   d5                RETN
                        
                        ; ==============================================================================
                        ; HASH_XOR_SIDE - Toggle side-to-move in hash
                        ; ==============================================================================
                        ; Called after every move to flip the side-to-move bit in the hash.
                        ;
                        ; Uses: R7, R10
                        ; ==============================================================================
   5929                 HASH_XOR_SIDE:
                            ; Load current hash
   5929   68 ca 64 b9       RLDI 10, HASH_HI
   592d   4a                LDA 10
   592e   b7                PHI 7
   592f   0a                LDN 10
   5930   a7                PLO 7               ; R7 = current hash
                        
                            ; XOR with side key
   5931   68 ca 5f 49       RLDI 10, ZOBRIST_SIDE
   5935   4a                LDA 10              ; key_hi
   5936   52                STR 2
   5937   97                GHI 7
   5938   f3                XOR
   5939   b7                PHI 7
   593a   0a                LDN 10              ; key_lo
   593b   52                STR 2
   593c   87                GLO 7
   593d   f3                XOR
   593e   a7                PLO 7
                        
                            ; Store updated hash
   593f   68 ca 64 b9       RLDI 10, HASH_HI
   5943   97                GHI 7
   5944   5a                STR 10
   5945   1a                INC 10
   5946   87                GLO 7
   5947   5a                STR 10
                        
   5948   d5                RETN
