   1319   0b                LDN 11
   131a   ff 07             SMI 7               ; pc - 7; DF=1 if pc >= 7
   131c   c3 13 38          LBDF HM_AMP_DONE    ; pc > 6, skip amp
   131f   99                GHI 9
   1320   fa 80             ANI $80
