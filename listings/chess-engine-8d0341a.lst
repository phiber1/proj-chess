   2308   fc 0e             ADI 14              ; Calculate offset to alpha_hi
   230a   aa                PLO 10
   230b   92                GHI 2
   230c   7c 00             ADCI 0
   230e   ba                PHI 10              ; R10 = address of alpha_hi on stack
   230f   0a                LDN 10              ; D = alpha_hi
   2310   b7                PHI 7               ; R7.1 = alpha_hi
   2311   2a                DEC 10              ; Point to alpha_lo (R2+11)
   2312   0a                LDN 10              ; D = alpha_lo
   2313   a7                PLO 7               ; R7 = parent's alpha (big-endian)
                        
                            ; Load score from SCORE_HI/LO
   2314   68 ca 64 46       RLDI 10, SCORE_HI
   2318   4a                LDA 10              ; D = score_hi
   2319   bd                PHI 13
   231a   0a                LDN 10              ; D = score_lo
   231b   ad                PLO 13              ; R13 = score
                        
                            ; Signed comparison: score (R13) > alpha (R7)?
                            ; Use COMPARE_TEMP for scratch
   231c   68 ca 64 49       RLDI 10, COMPARE_TEMP
   2320   ea                SEX 10              ; X = R10 for comparisons
                        
                            ; Check if signs differ
   2321   9d                GHI 13              ; score_hi
   2322   5a                STR 10
   2323   97                GHI 7               ; alpha_hi
   2324   f3                XOR
   2325   fa 80             ANI $80             ; Check sign bits differ
   2327   e2                SEX 2               ; Restore X = R2
   2328   ca 23 43          LBNZ LMR_RESEARCH_DIFF_SIGN
                        
                            ; Same sign: score > alpha if score - alpha > 0 (positive, no borrow)
   232b   ea                SEX 10
   232c   87                GLO 7               ; alpha_lo
   232d   5a                STR 10
   232e   8d                GLO 13              ; score_lo
   232f   f7                SM                  ; D = score_lo - alpha_lo
   2330   b8                PHI 8               ; Save low result in R8.1
   2331   97                GHI 7               ; alpha_hi
   2332   5a                STR 10
   2333   9d                GHI 13              ; score_hi
   2334   77                SMB                 ; D = score_hi - alpha_hi - borrow
   2335   e2                SEX 2               ; Restore X = R2
   2336   cb 23 d4          LBNF LMR_NO_RESEARCH ; Borrow = score <= alpha, no re-search
   2339   ca 23 49          LBNZ LMR_DO_RESEARCH ; High bytes differ and positive
   233c   98                GHI 8               ; Check saved low result
   233d   c2 23 d4          LBZ LMR_NO_RESEARCH  ; Equal (both zero), no re-search
   2340   c0 23 49          LBR LMR_DO_RESEARCH
                        
   2343                 LMR_RESEARCH_DIFF_SIGN:
                            ; Different signs: positive > negative
   2343   9d                GHI 13              ; score_hi
   2344   fa 80             ANI $80
   2346   ca 23 d4          LBNZ LMR_NO_RESEARCH ; score negative, alpha positive: score < alpha
                        
   2349                 LMR_DO_RESEARCH:
                            ; Re-search needed! Score beat alpha on reduced search.
                        
                            ; Clear LMR_REDUCED so we don't re-search again
   2349   68 ca 64 a4       RLDI 10, LMR_REDUCED
   234d   f8 00             LDI 0
   234f   5a                STR 10
                        
                            ; Increment SEARCH_DEPTH by 1 (undo the extra LMR reduction)
                            ; Current depth = original - 2, we want original - 1
   2350   68 cd 64 17       RLDI 13, SEARCH_DEPTH + 1
   2354   0d                LDN 13              ; D = depth_lo
   2355   fc 01             ADI 1
   2357   5d                STR 13              ; depth_lo++
   2358   2d                DEC 13              ; Point to high byte
   2359   0d                LDN 13              ; D = depth_hi
   235a   7c 00             ADCI 0              ; Add carry
   235c   5d                STR 13              ; depth_hi++ (with carry)
                        
                            ; Re-setup alpha/beta for child (same swap as original)
                            ; Peek parent's beta from stack (beta_hi at R2+12, beta_lo at R2+11)
   235d   82                GLO 2
   235e   fc 0c             ADI 12
   2360   aa                PLO 10
   2361   92                GHI 2
   2362   7c 00             ADCI 0
   2364   ba                PHI 10              ; R10 = address of beta_hi on stack
   2365   0a                LDN 10              ; D = beta_hi
   2366   b8                PHI 8
   2367   2a                DEC 10              ; Point to beta_lo
   2368   0a                LDN 10              ; D = beta_lo
   2369   a8                PLO 8               ; R8 = parent's beta
                        
                            ; Negate R8 (beta) → R7 = -beta (new alpha)
   236a   88                GLO 8               ; low byte
   236b   fd 00             SDI 0               ; negate low
   236d   a7                PLO 7
   236e   98                GHI 8               ; high byte
   236f   7d 00             SDBI 0              ; negate high with borrow
   2371   b7                PHI 7               ; R7 = -beta
                        
                            ; Peek parent's alpha again (R2+14, R2+13)
   2372   82                GLO 2
   2373   fc 0e             ADI 14
   2375   aa                PLO 10
   2376   92                GHI 2
   2377   7c 00             ADCI 0
   2379   ba                PHI 10
   237a   0a                LDN 10              ; D = alpha_hi
   237b   b8                PHI 8
   237c   2a                DEC 10
   237d   0a                LDN 10              ; D = alpha_lo
   237e   a8                PLO 8               ; R8 = parent's alpha
                        
                            ; Negate R8 (alpha) in place → R8 = -alpha (new beta)
   237f   88                GLO 8               ; low byte
   2380   fd 00             SDI 0               ; negate low
   2382   a8                PLO 8
   2383   98                GHI 8               ; high byte
   2384   7d 00             SDBI 0              ; negate high with borrow
   2386   b8                PHI 8               ; R8 = -alpha
                        
                            ; Store new alpha/beta to memory
   2387   68 ca 64 42       RLDI 10, ALPHA_HI
   238b   97                GHI 7               ; new_alpha_hi
   238c   5a                STR 10
   238d   1a                INC 10
   238e   87                GLO 7               ; new_alpha_lo
   238f   5a                STR 10              ; ALPHA = -beta
                        
   2390   68 ca 64 44       RLDI 10, BETA_HI
   2394   98                GHI 8               ; new_beta_hi
   2395   5a                STR 10
   2396   1a                INC 10
   2397   88                GLO 8               ; new_beta_lo
   2398   5a                STR 10              ; BETA = -alpha
                        
                            ; ----------------------------------------------------------------
                            ; LMR-RESEARCH FIX 2026-05-06: refresh CHECK_EXT_FLAG before re-search.
                            ; The first reduced-depth call's child overwrote CHECK_EXT_FLAG with
                            ; whatever its last move-loop iteration left (typically 0 for non-checking
                            ; quiet moves). Re-search child's snapshot would read this stale value,
                            ; breaking the LMP in-check guard at line ~1238 even though our move IS
                            ; a check.  R12 is currently BLACK (child's color = opponent of parent
                            ; at root), so direct IS_IN_CHECK checks the opponent's king — exactly
                            ; what we want for "did parent's move give check".
                            ; ----------------------------------------------------------------
   2399   d4 01 8e          CALL IS_IN_CHECK
   239c   68 ca 64 da       RLDI 10, CHECK_EXT_FLAG
   23a0   5a                STR 10              ; CHECK_EXT_FLAG = fresh "in check?" result
                        
                            ; --- BUGFIX (carried from 09ccdcf, origin 2e3333a 2026-01-27): preserve
                            ; LMR_MOVE_INDEX across the re-search. The first (reduced) CALL NEGAMAX
                            ; saves/restores it; this full-depth re-search call did NOT, so the child
                            ; reset+incremented it and never restored this node's value -> corrupts
                            ; LMP/LMR state and, via the LMR_REDUCED-gated SEARCH_DEPTH decrement, can
                            ; underflow depth -> near-infinite child search = the freeze-class hang.
                            ; Latent in 7b3a53d (bug predates it). Push before / restore after.
   23a1   68 ca 64 a3       RLDI 10, LMR_MOVE_INDEX
   23a5   0a                LDN 10
   23a6   73                STXD                ; push LMR_MOVE_INDEX
                        
                            ; Increment ply for recursive call
   23a7   68 ca 64 48       RLDI 10, CURRENT_PLY
   23ab   0a                LDN 10
   23ac   fc 01             ADI 1
   23ae   5a                STR 10              ; CURRENT_PLY++
                        
                            ; Call NEGAMAX again (full depth this time)
   23af   d4 1c 4e          CALL NEGAMAX
                        
                            ; Restore LMR_MOVE_INDEX (the re-searched child clobbered it)
   23b2   60                IRX
   23b3   f0                LDX                 ; D = saved LMR_MOVE_INDEX
   23b4   a7                PLO 7               ; temp (R7.0 dead here — R9 holds the score)
   23b5   68 ca 64 a3       RLDI 10, LMR_MOVE_INDEX
   23b9   87                GLO 7
   23ba   5a                STR 10              ; LMR_MOVE_INDEX restored to this node's value
                        
                            ; Decrement ply
   23bb   68 ca 64 48       RLDI 10, CURRENT_PLY
   23bf   0a                LDN 10
   23c0   ff 01             SMI 1
   23c2   5a                STR 10              ; CURRENT_PLY--
                        
                            ; Negate R9 (score = -score)
   23c3   89                GLO 9               ; low byte
   23c4   fd 00             SDI 0               ; negate low
   23c6   a9                PLO 9
   23c7   99                GHI 9               ; high byte
   23c8   7d 00             SDBI 0              ; negate high with borrow
   23ca   b9                PHI 9
                        
                            ; Save to SCORE_HI/LO
   23cb   68 ca 64 46       RLDI 10, SCORE_HI
   23cf   99                GHI 9               ; high byte → SCORE_HI (lower address)
   23d0   5a                STR 10
   23d1   1a                INC 10
   23d2   89                GLO 9               ; low byte → SCORE_LO (higher address)
   23d3   5a                STR 10
                        
   23d4                 LMR_NO_RESEARCH:
                        
                            ; -----------------------------------------------
                            ; Restore BEST_SCORE from stack FIRST (it was pushed last - LIFO!)
                            ; This was corrupted by child's NEGAMAX initialization!
                            ; -----------------------------------------------
   23d4   68 ca 64 0f       RLDI 10, BEST_SCORE_LO
   23d8   60                IRX
   23d9   72                LDXA                ; BEST_SCORE_LO
   23da   5a                STR 10
   23db   2a                DEC 10
   23dc   f0                LDX                 ; BEST_SCORE_HI (R2 stays at this slot)
   23dd   5a                STR 10
                        
                            ; -----------------------------------------------
                            ; Restore UNDO_* from stack (7 bytes) before UNMAKE_MOVE
                            ; -----------------------------------------------
                            ; UNDO_CAP_SQ first (it was pushed last - LIFO)
   23de   68 ca 64 ff       RLDI 10, UNDO_CAP_SQ
   23e2   60                IRX
   23e3   f0                LDX                 ; UNDO_CAP_SQ
   23e4   5a                STR 10
                            ; UNDO_PROMOTION next
   23e5   68 ca 64 04       RLDI 10, UNDO_PROMOTION
   23e9   60                IRX
   23ea   f0                LDX                 ; UNDO_PROMOTION
   23eb   5a                STR 10
                            ; Now restore the contiguous block ($6408-$640D)
   23ec   68 ca 64 0d       RLDI 10, UNDO_HALFMOVE
   23f0   60                IRX
   23f1   72                LDXA                ; UNDO_HALFMOVE
   23f2   5a                STR 10
   23f3   2a                DEC 10
   23f4   72                LDXA                ; UNDO_EP
   23f5   5a                STR 10
   23f6   2a                DEC 10
   23f7   72                LDXA                ; UNDO_CASTLING
   23f8   5a                STR 10
   23f9   2a                DEC 10
   23fa   72                LDXA                ; UNDO_TO
   23fb   5a                STR 10
   23fc   2a                DEC 10
   23fd   72                LDXA                ; UNDO_FROM
   23fe   5a                STR 10
   23ff   2a                DEC 10
   2400   f0                LDX                 ; UNDO_CAPTURED (last, no inc)
   2401   5a                STR 10
                        
                            ; -----------------------------------------------
                            ; Unmake the move
                            ; -----------------------------------------------
   2402   d4 0c 20          CALL UNMAKE_MOVE
                            ; Board restored to previous state
                        
                            ; -----------------------------------------------
                            ; Restore context (memory-based alpha/beta - R6 is SCRT linkage!)
                            ; -----------------------------------------------
                            ; Stack order (low to high): beta_lo, beta_hi, alpha_lo, alpha_hi, depth_lo, depth_hi, R9
                        
                            ; Pop beta from stack to BETA memory (big-endian)
   2405   60                IRX                 ; Point to beta_lo
   2406   72                LDXA                ; D = beta_lo
   2407   a7                PLO 7               ; R7.0 = beta_lo
   2408   72                LDXA                ; D = beta_hi
   2409   b7                PHI 7               ; R7.1 = beta_hi, R7 = beta
   240a   68 cd 64 44       RLDI 13, BETA_HI
   240e   97                GHI 7
   240f   5d                STR 13              ; BETA_HI (high byte at lower addr)
   2410   1d                INC 13
   2411   87                GLO 7
   2412   5d                STR 13              ; BETA_LO (low byte at higher addr)
                        
                            ; Pop alpha from stack to ALPHA memory (NO extra IRX - R2 already at alpha_lo)
   2413   72                LDXA                ; D = alpha_lo
   2414   a7                PLO 7               ; R7.0 = alpha_lo
   2415   72                LDXA                ; D = alpha_hi
   2416   b7                PHI 7               ; R7.1 = alpha_hi, R7 = alpha
   2417   68 cd 64 42       RLDI 13, ALPHA_HI
   241b   97                GHI 7
   241c   5d                STR 13              ; ALPHA_HI (high byte at lower addr)
   241d   1d                INC 13
   241e   87                GLO 7
   241f   5d                STR 13              ; ALPHA_LO (low byte at higher addr)
                        
                            ; Pop depth from stack to SEARCH_DEPTH memory
                            ; Stack has: depth_lo, depth_hi (depth_lo at lower addr)
                            ; R9 no longer on stack; move count no longer on stack (LOOP_MOVE_CNT) —
                            ; depth_hi is now the TOP byte of this iteration's search-context frame.
   2420   72                LDXA                ; D = depth_lo, R2 advances to depth_hi
   2421   a7                PLO 7               ; Temp
   2422   f0                LDX                 ; D = depth_hi, R2 stays AT depth_hi (frame top)
   2423   b7                PHI 7               ; R7 = depth (temp: hi.lo)
   2424   68 cd 64 16       RLDI 13, SEARCH_DEPTH
   2428   97                GHI 7
   2429   5d                STR 13              ; SEARCH_DEPTH high
   242a   1d                INC 13
   242b   87                GLO 7
   242c   5d                STR 13              ; SEARCH_DEPTH+1 low
                        
                            ; Toggle color back to parent's color (0/8)
   242d   8c                GLO 12
   242e   fb 08             XRI $08
   2430   ac                PLO 12              ; C = color restored
                        
                            ; Restore R9 (move list pointer) from ply-indexed memory
   2431   68 ca 64 48       RLDI 10, CURRENT_PLY
   2435   0a                LDN 10              ; D = ply
   2436   fe                SHL                 ; D = ply * 2
   2437   fc db             ADI LOW(LOOP_MOVE_PTR)
   2439   aa                PLO 10
   243a   f8 64             LDI HIGH(LOOP_MOVE_PTR)
   243c   ba                PHI 10              ; R10 = LOOP_MOVE_PTR + ply*2
   243d   4a                LDA 10
   243e   b9                PHI 9               ; R9.hi
   243f   0a                LDN 10
   2440   a9                PLO 9               ; R9 = move list pointer restored
                        
                            ; Load score from SCORE memory into R13 (R9 is move list pointer!)
                            ; Big-endian: high byte at lower address (SCORE_HI)
   2441   68 ca 64 46       RLDI 10, SCORE_HI
   2445   4a                LDA 10              ; SCORE_HI -> high byte
   2446   bd                PHI 13
   2447   0a                LDN 10              ; SCORE_LO -> low byte
   2448   ad                PLO 13              ; R13 = negated score from memory
                        
                            ; -----------------------------------------------
                            ; Beta Cutoff Check: if (score >= beta) return beta
                            ; -----------------------------------------------
                            ; Compare score (R13) with beta (from BETA memory)
                            ; Score is already saved to SCORE_HI/LO, can reload if needed
                        
                            ; Load beta from memory into R7 (use R10 as pointer, preserve R13=score)
                            ; Big-endian: high byte at lower address (BETA_HI)
   2449   68 ca 64 44       RLDI 10, BETA_HI
   244d   4a                LDA 10              ; D = beta_hi
   244e   b7                PHI 7
   244f   0a                LDN 10              ; D = beta_lo
   2450   a7                PLO 7               ; R7 = beta (loaded from memory)
                        
                            ; SIGNED comparison: score (R13) vs beta (R7)
                            ; Use COMPARE_TEMP for scratch (NEVER use STR 2 for scratch!)
   2451   68 ca 64 49       RLDI 10, COMPARE_TEMP
   2455   ea                SEX 10              ; X = R10 for comparisons
                        
                            ; First check if signs differ
   2456   9d                GHI 13              ; score high byte
   2457   5a                STR 10
   2458   97                GHI 7               ; beta high byte
   2459   f3                XOR                 ; XOR high bytes
   245a   fa 80             ANI $80             ; Check if sign bits differ
   245c   e2                SEX 2               ; X = R2 (restore for branches)
   245d   ca 24 72          LBNZ NEGAMAX_BETA_DIFF_SIGN
                        
                            ; Same sign - use subtraction result
                            ; Compute score - beta: SM does D - M(X), SD does M(X) - D
   2460   ea                SEX 10
   2461   87                GLO 7
   2462   5a                STR 10              ; M(R10) = beta_lo
   2463   8d                GLO 13              ; D = score_lo
   2464   f7                SM                  ; D = D - M(X) = score_lo - beta_lo
   2465   97                GHI 7
   2466   5a                STR 10              ; M(R10) = beta_hi
   2467   9d                GHI 13              ; D = score_hi
   2468   77                SMB                 ; D = D - M(X) - borrow = score_hi - beta_hi - borrow
   2469   e2                SEX 2               ; X = R2 (restore)
                        
                            ; Check sign bit (negative means score < beta, no cutoff)
   246a   fa 80             ANI $80
   246c   ca 24 e7          LBNZ NEGAMAX_NO_BETA_CUTOFF  ; score < beta, no cutoff
                            ; Fall through to cutoff (score >= beta)
   246f   c0 24 78          LBR NEGAMAX_DO_BETA_CUTOFF
                        
   2472                 NEGAMAX_BETA_DIFF_SIGN:
                            ; Different signs - positive number is greater
   2472   9d                GHI 13              ; score high byte
   2473   fa 80             ANI $80
   2475   ca 24 e7          LBNZ NEGAMAX_NO_BETA_CUTOFF  ; Score negative, beta positive: score < beta, NO cutoff
                            ; Score positive, beta negative: score > beta, CUTOFF (fall through)
                        
   2478                 NEGAMAX_DO_BETA_CUTOFF:
                            ; Beta cutoff! Return beta (already in R7)
                            ; Store beta to BEST_SCORE memory for return
                        
                            ; Store beta (R7) to BEST_SCORE memory
   2478   68 ca 64 0e       RLDI 10, BEST_SCORE_HI
   247c   97                GHI 7               ; Beta high byte
   247d   5a                STR 10
   247e   1a                INC 10
   247f   87                GLO 7               ; Beta low byte
   2480   5a                STR 10
                        
                            ; Save cutoff move to NODE_BEST_MOVE (all plies)
   2481   68 ca 64 48       RLDI 10, CURRENT_PLY
   2485   0a                LDN 10              ; D = ply
   2486   fe                SHL                 ; D = ply * 2
   2487   aa                PLO 10
   2488   f8 67             LDI HIGH(NODE_BEST_MOVE)
   248a   ba                PHI 10              ; R10 = &NODE_BEST_MOVE[ply]
   248b   68 c7 64 09       RLDI 7, UNDO_FROM
   248f   47                LDA 7               ; D = from
   2490   5a                STR 10
   2491   1a                INC 10
   2492   07                LDN 7               ; D = to
   2493   5a                STR 10              ; R7 clobbered — safe (not used before NEGAMAX_RETURN)
                        
                            ; At root (ply 0), save the cutoff move as BEST_MOVE.
                            ; Beta cutoff means this move is "too good" - but at root there's
                            ; no parent to reject it, so it IS the best move. Without this,
                            ; BEST_MOVE stays at $FF/$FF sentinel → h@h@ output.
   2494   68 ca 64 48       RLDI 10, CURRENT_PLY
   2498   0a                LDN 10              ; D = current ply
   2499   ca 24 ad          LBNZ NEGAMAX_BETA_NOT_ROOT
                        
                            ; At root: save UNDO_FROM/UNDO_TO to BEST_MOVE
   249c   68 ca 64 09       RLDI 10, UNDO_FROM
   24a0   4a                LDA 10              ; UNDO_FROM
   24a1   b8                PHI 8               ; Temp in R8.1
   24a2   0a                LDN 10              ; UNDO_TO
   24a3   a8                PLO 8               ; R8 = from/to
                        
   24a4   68 ca 64 10       RLDI 10, BEST_MOVE
   24a8   98                GHI 8
   24a9   5a                STR 10              ; BEST_MOVE[0] = from
   24aa   1a                INC 10
   24ab   88                GLO 8
   24ac   5a                STR 10              ; BEST_MOVE[1] = to
                        
   24ad                 NEGAMAX_BETA_NOT_ROOT:
                            ; Decrement move count (in ply-indexed memory) before returning
   24ad   68 ca 64 48       RLDI 10, CURRENT_PLY
   24b1   0a                LDN 10
   24b2   fc ef             ADI LOW(LOOP_MOVE_CNT)
   24b4   aa                PLO 10
   24b5   f8 64             LDI HIGH(LOOP_MOVE_CNT)
   24b7   ba                PHI 10              ; R10 = &LOOP_MOVE_CNT[ply]
   24b8   0a                LDN 10
   24b9   ff 01             SMI 1
   24bb   5a                STR 10             ; LOOP_MOVE_CNT[ply]--
                        
                            ; Encode cutoff move into R11 for killer table
                            ; (R11 has stale data from ORDER_CAPTURES_FIRST, not the actual move)
   24bc   68 ca 64 09       RLDI 10, UNDO_FROM
   24c0   0a                LDN 10              ; D = from square
   24c1   bd                PHI 13              ; R13.1 = from
   24c2   1a                INC 10
   24c3   0a                LDN 10              ; D = to square
   24c4   ad                PLO 13              ; R13.0 = to
                            ; Flags = 0 (MOVE_NORMAL); promotions rare in cutoffs
   24c5   68 ca 64 06       RLDI 10, MOVE_FLAGS_TEMP
   24c9   f8 00             LDI 0
   24cb   5a                STR 10
   24cc   d4 03 8d          CALL ENCODE_MOVE_16BIT
                            ; R8 = encoded move
   24cf   98                GHI 8
   24d0   bb                PHI 11
   24d1   88                GLO 8
   24d2   ab                PLO 11              ; R11 = properly encoded cutoff move
   24d3   d4 29 22          CALL STORE_KILLER_MOVE
                        
                            ; -- TT node flag: BETA (lower bound) --
   24d6   68 ca 64 48       RLDI 10, CURRENT_PLY
   24da   0a                LDN 10
   24db   fc d2             ADI LOW(NODE_TT_FLAGS)
   24dd   aa                PLO 10
   24de   f8 64             LDI HIGH(NODE_TT_FLAGS)
   24e0   ba                PHI 10
   24e1   f8 03             LDI TT_FLAG_BETA
   24e3   5a                STR 10
                        
   24e4   c0 25 d9          LBR NEGAMAX_RETURN
                        
   24e7                 NEGAMAX_NO_BETA_CUTOFF:
                            ; Score is already in R13 from earlier load (before beta check)
                            ; R9 = move list pointer (preserved)
                        
                            ; Load best score from memory into R8 for comparison
   24e7   68 ca 64 0e       RLDI 10, BEST_SCORE_HI
   24eb   4a                LDA 10              ; BEST_SCORE_HI
   24ec   b8                PHI 8
   24ed   0a                LDN 10              ; BEST_SCORE_LO
   24ee   a8                PLO 8               ; R8 = best score from memory
                        
                            ; -----------------------------------------------
                            ; Update best score: if (score > maxScore) maxScore = score
                            ; -----------------------------------------------
                            ; SIGNED comparison of score (R13) vs best (R8)
                            ; Use COMPARE_TEMP for scratch (NEVER use STR 2 for scratch!)
   24ef   68 ca 64 49       RLDI 10, COMPARE_TEMP
   24f3   ea                SEX 10              ; X = R10 for comparisons
                        
                            ; First check if signs differ
   24f4   9d                GHI 13              ; score high byte
   24f5   5a                STR 10
   24f6   98                GHI 8               ; best high byte
   24f7   f3                XOR                 ; XOR high bytes
   24f8   fa 80             ANI $80             ; Check if sign bits differ
   24fa   e2                SEX 2               ; X = R2 (restore for branches)
   24fb   ca 25 1c          LBNZ NEGAMAX_DIFF_SIGN
                        
                            ; Same sign - use subtraction result
   24fe   ea                SEX 10
   24ff   98                GHI 8
   2500   5a                STR 10
   2501   9d                GHI 13
   2502   f5                SD                  ; D = score_hi - best_hi
   2503   e2                SEX 2
   2504   ca 25 16          LBNZ NEGAMAX_HI_DIFF
                            ; High bytes equal, compare low
   2507   ea                SEX 10
   2508   88                GLO 8
   2509   5a                STR 10
   250a   8d                GLO 13
   250b   f5                SD                  ; D = score_lo - best_lo
   250c   e2                SEX 2
   250d   c2 25 a9          LBZ NEGAMAX_NEXT_MOVE       ; Equal, don't update (keep first move)
   2510   cb 25 22          LBNF NEGAMAX_SCORE_BETTER   ; DF=0: score > best
   2513   c0 25 a9          LBR NEGAMAX_NEXT_MOVE       ; DF=1: score < best
                        
   2516                 NEGAMAX_HI_DIFF:
   2516   cb 25 22          LBNF NEGAMAX_SCORE_BETTER   ; DF=0: score > best
   2519   c0 25 a9          LBR NEGAMAX_NEXT_MOVE       ; DF=1: score < best
                        
   251c                 NEGAMAX_DIFF_SIGN:
                            ; Different signs - positive number is greater
   251c   9d                GHI 13
   251d   fa 80             ANI $80
   251f   ca 25 a9          LBNZ NEGAMAX_NEXT_MOVE      ; Score negative, best positive - skip
                            ; Score positive/zero, best negative - update (fall through)
                        
   2522                 NEGAMAX_SCORE_BETTER:
                            ; Score is better, update best score in memory (R13 -> BEST_SCORE)
   2522   68 ca 64 0e       RLDI 10, BEST_SCORE_HI
   2526   9d                GHI 13              ; Score high byte
   2527   5a                STR 10
   2528   1a                INC 10
   2529   8d                GLO 13              ; Score low byte
   252a   5a                STR 10              ; BEST_SCORE = score
                        
                            ; Save node best move for TT (all plies)
   252b   68 ca 64 48       RLDI 10, CURRENT_PLY
   252f   0a                LDN 10              ; D = ply
   2530   fe                SHL                 ; D = ply * 2
   2531   aa                PLO 10
   2532   f8 67             LDI HIGH(NODE_BEST_MOVE)
   2534   ba                PHI 10              ; R10 = &NODE_BEST_MOVE[ply]
   2535   68 c7 64 09       RLDI 7, UNDO_FROM   ; RLDI preserves D!
   2539   47                LDA 7               ; D = from, R7 → UNDO_TO
   253a   5a                STR 10              ; NODE_BEST_MOVE[ply] = from
   253b   1a                INC 10
   253c   07                LDN 7               ; D = to
   253d   5a                STR 10              ; NODE_BEST_MOVE[ply+1] = to
                        
                            ; -----------------------------------------------
                            ; If at root (PLY == 0), save this move to BEST_MOVE
                            ; -----------------------------------------------
   253e   68 ca 64 48       RLDI 10, CURRENT_PLY
   2542   0a                LDN 10              ; Get current ply
   2543   ca 25 57          LBNZ NEGAMAX_UPDATE_ALPHA  ; Not at root, skip BEST_MOVE but still update alpha
                        
                            ; At root - save move to BEST_MOVE from UNDO_FROM/UNDO_TO
   2546   68 ca 64 09       RLDI 10, UNDO_FROM
   254a   4a                LDA 10              ; UNDO_FROM
   254b   b7                PHI 7               ; Temp
   254c   0a                LDN 10              ; UNDO_TO
   254d   a7                PLO 7               ; R7 = from/to
                        
   254e   68 ca 64 10       RLDI 10, BEST_MOVE
   2552   97                GHI 7
   2553   5a                STR 10              ; BEST_MOVE[0] = from
   2554   1a                INC 10
   2555   87                GLO 7
   2556   5a                STR 10              ; BEST_MOVE[1] = to
                        
                            ; Fall through to alpha update
                        
   2557                 NEGAMAX_UPDATE_ALPHA:
                            ; -----------------------------------------------
                            ; Update alpha: if (score > alpha) alpha = score
                            ; -----------------------------------------------
                            ; R13 = score (preserved from NEGAMAX_SCORE_BETTER entry)
                            ; Load alpha from memory into R8
   2557   68 ca 64 42       RLDI 10, ALPHA_HI
   255b   4a                LDA 10
   255c   b8                PHI 8               ; R8.1 = alpha_hi
   255d   0a                LDN 10
   255e   a8                PLO 8               ; R8 = alpha
                        
                            ; Signed compare: score (R13) > alpha (R8)?
   255f   68 ca 64 49       RLDI 10, COMPARE_TEMP
   2563   ea                SEX 10
                        
                            ; Check if signs differ
   2564   9d                GHI 13              ; score_hi
   2565   5a                STR 10
   2566   98                GHI 8               ; alpha_hi
   2567   f3                XOR
   2568   fa 80             ANI $80
   256a   e2                SEX 2
   256b   ca 25 8c          LBNZ NEGAMAX_ALPHA_DIFF_SIGN
                        
                            ; Same sign: score > alpha if (score - alpha) > 0
   256e   ea                SEX 10
   256f   98                GHI 8               ; alpha_hi
   2570   5a                STR 10
   2571   9d                GHI 13              ; score_hi
   2572   f5                SD                  ; D = score_hi - alpha_hi
   2573   e2                SEX 2
   2574   ca 25 86          LBNZ NEGAMAX_ALPHA_HI_DIFF
                            ; High bytes equal, compare low
   2577   ea                SEX 10
   2578   88                GLO 8               ; alpha_lo
   2579   5a                STR 10
   257a   8d                GLO 13              ; score_lo
   257b   f5                SD                  ; D = score_lo - alpha_lo
   257c   e2                SEX 2
   257d   c2 25 a9          LBZ NEGAMAX_NEXT_MOVE           ; Equal, don't update
   2580   cb 25 92          LBNF NEGAMAX_ALPHA_DO_UPDATE    ; DF=0: score > alpha
   2583   c0 25 a9          LBR NEGAMAX_NEXT_MOVE           ; DF=1: score < alpha
                        
   2586                 NEGAMAX_ALPHA_HI_DIFF:
   2586   cb 25 92          LBNF NEGAMAX_ALPHA_DO_UPDATE    ; DF=0: score > alpha
   2589   c0 25 a9          LBR NEGAMAX_NEXT_MOVE           ; DF=1: score < alpha
                        
   258c                 NEGAMAX_ALPHA_DIFF_SIGN:
                            ; Different signs: positive > negative
   258c   9d                GHI 13              ; score_hi
   258d   fa 80             ANI $80
   258f   ca 25 a9          LBNZ NEGAMAX_NEXT_MOVE          ; Score negative, alpha positive - skip
                            ; Score positive, alpha negative - update (fall through)
                        
   2592                 NEGAMAX_ALPHA_DO_UPDATE:
                            ; alpha = score
   2592   68 ca 64 42       RLDI 10, ALPHA_HI
   2596   9d                GHI 13
   2597   5a                STR 10
   2598   1a                INC 10
   2599   8d                GLO 13
   259a   5a                STR 10              ; ALPHA = score
                        
                            ; -- TT node flag: EXACT (PV node) --
   259b   68 ca 64 48       RLDI 10, CURRENT_PLY
   259f   0a                LDN 10
   25a0   fc d2             ADI LOW(NODE_TT_FLAGS)
   25a2   aa                PLO 10
   25a3   f8 64             LDI HIGH(NODE_TT_FLAGS)
   25a5   ba                PHI 10
   25a6   f8 01             LDI TT_FLAG_EXACT
   25a8   5a                STR 10
                        
   25a9                 NEGAMAX_NEXT_MOVE:
                            ; -----------------------------------------------
                            ; Increment LMR move counter (move was processed)
                            ; -----------------------------------------------
   25a9   68 ca 64 a3       RLDI 10, LMR_MOVE_INDEX
   25ad   0a                LDN 10
   25ae   fc 01             ADI 1
   25b0   5a                STR 10              ; LMR_MOVE_INDEX++
                        
                            ; -----------------------------------------------
                            ; Decrement move counter and continue loop
                            ; -----------------------------------------------
   25b1   68 ca 64 48       RLDI 10, CURRENT_PLY
   25b5   0a                LDN 10             ; D = ply
   25b6   fc ef             ADI LOW(LOOP_MOVE_CNT)
   25b8   aa                PLO 10
   25b9   f8 64             LDI HIGH(LOOP_MOVE_CNT)
   25bb   ba                PHI 10             ; R10 = &LOOP_MOVE_CNT[ply]
   25bc   0a                LDN 10             ; D = move count
   25bd   ff 01             SMI 1              ; Decrement
   25bf   5a                STR 10             ; LOOP_MOVE_CNT[ply]-- (D still holds new value)
   25c0   c2 25 c6          LBZ NEGAMAX_LOOP_DONE ; If count == 0, exit loop (long branch)
   25c3   c0 20 7f          LBR NEGAMAX_MOVE_LOOP
                        
   25c6                 NEGAMAX_LOOP_DONE:
                            ; Count (now in LOOP_MOVE_CNT[ply], not the stack) reached 0.
                            ; R2 was never perturbed by count management — no stack re-sync needed.
                        
                            ; Check if any legal move updated BEST_SCORE.
                            ; If BEST_SCORE is still $8001 (initial sentinel), no legal move
                            ; was found - all pseudo-legal moves left king in check.
                            ; This is checkmate or stalemate; handle via NEGAMAX_NO_MOVES.
                            ; (R2 is at the function-entry position; count is in LOOP_MOVE_CNT, not stack)
   25c6   68 ca 64 0e       RLDI 10, BEST_SCORE_HI
   25ca   4a                LDA 10              ; D = BEST_SCORE_HI
   25cb   fb 80             XRI $80
   25cd   ca 25 d9          LBNZ NEGAMAX_RETURN ; BEST_SCORE_HI != $80 → a legal move was scored
   25d0   0a                LDN 10              ; D = BEST_SCORE_LO
   25d1   fb 01             XRI $01
   25d3   ca 25 d9          LBNZ NEGAMAX_RETURN ; BEST_SCORE_LO != $01 → a legal move was scored
                        
                            ; BEST_SCORE == $8001: no legal move improved the sentinel.
                            ; All pseudo-legal moves were illegal → checkmate or stalemate.
   25d6   c0 26 23          LBR NEGAMAX_NO_MOVES
                        
   25d9                 NEGAMAX_RETURN:
                            ; -----------------------------------------------
                            ; Return best score (from BEST_SCORE memory) via R9
                            ; -----------------------------------------------
                            ; Move count now lives in LOOP_MOVE_CNT[ply], never on the stack, so R2
                            ; is already at the function-entry position here — no count byte to pop.
                            ; (Was: IRX to skip a stack-resident move count. See LOOP_MOVE_CNT.)
                        
                            ; Copy BEST_SCORE to SCORE memory BEFORE restore (RESTORE clobbers R9!)
                            ; Best score is in BEST_SCORE_HI/LO, copy to SCORE_HI/LO for return
   25d9   68 ca 64 0e       RLDI 10, BEST_SCORE_HI
   25dd   4a                LDA 10              ; BEST_SCORE_HI
   25de   b8                PHI 8               ; Temp in R8.1
   25df   0a                LDN 10              ; BEST_SCORE_LO
   25e0   a8                PLO 8               ; Temp in R8.0
                        
   25e1   68 ca 64 46       RLDI 10, SCORE_HI
   25e5   98                GHI 8               ; Best score high byte
   25e6   5a                STR 10
   25e7   1a                INC 10
   25e8   88                GLO 8               ; Best score low byte
   25e9   5a                STR 10
                        
                            ; -----------------------------------------------
                            ; Store result in Transposition Table
                            ; -----------------------------------------------
                            ; Hash is updated incrementally in MAKE/UNMAKE_MOVE,
                            ; so TT works correctly at all nodes.
                        
                            ; TT_STORE expects: D = depth, R8.0 = flag, SCORE_HI/LO and BEST_MOVE set
                            ; -- Load TT node flag for current ply --
   25ea   68 ca 64 48       RLDI 10, CURRENT_PLY
   25ee   0a                LDN 10
   25ef   fc d2             ADI LOW(NODE_TT_FLAGS)
   25f1   aa                PLO 10
   25f2   f8 64             LDI HIGH(NODE_TT_FLAGS)
   25f4   ba                PHI 10
   25f5   0a                LDN 10              ; D = flag
   25f6   a8                PLO 8               ; R8.0 = flag
   25f7   68 ca 64 17       RLDI 10, SEARCH_DEPTH + 1
   25fb   0a                LDN 10              ; D = depth (low byte = actual depth)
   25fc   d4 58 6b          CALL TT_STORE
                        
                            ; Restore caller's context (clobbers R7, R8, R9, R11, R12)
   25ff   d4 00 54          CALL RESTORE_PLY_STATE
                        
                            ; Load return value back into R9 AFTER restore
                            ; Big-endian: load high byte from lower address first
   2602   68 ca 64 46       RLDI 10, SCORE_HI
   2606   4a                LDA 10              ; SCORE_HI -> high byte
   2607   b9                PHI 9
   2608   0a                LDN 10              ; SCORE_LO -> low byte
   2609   a9                PLO 9
                        
   260a   d5                RETN
                        
   260b                 NEGAMAX_LEAF:
                            ; -----------------------------------------------
                            ; Leaf node - do quiescence search
                            ; -----------------------------------------------
   260b   d4 26 72          CALL QUIESCENCE_SEARCH
                            ; Returns score in R9 (already from side-to-move's perspective)
                        
                            ; Save return value to SCORE memory BEFORE restore (RESTORE clobbers R9!)
                            ; Big-endian: store high byte at lower address (SCORE_HI), low at SCORE_LO
   260e   68 ca 64 46       RLDI 10, SCORE_HI
   2612   99                GHI 9               ; Score high byte first
   2613   5a                STR 10
   2614   1a                INC 10
   2615   89                GLO 9               ; Score low byte second
   2616   5a                STR 10
                        
                            ; Restore caller's context (clobbers R7, R8, R9, R11, R12)
   2617   d4 00 54          CALL RESTORE_PLY_STATE
                        
                            ; Load return value back into R9 AFTER restore
                            ; Big-endian: load high byte from lower address first
   261a   68 ca 64 46       RLDI 10, SCORE_HI
   261e   4a                LDA 10              ; SCORE_HI -> high byte
   261f   b9                PHI 9
   2620   0a                LDN 10              ; SCORE_LO -> low byte
   2621   a9                PLO 9
                        
   2622   d5                RETN
                        
   2623                 NEGAMAX_NO_MOVES:
                            ; -----------------------------------------------
                            ; No legal moves - checkmate or stalemate
                            ; -----------------------------------------------
                            ; Check if in check
   2623   d4 01 8e          CALL IS_IN_CHECK
                            ; Returns: D = 1 if in check, 0 if not
                        
   2626   c2 26 58          LBZ NEGAMAX_STALEMATE   ; Long branch - may cross page
                        
                            ; Checkmate - return mate-score adjusted by ply so shorter mates score higher.
                            ; Formula: score = -MATE_VAL + ply  (standard negamax mate convention)
                            ; The mated side's score is "less negative" the farther from root we are,
                            ; so after the negation chain back to root, the side delivering the mate
                            ; sees a HIGHER score for SHORTER mate sequences (mate-in-1 > mate-in-2 > ...).
                            ;
                            ; FIXED 2026-04-27: previously used SEARCH_DEPTH+1 (depth_remaining), which
                            ; INVERTED the preference — engine consistently picked longer mates over
                            ; shorter ones at d>=3. Manifested visibly only after 2271af2 enabled real
                            ; promotions (positions with multiple forced-mate sequences became reachable).
                            ;
                            ; NOTE: Use $8001 (-32767) not $8000 (-32768) to avoid overflow when negating!
                            ; -(-32768) = -32768 due to two's complement overflow, breaking score propagation!
   2629   f8 80             LDI $80
   262b   b9                PHI 9
   262c   f8 01             LDI $01
   262e   a9                PLO 9              ; R9 = -32767 (R6 is SCRT linkage - off limits!)
                        
                            ; Add ply (distance from root) so shorter mates score higher
   262f   68 cd 64 48       RLDI 13, CURRENT_PLY
   2633   0d                LDN 13              ; D = current ply (0 at root, increases with depth)
                            ; Use COMPARE_TEMP for ADD scratch (NEVER use STR 2!)
   2634   68 ca 64 49       RLDI 10, COMPARE_TEMP
   2638   ea                SEX 10
   2639   5a                STR 10
   263a   89                GLO 9
   263b   f4                ADD
   263c   e2                SEX 2
   263d   a9                PLO 9
                            ; High byte stays same (adding small depth won't overflow)
                        
                            ; Store checkmate score to BEST_SCORE memory for return
   263e   68 ca 64 0e       RLDI 10, BEST_SCORE_HI
   2642   99                GHI 9               ; Score high byte
   2643   5a                STR 10
   2644   1a                INC 10
   2645   89                GLO 9               ; Score low byte
   2646   5a                STR 10
                        
                            ; -- TT node flag: EXACT (checkmate) --
   2647   68 ca 64 48       RLDI 10, CURRENT_PLY
   264b   0a                LDN 10
   264c   fc d2             ADI LOW(NODE_TT_FLAGS)
   264e   aa                PLO 10
   264f   f8 64             LDI HIGH(NODE_TT_FLAGS)
   2651   ba                PHI 10
   2652   f8 01             LDI TT_FLAG_EXACT
   2654   5a                STR 10
                        
   2655   c0 25 d9          LBR NEGAMAX_RETURN
                        
   2658                 NEGAMAX_STALEMATE:
                            ; Stalemate - return 0 (draw)
                            ; Store 0 to BEST_SCORE memory for return
   2658   68 ca 64 0e       RLDI 10, BEST_SCORE_HI
   265c   f8 00             LDI 0
   265e   5a                STR 10              ; BEST_SCORE_HI = 0
   265f   1a                INC 10
   2660   5a                STR 10              ; BEST_SCORE_LO = 0
                        
                            ; -- TT node flag: EXACT (stalemate) --
   2661   68 ca 64 48       RLDI 10, CURRENT_PLY
   2665   0a                LDN 10
   2666   fc d2             ADI LOW(NODE_TT_FLAGS)
   2668   aa                PLO 10
   2669   f8 64             LDI HIGH(NODE_TT_FLAGS)
   266b   ba                PHI 10
   266c   f8 01             LDI TT_FLAG_EXACT
   266e   5a                STR 10
                        
   266f   c0 25 d9          LBR NEGAMAX_RETURN
                        
                        ; ==============================================================================
                        ; QUIESCENCE_SEARCH - Search captures at leaf nodes
                        ; ==============================================================================
                        ; Avoids horizon effect by extending search for captures
                        ; Input:  C = color (0 for white, 8 for black - matches COLOR_MASK)
                        ;         A = board pointer
                        ; Output: R9 = best score (from side-to-move's perspective)
                        ; NOTE:   R6 is SCRT linkage register - off limits for application data!
                        ; ==============================================================================
   2672                 QUIESCENCE_SEARCH:
                            ; Ensure X=2 for stack operations
   2672   e2                SEX 2
                        
   2673   68 ca 64 1d       RLDI 10, TRACE_WHERE
   2677   f8 c1             LDI $C1
   2679   5a                STR 10              ; tracer: in QSEARCH
                        
                            ; Stack overflow detection (see NEGAMAX comment).
   267a   d4 00 87          CALL CHECK_STACK_OVERFLOW
                        
                            ; Stand-pat: evaluate current position
   267d   d4 0e b4          CALL EVALUATE
                            ; Returns score in R9 (from white's perspective)
                        
                            ; Negate R9 if black to move (white-perspective → side-to-move)
   2680   8c                GLO 12
   2681   fa 08             ANI $08
   2683   c2 26 8e          LBZ QS_SAVE_STANDPAT
   2686   89                GLO 9               ; low byte
   2687   fd 00             SDI 0               ; negate low
   2689   a9                PLO 9
   268a   99                GHI 9               ; high byte
   268b   7d 00             SDBI 0              ; negate high with borrow
   268d   b9                PHI 9
                        
   268e                 QS_SAVE_STANDPAT:
                            ; Save stand-pat score to QS_BEST_HI/LO
   268e   68 ca 64 18       RLDI 10, QS_BEST_HI
   2692   99                GHI 9               ; high byte → QS_BEST_HI (lower address)
   2693   5a                STR 10
   2694   1a                INC 10
   2695   89                GLO 9               ; low byte → QS_BEST_LO (higher address)
   2696   5a                STR 10
                        
                            ; -----------------------------------------------
                            ; Stand-pat beta cutoff: if stand-pat >= beta, return
                            ; (Position is already good enough, no need to search captures)
                            ; -----------------------------------------------
                            ; Load beta from memory (big-endian: HI at lower address)
   2697   68 ca 64 44       RLDI 10, BETA_HI
   269b   4a                LDA 10              ; beta high
   269c   b7                PHI 7
   269d   0a                LDN 10              ; beta low
   269e   a7                PLO 7               ; R7 = beta
                        
                            ; Compare: stand-pat (R9) >= beta (R7)?
                            ; Signed comparison using COMPARE_TEMP
   269f   68 ca 64 49       RLDI 10, COMPARE_TEMP
   26a3   ea                SEX 10
   26a4   99                GHI 9               ; stand-pat high
   26a5   5a                STR 10
   26a6   97                GHI 7               ; beta high
   26a7   f3                XOR
   26a8   fa 80             ANI $80             ; Check if different signs
   26aa   e2                SEX 2
   26ab   ca 26 be          LBNZ QS_BETA_DIFF_SIGN
                        
                            ; Same sign - compare magnitudes
                            ; stand-pat >= beta means stand-pat - beta >= 0, i.e., no borrow
   26ae   ea                SEX 10
   26af   87                GLO 7               ; beta low
   26b0   5a                STR 10
   26b1   89                GLO 9               ; stand-pat low
   26b2   f7                SM                  ; D = stand-pat_lo - beta_lo
   26b3   97                GHI 7               ; beta high
   26b4   5a                STR 10
   26b5   99                GHI 9               ; stand-pat high
   26b6   77                SMB                 ; D = stand-pat_hi - beta_hi - borrow
   26b7   e2                SEX 2
   26b8   c3 29 19          LBDF QS_RETURN      ; No borrow = stand-pat >= beta, cutoff!
   26bb   c0 26 c4          LBR QS_NO_BETA_CUTOFF
                        
   26be                 QS_BETA_DIFF_SIGN:
                            ; Different signs: positive >= negative always
                            ; stand-pat positive (bit 7 = 0) means stand-pat >= beta
   26be   99                GHI 9
   26bf   fa 80             ANI $80
   26c1   c2 29 19          LBZ QS_RETURN       ; stand-pat positive, beta negative -> cutoff
                        
   26c4                 QS_NO_BETA_CUTOFF:
                            ; -----------------------------------------------
                            ; Alpha update: if stand-pat > alpha, alpha = stand-pat
                            ; (Tightens window, makes beta cutoffs more likely)
                            ; -----------------------------------------------
                            ; Load alpha (R9 still has stand-pat)
   26c4   68 ca 64 42       RLDI 10, ALPHA_HI
   26c8   4a                LDA 10              ; alpha high
   26c9   b7                PHI 7
   26ca   0a                LDN 10              ; alpha low
   26cb   a7                PLO 7               ; R7 = alpha
                        
                            ; Compare: stand-pat (R9) > alpha (R7)?
   26cc   68 ca 64 49       RLDI 10, COMPARE_TEMP
   26d0   ea                SEX 10
   26d1   99                GHI 9
   26d2   5a                STR 10
   26d3   97                GHI 7
   26d4   f3                XOR
   26d5   fa 80             ANI $80
   26d7   e2                SEX 2
   26d8   ca 26 f3          LBNZ QS_ALPHA_DIFF_SIGN
                        
                            ; Same sign - R9 > R7 means R9 - R7 > 0 (positive, no borrow, not zero)
   26db   ea                SEX 10
   26dc   87                GLO 7
   26dd   5a                STR 10
   26de   89                GLO 9
   26df   f7                SM                  ; D = stand-pat_lo - alpha_lo
   26e0   b8                PHI 8               ; Save low result
   26e1   97                GHI 7
   26e2   5a                STR 10
   26e3   99                GHI 9
   26e4   77                SMB                 ; D = stand-pat_hi - alpha_hi - borrow
   26e5   e2                SEX 2
   26e6   cb 27 02          LBNF QS_NO_ALPHA_UPDATE  ; Borrow = stand-pat <= alpha
   26e9   ca 26 f9          LBNZ QS_UPDATE_ALPHA     ; High diff non-zero and positive
   26ec   98                GHI 8                    ; Check low diff
   26ed   c2 27 02          LBZ QS_NO_ALPHA_UPDATE   ; Both zero = equal, don't update
   26f0   c0 26 f9          LBR QS_UPDATE_ALPHA
                        
   26f3                 QS_ALPHA_DIFF_SIGN:
                            ; Different signs: positive > negative
   26f3   99                GHI 9
   26f4   fa 80             ANI $80
   26f6   ca 27 02          LBNZ QS_NO_ALPHA_UPDATE  ; stand-pat negative, alpha positive
                            ; stand-pat positive, alpha negative -> update
                        
   26f9                 QS_UPDATE_ALPHA:
                            ; alpha = stand-pat
   26f9   68 ca 64 42       RLDI 10, ALPHA_HI
   26fd   99                GHI 9
   26fe   5a                STR 10
   26ff   1a                INC 10
   2700   89                GLO 9
   2701   5a                STR 10
                        
   2702                 QS_NO_ALPHA_UPDATE:
                            ; -----------------------------------------------
                            ; Delta pruning: if stand-pat + QUEEN_VALUE < alpha, return alpha
                            ; (Even capturing a queen can't raise alpha - futile to search)
                            ; -----------------------------------------------
                            ; Load alpha from memory (big-endian: HI at lower address)
   2702   68 ca 64 42       RLDI 10, ALPHA_HI
   2706   4a                LDA 10              ; alpha high
   2707   b7                PHI 7
   2708   0a                LDN 10              ; alpha low
   2709   a7                PLO 7               ; R7 = alpha
                        
                            ; Calculate stand-pat + QUEEN_VALUE (900 = $0384)
                            ; R9 = stand-pat, add 900
   270a   89                GLO 9
   270b   fc 84             ADI LOW(900)        ; Add low byte of 900 ($84)
   270d   a8                PLO 8
   270e   99                GHI 9
   270f   7c 03             ADCI HIGH(900)      ; Add high byte of 900 ($03) + carry
   2711   b8                PHI 8               ; R8 = stand-pat + 900
                        
                            ; Compare: (stand-pat + 900) < alpha?
                            ; If R8 < R7, then delta prune
   2712   68 ca 64 49       RLDI 10, COMPARE_TEMP
   2716   ea                SEX 10
   2717   98                GHI 8               ; (stand-pat + 900) high
   2718   5a                STR 10
   2719   97                GHI 7               ; alpha high
   271a   f3                XOR
   271b   fa 80             ANI $80             ; Check if different signs
   271d   e2                SEX 2
   271e   ca 27 31          LBNZ QS_DELTA_DIFF_SIGN
                        
                            ; Same sign - compare: R8 < R7 means R8 - R7 has borrow
   2721   ea                SEX 10
   2722   87                GLO 7               ; alpha low
   2723   5a                STR 10
   2724   88                GLO 8               ; (stand-pat + 900) low
   2725   f7                SM                  ; D = (sp+900)_lo - alpha_lo
   2726   97                GHI 7               ; alpha high
   2727   5a                STR 10
   2728   98                GHI 8               ; (stand-pat + 900) high
   2729   77                SMB                 ; D = (sp+900)_hi - alpha_hi - borrow
   272a   e2                SEX 2
   272b   cb 27 37          LBNF QS_DELTA_PRUNE ; Borrow = (stand-pat + 900) < alpha, prune!
   272e   c0 27 3c          LBR QS_NO_DELTA_PRUNE
                        
   2731                 QS_DELTA_DIFF_SIGN:
                            ; Different signs: negative < positive always
                            ; (stand-pat + 900) negative means it's < alpha (if alpha positive)
   2731   98                GHI 8
   2732   fa 80             ANI $80
   2734   c2 27 3c          LBZ QS_NO_DELTA_PRUNE ; (stand-pat + 900) positive -> no prune
                        
   2737                 QS_DELTA_PRUNE:
                            ; Return alpha (in R7) - we're too far behind
   2737   97                GHI 7
   2738   b9                PHI 9
   2739   87                GLO 7
   273a   a9                PLO 9               ; R9 = alpha
   273b   d5                RETN
                        
   273c                 QS_NO_DELTA_PRUNE:
                            ; Generate all moves (use QS_MOVE_LIST to avoid clobbering parent's move list!)
   273c   68 c9 67 80       RLDI 9, QS_MOVE_LIST
   2740   d4 04 d7          CALL GENERATE_MOVES
                            ; D = move count
                        
                            ; Save move count to temp (must clear R15.1 to avoid DEC underflow!)
   2743   af                PLO 15              ; R15.0 = move count (temp)
   2744   f8 00             LDI 0
   2746   bf                PHI 15              ; R15.1 = 0 (prevents underflow when DEC 15)
                        
                            ; Save move list start pointer (big-endian: high byte first)
   2747   68 ca 64 1a       RLDI 10, QS_MOVE_PTR_HI
   274b   f8 67             LDI HIGH(QS_MOVE_LIST)
   274d   5a                STR 10
   274e   1a                INC 10
   274f   f8 80             LDI LOW(QS_MOVE_LIST)
   2751   5a                STR 10
                        
                            ; Initialize capture limit counter
   2752   f8 08             LDI 8                   ; QS_CAPTURE_LIMIT = 8 captures max
   2754   bb                PHI 11                  ; R11.1 = captures remaining
                        
   2755                 QS_LOOP:
   2755   3f 59             BN4  BRK_QS_LOOP      ; /EF4 break trap (DEBUG)
   2757   79                MARK
   2758   d1                SEP  1
   2759                 BRK_QS_LOOP:
                            ; Check if any moves left
   2759   8f                GLO 15
   275a   c2 29 19          LBZ QS_RETURN
                        
                            ; Load move list pointer (big-endian: high byte first)
   275d   68 ca 64 1a       RLDI 10, QS_MOVE_PTR_HI
   2761   4a                LDA 10              ; High byte
   2762   b9                PHI 9
   2763   0a                LDN 10              ; Low byte
   2764   a9                PLO 9               ; R9 = move pointer
                        
                            ; Load encoded move (big-endian: high byte first)
   2765   49                LDA 9
   2766   b8                PHI 8
   2767   49                LDA 9
   2768   a8                PLO 8               ; R8 = encoded move
                        
                            ; Save updated pointer (big-endian: high byte first)
   2769   68 ca 64 1a       RLDI 10, QS_MOVE_PTR_HI
   276d   99                GHI 9
   276e   5a                STR 10
   276f   1a                INC 10
   2770   89                GLO 9
   2771   5a                STR 10
                        
                            ; Decrement move count
   2772   2f                DEC 15
                        
                            ; Decode move to get from/to squares
   2773   d4 03 c7          CALL DECODE_MOVE_16BIT
                            ; R13.1 = from, R13.0 = to (R14.0 = flags - but we don't use it)
                        
                            ; Check if this is a capture: target square must have enemy piece
   2776   f8 60             LDI HIGH(BOARD)
   2778   ba                PHI 10
   2779   8d                GLO 13              ; to square
   277a   aa                PLO 10
   277b   0a                LDN 10              ; piece at target
   277c   c2 27 55          LBZ QS_LOOP         ; Empty = not a capture, skip
                        
                            ; Has piece - check if enemy color
   277f   fa 08             ANI COLOR_MASK      ; D = target piece color (0 or 8)
                            ; Use COMPARE_TEMP for XOR scratch (NEVER use STR 2!)
   2781   68 ca 64 49       RLDI 10, COMPARE_TEMP
   2785   ea                SEX 10
   2786   5a                STR 10              ; Store target color to COMPARE_TEMP
   2787   8c                GLO 12              ; D = our color (0 or 8, per COLOR_MASK)
   2788   fa 08             ANI COLOR_MASK      ; D = our color masked (0 or 8)
   278a   f3                XOR                 ; D = our_color XOR target_color
   278b   e2                SEX 2
   278c   c2 27 55          LBZ QS_LOOP         ; Same color (result 0) = own piece, skip
                        
                            ; -------------------------------------------------
                            ; Per-capture delta pruning:
                            ; If stand_pat + victim_value < alpha, skip capture
                            ; (Even capturing this piece won't raise score above alpha)
                            ; -------------------------------------------------
                            ; Reload victim piece and extract type
   278f   f8 60             LDI HIGH(BOARD)
   2791   ba                PHI 10
   2792   8d                GLO 13              ; to square (preserved in R13.0)
   2793   aa                PLO 10
   2794   0a                LDN 10              ; piece at target
   2795   fa 07             ANI $07             ; D = piece type (1-6)
                        
                            ; Look up value: PIECE_VALUES + type*2
   2797   fe                SHL                 ; D = type * 2
   2798   fc 00             ADI LOW(PIECE_VALUES)
   279a   aa                PLO 10
   279b   f8 0e             LDI HIGH(PIECE_VALUES)
   279d   7c 00             ADCI 0
   279f   ba                PHI 10              ; R10 = &PIECE_VALUES[type]
                        
   27a0   4a                LDA 10              ; victim value high
   27a1   b8                PHI 8
   27a2   0a                LDN 10              ; victim value low
   27a3   a8                PLO 8               ; R8 = victim_value
                        
                            ; Load stand_pat from QS_BEST
   27a4   68 ca 64 18       RLDI 10, QS_BEST_HI
   27a8   4a                LDA 10
   27a9   b7                PHI 7
   27aa   0a                LDN 10
   27ab   a7                PLO 7               ; R7 = stand_pat
                        
                            ; R7 = stand_pat + victim_value
   27ac   88                GLO 8
   27ad   52                STR 2               ; Use stack top as temp
   27ae   87                GLO 7
   27af   f4                ADD
   27b0   a7                PLO 7
   27b1   98                GHI 8
   27b2   52                STR 2
   27b3   97                GHI 7
   27b4   74                ADC
   27b5   b7                PHI 7               ; R7 = stand_pat + victim_value
                        
                            ; Load alpha
   27b6   68 ca 64 42       RLDI 10, ALPHA_HI
   27ba   4a                LDA 10
   27bb   b8                PHI 8
   27bc   0a                LDN 10
   27bd   a8                PLO 8               ; R8 = alpha
                        
                            ; Compare: (stand_pat + victim) < alpha?
                            ; If R7 < R8, skip this capture
   27be   68 ca 64 49       RLDI 10, COMPARE_TEMP
   27c2   ea                SEX 10
   27c3   97                GHI 7               ; (stand_pat + victim) high
   27c4   5a                STR 10
   27c5   98                GHI 8               ; alpha high
   27c6   f3                XOR
   27c7   fa 80             ANI $80             ; Check if different signs
   27c9   e2                SEX 2
   27ca   ca 27 dd          LBNZ QS_DELTA_DIFF_SIGN2
                        
                            ; Same sign: R7 < R8 means R7 - R8 has borrow
   27cd   ea                SEX 10
   27ce   88                GLO 8               ; alpha low
   27cf   5a                STR 10
   27d0   87                GLO 7               ; (stand_pat + victim) low
   27d1   f7                SM                  ; D = (sp+v)_lo - alpha_lo
   27d2   98                GHI 8               ; alpha high
   27d3   5a                STR 10
   27d4   97                GHI 7               ; (stand_pat + victim) high
   27d5   77                SMB                 ; D = (sp+v)_hi - alpha_hi - borrow
   27d6   e2                SEX 2
   27d7   cb 27 55          LBNF QS_LOOP        ; Borrow = (stand_pat + victim) < alpha, skip!
   27da   c0 27 e3          LBR QS_DELTA_NO_PRUNE
                        
   27dd                 QS_DELTA_DIFF_SIGN2:
                            ; Different signs: negative < positive always
                            ; (stand_pat + victim) negative means it's < alpha (if alpha positive)
   27dd   97                GHI 7
   27de   fa 80             ANI $80
   27e0   ca 27 55          LBNZ QS_LOOP        ; (stand_pat + victim) negative -> skip capture
                        
   27e3                 QS_DELTA_NO_PRUNE:
                            ; -------------------------------------------------
                            ; End per-capture delta pruning
                            ; -------------------------------------------------
                        
                            ; It's a capture! Process it.
                            ; Save move count to stack (BOTH bytes! IS_IN_CHECK clobbers R15.1)
   27e3   9f                GHI 15
   27e4   73                STXD
   27e5   8f                GLO 15
   27e6   73                STXD
                        
                            ; ===============================================================
                            ; QSEARCH defender-check pre-filter (added 2026-05-07)
                            ; ===============================================================
                            ; QSEARCH lacks recursion: each capture is evaluated as if its
                            ; recapture won't happen. This causes phantom material wins when
                            ; we capture a defended piece with a more valuable attacker.
                            ;
                            ; Filter: if captor_value > victim_value AND target is defended
                            ; by enemy, skip this capture entirely. Single-level defender
                            ; check; doesn't see exchange chains, but catches the dominant
                            ; bug class (e.g., Bxg6 when h7-pawn defends).
                            ;
                            ; Empirical motivation (2026-05-07): post-Kxf7 d=1 returned +220cp
                            ; bestmove d3g6 (Bxg6) despite h7 pawn obviously recapturing —
                            ; QSEARCH saw bishop "win" but not the recapture.
                            ; ===============================================================
                        
                            ; Load victim_value from board[to_square]
   27e7   f8 60             LDI HIGH(BOARD)
   27e9   ba                PHI 10
   27ea   8d                GLO 13                          ; to square
   27eb   aa                PLO 10
   27ec   0a                LDN 10
   27ed   fa 07             ANI $07                         ; victim piece type 1-6
   27ef   fe                SHL                             ; * 2 for 16-bit table
   27f0   fc 00             ADI LOW(PIECE_VALUES)
   27f2   aa                PLO 10
   27f3   f8 0e             LDI HIGH(PIECE_VALUES)
   27f5   7c 00             ADCI 0
   27f7   ba                PHI 10
   27f8   4a                LDA 10                          ; victim_value hi
   27f9   b8                PHI 8
   27fa   0a                LDN 10                          ; victim_value lo
   27fb   a8                PLO 8                           ; R8 = victim_value
                        
                            ; Load captor_value from board[from_square]
   27fc   f8 60             LDI HIGH(BOARD)
   27fe   ba                PHI 10
   27ff   9d                GHI 13                          ; from square
   2800   aa                PLO 10
   2801   0a                LDN 10
   2802   fa 07             ANI $07                         ; captor piece type 1-6
   2804   fe                SHL
   2805   fc 00             ADI LOW(PIECE_VALUES)
   2807   aa                PLO 10
   2808   f8 0e             LDI HIGH(PIECE_VALUES)
   280a   7c 00             ADCI 0
   280c   ba                PHI 10
   280d   4a                LDA 10                          ; captor_value hi
   280e   b7                PHI 7
   280f   0a                LDN 10                          ; captor_value lo
   2810   a7                PLO 7                           ; R7 = captor_value
                        
                            ; Compare: victim - captor (16-bit signed). DF=1 if victim >= captor.
   2811   87                GLO 7
   2812   52                STR 2                           ; M(R2) = captor_lo
   2813   88                GLO 8
   2814   f7                SM                              ; D = victim_lo - captor_lo
   2815   97                GHI 7
   2816   52                STR 2                           ; M(R2) = captor_hi
   2817   98                GHI 8
   2818   77                SMB                             ; D = victim_hi - captor_hi - borrow
   2819   c3 28 34          LBDF QS_DEF_OK                  ; victim >= captor: no filter
                        
                            ; Captor > victim. Check if target square is defended by enemy.
                            ; Save R11.1 (capture limit) and R13 (from/to) — IS_SQUARE_ATTACKED
                            ; restores R11.0 and R12.0 but clobbers everything else including
                            ; R13 and R15.0.
   281c   9b                GHI 11
   281d   73                STXD                            ; push capture limit
   281e   9d                GHI 13
   281f   73                STXD                            ; push from
   2820   8d                GLO 13
   2821   73                STXD                            ; push to
                        
                            ; Set R11.0 = target square, R12.0 already = our color
   2822   8d                GLO 13
   2823   ab                PLO 11
   2824   d4 01 a4          CALL IS_SQUARE_ATTACKED
   2827   a7                PLO 7                           ; R7.0 = result (0=safe, 1=attacked)
   2828   e2                SEX 2                           ; Defensive: ensure X=2 for following pop
                        
                            ; Restore saved state
   2829   60                IRX
   282a   72                LDXA                            ; pop to → R13.0
   282b   ad                PLO 13
   282c   72                LDXA                            ; pop from → R13.1
   282d   bd                PHI 13
   282e   f0                LDX                             ; pop capture limit → R11.1
   282f   bb                PHI 11
                        
   2830   87                GLO 7
   2831   ca 28 67          LBNZ QS_DEF_SKIP                ; defended: filter fires, skip capture
                        
   2834                 QS_DEF_OK:
                            ; ===============================================================
                            ; End QSEARCH defender-check pre-filter
                            ; ===============================================================
                        
                            ; Store from/to for MAKE_MOVE
   2834   68 ca 64 02       RLDI 10, MOVE_FROM
   2838   9d                GHI 13              ; from
   2839   5a                STR 10
   283a   1a                INC 10
   283b   8d                GLO 13              ; to
   283c   5a                STR 10
                        
                            ; Set UNDO_PROMOTION based on move flags (capture-promotions)
   283d   68 ca 64 04       RLDI 10, UNDO_PROMOTION
   2841   68 cd 64 05       RLDI 13, DECODED_FLAGS
   2845   0d                LDN 13              ; D = flags
   2846   fb 03             XRI MOVE_PROMOTION  ; == $03?
   2848   ca 28 50          LBNZ QS_NOT_PROMO
   284b   f8 05             LDI QUEEN_TYPE      ; Promote to queen ($05)
   284d   c0 28 52          LBR QS_SET_PROMO
   2850                 QS_NOT_PROMO:
   2850   f8 00             LDI 0               ; Not a promotion
   2852                 QS_SET_PROMO:
   2852   5a                STR 10              ; UNDO_PROMOTION = QUEEN_TYPE or 0
                        
                            ; Make move
   2853   d4 09 b4          CALL MAKE_MOVE
                        
                            ; -----------------------------------------------
                            ; LEGALITY CHECK: Does this capture leave our king in check?
                            ; MAKE_MOVE does NOT toggle R12 - only SIDE in memory.
                            ; R12 still contains our color (the side that just moved).
                            ; -----------------------------------------------
   2856   d4 01 8e          CALL IS_IN_CHECK
                            ; D = 1 if our king is in check (illegal), 0 if safe
                        
   2859   c2 28 6f          LBZ QS_CAPTURE_LEGAL  ; D=0 means not in check, capture is legal
                        
                            ; ILLEGAL CAPTURE: Unmake and skip to next capture
   285c   d4 0c 20          CALL UNMAKE_MOVE
                        
                            ; R12 stays as our color (UNMAKE_MOVE doesn't toggle R12)
                        
                            ; Restore move count from stack and continue loop (both bytes)
   285f   60                IRX
   2860   72                LDXA
   2861   af                PLO 15              ; R15.0 = move count low
   2862   f0                LDX
   2863   bf                PHI 15              ; R15.1 = move count high (0)
   2864   c0 27 55          LBR QS_LOOP         ; Skip this illegal capture, try next
                        
   2867                 QS_DEF_SKIP:
                            ; Defender-check filter fired: skip capture WITHOUT make/unmake.
                            ; Pop R15 (saved before our filter ran) and continue.
   2867   60                IRX
   2868   72                LDXA
   2869   af                PLO 15              ; R15.0 = move count low
   286a   f0                LDX
   286b   bf                PHI 15              ; R15.1 = move count high (0)
   286c   c0 27 55          LBR QS_LOOP
                        
   286f                 QS_CAPTURE_LEGAL:
                            ; Check capture limit - decrement and bail if exhausted
   286f   9b                GHI 11                  ; D = captures remaining
   2870   c2 29 11          LBZ QS_CAPTURE_LIMIT_HIT ; Already at 0, don't process more
   2873   ff 01             SMI 1
   2875   bb                PHI 11                  ; R11.1 = captures remaining - 1
                        
                            ; Evaluate position after capture
   2876   d4 0e b4          CALL EVALUATE
                            ; Score in R9 (from white's perspective)
                        
                            ; Negate R9 if black to move (white-perspective → side-to-move)
   2879   8c                GLO 12
   287a   fa 08             ANI $08
   287c   c2 28 87          LBZ QS_NO_NEG
   287f   89                GLO 9               ; low byte
   2880   fd 00             SDI 0               ; negate low
   2882   a9                PLO 9
   2883   99                GHI 9               ; high byte
   2884   7d 00             SDBI 0              ; negate high with borrow
   2886   b9                PHI 9
   2887                 QS_NO_NEG:
                            ; Save score (R9) before UNMAKE_MOVE clobbers it
   2887   99                GHI 9
   2888   73                STXD
   2889   89                GLO 9
   288a   73                STXD
                        
                            ; Unmake move
   288b   d4 0c 20          CALL UNMAKE_MOVE
                        
                            ; Restore score (R9)
   288e   60                IRX
   288f   72                LDXA
   2890   a9                PLO 9
   2891   f0                LDX
   2892   b9                PHI 9
                        
                            ; Restore move count (both bytes)
   2893   60                IRX
   2894   72                LDXA
   2895   af                PLO 15              ; R15.0 = move count low
   2896   f0                LDX
   2897   bf                PHI 15              ; R15.1 = move count high (0)
                        
                            ; Compare: if score (R9) > best (QS_BEST), update best
                            ; Load QS_BEST into R7 for comparison (big-endian: HI first)
   2898   68 ca 64 18       RLDI 10, QS_BEST_HI
   289c   4a                LDA 10              ; High byte
   289d   b7                PHI 7
   289e   0a                LDN 10              ; Low byte
   289f   a7                PLO 7               ; R7 = QS_BEST
                        
                            ; Signed comparison: R9 > R7?
                            ; Use COMPARE_TEMP for scratch (NEVER use STR 2!)
   28a0   68 ca 64 49       RLDI 10, COMPARE_TEMP
   28a4   ea                SEX 10
   28a5   99                GHI 9
   28a6   5a                STR 10
   28a7   97                GHI 7
   28a8   f3                XOR
   28a9   fa 80             ANI $80
   28ab   e2                SEX 2
   28ac   ca 28 cd          LBNZ QS_DIFF_SIGN
                        
                            ; Same sign - compare normally
   28af   ea                SEX 10
   28b0   97                GHI 7
   28b1   5a                STR 10
   28b2   99                GHI 9
   28b3   f5                SD
   28b4   e2                SEX 2
   28b5   ca 28 c7          LBNZ QS_HI_DIFF
                            ; High bytes equal, compare low
   28b8   ea                SEX 10
   28b9   87                GLO 7
   28ba   5a                STR 10
   28bb   89                GLO 9
   28bc   f5                SD
   28bd   e2                SEX 2
   28be   c2 27 55          LBZ QS_LOOP         ; Equal, don't update
   28c1   cb 28 d3          LBNF QS_UPDATE      ; Score > best
   28c4   c0 27 55          LBR QS_LOOP         ; Score < best
                        
   28c7                 QS_HI_DIFF:
   28c7   cb 28 d3          LBNF QS_UPDATE      ; Score > best
   28ca   c0 27 55          LBR QS_LOOP         ; Score < best
                        
   28cd                 QS_DIFF_SIGN:
                            ; Different signs - positive is greater
   28cd   99                GHI 9
   28ce   fa 80             ANI $80
   28d0   ca 27 55          LBNZ QS_LOOP        ; Score negative, best positive - don't update
                            ; Score positive, best negative - update
                        
   28d3                 QS_UPDATE:
                            ; Update best = score (big-endian: HI first)
   28d3   68 ca 64 18       RLDI 10, QS_BEST_HI
   28d7   99                GHI 9               ; High byte first
   28d8   5a                STR 10
   28d9   1a                INC 10
   28da   89                GLO 9               ; Low byte second
   28db   5a                STR 10
                        
                            ; -----------------------------------------------
                            ; Beta cutoff check: if best >= beta, return beta
                            ; -----------------------------------------------
                            ; Load beta (big-endian: HI first)
   28dc   68 ca 64 44       RLDI 10, BETA_HI
   28e0   4a                LDA 10              ; beta high
   28e1   b7                PHI 7
   28e2   0a                LDN 10              ; beta low
   28e3   a7                PLO 7               ; R7 = beta
                        
                            ; Compare: best (R9) >= beta (R7)?
   28e4   68 ca 64 49       RLDI 10, COMPARE_TEMP
   28e8   ea                SEX 10
   28e9   99                GHI 9               ; best high
   28ea   5a                STR 10
   28eb   97                GHI 7               ; beta high
   28ec   f3                XOR
   28ed   fa 80             ANI $80
   28ef   e2                SEX 2
   28f0   ca 29 03          LBNZ QS_BETA_CUT_DIFF
                        
                            ; Same sign: best >= beta means best - beta >= 0 (no borrow)
   28f3   ea                SEX 10
   28f4   87                GLO 7               ; beta low
   28f5   5a                STR 10
   28f6   89                GLO 9               ; best low
   28f7   f7                SM
   28f8   97                GHI 7               ; beta high
   28f9   5a                STR 10
   28fa   99                GHI 9               ; best high
   28fb   77                SMB
   28fc   e2                SEX 2
   28fd   c3 29 0c          LBDF QS_BETA_CUTOFF ; No borrow = best >= beta, cutoff!
   2900   c0 27 55          LBR QS_LOOP
                        
   2903                 QS_BETA_CUT_DIFF:
                            ; Different signs: positive >= negative
   2903   99                GHI 9               ; best high
   2904   fa 80             ANI $80
   2906   c2 29 0c          LBZ QS_BETA_CUTOFF  ; best positive, beta negative -> cutoff
   2909   c0 27 55          LBR QS_LOOP
                        
   290c                 QS_BETA_CUTOFF:
                            ; Return beta (fail-high)
   290c   97                GHI 7
   290d   b9                PHI 9
   290e   87                GLO 7
   290f   a9                PLO 9               ; R9 = beta
   2910   d5                RETN
                        
   2911                 QS_CAPTURE_LIMIT_HIT:
                            ; Hit capture limit - unmake the move and return best so far
   2911   d4 0c 20          CALL UNMAKE_MOVE
                            ; Restore move count from stack (was pushed at capture processing start)
   2914   60                IRX
   2915   72                LDXA
   2916   af                PLO 15              ; R15.0 = move count low
   2917   f0                LDX
   2918   bf                PHI 15              ; R15.1 = move count high (0)
                            ; Fall through to QS_RETURN
                        
   2919                 QS_RETURN:
                            ; Return best score in R9 (big-endian: HI first)
   2919   68 ca 64 18       RLDI 10, QS_BEST_HI
   291d   4a                LDA 10              ; High byte
   291e   b9                PHI 9
   291f   0a                LDN 10              ; Low byte
   2920   a9                PLO 9
   2921   d5                RETN
                        
                        ; ------------------------------------------------------------------------------
                        ; Helper Functions - STUBS REMOVED (functions now in other modules)
                        ; ------------------------------------------------------------------------------
                        ; GENERATE_MOVES - implemented in movegen.asm
                        ; MAKE_MOVE - implemented in makemove.asm
                        ; UNMAKE_MOVE - implemented in makemove.asm
                        ; EVALUATE - implemented in evaluate.asm
                        ; IS_IN_CHECK - implemented in check.asm
                        
                        ; Only these helper functions remain here:
                        
                        ; ------------------------------------------------------------------------------
                        ; STORE_KILLER_MOVE - Store killer move for move ordering
                        ; ------------------------------------------------------------------------------
                        ; Input:  R11 = move that caused beta cutoff
                        ;         CURRENT_PLY = current ply (in memory)
                        ; Output: Killer move stored in table
                        ; Uses:   R10, R13, D
                        ; ------------------------------------------------------------------------------
   2922                 STORE_KILLER_MOVE:
                            ; Calculate killer table offset from CURRENT_PLY
                            ; (Use ply, not depth, so killers work across different search depths)
   2922   68 cd 64 48       RLDI 13, CURRENT_PLY
   2926   0d                LDN 13              ; D = current ply
   2927   fa 0f             ANI $0F             ; Limit to 16 plies
   2929   fe                SHL
   292a   fe                SHL                 ; × 4 (2 moves × 2 bytes each)
   292b   ad                PLO 13
                        
                            ; Point to killer table (offset in R13.0 is 0-60, won't overflow with ADI)
   292c   f8 64             LDI HIGH(KILLER_MOVES)
   292e   ba                PHI 10
   292f   8d                GLO 13              ; Get offset (0, 4, 8, ... 60)
   2930   fc 20             ADI LOW(KILLER_MOVES)  ; Add base address low byte
   2932   aa                PLO 10              ; R10 = KILLER_MOVES + offset
                        
                            ; Shift killers: killer2 = killer1
   2933   4a                LDA 10              ; Load killer1 low
   2934   ad                PLO 13
   2935   4a                LDA 10              ; Load killer1 high
   2936   bd                PHI 13              ; D = old killer1
                        
                            ; Store old killer1 as new killer2
   2937   8d                GLO 13
   2938   5a                STR 10
   2939   1a                INC 10
   293a   9d                GHI 13
   293b   5a                STR 10
                        
                            ; Reset pointer to killer1 position (R10 is at killer2_high, need killer1_low)
   293c   2a                DEC 10              ; killer2_low
   293d   2a                DEC 10              ; killer1_high
   293e   2a                DEC 10              ; killer1_low
                        
                            ; Store new killer1 (R11 = move that caused cutoff)
   293f   8b                GLO 11
   2940   5a                STR 10
   2941   1a                INC 10
   2942   9b                GHI 11
   2943   5a                STR 10
                        
   2944   d5                RETN
                        
                        ; ------------------------------------------------------------------------------
                        ; ORDER_TT_MOVE - Promote TT best move to front of move list
                        ; ------------------------------------------------------------------------------
                        ; Input:  R9 = start of move list
                        ;         D = move count
                        ; Output: Move list reordered with TT move at front (if found)
                        ; Uses:   R7, R8, R10, R11, R13
                        ; Note:   TT_MOVE_HI/LO must be populated by TT_PROBE before calling
                        ; ------------------------------------------------------------------------------
   2945                 ORDER_TT_MOVE:
   2945   a7                PLO 7               ; R7.0 = move count
   2946   c2 29 b0          LBZ OTM_DONE        ; No moves, return
                        
                            ; Load TT move (raw from/to squares)
   2949   68 ca 64 c0       RLDI 10, TT_MOVE_HI
   294d   4a                LDA 10              ; D = from
   294e   bd                PHI 13              ; R13.1 = from
   294f   0a                LDN 10              ; D = to
   2950   ad                PLO 13              ; R13.0 = to
                        
                            ; Check validity: both zero = no TT move
   2951   9d                GHI 13
   2952   ca 29 59          LBNZ OTM_VALID
   2955   8d                GLO 13
   2956   c2 29 b0          LBZ OTM_DONE
   2959                 OTM_VALID:
                        
                            ; Save move count (ENCODE clobbers R7)
   2959   87                GLO 7
   295a   73                STXD
                        
                            ; Set flags = 0 for encoding
   295b   68 ca 64 06       RLDI 10, MOVE_FLAGS_TEMP
   295f   f8 00             LDI 0
   2961   5a                STR 10
                        
                            ; Encode TT move to 16-bit format
   2962   d4 03 8d          CALL ENCODE_MOVE_16BIT
                            ; R8 = encoded TT move (flags=0 in top 2 bits)
                        
                            ; Save to R11 for comparison
   2965   98                GHI 8
   2966   bb                PHI 11
   2967   88                GLO 8
   2968   ab                PLO 11              ; R11 = encoded TT move
                        
                            ; Restore move count
   2969   60                IRX
   296a   f0                LDX                 ; D = move count
   296b   b7                PHI 7               ; R7.1 = loop counter
                        
                            ; Set up scan pointer
   296c   99                GHI 9
   296d   b8                PHI 8
   296e   89                GLO 9
   296f   a8                PLO 8               ; R8 = list start
                        
   2970                 OTM_SCAN:
   2970   97                GHI 7
   2971   c2 29 b0          LBZ OTM_DONE        ; Scanned all, no match
                        
                            ; MOVE_LIST entries are stored HIGH byte first (ADD_MOVE_ENCODED
                            ; movegen-helpers.asm:221). Fixed 2026-05-13 — old code mistakenly
                            ; called LDA 8's read "low byte". Compare HIGH (mask flag bits 6-7)
                            ; first, then LOW.
   2974   48                LDA 8               ; list move HIGH byte; R8 advances
   2975   fa 3f             ANI $3F             ; mask off flag bits 6-7
   2977   52                STR 2
   2978   9b                GHI 11              ; TT encoded HIGH byte (flags=0)
   2979   f3                XOR
   297a   ca 29 84          LBNZ OTM_NEXT       ; HIGH bytes differ
                        
                            ; HIGH match — compare LOW byte (no mask)
   297d   08                LDN 8               ; list move LOW byte; R8 stays
   297e   52                STR 2
   297f   8b                GLO 11              ; TT encoded LOW byte
   2980   f3                XOR
   2981   c2 29 8c          LBZ OTM_FOUND       ; Match!
                        
   2984                 OTM_NEXT:
   2984   18                INC 8               ; skip past LOW byte to next entry
   2985   97                GHI 7
   2986   ff 01             SMI 1
   2988   b7                PHI 7
   2989   c0 29 70          LBR OTM_SCAN
                        
   298c                 OTM_FOUND:
                            ; Match at R8-1 (LDA advanced). Swap with front (R9).
   298c   28                DEC 8               ; R8 → matched move low byte
                        
                            ; Skip if already at front
   298d   98                GHI 8
   298e   52                STR 2
   298f   99                GHI 9
   2990   f3                XOR
   2991   ca 29 9b          LBNZ OTM_SWAP
   2994   88                GLO 8
   2995   52                STR 2
   2996   89                GLO 9
   2997   f3                XOR
   2998   c2 29 b0          LBZ OTM_DONE        ; Already first
                        
   299b                 OTM_SWAP:
                            ; Save front (R9) to stack
   299b   49                LDA 9               ; front low, R9++
   299c   73                STXD
   299d   09                LDN 9               ; front high
   299e   73                STXD
                        
                            ; Copy matched (R8) to front
   299f   29                DEC 9               ; R9 back to front low
   29a0   48                LDA 8               ; src low, R8++
   29a1   59                STR 9
   29a2   19                INC 9
   29a3   08                LDN 8               ; src high
   29a4   59                STR 9
   29a5   19                INC 9               ; R9 = front + 2
                        
                            ; Copy saved front to matched position
   29a6   28                DEC 8               ; R8 back to src low
   29a7   60                IRX
   29a8   72                LDXA                ; saved high
   29a9   18                INC 8
   29aa   58                STR 8               ; R8+1 = saved high
   29ab   28                DEC 8
   29ac   f0                LDX                 ; saved low
   29ad   58                STR 8               ; R8 = saved low
                        
                            ; Reset R9 to front
   29ae   29                DEC 9
   29af   29                DEC 9
                        
   29b0                 OTM_DONE:
   29b0   d5                RETN
                        
                        ; ------------------------------------------------------------------------------
                        ; ORDER_KILLER_MOVES - Promote killer moves to front of move list
                        ; ------------------------------------------------------------------------------
                        ; Input:  R9 = start of move list
                        ;         D = move count
                        ;         CURRENT_PLY = current ply (for killer table index)
                        ; Output: Move list reordered with killers at front
                        ; Uses:   R7, R8, R10, R11, R13
                        ; Note:   Call this right after GENERATE_MOVES, before move loop
                        ; ------------------------------------------------------------------------------
   29b1                 ORDER_KILLER_MOVES:
                            ; Save move count
   29b1   a7                PLO 7               ; R7.0 = move count
   29b2   c2 2a 7b          LBZ OKM_DONE        ; No moves, nothing to order
                        
                            ; Calculate killer table offset from CURRENT_PLY
   29b5   68 ca 64 48       RLDI 10, CURRENT_PLY
   29b9   0a                LDN 10              ; D = ply
   29ba   fa 0f             ANI $0F             ; Limit to 16 plies
   29bc   fe                SHL
   29bd   fe                SHL                 ; × 4 (2 moves × 2 bytes each)
   29be   ad                PLO 13              ; R13.0 = offset
                        
                            ; Point to killer table entry
   29bf   f8 64             LDI HIGH(KILLER_MOVES)
   29c1   ba                PHI 10
   29c2   8d                GLO 13
   29c3   fc 20             ADI LOW(KILLER_MOVES)
   29c5   aa                PLO 10              ; R10 = &killer1 for this ply
                        
                            ; Load killer1 (16-bit) into R11
   29c6   4a                LDA 10              ; killer1 low
   29c7   ab                PLO 11
   29c8   4a                LDA 10              ; killer1 high
   29c9   bb                PHI 11              ; R11 = killer1
                        
                            ; Load killer2 (16-bit) into R13
   29ca   4a                LDA 10              ; killer2 low
   29cb   ad                PLO 13
   29cc   0a                LDN 10              ; killer2 high
   29cd   bd                PHI 13              ; R13 = killer2
                        
                            ; Check if killers are zero (uninitialized)
   29ce   8b                GLO 11
   29cf   f1                OR
   29d0   9b                GHI 11
   29d1   c2 2a 1a          LBZ OKM_TRY_KILLER2 ; killer1 is zero, skip
                        
                            ; === Search for killer1 in move list ===
                            ; R8 = scan pointer, start from R9
   29d4   99                GHI 9
   29d5   b8                PHI 8
   29d6   89                GLO 9
   29d7   a8                PLO 8               ; R8 = move list start
                        
   29d8   87                GLO 7               ; D = move count
   29d9   b7                PHI 7               ; R7.1 = loop counter
                        
   29da                 OKM_SCAN_K1:
   29da   97                GHI 7
   29db   c2 2a 1a          LBZ OKM_TRY_KILLER2 ; No more moves to scan
                        
                            ; MOVE_LIST entries stored HIGH first (ADD_MOVE_ENCODED:221). Killer is
                            ; stored with flags=0 (see beta-cutoff store at line ~2042). Compare
                            ; HIGH (mask flag bits 6-7 from list entry), then LOW. Fixed 2026-05-13
                            ; — old code had reversed byte order, so the optimization never matched.
   29de   48                LDA 8               ; list move HIGH byte; R8 advances
   29df   fa 3f             ANI $3F             ; mask off flag bits
   29e1   52                STR 2
   29e2   9b                GHI 11              ; killer1 HIGH (flags=0)
   29e3   f3                XOR
   29e4   ca 29 ee          LBNZ OKM_K1_NEXT    ; HIGH bytes don't match
                        
   29e7   08                LDN 8               ; list move LOW byte; R8 stays
   29e8   52                STR 2
   29e9   8b                GLO 11              ; killer1 LOW
   29ea   f3                XOR
   29eb   c2 29 f6          LBZ OKM_K1_FOUND    ; Match! Swap to front
                        
   29ee                 OKM_K1_NEXT:
   29ee   18                INC 8               ; skip past LOW byte to next entry
   29ef   97                GHI 7
   29f0   ff 01             SMI 1
   29f2   b7                PHI 7               ; Decrement counter
   29f3   c0 29 da          LBR OKM_SCAN_K1
                        
   29f6                 OKM_K1_FOUND:
                            ; Killer1 found at R8-1 (we did LDA). Swap with first move.
   29f6   28                DEC 8               ; R8 points to killer1_low in list
                        
                            ; Only swap if not already at front
   29f7   98                GHI 8
   29f8   52                STR 2
   29f9   99                GHI 9
   29fa   f3                XOR
   29fb   ca 2a 05          LBNZ OKM_K1_SWAP
   29fe   88                GLO 8
   29ff   52                STR 2
   2a00   89                GLO 9
   2a01   f3                XOR
   2a02   c2 2a 1a          LBZ OKM_TRY_KILLER2 ; Already at front, no swap needed
                        
   2a05                 OKM_K1_SWAP:
                            ; Swap 2-byte entry at R8 with entry at R9
                            ; Save move at R9 to stack
   2a05   49                LDA 9
   2a06   73                STXD
   2a07   09                LDN 9
   2a08   73                STXD
                        
                            ; Copy killer from R8 to R9 (LDA advanced R9 by 1, undo it)
   2a09   29                DEC 9
   2a0a   48                LDA 8               ; killer low
   2a0b   59                STR 9
   2a0c   19                INC 9
   2a0d   08                LDN 8               ; killer high
   2a0e   59                STR 9
   2a0f   19                INC 9               ; R9 back to +2
                        
                            ; Copy saved move from stack to R8
   2a10   28                DEC 8               ; Back to low byte position
   2a11   60                IRX
   2a12   72                LDXA                ; Saved high byte
   2a13   18                INC 8
   2a14   58                STR 8               ; Store at R8+1
   2a15   28                DEC 8
   2a16   f0                LDX                 ; Saved low byte
   2a17   58                STR 8               ; Store at R8
                        
                            ; Reset R9 to list start
   2a18   29                DEC 9
   2a19   29                DEC 9
                        
   2a1a                 OKM_TRY_KILLER2:
                            ; Check if killer2 is zero
   2a1a   8d                GLO 13
   2a1b   f1                OR
   2a1c   9d                GHI 13
   2a1d   c2 2a 7b          LBZ OKM_DONE        ; killer2 is zero, skip
                        
                            ; Check if we have at least 2 moves
   2a20   87                GLO 7               ; Original move count
   2a21   ff 02             SMI 2
   2a23   cb 2a 7b          LBNF OKM_DONE       ; Less than 2 moves
                        
                            ; === Search for killer2 in move list (skip first entry) ===
   2a26   99                GHI 9
   2a27   b8                PHI 8
   2a28   89                GLO 9
   2a29   fc 02             ADI 2               ; Skip first entry
   2a2b   a8                PLO 8
   2a2c   99                GHI 9
   2a2d   7c 00             ADCI 0
   2a2f   b8                PHI 8               ; R8 = second entry
                        
   2a30   87                GLO 7               ; move count
   2a31   ff 01             SMI 1               ; Skip first
   2a33   b7                PHI 7               ; R7.1 = counter
                        
   2a34                 OKM_SCAN_K2:
   2a34   97                GHI 7
   2a35   c2 2a 7b          LBZ OKM_DONE        ; No more moves
                        
                            ; Byte-order fix (2026-05-13) — HIGH first with mask, then LOW.
   2a38   48                LDA 8               ; list move HIGH byte; R8 advances
   2a39   fa 3f             ANI $3F             ; mask off flag bits 6-7
   2a3b   52                STR 2
   2a3c   9d                GHI 13              ; killer2 HIGH (flags=0)
   2a3d   f3                XOR
   2a3e   ca 2a 48          LBNZ OKM_K2_NEXT    ; HIGH bytes don't match
                        
   2a41   08                LDN 8               ; list move LOW byte; R8 stays
   2a42   52                STR 2
   2a43   8d                GLO 13              ; killer2 LOW
   2a44   f3                XOR
   2a45   c2 2a 50          LBZ OKM_K2_FOUND    ; Match!
                        
   2a48                 OKM_K2_NEXT:
   2a48   18                INC 8               ; skip past LOW byte to next entry
   2a49   97                GHI 7
   2a4a   ff 01             SMI 1
   2a4c   b7                PHI 7
   2a4d   c0 2a 34          LBR OKM_SCAN_K2
                        
   2a50                 OKM_K2_FOUND:
                            ; Killer2 found at R8-1. Swap with second move (R9+2).
   2a50   28                DEC 8               ; R8 points to killer2_low
                        
                            ; Calculate second entry position
   2a51   99                GHI 9
   2a52   ba                PHI 10
   2a53   89                GLO 9
   2a54   fc 02             ADI 2
   2a56   aa                PLO 10
   2a57   99                GHI 9
   2a58   7c 00             ADCI 0
   2a5a   ba                PHI 10              ; R10 = second entry
                        
                            ; Only swap if not already there
   2a5b   98                GHI 8
   2a5c   52                STR 2
   2a5d   9a                GHI 10
   2a5e   f3                XOR
   2a5f   ca 2a 69          LBNZ OKM_K2_SWAP
   2a62   88                GLO 8
   2a63   52                STR 2
   2a64   8a                GLO 10
   2a65   f3                XOR
   2a66   c2 2a 7b          LBZ OKM_DONE        ; Already in position
                        
   2a69                 OKM_K2_SWAP:
                            ; Swap 2-byte entry at R8 with entry at R10
   2a69   4a                LDA 10              ; second entry low
   2a6a   73                STXD
   2a6b   0a                LDN 10              ; second entry high
   2a6c   73                STXD
                        
                            ; Copy killer to second position
   2a6d   2a                DEC 10
   2a6e   48                LDA 8               ; killer low
   2a6f   5a                STR 10
   2a70   1a                INC 10
   2a71   08                LDN 8               ; killer high
   2a72   5a                STR 10
                        
                            ; Copy saved to R8
   2a73   28                DEC 8
   2a74   60                IRX
   2a75   72                LDXA                ; high byte
   2a76   18                INC 8
   2a77   58                STR 8
   2a78   28                DEC 8
   2a79   f0                LDX                 ; low byte
   2a7a   58                STR 8
                        
   2a7b                 OKM_DONE:
   2a7b   d5                RETN
                        
                        ; ------------------------------------------------------------------------------
                        ; ORDER_CAPTURES_FIRST - Move captures to front of move list, sorted by
                        ;                        victim piece-type value (queen first, pawn last).
                        ; ------------------------------------------------------------------------------
                        ; Input:  R9 = start of move list
                        ;         D = move count
                        ; Output: Move list reordered with captures at front, victim-value descending
                        ;         (Q-takes, R-takes, B-takes, N-takes, P-takes, then non-captures).
                        ; Uses:   R7, R8, R10, R11, R13
                        ; Note:   Call after GENERATE_MOVES, before move loop. Implements simplified
                        ;         victim-only sort (no attacker analysis): 5 passes filtering by
                        ;         piece-type value 5..1. Front pointer R8 persists across passes.
                        ; ------------------------------------------------------------------------------
   2a7c                 ORDER_CAPTURES_FIRST:
                            ; Save move count
   2a7c   a7                PLO 7               ; R7.0 = move count
   2a7d   c2 2a f3          LBZ OCF_DONE        ; No moves
                        
                            ; R8 = front pointer (where to put next capture; persists across passes)
   2a80   99                GHI 9
   2a81   b8                PHI 8
   2a82   89                GLO 9
   2a83   a8                PLO 8               ; R8 = front = list start
                        
                            ; Initialize filter: start with QUEEN piece type (5), decrement each pass
   2a84   68 cd 64 49       RLDI 13, COMPARE_TEMP
   2a88   f8 05             LDI 5
   2a8a   5d                STR 13              ; M(COMPARE_TEMP) = filter type
                        
   2a8b                 OCF_PASS_LOOP:
                            ; R10 = scan pointer (re-init each pass)
   2a8b   99                GHI 9
   2a8c   ba                PHI 10
   2a8d   89                GLO 9
   2a8e   aa                PLO 10              ; R10 = scan = list start
                        
                            ; R7.1 = remaining count to scan (re-init each pass)
   2a8f   87                GLO 7
   2a90   b7                PHI 7
                        
   2a91                 OCF_SCAN_LOOP:
   2a91   97                GHI 7
   2a92   c2 2a e8          LBZ OCF_PASS_DONE   ; No more moves to scan in this pass
                        
                            ; Decode move at R10 to get target square
                            ; Move format: [flags:2][to:7][from:7]
                            ; Move list is big-endian: high byte first, low byte second
   2a95   4a                LDA 10              ; High byte (first in big-endian)
   2a96   bb                PHI 11              ; R11.1 = high byte
   2a97   0a                LDN 10              ; Low byte (second in big-endian)
   2a98   ab                PLO 11              ; R11.0 = low byte
                        
                            ; Extract 'to' square: (high & $3F) << 1 | (low >> 7)
   2a99   9b                GHI 11              ; D = high byte (LDN left D with low byte)
   2a9a   fa 3f             ANI $3F
   2a9c   fe                SHL
   2a9d   ad                PLO 13              ; R13.0 = to bits 1-6
   2a9e   8b                GLO 11              ; Low byte
   2a9f   fa 80             ANI $80             ; Bit 7
   2aa1   c2 2a a8          LBZ OCF_TO_BIT0_CLR
   2aa4   8d                GLO 13
   2aa5   f9 01             ORI $01
   2aa7   ad                PLO 13
   2aa8                 OCF_TO_BIT0_CLR:
                            ; R13.0 = to square, R11 = encoded move
                        
                            ; Check if target square has a piece (any piece = potential capture)
                            ; Calculate BOARD + to_square
                            ; BOARD is at $6000, so high byte is $60, low byte is to_square
   2aa8   f8 60             LDI HIGH(BOARD)
   2aaa   bd                PHI 13
                            ; R13 now = $60xx where xx = to_square (already in R13.0)
                        
                            ; Load piece at target square
   2aab   0d                LDN 13              ; D = piece at target
   2aac   2a                DEC 10              ; Reset R10 to low byte position
                        
                            ; If piece is 0 (empty), not a capture
   2aad   c2 2a df          LBZ OCF_NEXT_MOVE   ; Empty square, skip
                        
                            ; Check victim type against current pass filter.
                            ; D still holds piece byte; mask off color to get type (1-6).
   2ab0   fa 07             ANI PIECE_MASK      ; D = victim type (1-5; king=6 can't actually be captured)
   2ab2   52                STR 2               ; M(R2) = victim type (temp)
   2ab3   68 cd 64 49       RLDI 13, COMPARE_TEMP
   2ab7   0d                LDN 13              ; D = current pass filter type
   2ab8   f3                XOR                 ; D = filter ^ victim (0 if match, since SEX 2 set globally)
   2ab9   ca 2a df          LBNZ OCF_NEXT_MOVE  ; victim type doesn't match this pass — skip
                        
                            ; Match: capture with current filter type. Fall through to swap.
                        
   2abc                 OCF_IS_CAPTURE:
                            ; Move is a capture - swap to front if not already there
                            ; R10 points to current move, R8 points to front
   2abc   9a                GHI 10
   2abd   52                STR 2
   2abe   98                GHI 8
   2abf   f3                XOR
   2ac0   ca 2a ca          LBNZ OCF_DO_SWAP
   2ac3   8a                GLO 10
   2ac4   52                STR 2
   2ac5   88                GLO 8
   2ac6   f3                XOR
   2ac7   c2 2a dd          LBZ OCF_ADVANCE_FRONT  ; Already at front
                        
   2aca                 OCF_DO_SWAP:
                            ; Swap 2-byte entries at R8 and R10
                            ; Save R8 entry to stack
   2aca   48                LDA 8
   2acb   73                STXD
   2acc   08                LDN 8
   2acd   73                STXD
   2ace   28                DEC 8               ; Reset R8
                        
                            ; Copy R10 to R8
   2acf   4a                LDA 10
   2ad0   58                STR 8
   2ad1   18                INC 8
   2ad2   0a                LDN 10
   2ad3   58                STR 8
   2ad4   28                DEC 8
   2ad5   2a                DEC 10              ; Reset both
                        
                            ; Copy stack to R10
   2ad6   60                IRX
   2ad7   72                LDXA                ; High byte
   2ad8   1a                INC 10
   2ad9   5a                STR 10
   2ada   2a                DEC 10
   2adb   f0                LDX                 ; Low byte
   2adc   5a                STR 10
                        
   2add                 OCF_ADVANCE_FRONT:
                            ; Advance front pointer
   2add   18                INC 8
   2ade   18                INC 8
                        
   2adf                 OCF_NEXT_MOVE:
                            ; Advance scan pointer
   2adf   1a                INC 10
   2ae0   1a                INC 10
                            ; Decrement counter
   2ae1   97                GHI 7
   2ae2   ff 01             SMI 1
   2ae4   b7                PHI 7
   2ae5   c0 2a 91          LBR OCF_SCAN_LOOP
                        
   2ae8                 OCF_PASS_DONE:
                            ; Decrement filter type for next pass; loop until filter reaches 0.
   2ae8   68 cd 64 49       RLDI 13, COMPARE_TEMP
   2aec   0d                LDN 13
   2aed   ff 01             SMI 1
   2aef   5d                STR 13              ; filter--
   2af0   ca 2a 8b          LBNZ OCF_PASS_LOOP  ; continue if filter > 0
                        
   2af3                 OCF_DONE:
   2af3   d5                RETN
                        
                        ; ------------------------------------------------------------------------------
                        ; INC_NODE_COUNT - Increment 32-bit node counter (FULL VERSION)
                        ; ------------------------------------------------------------------------------
                        ; Input:  None
                        ; Output: NODES_SEARCHED incremented
                        ; Uses:   A, D
                        ; ------------------------------------------------------------------------------
   2af4                 INC_NODE_COUNT:
   2af4   68 ca 64 12       RLDI 10, NODES_SEARCHED
                        
                            ; Increment byte 0 (LSB)
   2af8   0a                LDN 10
   2af9   fc 01             ADI 1
   2afb   5a                STR 10
   2afc   ca 2b 14          LBNZ INC_NODE_DONE   ; No carry
                        
                            ; Carry to byte 1
   2aff   1a                INC 10
   2b00   0a                LDN 10
   2b01   7c 00             ADCI 0
   2b03   5a                STR 10
   2b04   ca 2b 14          LBNZ INC_NODE_DONE
                        
                            ; Carry to byte 2
   2b07   1a                INC 10
   2b08   0a                LDN 10
   2b09   7c 00             ADCI 0
   2b0b   5a                STR 10
   2b0c   ca 2b 14          LBNZ INC_NODE_DONE
                        
                            ; Carry to byte 3 (MSB)
   2b0f   1a                INC 10
   2b10   0a                LDN 10
   2b11   7c 00             ADCI 0
   2b13   5a                STR 10
                        
   2b14                 INC_NODE_DONE:
   2b14   d5                RETN
                        
                        ; ==============================================================================
                        ; SEARCH_POSITION - Iterative Deepening Entry Point
                        ; ==============================================================================
                        ; Input:  SEARCH_DEPTH = target depth (stored in memory by UCI handler)
                        ; Output: R9 = best score (R6 is SCRT linkage - off limits!)
                        ;         BEST_MOVE = best move found
                        ; Searches depth 1, 2, ..., TARGET_DEPTH. If depth N exceeds node budget,
                        ; aborts and returns depth N-1's bestmove.
                        ; ==============================================================================
   2b15                 SEARCH_POSITION:
   2b15   e2                SEX 2
                        
                            ; --- Save TARGET_DEPTH from SEARCH_DEPTH (set by UCI handler) ---
   2b16   68 ca 64 17       RLDI 10, SEARCH_DEPTH + 1
   2b1a   0a                LDN 10                      ; D = target depth (low byte)
   2b1b   73                STXD                        ; Save depth on stack (LDI clobbers D!)
   2b1c   68 ca 64 c6       RLDI 10, TARGET_DEPTH
   2b20   60                IRX
   2b21   f0                LDX                         ; D = target depth (restored from stack)
   2b22   5a                STR 10                      ; TARGET_DEPTH = original depth
                        
                            ; --- Clear SEARCH_ABORTED flag ---
   2b23   68 ca 64 c4       RLDI 10, SEARCH_ABORTED
   2b27   f8 00             LDI 0
   2b29   5a                STR 10
                        
                            ; --- Clear ITER_BEST (no bestmove yet) ---
   2b2a   68 ca 64 c2       RLDI 10, ITER_BEST_FROM
   2b2e   f8 ff             LDI $FF
   2b30   5a                STR 10
   2b31   1a                INC 10
   2b32   5a                STR 10                      ; ITER_BEST_TO = $FF
                        
                            ; --- Set starting depth = 1 ---
   2b33   68 ca 64 c5       RLDI 10, CURRENT_MAX_DEPTH
   2b37   f8 01             LDI 1
   2b39   5a                STR 10
                        
                            ; --- Initialize RTC elapsed timer ---
                            ; Read current seconds from DS12887 RTC (binary mode)
                            ; Protocol: OUT port 2 = register select, INP port 3 = read data
   2b3a   f8 80             LDI $80                     ; $80 = seconds register
   2b3c   52                STR 2                       ; Store at M(R2) for OUT
   2b3d   62                OUT 2                       ; Send to port 2 (selects seconds), R2++
   2b3e   22                DEC 2                       ; Restore stack pointer
   2b3f   6b                INP 3                       ; D = seconds (binary 0-59), also M(R2)
   2b40   73                STXD                        ; Save seconds on stack (LDI clobbers D!)
   2b41   68 ca 64 ca       RLDI 10, SEARCH_PREV_SECS
   2b45   60                IRX
   2b46   f0                LDX                         ; D = seconds (restored)
   2b47   5a                STR 10                      ; SEARCH_PREV_SECS = current seconds
                        
                            ; Clear elapsed counter
   2b48   68 ca 64 cb       RLDI 10, SEARCH_ELAPSED
   2b4c   f8 00             LDI 0
   2b4e   5a                STR 10                      ; SEARCH_ELAPSED = 0
                        
                            ; --- Canary check (2026-07-03 crash hunt): CANARY_ZONE $64F7-$64FC must be
                            ; all zero (WORKSPACE_CLEAR zeroes it; NO code owns it). The 7/3 crash dump
                            ; found stray writes there. Sticky-OR the zone into CANARY_HIT once per
                            ; search; a nonzero CANARY_HIT in any post-crash dump = the stray writer
                            ; struck this game, and the zone bytes say what it wrote.
   2b4f   68 ca 64 f7       RLDI 10, CANARY_ZONE
   2b53   f8 00             LDI 0
   2b55   52                STR 2                       ; M(2) = accumulator = 0
   2b56   f8 06             LDI 6
   2b58   ab                PLO 11                      ; R11.0 = byte counter (R11 reloaded below)
   2b59                 SP_CANARY_LP:
   2b59   4a                LDA 10
   2b5a   f1                OR                          ; D = zone byte | acc
   2b5b   52                STR 2                       ; acc back to M(2)
   2b5c   2b                DEC 11
   2b5d   8b                GLO 11
   2b5e   ca 2b 59          LBNZ SP_CANARY_LP
   2b61   68 ca 64 1e       RLDI 10, CANARY_HIT
   2b65   0a                LDN 10
   2b66   f1                OR                          ; D = CANARY_HIT | acc
   2b67   5a                STR 10                      ; sticky
                        
                            ; --- Clear node counter (once for entire search) ---
   2b68   68 cb 64 12       RLDI 11, NODES_SEARCHED
   2b6c   f8 00             LDI 0
   2b6e   5b                STR 11
   2b6f   1b                INC 11
   2b70   5b                STR 11
   2b71   1b                INC 11
   2b72   5b                STR 11
   2b73   1b                INC 11
   2b74   5b                STR 11
                        
                            ; --- Zobrist hash: use the incremental hash from UCI parsing ---
                            ; Do NOT call HASH_INIT here! HASH_INIT includes castling/EP Zobrist
                            ; keys, but MAKE_MOVE doesn't XOR castling/EP changes. This creates a
                            ; mismatch between search hashes (from-scratch) and HASH_HIST entries
                            ; (incremental), which breaks repetition detection completely.
                            ; The hash left by UCI parsing is already correct and consistent.
                        
                        ; ======================================================================
                        ; ITERATIVE DEEPENING LOOP
                        ; ======================================================================
   2b75                 ITER_LOOP:
                            ; --- Set SEARCH_DEPTH = CURRENT_MAX_DEPTH for this iteration ---
   2b75   68 ca 64 16       RLDI 10, SEARCH_DEPTH
   2b79   f8 00             LDI 0
   2b7b   5a                STR 10                      ; SEARCH_DEPTH high = 0
   2b7c   1a                INC 10
                            ; Load CURRENT_MAX_DEPTH
   2b7d   68 cd 64 c5       RLDI 13, CURRENT_MAX_DEPTH
   2b81   0d                LDN 13                      ; D = current depth
   2b82   5a                STR 10                      ; SEARCH_DEPTH low = current depth
                        
                            ; --- Reset SEARCH_ABORTED for this iteration ---
   2b83   68 ca 64 c4       RLDI 10, SEARCH_ABORTED
   2b87   f8 00             LDI 0
   2b89   5a                STR 10
                        
                            ; --- Capture iteration start time for iteration-time gate ---
   2b8a   68 ca 64 cb       RLDI 10, SEARCH_ELAPSED
   2b8e   0a                LDN 10
   2b8f   68 ca 64 ed       RLDI 10, ITER_START_ELAPSED
   2b93   5a                STR 10
                        
                            ; --- Standard search init ---
                            ; Alpha = -32767
   2b94   68 ca 64 42       RLDI 10, ALPHA_HI
   2b98   f8 80             LDI $80
   2b9a   5a                STR 10                      ; ALPHA_HI = $80
   2b9b   1a                INC 10
   2b9c   f8 01             LDI $01
   2b9e   5a                STR 10                      ; ALPHA_LO = $01
                        
                            ; Beta = +32767
   2b9f   68 ca 64 44       RLDI 10, BETA_HI
   2ba3   f8 7f             LDI $7F
   2ba5   5a                STR 10                      ; BETA_HI = $7F
   2ba6   1a                INC 10
   2ba7   f8 ff             LDI $FF
   2ba9   5a                STR 10                      ; BETA_LO = $FF
                        
                            ; CURRENT_PLY = 0
   2baa   68 ca 64 48       RLDI 10, CURRENT_PLY
   2bae   f8 00             LDI 0
   2bb0   5a                STR 10
                        
                            ; NULL_MOVE_OK = 1
   2bb1   68 ca 64 a7       RLDI 10, NULL_MOVE_OK
   2bb5   f8 01             LDI 1
   2bb7   5a                STR 10
                        
                            ; Get side to move
   2bb8   d4 01 3e          CALL GET_SIDE_TO_MOVE
   2bbb   ac                PLO 12                      ; C.0 = color
                        
                            ; Board pointer
   2bbc   68 ca 60 00       RLDI 10, BOARD
                        
                            ; Clear best move for this iteration
   2bc0   68 cb 64 10       RLDI 11, BEST_MOVE
   2bc4   f8 ff             LDI $FF
   2bc6   5b                STR 11
   2bc7   1b                INC 11
   2bc8   5b                STR 11
                        
                            ; --- Run search for this depth ---
   2bc9   d4 1c 4e          CALL NEGAMAX
                        
                            ; --- Check if search was aborted ---
   2bcc   68 ca 64 c4       RLDI 10, SEARCH_ABORTED
   2bd0   0a                LDN 10
   2bd1   ca 2c 46          LBNZ ITER_ABORTED           ; Aborted: use previous depth's bestmove
                        
                            ; --- Depth completed: save bestmove ---
                            ; Set up BOTH pointers first, then copy (LDI clobbers D!)
   2bd4   68 ca 64 10       RLDI 10, BEST_MOVE
   2bd8   68 cb 64 c2       RLDI 11, ITER_BEST_FROM
                            ; Now copy: R10→BEST_MOVE, R11→ITER_BEST
   2bdc   4a                LDA 10                      ; D = from square
   2bdd   5b                STR 11                      ; ITER_BEST_FROM = from
   2bde   1b                INC 11
   2bdf   0a                LDN 10                      ; D = to square (BEST_MOVE+1)
   2be0   5b                STR 11                      ; ITER_BEST_TO = to
                        
                            ; --- Save score from this depth ---
   2be1   68 ca 64 c8       RLDI 10, ITER_SCORE_HI
   2be5   99                GHI 9
   2be6   5a                STR 10                      ; ITER_SCORE_HI = R9.hi
   2be7   1a                INC 10
   2be8   89                GLO 9
   2be9   5a                STR 10                      ; ITER_SCORE_LO = R9.lo
                        
                            ; --- Send UCI "info" for this depth ---
   2bea   d4 2c 54          CALL SEND_UCI_INFO
                        
                            ; Stack-overflow handling moved to CHECK_STACK_OVERFLOW (2026-05-16):
                            ; it now traps via MARK/SEP 1 immediately on detection, so this
                            ; IDS-boundary report path is unreachable. STACK_OVERFLOW_FLAG remains
                            ; written by the guard for post-trap memory dump inspection.
   2bed                 ITER_NO_SOVF:
                        
                            ; --- Iterative deepening termination decision ---
                            ; UCI semantics: TARGET_DEPTH is treated as a CAP (max depth we may reach),
                            ; not a fixed target. The engine self-decides whether to attempt the next
                            ; deeper iteration based on iteration-time prediction and a hard safety cap.
                            ;
                            ; Termination rules (stop if any are true; else continue to current+1):
                            ;   1. current >= TARGET_DEPTH   — respect UCI cap
                            ;   2. current >= 5              — hard safety cap (MOVE_LIST sized for 5 plies)
                            ;   3. current >= 3 AND predicted_next > remaining_budget — iter-time gate
                            ;
                            ; Iter-time gate (rule 3, replaces 60s/90s cumulative thresholds 2026-05-06):
                            ;   predicted_next = 3 * last_iter_seconds  (BF=3, conservative)
                            ;   remaining      = 180 - SEARCH_ELAPSED
                            ;   stop if predicted_next >= remaining
                            ; Rationale: closed positions branch ~3x at d>=4 (vs ~1.8x in open). Old
                            ; cumulative gate let d=5 start with insufficient budget in Hippo-class
                            ; positions, wasting 80-110s/move on incomplete d=5 (lost match 2026-05-06
                            ; move 5-9, all d=4 timeouts). Iteration-time gate uses the actual measured
                            ; iteration time so it adapts to position. RTC is 1s resolution; gate only
                            ; applies at d>=3 where iteration times are reliably multi-second.
                        
                            ; Rule 1: current >= TARGET_DEPTH?
   2bed   68 ca 64 c5       RLDI 10, CURRENT_MAX_DEPTH
   2bf1   0a                LDN 10
   2bf2   52                STR 2                       ; M(R2) = current
   2bf3   68 ca 64 c6       RLDI 10, TARGET_DEPTH
   2bf7   0a                LDN 10                      ; D = target
   2bf8   f7                SM                          ; D = target - current; DF=1 if target >= current
   2bf9   cb 2c 53          LBNF ITER_DONE              ; target < current — defensive (shouldn't happen)
   2bfc   c2 2c 53          LBZ ITER_DONE               ; target == current — UCI cap reached
                        
                            ; Rule 2: current >= 5?
   2bff   68 ca 64 c5       RLDI 10, CURRENT_MAX_DEPTH
   2c03   0a                LDN 10
   2c04   ff 05             SMI 5
   2c06   c3 2c 53          LBDF ITER_DONE              ; current >= 5 — hard safety cap
                        
                            ; Rule 3: iteration-time gate. Apply only at depth >= 3.
   2c09   68 ca 64 c5       RLDI 10, CURRENT_MAX_DEPTH
   2c0d   0a                LDN 10
   2c0e   ff 03             SMI 3
   2c10   cb 2c 3b          LBNF ITER_INCREMENT         ; current < 3 — always continue (RTC granularity)
                        
                            ; last_iter_seconds = SEARCH_ELAPSED - ITER_START_ELAPSED
   2c13   68 ca 64 ed       RLDI 10, ITER_START_ELAPSED
   2c17   0a                LDN 10
   2c18   52                STR 2                       ; M(R2) = iter_start
   2c19   68 ca 64 cb       RLDI 10, SEARCH_ELAPSED
   2c1d   0a                LDN 10                      ; D = elapsed
   2c1e   f7                SM                          ; D = elapsed - iter_start = last_iter
   2c1f   ad                PLO 13                      ; R13.0 = last_iter
                        
                            ; Fast path: last_iter > 60 → 3*last_iter overflows AND exceeds remaining
   2c20   ff 3d             SMI 61
   2c22   c3 2c 53          LBDF ITER_DONE              ; last_iter >= 61 — stop
                        
                            ; predicted = 3 * last_iter (no overflow: last_iter <= 60, so 3x <= 180)
   2c25   8d                GLO 13                      ; D = last_iter
   2c26   fe                SHL                         ; D = 2 * last_iter
   2c27   52                STR 2                       ; M(R2) = 2 * last_iter
   2c28   8d                GLO 13                      ; D = last_iter
   2c29   f4                ADD                         ; D = 3 * last_iter
   2c2a   ad                PLO 13                      ; R13.0 = predicted
                        
                            ; remaining = 180 - SEARCH_ELAPSED
   2c2b   68 ca 64 cb       RLDI 10, SEARCH_ELAPSED
   2c2f   0a                LDN 10
   2c30   fd b4             SDI 180                     ; D = 180 - elapsed
   2c32   cb 2c 53          LBNF ITER_DONE              ; elapsed > 180 (defensive; budget abort handles too)
                        
                            ; if predicted >= remaining: stop, else continue
   2c35   52                STR 2                       ; M(R2) = remaining
   2c36   8d                GLO 13                      ; D = predicted
   2c37   f7                SM                          ; D = predicted - remaining
   2c38   c3 2c 53          LBDF ITER_DONE              ; predicted >= remaining — stop
                        
   2c3b                 ITER_INCREMENT:
                            ; --- Increment depth and loop ---
   2c3b   68 ca 64 c5       RLDI 10, CURRENT_MAX_DEPTH
   2c3f   0a                LDN 10
   2c40   fc 01             ADI 1
   2c42   5a                STR 10                      ; CURRENT_MAX_DEPTH++
   2c43   c0 2b 75          LBR ITER_LOOP
                        
   2c46                 ITER_ABORTED:
                            ; Search at this depth was aborted — fall back to ITER_BEST
                            ; Set up BOTH pointers first, then copy (LDI clobbers D!)
   2c46   68 ca 64 c2       RLDI 10, ITER_BEST_FROM
   2c4a   68 cb 64 10       RLDI 11, BEST_MOVE
                            ; Now copy: R10→ITER_BEST, R11→BEST_MOVE
   2c4e   4a                LDA 10                      ; D = ITER_BEST_FROM
   2c4f   5b                STR 11                      ; BEST_MOVE[0] = from
   2c50   1b                INC 11
   2c51   0a                LDN 10                      ; D = ITER_BEST_TO
   2c52   5b                STR 11                      ; BEST_MOVE[1] = to
                        
   2c53                 ITER_DONE:
   2c53   d5                RETN
                        
                        ; ==============================================================================
                        ; SEND_UCI_INFO - Send "info depth N score cp S nodes NNNNN" after each iteration
                        ; ==============================================================================
                        ; Sends: "info depth N score cp S nodes NNNNN\r\n"
                        ;   N = CURRENT_MAX_DEPTH (ASCII digit)
                        ;   S = ITER_SCORE as signed decimal (centipawns)
                        ;   NNNNN = NODES_SEARCHED as decimal via F_UINTOUT (lower 16 bits)
                        ; ==============================================================================
   2c54                 SEND_UCI_INFO:
                            ; Send "info depth "
   2c54   68 cf 2d 82       RLDI 15, STR_INFO_DEPTH
   2c58   d4                SEP 4
   2c59   ff 09             DW F_MSG
                        
                            ; Send depth digit (1-9)
   2c5b   68 ca 64 c5       RLDI 10, CURRENT_MAX_DEPTH
   2c5f   0a                LDN 10                      ; D = depth (1-9)
   2c60   fc 30             ADI '0'                     ; Convert to ASCII
   2c62   d4 00 0b          CALL SERIAL_WRITE_CHAR
                        
                            ; Send " score cp "
   2c65   68 cf 2d 8e       RLDI 15, STR_SCORE_CP
   2c69   d4                SEP 4
   2c6a   ff 09             DW F_MSG
                        
                            ; Load score into R13 (big-endian: HI at $64C8, LO at $64C9)
   2c6c   68 ca 64 c8       RLDI 10, ITER_SCORE_HI
   2c70   4a                LDA 10                      ; D = score high byte, R10 -> LO
   2c71   bd                PHI 13
   2c72   0a                LDN 10                      ; D = score low byte
   2c73   ad                PLO 13                      ; R13 = signed 16-bit score
                        
                            ; Check if negative
   2c74   9d                GHI 13
   2c75   fa 80             ANI $80
   2c77   c2 2c 87          LBZ SUCI_POSITIVE
                        
                            ; Negative: print '-' and negate R13 to get absolute value
   2c7a   f8 2d             LDI '-'
   2c7c   d4 00 0b          CALL SERIAL_WRITE_CHAR
   2c7f   8d                GLO 13                      ; low byte
   2c80   fd 00             SDI 0                       ; negate low
   2c82   ad                PLO 13
   2c83   9d                GHI 13                      ; high byte
   2c84   7d 00             SDBI 0                      ; negate high with borrow
   2c86   bd                PHI 13
                        
   2c87                 SUCI_POSITIVE:
                            ; Convert R13 (now unsigned magnitude) to ASCII decimal
   2c87   68 cf 64 cc       RLDI 15, UINT_BUFFER
   2c8b   d4                SEP 4
   2c8c   ff 60             DW F_UINTOUT
                        
                            ; Null-terminate (R15 points past last digit)
   2c8e   f8 00             LDI 0
   2c90   5f                STR 15
                        
                            ; Print the score string
   2c91   68 cf 64 cc       RLDI 15, UINT_BUFFER
   2c95   d4                SEP 4
   2c96   ff 09             DW F_MSG
                        
                            ; Send " nodes "
   2c98   68 cf 2d 99       RLDI 15, STR_NODES
   2c9c   d4                SEP 4
   2c9d   ff 09             DW F_MSG
                        
                            ; Load NODES_SEARCHED (16-bit) into R13: high byte first, then low
   2c9f   68 ca 64 13       RLDI 10, NODES_SEARCHED + 1
   2ca3   0a                LDN 10                      ; D = high byte of node count
   2ca4   bd                PHI 13                      ; R13.1 = high byte
   2ca5   68 ca 64 12       RLDI 10, NODES_SEARCHED
   2ca9   0a                LDN 10                      ; D = low byte of node count
   2caa   ad                PLO 13                      ; R13.0 = low byte
                        
                            ; Point R15 at ASCII scratch buffer
   2cab   68 cf 64 cc       RLDI 15, UINT_BUFFER
                        
                            ; Convert R13 to ASCII decimal at R15
   2caf   d4                SEP 4
   2cb0   ff 60             DW F_UINTOUT
                        
                            ; Null-terminate (R15 points past last digit)
   2cb2   f8 00             LDI 0
   2cb4   5f                STR 15
                        
                            ; Print the decimal string
   2cb5   68 cf 64 cc       RLDI 15, UINT_BUFFER
   2cb9   d4                SEP 4
   2cba   ff 09             DW F_MSG
                        
                            ; Send CR+LF
   2cbc   f8 0d             LDI 13
   2cbe   d4 00 0b          CALL SERIAL_WRITE_CHAR
   2cc1   f8 0a             LDI 10
   2cc3   d4 00 0b          CALL SERIAL_WRITE_CHAR
                        
   2cc6   d5                RETN
                        
                        ; ==============================================================================
                        ; End of Negamax Core
                        ; ==============================================================================
                        ; ==============================================================================
                        ; RCA 1802/1806 Chess Engine - UCI Protocol Implementation
                        ; ==============================================================================
                        ; Universal Chess Interface for communication with GUI
                        ; Implements minimal UCI subset for playability
                        ; ==============================================================================
                        
                        ; ------------------------------------------------------------------------------
                        ; UCI Command Buffer - defined in board.asm
                        ; ------------------------------------------------------------------------------
                        ; UCI_BUFFER ($7000, 2048 bytes) and UCI_STATE ($64B8) defined in board.asm
   07ff                 UCI_BUFFER_LEN  EQU 2047    ; Max chars (16-bit counter, 2048-byte buffer)
   0001                 UCI_READY       EQU 1       ; Ready state
                        
                        ; ------------------------------------------------------------------------------
                        ; UCI String Constants
                        ; ------------------------------------------------------------------------------
                        ; These would be defined as byte arrays in actual implementation
                        
   2cc7   75 63 69 00   STR_UCI         DB "uci", 0
   2ccb   69 73 72 65   STR_ISREADY     DB "isready", 0
   2ccf   61 64 79 00   
   2cd3   70 6f 73 69   STR_POSITION    DB "position", 0
   2cd7   74 69 6f 6e   
   2cdb   00            
   2cdc   67 6f 00      STR_GO          DB "go", 0
   2cdf   71 75 69 74   STR_QUIT        DB "quit", 0
   2ce3   00            
   2ce4   75 63 69 6e   STR_UCINEWGAME  DB "ucinewgame", 0
   2ce8   65 77 67 61   
   2cec   6d 65 00      
   2cef   73 74 6f 70   STR_STOP        DB "stop", 0
   2cf3   00            
                        
                        ; Response strings (CR+LF for terminal display)
   2cf4   69 64 20 6e   STR_ID_NAME     DB "id name RCA-Chess-1806", 13, 10, 0
   2cf8   61 6d 65 20   
   2cfc   52 43 41 2d   
   2d00   43 68 65 73   
   2d04   73 2d 31 38   
   2d08   30 36 0d 0a   
   2d0c   00            
   2d0d   69 64 20 61   STR_ID_AUTHOR   DB "id author Mark Abene & Claude Code", 13, 10, 0
   2d11   75 74 68 6f   
   2d15   72 20 4d 61   
   2d19   72 6b 20 41   
   2d1d   62 65 6e 65   
   2d21   20 26 20 43   
   2d25   6c 61 75 64   
   2d29   65 20 43 6f   
   2d2d   64 65 0d 0a   
   2d31   00            
   2d32   6f 70 74 69   STR_OPTION_DEPTH DB "option name Depth type spin default 4 min 1 max 6", 13, 10, 0
   2d36   6f 6e 20 6e   
   2d3a   61 6d 65 20   
   2d3e   44 65 70 74   
   2d42   68 20 74 79   
   2d46   70 65 20 73   
   2d4a   70 69 6e 20   
   2d4e   64 65 66 61   
   2d52   75 6c 74 20   
   2d56   34 20 6d 69   
   2d5a   6e 20 31 20   
   2d5e   6d 61 78 20   
   2d62   36 0d 0a 00   
   2d66   75 63 69 6f   STR_UCIOK       DB "uciok", 13, 10, 0
   2d6a   6b 0d 0a 00   
   2d6e   72 65 61 64   STR_READYOK     DB "readyok", 13, 10, 0
   2d72   79 6f 6b 0d   
   2d76   0a 00         
   2d78   62 65 73 74   STR_BESTMOVE    DB "bestmove ", 0
   2d7c   6d 6f 76 65   
   2d80   20 00         
   2d82   69 6e 66 6f   STR_INFO_DEPTH  DB "info depth ", 0
   2d86   20 64 65 70   
   2d8a   74 68 20 00   
   2d8e   20 73 63 6f   STR_SCORE_CP    DB " score cp ", 0
   2d92   72 65 20 63   
   2d96   70 20 00      
   2d99   20 6e 6f 64   STR_NODES       DB " nodes ", 0
   2d9d   65 73 20 00   
                        ; STR_INFO_SOVF removed 2026-05-16 — CHECK_STACK_OVERFLOW now hard-traps
                        ; via MARK/SEP 1 instead of emitting an info string via a corrupted stack.
   2da1   69 6e 66 6f   STR_INFO_RMV    DB "info string ROOT_MOVE_INVALID_SUBSTITUTED", 13, 10, 0
   2da5   20 73 74 72   
   2da9   69 6e 67 20   
   2dad   52 4f 4f 54   
   2db1   5f 4d 4f 56   
   2db5   45 5f 49 4e   
   2db9   56 41 4c 49   
   2dbd   44 5f 53 55   
   2dc1   42 53 54 49   
   2dc5   54 55 54 45   
   2dc9   44 0d 0a 00   
                        
                        ; ------------------------------------------------------------------------------
                        ; UCI_INIT - Initialize UCI interface
                        ; ------------------------------------------------------------------------------
   2dcd                 UCI_INIT:
                            ; Set up serial I/O (if needed)
                            ; TODO: Hardware-specific initialization
                        
                            ; Set initial state
   2dcd   f8 01             LDI UCI_READY
   2dcf   ad                PLO 13
                        
   2dd0   68 ca 64 b8       RLDI 10, UCI_STATE
                        
   2dd4   8d                GLO 13
   2dd5   5a                STR 10
                        
   2dd6   d5                RETN
                        
                        ; ------------------------------------------------------------------------------
                        ; UCI_READ_LINE - Read a line of input
                        ; ------------------------------------------------------------------------------
                        ; Input:  None
                        ; Output: Line in UCI_BUFFER, null-terminated
                        ;         D = length
                        ; Uses:   A, D
                        ;
                        ; Reads characters until newline or max length
                        ; ------------------------------------------------------------------------------
   2dd7                 UCI_READ_LINE:
   2dd7   68 ca 70 00       RLDI 10, UCI_BUFFER
                        
   2ddb   f8 00             LDI 0
   2ddd   bd                PHI 13              ; R13.1 = count high byte = 0
   2dde   ad                PLO 13              ; R13.0 = count low byte = 0
                        
   2ddf                 UCI_READ_LOOP:
                            ; Read character from serial input
   2ddf   d4 00 07          CALL SERIAL_READ_CHAR
                            ; Returns character in D
                        
                            ; Check for carriage return (CR = 13)
   2de2   ff 0d             SMI 13
   2de4   c2 2d ff          LBZ UCI_READ_DONE
                        
                            ; Check for newline (LF = 10) - restore D first
   2de7   fc 0d             ADI 13              ; Restore: (D-13)+13 = D
   2de9   ff 0a             SMI 10              ; Check for LF
   2deb   c2 2d ff          LBZ UCI_READ_DONE
   2dee   fc 0a             ADI 10              ; Restore D
                        
                            ; Store character
   2df0   5a                STR 10
   2df1   1a                INC 10
                        
                            ; Increment 16-bit count
   2df2   1d                INC 13
                        
                            ; Check buffer limit (16-bit: UCI_BUFFER_LEN = 2047 = $07FF)
   2df3   8d                GLO 13
   2df4   fb ff             XRI LOW(UCI_BUFFER_LEN)
   2df6   ca 2d df          LBNZ UCI_READ_LOOP
   2df9   9d                GHI 13
   2dfa   fb 07             XRI HIGH(UCI_BUFFER_LEN)
   2dfc   ca 2d df          LBNZ UCI_READ_LOOP
                            ; Count == UCI_BUFFER_LEN, buffer full
                        
                        
                        
   2dff                 UCI_READ_DONE:
                            ; Null-terminate string
   2dff   f8 00             LDI 0
   2e01   5a                STR 10
                        
                            ; Echo CR+LF
   2e02   f8 0d             LDI 13
   2e04   d4 00 0b          CALL SERIAL_WRITE_CHAR
   2e07   f8 0a             LDI 10
   2e09   d4 00 0b          CALL SERIAL_WRITE_CHAR
                        
                            ; Return length
   2e0c   8d                GLO 13
   2e0d   d5                RETN
                        
                        ; NOTE: UCI_WRITE_STRING removed - use F_MSG with R15 directly
                        ; The old UCI_WRITE_STRING used R10, which clobbered the negamax loop counter!
                        
                        ; ------------------------------------------------------------------------------
                        ; UCI_PROCESS_COMMAND - Process UCI command from buffer
                        ; ------------------------------------------------------------------------------
                        ; Input:  Command in UCI_BUFFER
                        ; Output: Appropriate action taken
                        ; ------------------------------------------------------------------------------
   2e0e                 UCI_PROCESS_COMMAND:
                            ; Compare command with known commands
                        
                            ; Check "uci"
   2e0e   68 ca 70 00       RLDI 10, UCI_BUFFER
                        
   2e12   68 cb 2c c7       RLDI 11, STR_UCI
                        
   2e16   d4 31 2a          CALL STRCMP
   2e19   c2 2e 71          LBZ UCI_CMD_UCI
                        
                            ; Check "isready"
   2e1c   68 ca 70 00       RLDI 10, UCI_BUFFER
                        
   2e20   68 cb 2c cb       RLDI 11, STR_ISREADY
                        
   2e24   d4 31 2a          CALL STRCMP
   2e27   c2 2e 8e          LBZ UCI_CMD_ISREADY
                        
                            ; Check "position"
   2e2a   68 ca 70 00       RLDI 10, UCI_BUFFER
                        
   2e2e   68 cb 2c d3       RLDI 11, STR_POSITION
                        
   2e32   d4 31 40          CALL STRNCMP        ; Compare first 8 chars
   2e35   c2 2e 96          LBZ UCI_CMD_POSITION
                        
                            ; Check "go"
   2e38   68 ca 70 00       RLDI 10, UCI_BUFFER
                        
   2e3c   68 cb 2c dc       RLDI 11, STR_GO
                        
   2e40   d4 31 40          CALL STRNCMP
   2e43   c2 2f c5          LBZ UCI_CMD_GO
                        
                            ; Check "quit"
   2e46   68 ca 70 00       RLDI 10, UCI_BUFFER
                        
   2e4a   68 cb 2c df       RLDI 11, STR_QUIT
                        
   2e4e   d4 31 2a          CALL STRCMP
   2e51   c2 30 ad          LBZ UCI_CMD_QUIT
                        
                            ; Check "ucinewgame"
   2e54   68 ca 70 00       RLDI 10, UCI_BUFFER
                        
   2e58   68 cb 2c e4       RLDI 11, STR_UCINEWGAME
                        
   2e5c   d4 31 2a          CALL STRCMP
   2e5f   c2 30 b0          LBZ UCI_CMD_UCINEWGAME
                        
                            ; Check "stop"
   2e62   68 ca 70 00       RLDI 10, UCI_BUFFER
                        
   2e66   68 cb 2c ef       RLDI 11, STR_STOP
                        
   2e6a   d4 31 2a          CALL STRCMP
   2e6d   c2 30 db          LBZ UCI_CMD_STOP
                        
                            ; Unknown command - ignore
   2e70   d5                RETN
                        
                        ; ------------------------------------------------------------------------------
                        ; UCI Command Handlers
                        ; ------------------------------------------------------------------------------
                        
   2e71                 UCI_CMD_UCI:
                            ; Send identification
   2e71   68 cf 2c f4       RLDI 15, STR_ID_NAME
   2e75   d4                SEP 4
   2e76   ff 09             DW F_MSG
                        
   2e78   68 cf 2d 0d       RLDI 15, STR_ID_AUTHOR
   2e7c   d4                SEP 4
   2e7d   ff 09             DW F_MSG
                        
                            ; Send options
   2e7f   68 cf 2d 32       RLDI 15, STR_OPTION_DEPTH
   2e83   d4                SEP 4
   2e84   ff 09             DW F_MSG
                        
                            ; Send uciok
   2e86   68 cf 2d 66       RLDI 15, STR_UCIOK
   2e8a   d4                SEP 4
   2e8b   ff 09             DW F_MSG
                        
   2e8d   d5                RETN
                        
   2e8e                 UCI_CMD_ISREADY:
                            ; Send readyok
   2e8e   68 cf 2d 6e       RLDI 15, STR_READYOK
   2e92   d4                SEP 4
   2e93   ff 09             DW F_MSG
                        
   2e95   d5                RETN
                        
   2e96                 UCI_CMD_POSITION:
                            ; Parse position command
                            ; Format: "position startpos" or "position startpos moves e2e4 ..."
                        
                            ; Check if "startpos"
   2e96   68 ca 70 09       RLDI 10, UCI_BUFFER + 9
                        
                            ; Check for "startpos"
   2e9a   0a                LDN 10
   2e9b   fb 73             XRI 's'
   2e9d   ca 2f 9f          LBNZ UCI_POS_DONE   ; Not startpos (FEN not supported yet)
                        
                            ; Initialize to starting position
   2ea0   d4 00 a6          CALL INIT_BOARD
   2ea3   d4 01 76          CALL INIT_MOVE_HISTORY
                        
                            ; --- Compute and store starting position hash for repetition detection ---
   2ea6   d4 56 b3          CALL HASH_INIT          ; Compute hash for starting position
   2ea9   68 ca 65 00       RLDI 10, HASH_HIST      ; R10 → first hash history entry
   2ead   68 cd 64 b9       RLDI 13, HASH_HI
   2eb1   4d                LDA 13                  ; D = HASH_HI, R13 → HASH_LO
   2eb2   5a                STR 10
   2eb3   1a                INC 10
   2eb4   0d                LDN 13                  ; D = HASH_LO
   2eb5   5a                STR 10
   2eb6   68 ca 64 eb       RLDI 10, HASH_HIST_COUNT
   2eba   f8 01             LDI 1
   2ebc   5a                STR 10                  ; count = 1 (starting position stored)
                        
                            ; Skip past "startpos" (8 chars) to check for " moves"
                            ; Buffer now at "startpos..." - need to find " moves "
   2ebd   68 ca 70 11       RLDI 10, UCI_BUFFER + 17
                        
                            ; Check if there's more (should be space or null)
   2ec1   0a                LDN 10
   2ec2   c2 2f 9f          LBZ UCI_POS_DONE    ; End of string, no moves
   2ec5   fb 20             XRI ' '
   2ec7   ca 2f 9f          LBNZ UCI_POS_DONE   ; Not a space, unexpected
                        
                            ; Skip the space
   2eca   1a                INC 10
                        
                            ; Check for "moves" (5 chars)
   2ecb   0a                LDN 10
   2ecc   fb 6d             XRI 'm'
   2ece   ca 2f 9f          LBNZ UCI_POS_DONE
   2ed1   1a                INC 10
   2ed2   0a                LDN 10
   2ed3   fb 6f             XRI 'o'
   2ed5   ca 2f 9f          LBNZ UCI_POS_DONE
   2ed8   1a                INC 10
   2ed9   0a                LDN 10
   2eda   fb 76             XRI 'v'
   2edc   ca 2f 9f          LBNZ UCI_POS_DONE
   2edf   1a                INC 10
   2ee0   0a                LDN 10
   2ee1   fb 65             XRI 'e'
   2ee3   ca 2f 9f          LBNZ UCI_POS_DONE
   2ee6   1a                INC 10
   2ee7   0a                LDN 10
   2ee8   fb 73             XRI 's'
   2eea   ca 2f 9f          LBNZ UCI_POS_DONE
   2eed   1a                INC 10              ; R10 now past "moves"
                        
                            ; Now parse move list: " e2e4 e7e5 ..."
   2eee                 UCI_POS_MOVE_LOOP:
                            ; Skip spaces
   2eee   0a                LDN 10
   2eef   c2 2f 9f          LBZ UCI_POS_DONE    ; End of string
   2ef2   fb 20             XRI ' '
   2ef4   ca 2e fb          LBNZ UCI_POS_PARSE_MOVE  ; Not a space, should be move
   2ef7   1a                INC 10
   2ef8   c0 2e ee          LBR UCI_POS_MOVE_LOOP
                        
   2efb                 UCI_POS_PARSE_MOVE:
                            ; R10 points to start of move (e.g., "e2e4")
                            ; Parse from square (2 chars)
   2efb   d4 2f a0          CALL ALGEBRAIC_TO_SQUARE
   2efe   fb ff             XRI $FF
   2f00   c2 2f 9f          LBZ UCI_POS_DONE    ; Invalid square, abort
                        
                            ; Save from square
   2f03   fb ff             XRI $FF             ; Restore value (XRI is self-inverse)
   2f05   b7                PHI 7               ; R7.1 = from square
                        
                            ; Parse to square (2 chars)
   2f06   d4 2f a0          CALL ALGEBRAIC_TO_SQUARE
   2f09   fb ff             XRI $FF
   2f0b   c2 2f 9f          LBZ UCI_POS_DONE    ; Invalid square, abort
   2f0e   fb ff             XRI $FF             ; Restore value
                        
                            ; Store from and to in MOVE_FROM/MOVE_TO
   2f10   a7                PLO 7               ; R7.0 = to square
                        
   2f11   68 c8 64 02       RLDI 8, MOVE_FROM
   2f15   97                GHI 7
   2f16   58                STR 8               ; MOVE_FROM = from
   2f17   18                INC 8
   2f18   87                GLO 7
   2f19   58                STR 8               ; MOVE_TO = to
                        
                            ; ---- Check for promotion suffix (5th char: q/r/b/n) ----
                            ; Clear UNDO_PROMOTION first (default: no promotion)
   2f1a   68 c8 64 04       RLDI 8, UNDO_PROMOTION
   2f1e   f8 00             LDI 0
   2f20   58                STR 8               ; UNDO_PROMOTION = 0
                        
                            ; Check next char for promotion piece
   2f21   0a                LDN 10              ; Peek next char
   2f22   fb 71             XRI 'q'
   2f24   c2 2f 39          LBZ UCI_PROMO_QUEEN
   2f27   fb 03             XRI $03             ; 'q'^'r' = $71^$72 = $03
   2f29   c2 2f 3e          LBZ UCI_PROMO_ROOK
   2f2c   fb 10             XRI $10             ; 'r'^'b' = $72^$62 = $10
   2f2e   c2 2f 43          LBZ UCI_PROMO_BISHOP
   2f31   fb 0c             XRI $0C             ; 'b'^'n' = $62^$6E = $0C
   2f33   c2 2f 48          LBZ UCI_PROMO_KNIGHT
   2f36   c0 2f 4c          LBR UCI_PROMO_DONE  ; Not a promotion char, don't advance
                        
   2f39                 UCI_PROMO_QUEEN:
   2f39   f8 05             LDI QUEEN_TYPE      ; $05
   2f3b   c0 2f 4a          LBR UCI_PROMO_STORE
   2f3e                 UCI_PROMO_ROOK:
   2f3e   f8 04             LDI ROOK_TYPE       ; $04
   2f40   c0 2f 4a          LBR UCI_PROMO_STORE
   2f43                 UCI_PROMO_BISHOP:
   2f43   f8 03             LDI BISHOP_TYPE     ; $03
   2f45   c0 2f 4a          LBR UCI_PROMO_STORE
   2f48                 UCI_PROMO_KNIGHT:
   2f48   f8 02             LDI KNIGHT_TYPE     ; $02
                        
   2f4a                 UCI_PROMO_STORE:
   2f4a   58                STR 8               ; UNDO_PROMOTION = piece type
   2f4b   1a                INC 10              ; Advance past promotion char
                        
   2f4c                 UCI_PROMO_DONE:
                        
                            ; ---- Record move in MOVE_HIST for opening book ----
                            ; Skip recording past book depth (prevents 8-bit GAME_PLY overflow)
   2f4c   68 c8 64 4d       RLDI 8, GAME_PLY
   2f50   08                LDN 8               ; D = GAME_PLY
   2f51   ff 0f             SMI BOOK_PLY_LIMIT  ; past book depth?
   2f53   c3 2f 71          LBDF UCI_HIST_DONE  ; skip recording + increment
                            ; Calculate offset: GAME_PLY * 2
   2f56   08                LDN 8               ; reload GAME_PLY (SMI clobbered D)
   2f57   fe                SHL                 ; D = GAME_PLY * 2
   2f58   a9                PLO 9               ; R9.0 = offset
                        
                            ; R9 = MOVE_HIST + offset
   2f59   f8 60             LDI HIGH(MOVE_HIST)
   2f5b   b9                PHI 9
   2f5c   f8 90             LDI LOW(MOVE_HIST)
   2f5e   e2                SEX 2
   2f5f   52                STR 2
   2f60   89                GLO 9               ; D = offset
   2f61   f4                ADD                 ; D = LOW(MOVE_HIST) + offset
   2f62   a9                PLO 9
   2f63   f8 60             LDI HIGH(MOVE_HIST)
   2f65   7c 00             ADCI 0              ; Add carry to high byte
   2f67   b9                PHI 9
                        
                            ; Store from square
   2f68   97                GHI 7               ; from square
   2f69   59                STR 9
   2f6a   19                INC 9
                            ; Store to square
   2f6b   87                GLO 7               ; to square
   2f6c   59                STR 9
                        
                            ; Increment GAME_PLY
   2f6d   08                LDN 8               ; R8 still points to GAME_PLY
   2f6e   fc 01             ADI 1
   2f70   58                STR 8
   2f71                 UCI_HIST_DONE:
                            ; ---- End of MOVE_HIST recording ----
                        
                            ; Apply the move (save R10 - MAKE_MOVE clobbers it!)
   2f71   9a                GHI 10
   2f72   73                STXD
   2f73   8a                GLO 10
   2f74   73                STXD
   2f75   d4 09 b4          CALL MAKE_MOVE
   2f78   60                IRX
   2f79   72                LDXA
   2f7a   aa                PLO 10
   2f7b   f0                LDX
   2f7c   ba                PHI 10
                        
                            ; ---- Record hash for repetition detection ----
   2f7d   68 cd 64 eb       RLDI 13, HASH_HIST_COUNT
   2f81   0d                LDN 13              ; D = count
   2f82   fb ff             XRI 255             ; Zero if count == 255 (table full)
   2f84   c2 2e ee          LBZ UCI_POS_MOVE_LOOP   ; Full, skip recording
   2f87   0d                LDN 13              ; D = count (reload)
   2f88   fe                SHL                 ; D = (count*2) & $FF, DF = carry for counts >= 128
   2f89   a8                PLO 8               ; R8.0 = offset low byte
   2f8a   f8 65             LDI HIGH(HASH_HIST) ; DF preserved (LDI doesn't affect DF)
   2f8c   7c 00             ADCI 0              ; D = HIGH(HASH_HIST) + carry from SHL
   2f8e   b8                PHI 8               ; R8 = &HASH_HIST[count] (correct for all counts)
   2f8f   68 c9 64 b9       RLDI 9, HASH_HI
   2f93   49                LDA 9               ; D = HASH_HI
   2f94   58                STR 8
   2f95   18                INC 8
   2f96   09                LDN 9               ; D = HASH_LO
   2f97   58                STR 8
   2f98   0d                LDN 13              ; count (R13 still at HASH_HIST_COUNT)
   2f99   fc 01             ADI 1
   2f9b   5d                STR 13              ; count++
   2f9c   c0 2e ee          LBR UCI_POS_MOVE_LOOP
                        
   2f9f                 UCI_POS_DONE:
   2f9f   d5                RETN
                        
                        ; ------------------------------------------------------------------------------
                        ; ALGEBRAIC_TO_SQUARE - Convert algebraic notation to 0x88 square
                        ; ------------------------------------------------------------------------------
                        ; Input:  R10 = pointer to 2-char string (e.g., "e2"), advanced by 2
                        ; Output: D = 0x88 square index, or $FF if invalid
                        ; Uses:   R7.0 for file temp
                        ; ------------------------------------------------------------------------------
   2fa0                 ALGEBRAIC_TO_SQUARE:
                            ; Get file character (a-h)
   2fa0   4a                LDA 10              ; Load file char, advance R10
   2fa1   ff 61             SMI 'a'             ; Convert to 0-7
   2fa3   cb 2f c1          LBNF ATS_INVALID    ; If DF=0 (borrow), char < 'a', invalid
   2fa6   a7                PLO 7               ; Save potential file in R7.0
   2fa7   ff 08             SMI 8               ; Check if >= 8
   2fa9   c3 2f c1          LBDF ATS_INVALID    ; If >= 8, invalid
                        
                            ; Get rank character (1-8)
   2fac   4a                LDA 10              ; Load rank char, advance R10
   2fad   ff 31             SMI '1'             ; Convert to 0-7
   2faf   cb 2f c1          LBNF ATS_INVALID    ; If DF=0 (borrow), char < '1', invalid
   2fb2   ff 08             SMI 8               ; Check if >= 8
   2fb4   c3 2f c1          LBDF ATS_INVALID    ; If >= 8, invalid
   2fb7   fc 08             ADI 8               ; Restore 0-7 value
                        
                            ; Calculate 0x88 square = rank * 16 + file
                            ; rank is in D (0-7), file in R7.0
   2fb9   fe                SHL                 ; D = rank * 2
   2fba   fe                SHL                 ; D = rank * 4
   2fbb   fe                SHL                 ; D = rank * 8
   2fbc   fe                SHL                 ; D = rank * 16
   2fbd   52                STR 2               ; Save rank*16 on stack
   2fbe   87                GLO 7               ; Get file (0-7)
   2fbf   f4                ADD                 ; D = rank*16 + file
   2fc0   d5                RETN
                        
   2fc1                 ATS_INVALID:
   2fc1   1a                INC 10              ; Skip second char even on error (keep R10 consistent)
   2fc2   f8 ff             LDI $FF
   2fc4   d5                RETN
                        
   2fc5                 UCI_CMD_GO:
                            ; Parse go command
                            ; Format: "go depth 6" or "go infinite", etc.
                            ; Default to depth 1, parse "depth N" if present
                            ; Store in memory (R5 is SRET in BIOS mode!)
                        
                            ; Default depth = 1
   2fc5   f8 01             LDI 1
   2fc7   a7                PLO 7               ; R7.0 = depth (default 1)
                        
                            ; Check for "depth " after "go "
                            ; Buffer: "go depth 3" or "go" or "go infinite"
   2fc8   68 ca 70 03       RLDI 10, UCI_BUFFER + 3
                        
                            ; Check if we have "depth"
   2fcc   0a                LDN 10
   2fcd   fb 64             XRI 'd'
   2fcf   ca 30 07          LBNZ UCI_GO_SET_DEPTH   ; Not "depth", use default
   2fd2   1a                INC 10
   2fd3   0a                LDN 10
   2fd4   fb 65             XRI 'e'
   2fd6   ca 30 07          LBNZ UCI_GO_SET_DEPTH
   2fd9   1a                INC 10
   2fda   0a                LDN 10
   2fdb   fb 70             XRI 'p'
   2fdd   ca 30 07          LBNZ UCI_GO_SET_DEPTH
   2fe0   1a                INC 10
   2fe1   0a                LDN 10
   2fe2   fb 74             XRI 't'
   2fe4   ca 30 07          LBNZ UCI_GO_SET_DEPTH
   2fe7   1a                INC 10
   2fe8   0a                LDN 10
   2fe9   fb 68             XRI 'h'
   2feb   ca 30 07          LBNZ UCI_GO_SET_DEPTH
   2fee   1a                INC 10
   2fef   0a                LDN 10
   2ff0   fb 20             XRI ' '
   2ff2   ca 30 07          LBNZ UCI_GO_SET_DEPTH
   2ff5   1a                INC 10              ; R10 now at the number
                        
                            ; Parse the depth number (1-9, single digit only)
                            ; Depths > 9 would take impractically long on the 1802 anyway
   2ff6   0a                LDN 10
   2ff7   ff 30             SMI '0'             ; Convert ASCII to value
   2ff9   cb 30 07          LBNF UCI_GO_SET_DEPTH ; Invalid (< '0'), use default
   2ffc   ff 0a             SMI 10              ; Check if >= 10
   2ffe   c3 30 07          LBDF UCI_GO_SET_DEPTH ; >= 10, use default
   3001   fc 0a             ADI 10              ; Restore 0-9 value
   3003   c2 30 07          LBZ UCI_GO_SET_DEPTH ; Depth 0 invalid, use default
   3006   a7                PLO 7               ; R7.0 = parsed depth (1-9)
                        
   3007                 UCI_GO_SET_DEPTH:
                            ; Set SEARCH_DEPTH from R7.0
   3007   68 cd 64 16       RLDI 13, SEARCH_DEPTH
   300b   f8 00             LDI 0
   300d   5d                STR 13              ; SEARCH_DEPTH high = 0
   300e   1d                INC 13
   300f   87                GLO 7
   3010   5d                STR 13              ; SEARCH_DEPTH low = depth
                        
                            ; ---- Check opening book first ----
   3011   d4 31 63          CALL BOOK_LOOKUP
   3014   c2 30 27          LBZ UCI_GO_SEARCH   ; D=0: no book hit, do normal search
                        
                            ; Book hit! Copy BOOK_MOVE to BEST_MOVE
   3017   68 c8 64 4e       RLDI 8, BOOK_MOVE_FROM
   301b   68 c9 64 10       RLDI 9, BEST_MOVE
                        
                            ; Store book move in BEST_MOVE (from in high, to in low)
   301f   48                LDA 8               ; BOOK_MOVE_FROM
   3020   59                STR 9               ; BEST_MOVE high = from
   3021   19                INC 9
   3022   08                LDN 8               ; BOOK_MOVE_TO
   3023   59                STR 9               ; BEST_MOVE low = to
   3024   c0 30 31          LBR UCI_GO_SEND_MOVE
                        
   3027                 UCI_GO_SEARCH:
                            ; Clear stale promotion flag before search
                            ; (opponent's promotion move leaves UNDO_PROMOTION set, which would
                            ; corrupt every MAKE_MOVE during search)
   3027   68 ca 64 04       RLDI 10, UNDO_PROMOTION
   302b   f8 00             LDI 0
   302d   5a                STR 10              ; UNDO_PROMOTION = 0
                        
                            ; Run search
   302e   d4 2b 15          CALL SEARCH_POSITION
                        
   3031                 UCI_GO_SEND_MOVE:
                            ; Best move now at BEST_MOVE.
                            ;
                            ; --- Root-move validation (added 2026-05-12) ---
                            ; Defense against MOVE_LIST corruption causing illegal-move output.
                            ; Regenerate moves from current board; verify BEST_MOVE appears in
                            ; the regenerated list. If not, emit info string + substitute first
                            ; legal move. Catches the symptom of any state corruption affecting
                            ; root MOVE_LIST regardless of underlying cause.
                        
                            ; Encode BEST_MOVE for byte-by-byte comparison (mirrors ORDER_TT_MOVE)
   3031   68 ca 64 10       RLDI 10, BEST_MOVE
   3035   4a                LDA 10
   3036   bd                PHI 13                      ; R13.1 = BEST_MOVE from (0x88)
   3037   0a                LDN 10
   3038   ad                PLO 13                      ; R13.0 = BEST_MOVE to (0x88)
                        
   3039   68 ca 64 06       RLDI 10, MOVE_FLAGS_TEMP
   303d   f8 00             LDI 0
   303f   5a                STR 10                      ; flags=0 for the comparison encoding
                        
   3040   d4 03 8d          CALL ENCODE_MOVE_16BIT
                            ; R8 = encoded BEST_MOVE (flags=0)
                        
                            ; Save encoded BEST_MOVE on stack across GENERATE_MOVES
                            ; (GENERATE_MOVES clobbers R11 — uses R11.1 as current-from-square)
   3043   98                GHI 8
   3044   73                STXD
   3045   88                GLO 8
   3046   73                STXD
                        
                            ; Regenerate legal moves into MOVE_LIST
   3047   68 c9 78 00       RLDI 9, MOVE_LIST
   304b   d4 04 d7          CALL GENERATE_MOVES
                            ; D = move count
                        
   304e   a7                PLO 7                       ; R7.0 = move count
   304f   b7                PHI 7                       ; R7.1 = loop counter (D unchanged by PLO)
                        
                            ; Restore encoded BEST_MOVE to R11
   3050   60                IRX
   3051   72                LDXA
   3052   ab                PLO 11                      ; R11.0 = LOW
   3053   f0                LDX
   3054   bb                PHI 11                      ; R11.1 = HIGH
                        
   3055   97                GHI 7                       ; check count
   3056   c2 30 98          LBZ RMV_DONE                ; 0 moves (mate/stalemate) — leave as-is
                        
   3059   68 c8 78 00       RLDI 8, MOVE_LIST           ; R8 = scan pointer
                        
   305d                 RMV_SCAN_LOOP:
   305d   97                GHI 7
   305e   c2 30 79          LBZ RMV_NOT_FOUND
                        
                            ; MOVE_LIST stores HIGH byte first (per ADD_MOVE_ENCODED line 221):
                            ; entry layout in memory is [HIGH][LOW] for each 2-byte move.
                            ; Compare HIGH byte (with flag bits 6-7 masked off)
   3061   48                LDA 8                       ; list move HIGH byte; R8++
   3062   fa 3f             ANI $3F                     ; mask off flag bits
   3064   52                STR 2
   3065   9b                GHI 11                      ; encoded BEST_MOVE HIGH byte (flags=0)
   3066   f3                XOR
   3067   ca 30 71          LBNZ RMV_NEXT
                        
                            ; HIGH bytes match — compare LOW byte (no masking needed)
   306a   08                LDN 8                       ; list move LOW byte; R8 stays
   306b   52                STR 2
   306c   8b                GLO 11                      ; encoded BEST_MOVE LOW byte
   306d   f3                XOR
   306e   c2 30 98          LBZ RMV_DONE                ; Match — BEST_MOVE is legal, emit normally
                        
   3071                 RMV_NEXT:
   3071   18                INC 8                       ; skip past LOW byte to next entry
   3072   97                GHI 7
   3073   ff 01             SMI 1
   3075   b7                PHI 7
   3076   c0 30 5d          LBR RMV_SCAN_LOOP
                        
   3079                 RMV_NOT_FOUND:
                            ; BEST_MOVE not in regenerated legal list — corruption symptom.
   3079   68 cf 2d a1       RLDI 15, STR_INFO_RMV
   307d   d4                SEP 4
   307e   ff 09             DW F_MSG
                        
                            ; Substitute first legal move from regenerated list
                            ; (memory order is [HIGH][LOW]; DECODE_MOVE_16BIT wants R8.0=LOW, R8.1=HIGH)
   3080   68 c8 78 00       RLDI 8, MOVE_LIST
   3084   48                LDA 8                       ; HIGH byte from memory
   3085   bb                PHI 11                      ; R11.1 = HIGH
   3086   08                LDN 8                       ; LOW byte from memory
   3087   ab                PLO 11                      ; R11.0 = LOW
                        
                            ; Now build R8 = [HIGH in .1, LOW in .0] for DECODE
   3088   9b                GHI 11
   3089   b8                PHI 8
   308a   8b                GLO 11
   308b   a8                PLO 8
   308c   d4 03 c7          CALL DECODE_MOVE_16BIT
                            ; R13.1 = from, R13.0 = to
                        
                            ; Write back to BEST_MOVE
   308f   68 ca 64 10       RLDI 10, BEST_MOVE
   3093   9d                GHI 13
   3094   5a                STR 10
   3095   1a                INC 10
   3096   8d                GLO 13
   3097   5a                STR 10
                        
   3098                 RMV_DONE:
                            ; Send best move (validated or substituted)
   3098   68 cf 2d 78       RLDI 15, STR_BESTMOVE
   309c   d4                SEP 4
   309d   ff 09             DW F_MSG
                        
                            ; Convert best move to algebraic and send
                            ; TODO: Load best move and convert
   309f   d4 30 dc          CALL UCI_SEND_BEST_MOVE
                        
                            ; Send CR+LF
   30a2   f8 0d             LDI 13
   30a4   d4 00 0b          CALL SERIAL_WRITE_CHAR
   30a7   f8 0a             LDI 10
   30a9   d4 00 0b          CALL SERIAL_WRITE_CHAR
                        
   30ac   d5                RETN
                        
   30ad                 UCI_CMD_QUIT:
                            ; Return to monitor at $8000
   30ad   c0 80 03          LBR $8003
                        
                        ; ------------------------------------------------------------------------------
                        ; UCI_CMD_UCINEWGAME - Prepare for a new game
                        ; ------------------------------------------------------------------------------
                        ; Clears transposition table and resets game state
                        ; ------------------------------------------------------------------------------
   30b0                 UCI_CMD_UCINEWGAME:
                            ; Clear workspace RAM to prevent stale variable bugs
   30b0   d4 5f 8a          CALL WORKSPACE_CLEAR
                        
                            ; Clear transposition table
   30b3   d4 57 c2          CALL TT_CLEAR
                        
                            ; Reset game ply counter
   30b6   68 ca 64 4d       RLDI 10, GAME_PLY
   30ba   f8 00             LDI 0
   30bc   5a                STR 10
                        
                            ; Clear move history
   30bd   d4 01 76          CALL INIT_MOVE_HISTORY
                        
                            ; Initialize board to starting position
   30c0   d4 00 a6          CALL INIT_BOARD
                        
                            ; Compute and store starting-position Zobrist hash + first HASH_HIST entry.
                            ; UCI_CMD_POSITION normally does this when parsing "position startpos",
                            ; but the first such command after ucinewgame is frequently dropped at
                            ; the start of every match since 2026-04-30 ("PARTIAL_ECHO 'sition
                            ; startpos'"). The bridge sends ucinewgame and position back-to-back,
                            ; and BIOS serial RX drops the first 1-2 bytes during the long
                            ; WORKSPACE_CLEAR/TT_CLEAR processing window. Without hash init here,
                            ; the first search runs with hash=0 and pollutes TT with mis-keyed
                            ; entries that persist for the entire match.
   30c3   d4 56 b3          CALL HASH_INIT
   30c6   68 ca 65 00       RLDI 10, HASH_HIST
   30ca   68 cd 64 b9       RLDI 13, HASH_HI
   30ce   4d                LDA 13                  ; D = HASH_HI, R13 → HASH_LO
   30cf   5a                STR 10
   30d0   1a                INC 10
   30d1   0d                LDN 13                  ; D = HASH_LO
   30d2   5a                STR 10
   30d3   68 ca 64 eb       RLDI 10, HASH_HIST_COUNT
   30d7   f8 01             LDI 1
   30d9   5a                STR 10                  ; HASH_HIST_COUNT = 1 (startpos stored)
                        
   30da   d5                RETN
                        
                        ; ------------------------------------------------------------------------------
                        ; UCI_CMD_STOP - Stop calculating (no-op for now)
                        ; ------------------------------------------------------------------------------
                        ; On a single-threaded system we cannot interrupt search.
                        ; GUI should wait for bestmove response.
                        ; This is here for protocol compatibility.
                        ; ------------------------------------------------------------------------------
   30db                 UCI_CMD_STOP:
                            ; No-op - search completes naturally
                            ; GUI will receive bestmove when search finishes
   30db   d5                RETN
                        
                        ; ------------------------------------------------------------------------------
                        ; UCI_SEND_BEST_MOVE - Send best move in algebraic notation
                        ; ------------------------------------------------------------------------------
   30dc                 UCI_SEND_BEST_MOVE:
                            ; BEST_MOVE contains raw from/to squares (not encoded)
                            ; BEST_MOVE[0] = from square (0x88), BEST_MOVE[1] = to square (0x88)
   30dc   68 ca 64 10       RLDI 10, BEST_MOVE
                        
   30e0   4a                LDA 10              ; from square (raw 0x88)
   30e1   bd                PHI 13              ; R13.1 = from
   30e2   0a                LDN 10              ; to square (raw 0x88)
   30e3   ad                PLO 13              ; R13.0 = to
                        
                            ; Convert to algebraic notation (e.g., "e2e4")
                            ; From square
   30e4   9d                GHI 13              ; From square
   30e5   d4 31 17          CALL SQUARE_TO_ALGEBRAIC
                            ; Sends two characters (file, rank)
                        
                            ; To square
   30e8   8d                GLO 13              ; To square
   30e9   d4 31 17          CALL SQUARE_TO_ALGEBRAIC
                        
                            ; Check if this is a promotion move (pawn reaching last rank)
                            ; Load piece at from square
   30ec   f8 60             LDI HIGH(BOARD)
   30ee   ba                PHI 10
   30ef   9d                GHI 13              ; from square
   30f0   aa                PLO 10
   30f1   f8 00             LDI LOW(BOARD)
   30f3   52                STR 2
   30f4   8a                GLO 10
   30f5   f4                ADD
   30f6   aa                PLO 10
   30f7   9a                GHI 10
   30f8   7c 00             ADCI 0
   30fa   ba                PHI 10              ; R10 = &BOARD[from]
   30fb   0a                LDN 10              ; D = piece at from
   30fc   fa 07             ANI PIECE_MASK      ; Get piece type
   30fe   fb 01             XRI PAWN_TYPE       ; Is it a pawn?
   3100   ca 31 16          LBNZ UCI_BM_NO_PROMO
                        
                            ; It's a pawn - check if to square is on last rank
   3103   8d                GLO 13              ; to square
   3104   fa 70             ANI $70             ; Isolate rank
   3106   c2 31 11          LBZ UCI_BM_IS_PROMO ; Rank 0 = promotion for black
   3109   fb 70             XRI $70
   310b   c2 31 11          LBZ UCI_BM_IS_PROMO ; Rank 7 = promotion for white
   310e   c0 31 16          LBR UCI_BM_NO_PROMO
                        
   3111                 UCI_BM_IS_PROMO:
                            ; Append 'q' for queen promotion
   3111   f8 71             LDI 'q'
   3113   d4 00 0b          CALL SERIAL_WRITE_CHAR
                        
   3116                 UCI_BM_NO_PROMO:
   3116   d5                RETN
                        
                        ; ------------------------------------------------------------------------------
                        ; SQUARE_TO_ALGEBRAIC - Convert 0x88 square to algebraic notation
                        ; ------------------------------------------------------------------------------
                        ; Input:  D = square (0x88 format)
                        ; Output: Two characters sent (file letter, rank number)
                        ; ------------------------------------------------------------------------------
   3117                 SQUARE_TO_ALGEBRAIC:
   3117   a7                PLO 7               ; Save square in R7.0 (R13 used by caller!)
                        
                            ; Get file (0-7 → 'a'-'h')
   3118   fa 07             ANI $07             ; File bits
   311a   fc 61             ADI 'a'             ; Convert to ASCII
   311c   d4 00 0b          CALL SERIAL_WRITE_CHAR
                        
                            ; Get rank (0-7 → '1'-'8')
   311f   87                GLO 7               ; Get square from R7.0
   3120   f6                SHR
   3121   f6                SHR
   3122   f6                SHR
   3123   f6                SHR                 ; Rank bits
   3124   fc 31             ADI '1'             ; Convert to ASCII
   3126   d4 00 0b          CALL SERIAL_WRITE_CHAR
                        
   3129   d5                RETN
                        
                        ; ------------------------------------------------------------------------------
                        ; String Comparison Functions
                        ; ------------------------------------------------------------------------------
                        
                        ; STRCMP - Compare two null-terminated strings
                        ; Input:  A = string 1, B = string 2
                        ; Output: D = 0 if equal, non-zero if different
   312a                 STRCMP:
   312a   0a                LDN 10              ; D = char from string 1
   312b   52                STR 2               ; Save to stack
   312c   0b                LDN 11              ; D = char from string 2
   312d   f3                XOR                 ; D = char1 XOR char2 (0 if equal)
   312e   ca 31 3d          LBNZ STRCMP_DIFF     ; If XOR != 0, characters differ
                        
                            ; Characters are equal, check if end of both strings
   3131   0a                LDN 10
   3132   c2 31 3a          LBZ STRCMP_EQUAL     ; If null terminator, both ended - equal
                        
                            ; Continue comparing
   3135   1a                INC 10
   3136   1b                INC 11
   3137   c0 31 2a          LBR STRCMP
                        
   313a                 STRCMP_EQUAL:
   313a   f8 00             LDI 0
   313c   d5                RETN
                        
   313d                 STRCMP_DIFF:
   313d   f8 01             LDI 1
   313f   d5                RETN
                        
                        ; STRNCMP - Compare until space or null in string 1
                        ; Input:  R10 = string 1 (command buffer), R11 = string 2 (command name)
                        ; Output: D = 0 if equal, non-zero if different
   3140                 STRNCMP:
                            ; Check if string 1 hit space (end of command word)
   3140   0a                LDN 10
   3141   fb 20             XRI ' '
   3143   c2 31 56          LBZ STRNCMP_CHECK_END
                        
                            ; Check if string 1 hit null
   3146   0a                LDN 10
   3147   c2 31 56          LBZ STRNCMP_CHECK_END
                        
                            ; Compare characters
   314a   0a                LDN 10              ; D = char from string 1
   314b   52                STR 2               ; Save to stack
   314c   0b                LDN 11              ; D = char from string 2
   314d   f3                XOR                 ; D = char1 XOR char2 (0 if equal)
   314e   ca 31 60          LBNZ STRNCMP_DIFF   ; If different, not equal
                        
   3151   1a                INC 10
   3152   1b                INC 11
   3153   c0 31 40          LBR STRNCMP
                        
   3156                 STRNCMP_CHECK_END:
                            ; String 1 ended (space or null) - check if string 2 also ended
   3156   0b                LDN 11
   3157   c2 31 5d          LBZ STRNCMP_EQUAL   ; String 2 is null - match!
   315a   c0 31 60          LBR STRNCMP_DIFF    ; String 2 has more chars - no match
                        
   315d                 STRNCMP_EQUAL:
   315d   f8 00             LDI 0
   315f   d5                RETN
                        
   3160                 STRNCMP_DIFF:
   3160   f8 01             LDI 1
   3162   d5                RETN
                        
                        ; ==============================================================================
                        ; End of UCI Implementation
                        ; ==============================================================================
                        ; NOTE: SERIAL_READ_CHAR and SERIAL_WRITE_CHAR are provided by serial-io-9600.asm
                        ; ==============================================================================
                        ; ==============================================================================
                        ; Opening Book Lookup - Check if current position is in opening book
                        ; ==============================================================================
                        ;
                        ; Book format (from opening-book.asm):
                        ;   Each entry: [ply] [move1_from] [move1_to] ... [response_from] [response_to]
                        ;   Terminated with $FF
                        ;   Entries sorted by ply
                        ;
                        ; Uses: GAME_PLY - number of moves played since start
                        ;       MOVE_HIST - array of (from, to) pairs for game moves
                        ;       BOOK_MOVE_FROM/TO - output for book response
                        ;
                        ; ==============================================================================
                        
                        ; ==============================================================================
                        ; BOOK_LOOKUP - Search opening book for current position
                        ; ==============================================================================
                        ; Input:  GAME_PLY = number of moves played
                        ;         MOVE_HIST = game move history (2 bytes per move)
                        ; Output: D = 1 if book hit, 0 if no match
                        ;         BOOK_MOVE_FROM/TO = response move (if hit)
                        ; Uses:   R7, R8, R9, R10
                        ; ==============================================================================
   3163                 BOOK_LOOKUP:
                            ; R8 = pointer to current book entry
   3163   68 c8 31 d1       RLDI 8, OPENING_BOOK
                        
                            ; Load GAME_PLY into R7.1 for quick comparison
   3167   68 ca 64 4d       RLDI 10, GAME_PLY
   316b   0a                LDN 10
   316c   b7                PHI 7               ; R7.1 = GAME_PLY
                        
   316d                 BL_ENTRY_LOOP:
                            ; Read entry ply byte
   316d   08                LDN 8               ; D = entry ply
   316e   fb ff             XRI $FF             ; Check for end marker
   3170   c2 31 ce          LBZ BL_NO_MATCH     ; End of book, no match
                        
                            ; Restore ply value
   3173   fb ff             XRI $FF
   3175   a7                PLO 7               ; R7.0 = entry_ply
                        
                            ; Check if entry_ply > GAME_PLY (early exit - book sorted by ply)
   3176   97                GHI 7               ; D = GAME_PLY
   3177   52                STR 2               ; Store on stack
   3178   87                GLO 7               ; D = entry_ply
   3179   f5                SD                  ; D = GAME_PLY - entry_ply
   317a   cb 31 ce          LBNF BL_NO_MATCH    ; If borrow (entry_ply > GAME_PLY), no match possible
                        
                            ; Check if entry_ply == GAME_PLY
   317d   c2 31 8f          LBZ BL_CHECK_MOVES  ; If equal, check the moves
                        
                            ; entry_ply < GAME_PLY, skip to next entry
                            ; Entry length = 1 + entry_ply*2 + 2 = 3 + entry_ply*2
   3180   87                GLO 7               ; D = entry_ply
   3181   fe                SHL                 ; D = entry_ply * 2
   3182   fc 03             ADI 3               ; D = 3 + entry_ply * 2
   3184   52                STR 2               ; Save skip amount
   3185   88                GLO 8
   3186   f4                ADD
   3187   a8                PLO 8
   3188   98                GHI 8
   3189   7c 00             ADCI 0
   318b   b8                PHI 8
   318c   c0 31 6d          LBR BL_ENTRY_LOOP
                        
   318f                 BL_CHECK_MOVES:
                            ; entry_ply == GAME_PLY, compare all moves
                            ; R8 points to ply byte, moves start at R8+1
                            ; R9 = pointer to MOVE_HIST
   318f   68 c9 60 90       RLDI 9, MOVE_HIST
                        
                            ; R10.0 = move counter (number of move pairs to compare)
   3193   87                GLO 7               ; entry_ply = number of moves to compare
   3194   aa                PLO 10
                        
                            ; Move past ply byte
   3195   18                INC 8
                        
                            ; If ply == 0, no moves to compare - direct match!
   3196   8a                GLO 10
   3197   c2 31 b1          LBZ BL_MATCH_FOUND
                        
   319a                 BL_COMPARE_LOOP:
                            ; Compare from square
   319a   08                LDN 8               ; Book from
   319b   52                STR 2
   319c   09                LDN 9               ; History from
   319d   f3                XOR                 ; Compare
   319e   ca 31 bf          LBNZ BL_SKIP_ENTRY  ; Mismatch
                        
                            ; Compare to square
   31a1   18                INC 8
   31a2   19                INC 9
   31a3   08                LDN 8               ; Book to
   31a4   52                STR 2
   31a5   09                LDN 9               ; History to
   31a6   f3                XOR                 ; Compare
   31a7   ca 31 bd          LBNZ BL_SKIP_TO     ; TO mismatch - different skip path
                        
                            ; Move to next pair
   31aa   18                INC 8
   31ab   19                INC 9
   31ac   2a                DEC 10
   31ad   8a                GLO 10
   31ae   ca 31 9a          LBNZ BL_COMPARE_LOOP
                        
   31b1                 BL_MATCH_FOUND:
                            ; All moves matched! R8 now points to response
                            ; Store response in BOOK_MOVE_FROM/TO
   31b1   68 c9 64 4e       RLDI 9, BOOK_MOVE_FROM
                        
   31b5   48                LDA 8               ; Response from
   31b6   59                STR 9
   31b7   19                INC 9
   31b8   08                LDN 8               ; Response to
   31b9   59                STR 9
                        
                            ; Return success
   31ba   f8 01             LDI 1
   31bc   d5                RETN
                        
   31bd                 BL_SKIP_TO:
                            ; TO byte mismatch: R8 points to TO byte (already past FROM via INC 8)
                            ; Advance past TO and count this pair as consumed, then fall through
   31bd   18                INC 8               ; Past TO byte -> R8 at start of next pair
   31be   2a                DEC 10              ; This pair consumed
                            ; Fall through to BL_SKIP_ENTRY
                        
