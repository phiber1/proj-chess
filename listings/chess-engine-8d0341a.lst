                            ; Guard: if piece is EMPTY, skip promotion undo (prevents phantom pawn
                            ; from corrupted UNDO_PROMOTION)
   0c55   8a                GLO 10              ; D = piece from BOARD[to]
   0c56   c2 0c 67          LBZ UM_NOT_PROMOTION ; EMPTY piece = nothing to un-promote
   0c59   68 c9 64 04       RLDI 9, UNDO_PROMOTION
   0c5d   09                LDN 9               ; D = promotion type (0 if none)
   0c5e   c2 0c 67          LBZ UM_NOT_PROMOTION
                        
                            ; Promotion: restore pawn (get color from R10.0, the promoted piece)
   0c61   8a                GLO 10              ; D = promoted piece
   0c62   fa 08             ANI COLOR_MASK      ; Get color (0=white, 8=black)
   0c64   f9 01             ORI PAWN_TYPE       ; D = pawn of same color
   0c66   aa                PLO 10              ; R10.0 = pawn (overwrites promoted piece)
                        
   0c67                 UM_NOT_PROMOTION:
                            ; Put moving piece back at from square
   0c67   68 c9 64 09       RLDI 9, UNDO_FROM
   0c6b   09                LDN 9               ; D = from square
   0c6c   a8                PLO 8
   0c6d   f8 60             LDI HIGH(BOARD)
   0c6f   b8                PHI 8               ; R8 = &BOARD[from]
   0c70   8a                GLO 10              ; D = moving piece (pawn if promotion)
   0c71   58                STR 8               ; Put back at from square
                        
                            ; =========================================
                            ; KING POSITION RESTORE
                            ; =========================================
                            ; If moving piece is a king, restore GAME_STATE king position to from square
                            ; R10.0 = moving piece
   0c72   8a                GLO 10              ; Get moving piece
   0c73   fa 07             ANI PIECE_MASK      ; Get piece type (0-6)
   0c75   fb 06             XRI KING_TYPE       ; Is it a king?
   0c77   ca 0d 0d          LBNZ UM_NOT_KING    ; Not a king, skip
                        
                            ; It's a king - restore king position in GAME_STATE
                            ; Check color of king (R10.0 has full piece)
   0c7a   8a                GLO 10
   0c7b   fa 08             ANI COLOR_MASK      ; Get color (0=white, 8=black)
   0c7d   ca 0c 87          LBNZ UM_BLACK_KING
                        
   0c80                 UM_WHITE_KING:
                            ; Update STATE_W_KING_SQ with UNDO_FROM
   0c80   68 c9 60 86       RLDI 9, GAME_STATE + STATE_W_KING_SQ
   0c84   c0 0c 8b          LBR UM_STORE_KING
                        
   0c87                 UM_BLACK_KING:
                            ; Update STATE_B_KING_SQ with UNDO_FROM
   0c87   68 c9 60 87       RLDI 9, GAME_STATE + STATE_B_KING_SQ
                        
   0c8b                 UM_STORE_KING:
                            ; Get UNDO_FROM and store as restored king square
   0c8b   68 c8 64 09       RLDI 8, UNDO_FROM
   0c8f   08                LDN 8               ; D = from square
   0c90   59                STR 9               ; Restore king position
                        
                            ; =========================================
                            ; CASTLING ROOK UNDO
                            ; =========================================
                            ; Detect: to - from = $02 (kingside) or $FE (queenside)
   0c91   68 c9 64 49       RLDI 9, COMPARE_TEMP
   0c95   68 c8 64 09       RLDI 8, UNDO_FROM
   0c99   08                LDN 8               ; D = from square
   0c9a   e9                SEX 9
   0c9b   59                STR 9               ; M(COMPARE_TEMP) = from
   0c9c   68 c8 64 0a       RLDI 8, UNDO_TO
   0ca0   08                LDN 8               ; D = to square
   0ca1   f7                SM                   ; D = to - from
   0ca2   e2                SEX 2
                        
   0ca3   fb 02             XRI $02
   0ca5   c2 0c b0          LBZ UM_CASTLE_KS     ; Kingside
   0ca8   fb fc             XRI $FC
   0caa   c2 0c e0          LBZ UM_CASTLE_QS     ; Queenside
   0cad   c0 0d 0d          LBR UM_NOT_KING      ; Normal king move
                        
   0cb0                 UM_CASTLE_KS:
                            ; Kingside undo: rook from to-1 (f-file) back to to+1 (h-file)
   0cb0   68 c9 64 0a       RLDI 9, UNDO_TO
   0cb4   09                LDN 9               ; D = to square
                        
                            ; Read rook from BOARD[to-1]
   0cb5   ff 01             SMI 1                ; D = to - 1
   0cb7   a8                PLO 8
   0cb8   f8 60             LDI HIGH(BOARD)
   0cba   b8                PHI 8               ; R8 = &BOARD[to-1]
   0cbb   08                LDN 8               ; D = rook piece
   0cbc   bd                PHI 13              ; R13.1 = rook piece (temp)
   0cbd   f8 00             LDI EMPTY
   0cbf   58                STR 8               ; Clear f1/f8
                        
                            ; Place rook back at BOARD[to+1]
   0cc0   09                LDN 9               ; D = to square
   0cc1   fc 01             ADI 1                ; D = to + 1
   0cc3   a8                PLO 8
   0cc4   f8 60             LDI HIGH(BOARD)
   0cc6   b8                PHI 8               ; R8 = &BOARD[to+1]
   0cc7   9d                GHI 13              ; D = rook piece
   0cc8   58                STR 8               ; Restore rook to h1/h8
                        
                            ; Hash: XOR [rook, to-1] (same pairs as make - XOR cancels)
   0cc9   9d                GHI 13              ; D = rook piece
   0cca   a8                PLO 8               ; R8.0 = rook piece
   0ccb   09                LDN 9               ; D = to square
   0ccc   ff 01             SMI 1                ; D = to - 1
   0cce   b8                PHI 8               ; R8.1 = f1/f8
   0ccf   d4 58 c6          CALL HASH_XOR_PIECE_SQ
                        
                            ; Hash: XOR [rook, to+1] (R8.0 preserved)
   0cd2   68 c9 64 0a       RLDI 9, UNDO_TO
   0cd6   09                LDN 9               ; D = to square
   0cd7   fc 01             ADI 1                ; D = to + 1
   0cd9   b8                PHI 8               ; R8.1 = h1/h8
   0cda   d4 58 c6          CALL HASH_XOR_PIECE_SQ
                        
   0cdd   c0 0d 0d          LBR UM_NOT_KING
                        
   0ce0                 UM_CASTLE_QS:
                            ; Queenside undo: rook from to+1 (d-file) back to to-2 (a-file)
   0ce0   68 c9 64 0a       RLDI 9, UNDO_TO
   0ce4   09                LDN 9               ; D = to square
                        
                            ; Read rook from BOARD[to+1]
   0ce5   fc 01             ADI 1                ; D = to + 1
   0ce7   a8                PLO 8
   0ce8   f8 60             LDI HIGH(BOARD)
   0cea   b8                PHI 8               ; R8 = &BOARD[to+1]
   0ceb   08                LDN 8               ; D = rook piece
   0cec   bd                PHI 13              ; R13.1 = rook piece (temp)
   0ced   f8 00             LDI EMPTY
   0cef   58                STR 8               ; Clear d1/d8
                        
                            ; Place rook back at BOARD[to-2]
   0cf0   09                LDN 9               ; D = to square
   0cf1   ff 02             SMI 2                ; D = to - 2
   0cf3   a8                PLO 8
   0cf4   f8 60             LDI HIGH(BOARD)
   0cf6   b8                PHI 8               ; R8 = &BOARD[to-2]
   0cf7   9d                GHI 13              ; D = rook piece
   0cf8   58                STR 8               ; Restore rook to a1/a8
                        
                            ; Hash: XOR [rook, to+1]
   0cf9   9d                GHI 13              ; D = rook piece
   0cfa   a8                PLO 8               ; R8.0 = rook piece
   0cfb   09                LDN 9               ; D = to square
   0cfc   fc 01             ADI 1                ; D = to + 1
   0cfe   b8                PHI 8               ; R8.1 = d1/d8
   0cff   d4 58 c6          CALL HASH_XOR_PIECE_SQ
                        
                            ; Hash: XOR [rook, to-2] (R8.0 preserved)
   0d02   68 c9 64 0a       RLDI 9, UNDO_TO
   0d06   09                LDN 9               ; D = to square
   0d07   ff 02             SMI 2                ; D = to - 2
   0d09   b8                PHI 8               ; R8.1 = a1/a8
   0d0a   d4 58 c6          CALL HASH_XOR_PIECE_SQ
                        
   0d0d                 UM_NOT_KING:
                            ; Restore castling rights to GAME_STATE + STATE_CASTLING
   0d0d   68 c9 64 0b       RLDI 9, UNDO_CASTLING
   0d11   09                LDN 9
   0d12   ba                PHI 10              ; Save in R10.1
                        
   0d13   68 c8 60 81       RLDI 8, GAME_STATE + STATE_CASTLING
   0d17   9a                GHI 10
   0d18   58                STR 8
                        
                            ; Restore en passant square to GAME_STATE + STATE_EP_SQUARE
   0d19   68 c9 64 0c       RLDI 9, UNDO_EP
   0d1d   09                LDN 9
   0d1e   18                INC 8               ; Point to EP_SQUARE ($6082)
   0d1f   58                STR 8
                        
                            ; Restore halfmove clock to GAME_STATE + STATE_HALFMOVE
   0d20   68 c9 64 0d       RLDI 9, UNDO_HALFMOVE
   0d24   09                LDN 9
   0d25   18                INC 8               ; Point to HALFMOVE ($6083)
   0d26   58                STR 8
                        
                            ; Toggle side to move back
   0d27   68 c8 60 80       RLDI 8, SIDE
   0d2b   08                LDN 8
   0d2c   fb 08             XRI BLACK           ; Toggle between 0 and 8
   0d2e   58                STR 8
                        
                            ; =========================================
                            ; HASH UPDATE: XOR piece-square changes (reverse of MAKE_MOVE)
                            ; =========================================
                            ; HASH_XOR_PIECE_SQ: R8.0 = piece, R8.1 = square
                            ; Clobbers: R7, R9, R10, R13. Preserves: R8
                            ; Board is now restored: piece at UNDO_FROM, captured at UNDO_TO
                            ;
                            ; For promotion: need to XOR out [promoted_piece, to], not [pawn, to]
                        
                            ; --- Step 1: XOR out [piece that WAS at to], to ---
                            ; Check if this was a promotion
   0d2f   68 ca 64 04       RLDI 10, UNDO_PROMOTION
   0d33   0a                LDN 10              ; D = promotion type (0 if none)
   0d34   c2 0d 54          LBZ UM_HASH_NOT_PROMO
                        
                            ; Promotion: XOR out [promoted_piece, to]
                            ; Get color from BOARD[from] (the pawn), combine with promotion type
   0d37   68 ca 64 09       RLDI 10, UNDO_FROM
   0d3b   0a                LDN 10              ; D = from_square
   0d3c   fc 00             ADI LOW(BOARD)
   0d3e   aa                PLO 10
   0d3f   f8 60             LDI HIGH(BOARD)
   0d41   7c 00             ADCI 0
   0d43   ba                PHI 10              ; R10 = &BOARD[from_square]
   0d44   0a                LDN 10              ; D = pawn
   0d45   fa 08             ANI COLOR_MASK      ; Get color
   0d47   a8                PLO 8               ; R8.0 = color (temp)
   0d48   68 ca 64 04       RLDI 10, UNDO_PROMOTION
   0d4c   0a                LDN 10              ; D = promotion piece type
   0d4d   52                STR 2               ; Save on stack
   0d4e   88                GLO 8               ; D = color
   0d4f   f4                ADD                 ; D = color + promotion_type = promoted piece
   0d50   a8                PLO 8               ; R8.0 = promoted piece
   0d51   c0 0d 63          LBR UM_HASH_GOT_PIECE
                        
   0d54                 UM_HASH_NOT_PROMO:
                            ; Normal move: XOR out [moving piece, to]
                            ; Moving piece is now at BOARD[UNDO_FROM]
   0d54   68 ca 64 09       RLDI 10, UNDO_FROM
   0d58   0a                LDN 10              ; D = from_square
   0d59   fc 00             ADI LOW(BOARD)
   0d5b   aa                PLO 10
   0d5c   f8 60             LDI HIGH(BOARD)
   0d5e   7c 00             ADCI 0
   0d60   ba                PHI 10              ; R10 = &BOARD[from_square]
   0d61   0a                LDN 10              ; D = moving piece
   0d62   a8                PLO 8               ; R8.0 = moving piece
                        
   0d63                 UM_HASH_GOT_PIECE:
                            ; Get to square
   0d63   68 ca 64 0a       RLDI 10, UNDO_TO
   0d67   0a                LDN 10              ; D = to_square
   0d68   b8                PHI 8               ; R8.1 = to_square
   0d69   d4 58 c6          CALL HASH_XOR_PIECE_SQ
                        
                            ; --- Step 2: XOR in [captured, captured_square] ---
                            ; For normal captures: captured_square = to
                            ; For EP captures: captured_square = (from_rank | to_file)
   0d6c   68 ca 64 08       RLDI 10, UNDO_CAPTURED
   0d70   0a                LDN 10              ; D = captured piece
   0d71   a8                PLO 8               ; R8.0 = captured piece
   0d72   68 ca 64 ff       RLDI 10, UNDO_CAP_SQ
   0d76   0a                LDN 10              ; D = capture square
   0d77   b8                PHI 8               ; R8.1 = capture square
   0d78   d4 58 c6          CALL HASH_XOR_PIECE_SQ  ; skips if captured == EMPTY
                        
                            ; --- Step 3: XOR in [moving piece, from] ---
                            ; Moving piece is at BOARD[UNDO_FROM]
   0d7b   68 ca 64 09       RLDI 10, UNDO_FROM
   0d7f   0a                LDN 10              ; D = from_square
   0d80   b8                PHI 8               ; R8.1 = from_square
                            ; Compute BOARD[from_square]
   0d81   fc 00             ADI LOW(BOARD)
   0d83   aa                PLO 10
   0d84   f8 60             LDI HIGH(BOARD)
   0d86   7c 00             ADCI 0
   0d88   ba                PHI 10              ; R10 = &BOARD[from_square]
   0d89   0a                LDN 10              ; D = moving piece
   0d8a   a8                PLO 8               ; R8.0 = moving piece
   0d8b   d4 58 c6          CALL HASH_XOR_PIECE_SQ
                        
                            ; --- Step 4: XOR side ---
   0d8e   d4 59 29          CALL HASH_XOR_SIDE
                        
   0d91   d5                SEP 5
                        
                        ; ==============================================================================
                        ; NULL_MAKE_MOVE - Make a null move (pass - just toggle side)
                        ; ==============================================================================
                        ; Used by null move pruning. No actual piece moves.
                        ; Input: None
                        ; Output: Side toggled, hash updated, EP cleared
                        ; Saves: EP square to NULL_SAVED_EP for unmake
                        ; ==============================================================================
   0d92                 NULL_MAKE_MOVE:
                            ; Save EP square to NULL_SAVED_EP
   0d92   68 ca 60 82       RLDI 10, GAME_STATE + STATE_EP_SQUARE
   0d96   0a                LDN 10              ; D = current EP square
   0d97   a7                PLO 7               ; Save in R7.0
   0d98   68 ca 64 a8       RLDI 10, NULL_SAVED_EP
   0d9c   87                GLO 7
   0d9d   5a                STR 10              ; NULL_SAVED_EP = old EP
                        
                            ; Clear EP square (no EP after null move)
   0d9e   68 ca 60 82       RLDI 10, GAME_STATE + STATE_EP_SQUARE
   0da2   f8 ff             LDI $FF             ; Invalid EP
   0da4   5a                STR 10
                        
                            ; Toggle side to move
   0da5   68 ca 60 80       RLDI 10, GAME_STATE + STATE_SIDE_TO_MOVE
   0da9   0a                LDN 10
   0daa   fb 08             XRI $08             ; Toggle 0 <-> 8
   0dac   5a                STR 10
                        
                            ; Update hash for side change
   0dad   d4 59 29          CALL HASH_XOR_SIDE
                        
   0db0   d5                RETN
                        
                        ; ==============================================================================
                        ; NULL_UNMAKE_MOVE - Undo a null move
                        ; ==============================================================================
                        ; Restores state from before null move
                        ; Input: None
                        ; Output: Side toggled back, hash restored, EP restored
                        ; ==============================================================================
   0db1                 NULL_UNMAKE_MOVE:
                            ; Toggle side back
   0db1   68 ca 60 80       RLDI 10, GAME_STATE + STATE_SIDE_TO_MOVE
   0db5   0a                LDN 10
   0db6   fb 08             XRI $08             ; Toggle 8 <-> 0
   0db8   5a                STR 10
                        
                            ; Restore EP square from NULL_SAVED_EP
   0db9   68 ca 64 a8       RLDI 10, NULL_SAVED_EP
   0dbd   0a                LDN 10              ; D = saved EP
   0dbe   a7                PLO 7               ; Save in R7.0
   0dbf   68 ca 60 82       RLDI 10, GAME_STATE + STATE_EP_SQUARE
   0dc3   87                GLO 7
   0dc4   5a                STR 10              ; Restore EP
                        
                            ; Update hash for side change (XOR again = restore)
   0dc5   d4 59 29          CALL HASH_XOR_SIDE
                        
   0dc8   d5                RETN
                        
                        ; ==============================================================================
                        ; END OF MAKE/UNMAKE MODULE
                        ; ==============================================================================
                        ; ==============================================================================
                        ; RCA 1802/1806 Chess Engine - Position Evaluation
                        ; ==============================================================================
                        ; Evaluate board position and return score
                        ; Positive score favors white, negative favors black
                        ; ==============================================================================
                        
                        ; ------------------------------------------------------------------------------
                        ; Piece Values (in centipawns)
                        ; ------------------------------------------------------------------------------
   0064                 PAWN_VALUE      EQU 100
   0140                 KNIGHT_VALUE    EQU 320
   014a                 BISHOP_VALUE    EQU 330
   01f4                 ROOK_VALUE      EQU 500
   0384                 QUEEN_VALUE     EQU 900
   4e20                 KING_VALUE      EQU 20000   ; Effectively infinite (not used in material count)
                        
                        ; Check bonus: credit the attacker when side-to-move is in check.
                        ; Applied at EVAL exit — rewards moves that deliver check, encourages
                        ; attacking play (especially with queen) in endgame mate-chasing.
   0028                 CHECK_BONUS     EQU 40
                        
                        ; King-safety v3 tables (2026-07-03). v2's STORM_PEN + DEFENSE_CREDIT and the
                        ; QUEEN_PROX_BONUS term are RETIRED (fork 2): offense credit is now luft-gated
                        ; inside KING_SAFETY_V3; queen activity is QUEEN_MOBILITY's job.
                        ; SHIELD_PEN kept, indexed by shield_missing (0-3), now pressure-gated.
   0dc9                 SHIELD_PEN:
   0dc9   00 19 3c 64       DB 0, 25, 60, 100       ; missing 0,1,2,3 shield pawns
                        ; DANGER_V3_TABLE[(pressure<<3) | luft]: rows = clamped pressure 0-3 (Q=2,R=1),
                        ; cols = luft 0-7 (SATURATED 8->7). STEEP by design — probe #1 requires a safe
                        ; castled king (luft 1-2, wandering enemy queen) to read ~0; weight lives at
                        ; luft 0-1. Entries <= 155 so SHIELD_PEN(max 100) + entry always fits one byte.
                        ; This is THE tuning surface: edit these 32 bytes, re-probe, repeat.
   0dcd                 DANGER_V3_TABLE:
   0dcd   00 00 00 00       DB   0,  0,  0,  0,  0, 0, 0, 0  ; pressure 0 (unreachable: short-circuited)
   0dd1   00 00 00 00   
   0dd5   28 14 05 00       DB  40, 20,  5,  0,  0, 0, 0, 0  ; pressure 1 (lone rook)
   0dd9   00 00 00 00   
   0ddd   5a 32 0f 05       DB  90, 50, 15,  5,  0, 0, 0, 0  ; pressure 2 (lone queen / two rooks — STEEP:
   0de1   00 00 00 00   
                                                             ;  this row is the castled-king false-positive
                                                             ;  surface; weight stays at luft 0-1 only)
   0de5   96 64 46 28       DB 150,100, 70, 40, 10, 0, 0, 0  ; pressure 3 (queen + rook(s) bearing = nearly
   0de9   0a 00 00 00   
                                                             ;  always a REAL attack; mid-luft raised after
                                                             ;  probe 2 read the 7/3 storm too lightly)
                        ; Enemy piece-square pointer table for the v3 pressure loop (big-endian DW,
                        ; read LDA-hi/LDA-lo). Order queen, rook1, rook2 (weight decided by phase).
   0ded                 KSV_PTAB:
   0ded   67 20 64 ab       DW W_QUEEN_SQ, EVAL_W_ROOK_SQ1, EVAL_W_ROOK_SQ2   ; enemy set when friendly=BLACK
   0df1   64 ac         
   0df3   67 21 64 ad       DW B_QUEEN_SQ, EVAL_B_ROOK_SQ1, EVAL_B_ROOK_SQ2   ; enemy set when friendly=WHITE
   0df7   64 ae         
   0df9                 KSV_COLOR:
   0df9   00                DB 0                    ; KING_SAFETY_V3 private scratch: friendly color of call
                        ; Racing-passer bonus (2026-06-13): EXTRA value for an advanced white passer with a
                        ; clear front, ramping toward queen value so white pushes it (the d5 search can't
                        ; see the promotion). Indexed by rank-5/6/7. 16-bit (big-endian DW) — > one byte.
   0dfa                 RUNNER_BONUS:
   0dfa   00 96 01 5e       DW 150, 350, 600       ; rank 5, rank 6, rank 7
   0dfe   02 58         
                        
                        ; Piece value table (indexed by piece type 0-6)
   0e00                 PIECE_VALUES:
   0e00   00 00             DW 0            ; Empty (type 0)
   0e02   00 64             DW 100          ; Pawn (type 1)
   0e04   01 40             DW 320          ; Knight (type 2)
   0e06   01 4a             DW 330          ; Bishop (type 3)
   0e08   01 f4             DW 500          ; Rook (type 4)
   0e0a   03 84             DW 900          ; Queen (type 5)
   0e0c   00 00             DW 0            ; King (type 6) - don't count in material
                        
                        ; ------------------------------------------------------------------------------
                        ; EVALUATE - Main evaluation function
                        ; ------------------------------------------------------------------------------
                        ; Input:  A = board pointer (BOARD)
                        ; Output: R9 = evaluation score (16-bit signed)
                        ;         Positive = white advantage
                        ;         Negative = black advantage
                        ; NOTE:   Returns in R9, NOT R6! R6 is SCRT linkage register - off limits!
                        ; Uses:   All registers except R6
                        ;
                        ; Components (in order of implementation):
                        ;   1. Material count (DONE)
                        ;   2. Piece-square tables (TODO)
                        ;   3. Pawn structure (TODO)
                        ;   4. King safety (TODO)
                        ;   5. Mobility (TODO)
                        ; ------------------------------------------------------------------------------
                        
                        ; ------------------------------------------------------------------------------
                        ; CHECK_INSUFFICIENT_MATERIAL - Detect the canonical dead-draw material configs
                        ; ------------------------------------------------------------------------------
                        ; Returns D = 1 if the position is one of:
                        ;   K vs K, K+N vs K, K+B vs K, K+B vs K+B (bishops on same square colour)
                        ; else D = 0.  These are the four cases where neither side can force mate
                        ; (item C — added 2026-05-18).  Returning 0 from EVALUATE for these stops the
                        ; engine meandering in drawn endgames until the 50-move rule.
                        ;
                        ; Scans BOARD once, early-aborting to "not draw" the moment a pawn, rook, or
                        ; queen is seen, or when the minor count exceeds 2.  In any position with
                        ; pawns/rooks/queens (every opening/middlegame) the very first occupied square
                        ; aborts the scan, so cost is ~1 iteration in normal play; only true bare-king
                        ; endgames pay the full 128-square walk.
                        ;
                        ; Provably safe for non-drawn positions: the short-circuit only fires when
                        ; material is EXACTLY one of the four configs above. Any pawn/rook/queen or a
                        ; 3rd minor falls through untouched — cannot alter winning/losing eval.
                        ;
                        ; Uses: R7 (sq index), R8 (piece + type/sqcolor scratch), R10 (board ptr),
                        ;       R11 (.0=minor total, .1=white bishop count),
                        ;       R13 (.0=black bishop count, .1=bishop sq-colour bits)
                        ; Does NOT touch R6 (SCRT) or R9 (caller score, not yet set at call site).
                        ; ------------------------------------------------------------------------------
   0e0e                 CHECK_INSUFFICIENT_MATERIAL:
   0e0e   f8 00             LDI 0
   0e10   ab                PLO 11              ; R11.0 = minor total (bishops + knights)
   0e11   bb                PHI 11              ; R11.1 = white bishop count
   0e12   ad                PLO 13              ; R13.0 = black bishop count
   0e13   bd                PHI 13              ; R13.1 = bishop sq-colour bits (b0=W, b1=B)
                        
   0e14   f8 00             LDI 0
   0e16   a7                PLO 7               ; R7.0 = square index 0
                        
   0e17                 CIM_LOOP:
   0e17   87                GLO 7
   0e18   fa 88             ANI $88
   0e1a   ca 0e 82          LBNZ CIM_NEXT       ; off-board 0x88 square, skip
                        
                            ; R10 = BOARD + sq
   0e1d   87                GLO 7
   0e1e   fc 00             ADI LOW(BOARD)
   0e20   aa                PLO 10
   0e21   f8 60             LDI HIGH(BOARD)
   0e23   7c 00             ADCI 0
   0e25   ba                PHI 10
   0e26   0a                LDN 10              ; D = piece
   0e27   c2 0e 82          LBZ CIM_NEXT        ; empty square
                        
   0e2a   a8                PLO 8               ; R8.0 = full piece byte (kept all loop)
   0e2b   fa 07             ANI PIECE_MASK      ; D = piece type 1-6
   0e2d   b8                PHI 8               ; R8.1 = piece type
                        
   0e2e   fb 06             XRI KING_TYPE       ; king? (always present, never counted)
   0e30   c2 0e 82          LBZ CIM_NEXT
                        
   0e33   98                GHI 8               ; type
   0e34   fb 01             XRI PAWN_TYPE
   0e36   c2 0e b1          LBZ CIM_NOT_DRAW    ; any pawn → not insufficient
   0e39   98                GHI 8
   0e3a   fb 04             XRI ROOK_TYPE
   0e3c   c2 0e b1          LBZ CIM_NOT_DRAW    ; any rook → not insufficient
   0e3f   98                GHI 8
   0e40   fb 05             XRI QUEEN_TYPE
   0e42   c2 0e b1          LBZ CIM_NOT_DRAW    ; any queen → not insufficient
                        
                            ; piece is a minor (knight=2 or bishop=3)
   0e45   8b                GLO 11
   0e46   fc 01             ADI 1
   0e48   ab                PLO 11              ; minor total++
   0e49   ff 03             SMI 3
   0e4b   c3 0e b1          LBDF CIM_NOT_DRAW   ; >=3 minors → not one of the four cases
                        
   0e4e   98                GHI 8               ; type
   0e4f   fb 03             XRI BISHOP_TYPE
   0e51   ca 0e 82          LBNZ CIM_NEXT       ; knight — counted in total, nothing more
                        
                            ; --- bishop: compute its square colour = ((sq>>4)+(sq&7)) & 1 ---
   0e54   87                GLO 7
   0e55   fa 07             ANI $07             ; file
   0e57   52                STR 2               ; M(R2) = file
   0e58   87                GLO 7
   0e59   f6                SHR
   0e5a   f6                SHR
   0e5b   f6                SHR
   0e5c   f6                SHR                 ; D = sq>>4 = rank (valid sq → high nibble 0-7)
   0e5d   f4                ADD                 ; D = rank + file
   0e5e   fa 01             ANI $01             ; D = square colour 0/1
   0e60   b8                PHI 8               ; R8.1 = square colour
                        
   0e61   88                GLO 8               ; full piece byte
   0e62   fa 08             ANI COLOR_MASK      ; 0 = white bishop, 8 = black bishop
   0e64   ca 0e 76          LBNZ CIM_BLACK_B
                        
                            ; white bishop
   0e67   9b                GHI 11
   0e68   fc 01             ADI 1
   0e6a   bb                PHI 11              ; white bishop count++
   0e6b   98                GHI 8               ; square colour
   0e6c   c2 0e 82          LBZ CIM_NEXT        ; colour 0 → leave bit0 clear
   0e6f   9d                GHI 13
   0e70   f9 01             ORI $01
   0e72   bd                PHI 13              ; bit0 = white bishop on colour-1 square
   0e73   c0 0e 82          LBR CIM_NEXT
                        
   0e76                 CIM_BLACK_B:
   0e76   8d                GLO 13
   0e77   fc 01             ADI 1
   0e79   ad                PLO 13              ; black bishop count++
   0e7a   98                GHI 8               ; square colour
   0e7b   c2 0e 82          LBZ CIM_NEXT
   0e7e   9d                GHI 13
   0e7f   f9 02             ORI $02
   0e81   bd                PHI 13              ; bit1 = black bishop on colour-1 square
                        
   0e82                 CIM_NEXT:
   0e82   87                GLO 7
   0e83   fc 01             ADI 1
   0e85   a7                PLO 7
   0e86   fb 80             XRI $80             ; scanned squares 0..127?
   0e88   ca 0e 17          LBNZ CIM_LOOP
                        
                            ; --- decision ---
   0e8b   8b                GLO 11              ; minor total
   0e8c   c2 0e ae          LBZ CIM_DRAW        ; 0 minors → K vs K
   0e8f   ff 01             SMI 1
   0e91   c2 0e ae          LBZ CIM_DRAW        ; 1 minor  → K+N vs K or K+B vs K (either side)
                        
                            ; minor total == 2 (>=3 already rejected mid-scan).
                            ; Draw only if exactly one bishop per side AND same square colour.
   0e94   9b                GHI 11              ; white bishop count
   0e95   ff 01             SMI 1
   0e97   ca 0e b1          LBNZ CIM_NOT_DRAW   ; != 1
   0e9a   8d                GLO 13              ; black bishop count
   0e9b   ff 01             SMI 1
   0e9d   ca 0e b1          LBNZ CIM_NOT_DRAW   ; != 1
   0ea0   9d                GHI 13
   0ea1   fa 03             ANI $03             ; b0=white sqcolour, b1=black sqcolour
   0ea3   c2 0e ae          LBZ CIM_DRAW        ; 00 → both colour-0 → same → draw
   0ea6   fb 03             XRI $03
   0ea8   c2 0e ae          LBZ CIM_DRAW        ; 11 → both colour-1 → same → draw
   0eab   c0 0e b1          LBR CIM_NOT_DRAW    ; 01/10 → opposite colours (not in item-C list)
                        
   0eae                 CIM_DRAW:
   0eae   f8 01             LDI 1
   0eb0   d5                RETN
                        
   0eb1                 CIM_NOT_DRAW:
   0eb1   f8 00             LDI 0
   0eb3   d5                RETN
                        
                        ; ------------------------------------------------------------------------------
   0eb4                 EVALUATE:
                            ; Ensure X=2 for all stack/memory operations
   0eb4   e2                SEX 2
                        
   0eb5   68 ca 64 1d       RLDI 10, TRACE_WHERE
   0eb9   f8 e1             LDI $E1
   0ebb   5a                STR 10              ; tracer: in EVALUATE
                        
                            ; Insufficient-material dead-draw short-circuit (item C, 2026-05-18).
                            ; Safe by construction: only fires for K-K / K+N-K / K+B-K / K+B-K+B
                            ; same-colour; any other material falls through to the full eval.
   0ebc   d4 0e 0e          CALL CHECK_INSUFFICIENT_MATERIAL
   0ebf   c2 0e c7          LBZ EVAL_NOT_DEAD_DRAW
   0ec2   f8 00             LDI 0
   0ec4   b9                PHI 9
   0ec5   a9                PLO 9              ; R9 = 0 (draw)
   0ec6   d5                RETN
   0ec7                 EVAL_NOT_DEAD_DRAW:
                        
                            ; Initialize score to 0
                            ; NOTE: Use R9 for score, NOT R6! R6 is SCRT linkage register!
   0ec7   f8 00             LDI 0
   0ec9   b9                PHI 9
   0eca   a9                PLO 9              ; R9 = 0 (score accumulator)
                        
                            ; Scan board and count material
   0ecb   68 ca 60 00       RLDI 10, BOARD
                        
                            ; Initialize square counter in memory (avoid R14!)
   0ecf   68 cd 64 1d       RLDI 13, EVAL_SQ_INDEX
   0ed3   f8 00             LDI 0
   0ed5   5d                STR 13              ; EVAL_SQ_INDEX = 0
                        
                            ; Initialize piece counter in memory (D is still 0)
   0ed6   68 cb 64 ec       RLDI 11, EG_PIECE_COUNT
   0eda   5b                STR 11              ; EG_PIECE_COUNT = 0
                        
                            ; Initialize advanced pawn counters (D is still 0)
   0edb   68 cb 64 fd       RLDI 11, ADV_PAWN_W
   0edf   5b                STR 11              ; ADV_PAWN_W = 0
   0ee0   1b                INC 11
   0ee1   5b                STR 11              ; ADV_PAWN_B = 0
                        
                            ; Initialize pawn file counts: 16 bytes at $6710-$671F (D is still 0)
   0ee2   68 cb 67 10       RLDI 11, W_PAWN_FILE_CT
   0ee6   f8 10             LDI 16              ; 16 bytes to clear
   0ee8   a8                PLO 8               ; R8.0 = loop counter
   0ee9                 EVAL_CLR_PAWN_CT:
   0ee9   f8 00             LDI 0
   0eeb   5b                STR 11
   0eec   1b                INC 11
   0eed   28                DEC 8
   0eee   88                GLO 8
   0eef   ca 0e e9          LBNZ EVAL_CLR_PAWN_CT
                        
                            ; Initialize bishop counts + rook file trackers + queen counts
   0ef2   f8 00             LDI 0
   0ef4   68 cb 64 af       RLDI 11, EVAL_W_BISHOPS
   0ef8   5b                STR 11              ; EVAL_W_BISHOPS = 0
   0ef9   1b                INC 11
   0efa   5b                STR 11              ; EVAL_B_BISHOPS = 0
   0efb   68 cb 64 b5       RLDI 11, W_QUEEN_CNT
   0eff   5b                STR 11              ; W_QUEEN_CNT = 0
   0f00   1b                INC 11
   0f01   5b                STR 11              ; B_QUEEN_CNT = 0
   0f02   1b                INC 11
   0f03   5b                STR 11              ; PIECE_BALANCE = 0 ($64B7, signed W-B non-pawn count; D still 0)
                            ; Rook files = $FF (no rook); queen squares also default to $FF (no queen).
                            ; v3 (2026-07-03): rook SQUARES also reset to $FF so KING_SAFETY_V3's
                            ; pressure loop can gate every piece read on one uniform $FF sentinel
                            ; (removes the latent a8-square trap the spec flagged).
   0f04   f8 ff             LDI $FF
   0f06   68 cb 64 ab       RLDI 11, EVAL_W_ROOK_SQ1
   0f0a   5b                STR 11              ; EVAL_W_ROOK_SQ1 = $FF
   0f0b   1b                INC 11
   0f0c   5b                STR 11              ; EVAL_W_ROOK_SQ2 = $FF
   0f0d   1b                INC 11
   0f0e   5b                STR 11              ; EVAL_B_ROOK_SQ1 = $FF
   0f0f   1b                INC 11
   0f10   5b                STR 11              ; EVAL_B_ROOK_SQ2 = $FF
   0f11   68 cb 64 b1       RLDI 11, EVAL_W_ROOK_F1
   0f15   5b                STR 11              ; EVAL_W_ROOK_F1 = $FF
   0f16   1b                INC 11
   0f17   5b                STR 11              ; EVAL_W_ROOK_F2 = $FF
   0f18   1b                INC 11
   0f19   5b                STR 11              ; EVAL_B_ROOK_F1 = $FF
   0f1a   1b                INC 11
   0f1b   5b                STR 11              ; EVAL_B_ROOK_F2 = $FF
   0f1c   68 cb 67 20       RLDI 11, W_QUEEN_SQ
   0f20   5b                STR 11              ; W_QUEEN_SQ = $FF
   0f21   1b                INC 11
   0f22   5b                STR 11              ; B_QUEEN_SQ = $FF
                        
   0f23                 EVAL_SCAN:
                            ; Check if square is valid (R13 points to EVAL_SQ_INDEX)
   0f23   0d                LDN 13
   0f24   fa 88             ANI $88
   0f26   ca 10 bc          LBNZ EVAL_NEXT_SQUARE
                        
                            ; Load piece at square
   0f29   0a                LDN 10
   0f2a   c2 10 bc          LBZ EVAL_NEXT_SQUARE ; Empty square
                        
                            ; Get piece type and color
                            ; NOTE: R13 must stay pointing to EVAL_SQ_INDEX - use R8 for piece temp!
   0f2d   a8                PLO 8               ; R8.0 = piece (temp storage)
                        
                            ; Check color
   0f2e   fa 08             ANI COLOR_MASK
   0f30   af                PLO 15              ; F.0 = color (0=white, 8=black)
                        
                            ; Get piece type
   0f31   88                GLO 8               ; Get piece back from R8.0
   0f32   fa 07             ANI PIECE_MASK
   0f34   a8                PLO 8               ; R8.0 = piece type (1-6)
                        
                            ; Skip king (type 6)
   0f35   fb 06             XRI 6
   0f37   c2 10 bc          LBZ EVAL_NEXT_SQUARE
                        
                            ; Count non-king piece (memory variable — R12 is side-to-move, off limits)
   0f3a   68 cb 64 ec       RLDI 11, EG_PIECE_COUNT
   0f3e   0b                LDN 11
   0f3f   fc 01             ADI 1
   0f41   5b                STR 11
                        
                            ; Accumulate SIGNED non-pawn piece balance (W-B) for the white RUNNER_BONUS gate
                            ; (2026-06-30). type in R8.0 (1-5; king already skipped), color in R15. White N/B/R/Q
                            ; -> +1, black -> -1. R11/D clobbered (both reloaded below).
   0f42   88                GLO 8
   0f43   ff 02             SMI 2               ; type - 2  (DF=0 if type < 2, i.e. pawn)
   0f45   cb 0f 5b          LBNF EVAL_PB_DONE   ; pawn -> not a piece, skip
   0f48   68 cb 64 b7       RLDI 11, PIECE_BALANCE
   0f4c   8f                GLO 15              ; color (0=white, 8=black)
   0f4d   ca 0f 57          LBNZ EVAL_PB_BLACK  ; black -> decrement
   0f50   0b                LDN 11              ; white: balance + 1
   0f51   fc 01             ADI 1
   0f53   5b                STR 11
   0f54   c0 0f 5b          LBR EVAL_PB_DONE
   0f57                 EVAL_PB_BLACK:
   0f57   0b                LDN 11              ; black: balance - 1
   0f58   ff 01             SMI 1
   0f5a   5b                STR 11
   0f5b                 EVAL_PB_DONE:
                        
                            ; Check if pawn for advanced pawn bonus (graduated)
   0f5b   88                GLO 8               ; piece type (1-5)
   0f5c   fb 01             XRI 1
   0f5e   ca 0f d8          LBNZ EVAL_NOT_ADV_PAWN  ; not a pawn (+3 instr for non-pawns)
                            ; Pawn — extract rank from 0x88 square
   0f61   0d                LDN 13              ; D = 0x88 square (from EVAL_SQ_INDEX)
   0f62   fa 70             ANI $70             ; D = rank << 4 ($00-$70)
   0f64   52                STR 2               ; save rank<<4 on stack
   0f65   8f                GLO 15              ; D = color (0=white, 8=black)
   0f66   ca 0f a2          LBNZ EVAL_BP_ADV
                            ; === White pawn: rank 7=$60 (+150), rank 6=$50 (+100), rank 5=$40 (+50), rank 4=$30 (+25) ===
   0f69   02                LDN 2
   0f6a   fb 60             XRI $60
   0f6c   c2 0f 8b          LBZ EVAL_WP_R7
   0f6f   02                LDN 2
   0f70   fb 50             XRI $50
   0f72   c2 0f 90          LBZ EVAL_WP_R6
   0f75   02                LDN 2
   0f76   fb 40             XRI $40
   0f78   c2 0f 86          LBZ EVAL_WP_R5
   0f7b   02                LDN 2
   0f7c   fb 30             XRI $30
   0f7e   ca 0f d8          LBNZ EVAL_NOT_ADV_PAWN
   0f81   f8 19             LDI 25              ; rank 4
   0f83   c0 0f 92          LBR EVAL_WP_ADD
   0f86                 EVAL_WP_R5:
   0f86   f8 32             LDI 50              ; rank 5
   0f88   c0 0f 92          LBR EVAL_WP_ADD
   0f8b                 EVAL_WP_R7:
   0f8b   f8 96             LDI 150             ; rank 7
   0f8d   c0 0f 92          LBR EVAL_WP_ADD
   0f90                 EVAL_WP_R6:
   0f90   f8 64             LDI 100             ; rank 6
   0f92                 EVAL_WP_ADD:
   0f92   52                STR 2
   0f93   68 cb 64 fd       RLDI 11, ADV_PAWN_W
   0f97   0b                LDN 11
   0f98   f4                ADD
   0f99   cb 0f 9e          LBNF EVAL_WP_NOSAT  ; DF=0: no carry, no overflow
   0f9c   f8 ff             LDI 255             ; Overflow: saturate at 255
   0f9e                 EVAL_WP_NOSAT:
   0f9e   5b                STR 11              ; ADV_PAWN_W = min(sum, 255)
   0f9f   c0 0f d8          LBR EVAL_NOT_ADV_PAWN
   0fa2                 EVAL_BP_ADV:
                            ; === Black pawn: rank 2=$10 (+150), rank 3=$20 (+100), rank 4=$30 (+50), rank 5=$40 (+25) ===
   0fa2   02                LDN 2
   0fa3   fb 10             XRI $10
   0fa5   c2 0f c4          LBZ EVAL_BP_R2
   0fa8   02                LDN 2
   0fa9   fb 20             XRI $20
   0fab   c2 0f c9          LBZ EVAL_BP_R3
   0fae   02                LDN 2
   0faf   fb 30             XRI $30
   0fb1   c2 0f bf          LBZ EVAL_BP_R4
   0fb4   02                LDN 2
   0fb5   fb 40             XRI $40
   0fb7   ca 0f d8          LBNZ EVAL_NOT_ADV_PAWN
   0fba   f8 19             LDI 25              ; rank 5
   0fbc   c0 0f cb          LBR EVAL_BP_ADD
   0fbf                 EVAL_BP_R4:
   0fbf   f8 32             LDI 50              ; rank 4
   0fc1   c0 0f cb          LBR EVAL_BP_ADD
   0fc4                 EVAL_BP_R2:
   0fc4   f8 96             LDI 150             ; rank 2
   0fc6   c0 0f cb          LBR EVAL_BP_ADD
   0fc9                 EVAL_BP_R3:
   0fc9   f8 64             LDI 100             ; rank 3
   0fcb                 EVAL_BP_ADD:
   0fcb   52                STR 2
   0fcc   68 cb 64 fe       RLDI 11, ADV_PAWN_B
   0fd0   0b                LDN 11
   0fd1   f4                ADD
   0fd2   cb 0f d7          LBNF EVAL_BP_NOSAT  ; DF=0: no carry, no overflow
   0fd5   f8 ff             LDI 255             ; Overflow: saturate at 255
   0fd7                 EVAL_BP_NOSAT:
   0fd7   5b                STR 11              ; ADV_PAWN_B = min(sum, 255)
   0fd8                 EVAL_NOT_ADV_PAWN:
                        
                            ; ==================================================================
                            ; Track pawn files, bishop count, rook files for structure eval
                            ; R8.0 = piece type (1-6), R15.0 = color, R13 -> EVAL_SQ_INDEX
                            ; ==================================================================
                        
                            ; --- PAWN: increment per-file count ---
   0fd8   88                GLO 8               ; piece type
   0fd9   fb 01             XRI 1               ; pawn?
   0fdb   ca 10 03          LBNZ EVAL_NOT_PAWN_TRACK
   0fde   0d                LDN 13              ; D = 0x88 square
   0fdf   fa 07             ANI $07             ; D = file (0-7)
   0fe1   52                STR 2               ; save file on stack
   0fe2   8f                GLO 15              ; color
   0fe3   ca 0f f6          LBNZ EVAL_BP_COUNT
                            ; White pawn: W_PAWN_FILE_CT[file]++
   0fe6   02                LDN 2               ; D = file
   0fe7   fc 10             ADI LOW(W_PAWN_FILE_CT)
   0fe9   ab                PLO 11
   0fea   f8 67             LDI HIGH(W_PAWN_FILE_CT)
   0fec   7c 00             ADCI 0
   0fee   bb                PHI 11              ; R11 = &W_PAWN_FILE_CT[file]
   0fef   0b                LDN 11
   0ff0   fc 01             ADI 1
   0ff2   5b                STR 11
   0ff3   c0 10 03          LBR EVAL_NOT_PAWN_TRACK
   0ff6                 EVAL_BP_COUNT:
                            ; Black pawn: B_PAWN_FILE_CT[file]++
   0ff6   02                LDN 2               ; D = file
   0ff7   fc 18             ADI LOW(B_PAWN_FILE_CT)
   0ff9   ab                PLO 11
   0ffa   f8 67             LDI HIGH(B_PAWN_FILE_CT)
   0ffc   7c 00             ADCI 0
   0ffe   bb                PHI 11              ; R11 = &B_PAWN_FILE_CT[file]
   0fff   0b                LDN 11
   1000   fc 01             ADI 1
   1002   5b                STR 11
   1003                 EVAL_NOT_PAWN_TRACK:
                        
                            ; --- BISHOP: count per color ---
   1003   88                GLO 8               ; piece type
   1004   fb 03             XRI 3               ; bishop?
   1006   ca 10 20          LBNZ EVAL_NOT_BISHOP_TRACK
   1009   8f                GLO 15              ; color
   100a   ca 10 18          LBNZ EVAL_BB_TRACK
   100d   68 cb 64 af       RLDI 11, EVAL_W_BISHOPS
   1011   0b                LDN 11
   1012   fc 01             ADI 1
   1014   5b                STR 11
   1015   c0 10 20          LBR EVAL_NOT_BISHOP_TRACK
   1018                 EVAL_BB_TRACK:
   1018   68 cb 64 b0       RLDI 11, EVAL_B_BISHOPS
   101c   0b                LDN 11
   101d   fc 01             ADI 1
   101f   5b                STR 11
   1020                 EVAL_NOT_BISHOP_TRACK:
                        
                            ; --- ROOK: save file number (up to 2 per side) ---
   1020   88                GLO 8               ; piece type
   1021   fb 04             XRI 4               ; rook?
   1023   ca 10 73          LBNZ EVAL_NOT_ROOK_TRACK
   1026   0d                LDN 13              ; 0x88 square
   1027   fa 07             ANI $07             ; D = file (0-7)
   1029   b8                PHI 8               ; save file in R8.1
   102a   8f                GLO 15              ; color
   102b   ca 10 52          LBNZ EVAL_BROOK_TRACK
                            ; White rook: store in F1 or F2
   102e   68 cb 64 b1       RLDI 11, EVAL_W_ROOK_F1
   1032   0b                LDN 11
   1033   fb ff             XRI $FF             ; is F1 empty?
   1035   ca 10 43          LBNZ EVAL_WR_F2
   1038   98                GHI 8               ; D = file
   1039   5b                STR 11              ; F1 = file
   103a   68 cb 64 ab       RLDI 11, EVAL_W_ROOK_SQ1
   103e   0d                LDN 13              ; D = 0x88 square (R13 -> EVAL_SQ_INDEX, read-only)
   103f   5b                STR 11              ; SQ1 = square (king-safety v3)
   1040   c0 10 73          LBR EVAL_NOT_ROOK_TRACK
   1043                 EVAL_WR_F2:
   1043   68 cb 64 b2       RLDI 11, EVAL_W_ROOK_F2
   1047   98                GHI 8
   1048   5b                STR 11              ; F2 = file
   1049   68 cb 64 ac       RLDI 11, EVAL_W_ROOK_SQ2
   104d   0d                LDN 13              ; D = 0x88 square (R13 -> EVAL_SQ_INDEX, read-only)
   104e   5b                STR 11              ; SQ2 = square (king-safety v3)
   104f   c0 10 73          LBR EVAL_NOT_ROOK_TRACK
   1052                 EVAL_BROOK_TRACK:
                            ; Black rook: store in F1 or F2
   1052   68 cb 64 b3       RLDI 11, EVAL_B_ROOK_F1
   1056   0b                LDN 11
   1057   fb ff             XRI $FF
   1059   ca 10 67          LBNZ EVAL_BR_F2
   105c   98                GHI 8
   105d   5b                STR 11
   105e   68 cb 64 ad       RLDI 11, EVAL_B_ROOK_SQ1
   1062   0d                LDN 13              ; D = 0x88 square (R13 -> EVAL_SQ_INDEX, read-only)
   1063   5b                STR 11              ; SQ1 = square (king-safety v3)
   1064   c0 10 73          LBR EVAL_NOT_ROOK_TRACK
   1067                 EVAL_BR_F2:
   1067   68 cb 64 b4       RLDI 11, EVAL_B_ROOK_F2
   106b   98                GHI 8
   106c   5b                STR 11
   106d   68 cb 64 ae       RLDI 11, EVAL_B_ROOK_SQ2
   1071   0d                LDN 13              ; D = 0x88 square (R13 -> EVAL_SQ_INDEX, read-only)
   1072   5b                STR 11              ; SQ2 = square (king-safety v3)
   1073                 EVAL_NOT_ROOK_TRACK:
                        
                            ; --- QUEEN: count + remember square (for redundant-queen cap and proximity bonus) ---
   1073   88                GLO 8               ; piece type
   1074   fb 05             XRI 5               ; queen?
   1076   ca 10 9c          LBNZ EVAL_NOT_QUEEN_TRACK
   1079   8f                GLO 15              ; color
   107a   ca 10 8e          LBNZ EVAL_BQ_TRACK
                            ; White queen
   107d   68 cb 64 b5       RLDI 11, W_QUEEN_CNT
   1081   0b                LDN 11
   1082   fc 01             ADI 1
   1084   5b                STR 11
   1085   0d                LDN 13              ; current 0x88 square from EVAL_SQ_INDEX
   1086   68 cb 67 20       RLDI 11, W_QUEEN_SQ
   108a   5b                STR 11
   108b   c0 10 9c          LBR EVAL_NOT_QUEEN_TRACK
   108e                 EVAL_BQ_TRACK:
                            ; Black queen
   108e   68 cb 64 b6       RLDI 11, B_QUEEN_CNT
   1092   0b                LDN 11
   1093   fc 01             ADI 1
   1095   5b                STR 11
   1096   0d                LDN 13              ; current 0x88 square from EVAL_SQ_INDEX
   1097   68 cb 67 21       RLDI 11, B_QUEEN_SQ
   109b   5b                STR 11
   109c                 EVAL_NOT_QUEEN_TRACK:
                        
                            ; Get piece value from table
                            ; R8.0 = piece type (1-6), need to look up in PIECE_VALUES table
   109c   88                GLO 8               ; Piece type from R8.0
   109d   fe                SHL                 ; Multiply by 2 (16-bit table entries)
   109e   52                STR 2               ; Save offset to stack
   109f   f8 00             LDI LOW(PIECE_VALUES)
   10a1   f4                ADD                 ; D = LOW(PIECE_VALUES) + offset
   10a2   ab                PLO 11              ; R11.0 = low byte of address
   10a3   f8 0e             LDI HIGH(PIECE_VALUES)
   10a5   7c 00             ADCI 0              ; Add carry if low byte overflowed
   10a7   bb                PHI 11              ; R11 = PIECE_VALUES + (type * 2)
                        
                            ; Load 16-bit value
   10a8   4b                LDA 11
   10a9   b7                PHI 7              ; 7.1 = value high
   10aa   0b                LDN 11
   10ab   a7                PLO 7              ; 7.0 = value low
                                                ; 7 = piece value
                        
                            ; Add or subtract based on color
   10ac   8f                GLO 15              ; Color
   10ad   32 b2             BZ EVAL_ADD_WHITE
                        
   10af                 EVAL_ADD_BLACK:
                            ; Black piece - subtract from score (negate 7)
   10af   d4 00 0f          CALL NEG16_R7
                            ; Fall through to add
                        
   10b2                 EVAL_ADD_WHITE:
                            ; White piece or negated black - add to score
                            ; R9 = R9 + R7 (using R9 for score, not R6 which is SCRT linkage!)
   10b2   89                GLO 9
   10b3   52                STR 2
   10b4   87                GLO 7
   10b5   f4                ADD
   10b6   a9                PLO 9
   10b7   99                GHI 9
   10b8   52                STR 2
   10b9   97                GHI 7
   10ba   74                ADC
   10bb   b9                PHI 9
                            ; 6 updated with new score
                        
   10bc                 EVAL_NEXT_SQUARE:
   10bc   1a                INC 10              ; Next square
                            ; Increment square counter in memory (R13 still points to EVAL_SQ_INDEX)
   10bd   0d                LDN 13
   10be   fc 01             ADI 1
   10c0   5d                STR 13
   10c1   ff 80             SMI 128
   10c3   cb 0f 23          LBNF EVAL_SCAN      ; Continue if < 128 (DF=0 means borrow, i.e., D was < 128)
                        
   10c6                 EVAL_DONE:
                            ; R9 contains material score
                        
                            ; ==================================================================
                            ; Redundant-queen cap: extra queens beyond the first (per side) score
                            ; as 0 cp. Prevents the engine from preferring more pawn promotions
                            ; over delivering mate when it already has a queen — the eval bug
                            ; that caused yesterday's 3-queen shuffle endgame.
                            ; Implementation: subtract (W_QUEEN_CNT - 1) * 900 from white side,
                            ; add (B_QUEEN_CNT - 1) * 900 for black side.
                            ; ==================================================================
                        
                            ; --- White side ---
   10c6   68 c8 64 b5       RLDI 8, W_QUEEN_CNT
   10ca   08                LDN 8
   10cb   c2 10 e8          LBZ QC_W_DONE       ; 0 queens: nothing to cap
   10ce   ff 01             SMI 1
   10d0   c2 10 e8          LBZ QC_W_DONE       ; 1 queen: no extras
                        
   10d3   a7                PLO 7               ; R7.0 = number of extras (>= 1)
   10d4   f8 00             LDI 0
   10d6   b7                PHI 7               ; clean R7.1 for predictable DEC
                        
   10d7                 QC_W_LOOP:
   10d7   f8 84             LDI $84             ; low byte of 900 ($0384)
   10d9   52                STR 2
   10da   89                GLO 9
   10db   f7                SM
   10dc   a9                PLO 9
   10dd   f8 03             LDI $03             ; high byte of 900
   10df   52                STR 2
   10e0   99                GHI 9
   10e1   77                SMB
   10e2   b9                PHI 9
   10e3   27                DEC 7
   10e4   87                GLO 7
   10e5   ca 10 d7          LBNZ QC_W_LOOP
   10e8                 QC_W_DONE:
                        
                            ; --- Black side (extras flip sign: ADD 900 each) ---
   10e8   68 c8 64 b6       RLDI 8, B_QUEEN_CNT
   10ec   08                LDN 8
   10ed   c2 11 0a          LBZ QC_B_DONE
   10f0   ff 01             SMI 1
   10f2   c2 11 0a          LBZ QC_B_DONE
                        
   10f5   a7                PLO 7
   10f6   f8 00             LDI 0
   10f8   b7                PHI 7
                        
   10f9                 QC_B_LOOP:
   10f9   f8 84             LDI $84
   10fb   52                STR 2
   10fc   89                GLO 9
   10fd   f4                ADD
   10fe   a9                PLO 9
   10ff   f8 03             LDI $03
   1101   52                STR 2
   1102   99                GHI 9
   1103   74                ADC
   1104   b9                PHI 9
   1105   27                DEC 7
   1106   87                GLO 7
   1107   ca 10 f9          LBNZ QC_B_LOOP
   110a                 QC_B_DONE:
                        
                            ; ==================================================================
                            ; King safety v3 (2026-07-03): KING_DANGER = ENEMY_PRESSURE x LUFT_FACTOR.
                            ; Replaces BOTH v2 (shield + queen-storm) AND the queen-prox term (fork 2:
                            ; offense credit must be luft-gated or it pays for unsound lone-piece
                            ; attacks; queen ACTIVITY is QUEEN_MOBILITY's job now).
                            ; KING_SAFETY_V3(R7.0 = king sq, R7.1 = FRIENDLY color) -> D = danger
                            ; 0-255. Applied symmetrically: white king danger subtracts, black adds.
                            ; ==================================================================
   110a   68 c8 60 86       RLDI 8, GAME_STATE + STATE_W_KING_SQ
   110e   08                LDN 8
   110f   a7                PLO 7               ; R7.0 = white king sq
   1110   f8 00             LDI 0
   1112   b7                PHI 7               ; R7.1 = friendly color = white
   1113   d4 17 00          CALL KING_SAFETY_V3
   1116   52                STR 2
   1117   89                GLO 9
   1118   f7                SM                  ; R9 -= white king danger
   1119   a9                PLO 9
   111a   99                GHI 9
   111b   7f 00             SMBI 0
   111d   b9                PHI 9
                        
   111e   68 c8 60 87       RLDI 8, GAME_STATE + STATE_B_KING_SQ
   1122   08                LDN 8
   1123   a7                PLO 7               ; R7.0 = black king sq
   1124   f8 08             LDI $08
   1126   b7                PHI 7               ; R7.1 = friendly color = black
   1127   d4 17 00          CALL KING_SAFETY_V3
   112a   52                STR 2
   112b   89                GLO 9
   112c   f4                ADD                 ; R9 += black king danger
   112d   a9                PLO 9
   112e   99                GHI 9
   112f   7c 00             ADCI 0
   1131   b9                PHI 9
                        
                            ; --- O-O-O discomfort (2026-07-08, task #53): queenside king posture vs a
                            ; developed enemy queen (files a-d). CALL returns D = signed net (-50/0/+50);
                            ; sign-extend and add to R9. Routine in the $7B00 overflow page.
   1132   d4 7b 00          CALL OOO_DISCOMFORT
   1135   52                STR 2               ; M(2) = signed adjustment
   1136   fa 80             ANI $80
   1138   c2 11 40          LBZ OOO_SEXT_POS
   113b   f8 ff             LDI $FF
   113d   c0 11 42          LBR OOO_SEXT_GO
   1140                 OOO_SEXT_POS:
   1140   f8 00             LDI $00
   1142                 OOO_SEXT_GO:
   1142   b8                PHI 8               ; R8.1 = sign-extension byte
   1143   89                GLO 9
   1144   f4                ADD                 ; R9.lo += adjustment (M(2))
   1145   a9                PLO 9
   1146   98                GHI 8
   1147   52                STR 2
   1148   99                GHI 9
   1149   74                ADC                 ; R9.hi += sign byte + carry
   114a   b9                PHI 9
                        
                            ; (v3 retirement note: the ~150 B of queen-prox Chebyshev code that lived
                            ; here, plus the v2 KING_SAFETY routine and its STORM_PEN/DEFENSE_CREDIT
                            ; tables, were removed 2026-07-03 — see git history for the old bodies.)
                            ; Add piece-square table bonuses
   114b   d4 19 f6          CALL EVAL_PST
                        
                            ; ==================================================================
                            ; Castling Rights Bonus
                            ; +20cp per side that still has castling rights remaining
                            ; Incentivizes preserving the option to castle
                            ; ==================================================================
   114e   68 cb 60 81       RLDI 11, GAME_STATE + STATE_CASTLING
   1152   0b                LDN 11              ; D = castling rights byte
   1153   52                STR 2               ; save for reuse
   1154   fa 03             ANI $03             ; white bits (WK|WQ)
   1156   c2 11 61          LBZ EVAL_NO_W_CASTLE
   1159   89                GLO 9
   115a   fc 14             ADI 20
   115c   a9                PLO 9
   115d   99                GHI 9
   115e   7c 00             ADCI 0
   1160   b9                PHI 9               ; R9 += 20 (white has castling rights)
   1161                 EVAL_NO_W_CASTLE:
   1161   02                LDN 2               ; reload castling byte
   1162   fa 0c             ANI $0C             ; black bits (BK|BQ)
   1164   c2 11 6f          LBZ EVAL_NO_B_CASTLE
   1167   89                GLO 9
   1168   ff 14             SMI 20
   116a   a9                PLO 9
   116b   99                GHI 9
   116c   7f 00             SMBI 0
   116e   b9                PHI 9               ; R9 -= 20 (black has castling rights)
   116f                 EVAL_NO_B_CASTLE:
                        
                            ; ==================================================================
                            ; Queen mobility (2026-06-17, always-on): low magnitude (mobility x2 = ~2cp/
                            ; square) to break ties toward an active queen without overriding material or
                            ; distorting trades. Tunable: SHL=x2 (start), SHL SHL=x4. Watch in matches for
                            ; premature queen sorties (the one real risk). See QUEEN_MOBILITY.
                            ; ==================================================================
   116f   68 c8 67 20       RLDI 8, W_QUEEN_SQ
   1173   08                LDN 8
   1174   a7                PLO 7                   ; R7.0 = white queen sq
   1175   fb ff             XRI $FF
   1177   c2 11 86          LBZ QMOB_BLACK          ; no white queen, skip
   117a   d4 18 2b          CALL QUEEN_MOBILITY     ; D = mobility (0..27)
   117d   fe                SHL                     ; x2 (low magnitude)
   117e   52                STR 2
   117f   89                GLO 9
   1180   f4                ADD
   1181   a9                PLO 9
   1182   99                GHI 9
   1183   7c 00             ADCI 0
   1185   b9                PHI 9                   ; R9 += white queen mobility x2
   1186                 QMOB_BLACK:
   1186   68 c8 67 21       RLDI 8, B_QUEEN_SQ
   118a   08                LDN 8
   118b   a7                PLO 7                   ; R7.0 = black queen sq
   118c   fb ff             XRI $FF
   118e   c2 11 9d          LBZ QMOB_DONE           ; no black queen, skip
   1191   d4 18 2b          CALL QUEEN_MOBILITY
   1194   fe                SHL                     ; x2
   1195   52                STR 2
   1196   89                GLO 9
   1197   f7                SM                      ; D = R9.0 - mobility x2
   1198   a9                PLO 9
   1199   99                GHI 9
   119a   7f 00             SMBI 0
   119c   b9                PHI 9                   ; R9 -= black queen mobility x2
   119d                 QMOB_DONE:
                        
                            ; ==================================================================
                            ; Doubled Pawn Penalty: -15cp per extra pawn on same file
                            ; Iterate 8 files; if count >= 2, penalty += (count - 1) * 15
                            ; ==================================================================
                        
                            ; --- White doubled pawns ---
   119d   68 cb 67 10       RLDI 11, W_PAWN_FILE_CT     ; $6710
   11a1   f8 08             LDI 8
   11a3   ad                PLO 13                      ; R13.0 = file counter (temp, will restore later)
   11a4   f8 00             LDI 0
   11a6   b7                PHI 7                       ; R7.1 = white doubled penalty accumulator
   11a7                 EVAL_WDP_LOOP:
   11a7   4b                LDA 11                      ; D = pawn count for this file, R11++
   11a8   ff 02             SMI 2                       ; D = count - 2 (DF=1 if count >= 2)
   11aa   cb 11 bb          LBNF EVAL_WDP_NEXT          ; count < 2, no doubled
                            ; count >= 2: penalty = (count - 1) * 15
                            ; D = count - 2, so D + 1 = count - 1
   11ad   fc 01             ADI 1                       ; D = count - 1
                            ; Multiply by 15: x*16 - x = (x<<4) - x
                            ; But with 8-bit arithmetic, max extra pawns = 7, 7*15 = 105 fits in byte
   11af   a7                PLO 7                       ; save (count-1) in R7.0
   11b0   fe                SHL
   11b1   fe                SHL
   11b2   fe                SHL
   11b3   fe                SHL                         ; D = (count-1) * 16
   11b4   52                STR 2                       ; M(R2) = (count-1) * 16
   11b5   87                GLO 7                       ; D = (count-1)
   11b6   f5                SD                          ; D = M(R2) - D = (count-1)*16 - (count-1) = (count-1)*15
   11b7   52                STR 2                       ; save penalty on stack
   11b8   97                GHI 7                       ; accumulated penalty
   11b9   f4                ADD                         ; D = accumulated + this file's penalty
   11ba   b7                PHI 7                       ; update accumulator
   11bb                 EVAL_WDP_NEXT:
   11bb   2d                DEC 13
   11bc   8d                GLO 13
   11bd   ca 11 a7          LBNZ EVAL_WDP_LOOP
                            ; R7.1 = total white doubled penalty (always positive)
                            ; Subtract from score (penalty for white)
   11c0   97                GHI 7
   11c1   c2 11 cc          LBZ EVAL_WDP_DONE           ; skip if 0
   11c4   52                STR 2
   11c5   89                GLO 9
   11c6   f7                SM                          ; R9.0 - penalty
   11c7   a9                PLO 9
   11c8   99                GHI 9
   11c9   7f 00             SMBI 0
   11cb   b9                PHI 9                       ; R9 -= white doubled penalty
   11cc                 EVAL_WDP_DONE:
                        
                            ; --- Black doubled pawns ---
   11cc   68 cb 67 18       RLDI 11, B_PAWN_FILE_CT     ; $6718
   11d0   f8 08             LDI 8
   11d2   ad                PLO 13
   11d3   f8 00             LDI 0
   11d5   b7                PHI 7
   11d6                 EVAL_BDP_LOOP:
   11d6   4b                LDA 11
   11d7   ff 02             SMI 2
   11d9   cb 11 ea          LBNF EVAL_BDP_NEXT
   11dc   fc 01             ADI 1                       ; D = count - 1
   11de   a7                PLO 7
   11df   fe                SHL
   11e0   fe                SHL
   11e1   fe                SHL
   11e2   fe                SHL                         ; (count-1) * 16
   11e3   52                STR 2
   11e4   87                GLO 7
   11e5   f5                SD                          ; (count-1) * 15
   11e6   52                STR 2
   11e7   97                GHI 7
   11e8   f4                ADD
   11e9   b7                PHI 7
   11ea                 EVAL_BDP_NEXT:
   11ea   2d                DEC 13
   11eb   8d                GLO 13
   11ec   ca 11 d6          LBNZ EVAL_BDP_LOOP
                            ; Add black penalty to score (good for white)
   11ef   97                GHI 7
   11f0   c2 11 fb          LBZ EVAL_BDP_DONE
   11f3   52                STR 2
   11f4   89                GLO 9
   11f5   f4                ADD
   11f6   a9                PLO 9
   11f7   99                GHI 9
   11f8   7c 00             ADCI 0
   11fa   b9                PHI 9                       ; R9 += black doubled penalty
   11fb                 EVAL_BDP_DONE:
                        
                            ; ==================================================================
                            ; Bishop Pair Bonus: +30cp for having both bishops
                            ; ==================================================================
   11fb   68 cb 64 af       RLDI 11, EVAL_W_BISHOPS
   11ff   0b                LDN 11
   1200   ff 02             SMI 2
   1202   cb 12 0d          LBNF EVAL_NO_WBP            ; < 2 bishops
   1205   89                GLO 9
   1206   fc 1e             ADI 30
   1208   a9                PLO 9
   1209   99                GHI 9
   120a   7c 00             ADCI 0
   120c   b9                PHI 9                       ; R9 += 30 (white bishop pair)
   120d                 EVAL_NO_WBP:
   120d   68 cb 64 b0       RLDI 11, EVAL_B_BISHOPS
   1211   0b                LDN 11
   1212   ff 02             SMI 2
   1214   cb 12 1f          LBNF EVAL_NO_BBP
   1217   89                GLO 9
   1218   ff 1e             SMI 30
   121a   a9                PLO 9
   121b   99                GHI 9
   121c   7f 00             SMBI 0
   121e   b9                PHI 9                       ; R9 -= 30 (black bishop pair)
   121f                 EVAL_NO_BBP:
                        
                            ; ==================================================================
                            ; Rook on Open/Semi-Open File
                            ; +20cp open (no friendly pawns, no enemy pawns on file)
                            ; +10cp semi-open (no friendly pawns, enemy pawns present)
                            ; ==================================================================
                        
                            ; --- White rook 1 ---
   121f   68 cb 64 b1       RLDI 11, EVAL_W_ROOK_F1
   1223   0b                LDN 11
   1224   fb ff             XRI $FF
   1226   c2 12 95          LBZ EVAL_WR_DONE            ; no white rook 1
                            ; Check white pawn count on this file
   1229   0b                LDN 11                      ; D = file (reload, XRI changed D)
   122a   fc 10             ADI LOW(W_PAWN_FILE_CT)
   122c   ab                PLO 11
   122d   f8 67             LDI HIGH(W_PAWN_FILE_CT)
   122f   7c 00             ADCI 0
   1231   bb                PHI 11                      ; R11 = &W_PAWN_FILE_CT[file]
   1232   0b                LDN 11
   1233   ca 12 5a          LBNZ EVAL_WR1_CLOSED        ; friendly pawns on file, no bonus
                            ; No friendly pawns. Check enemy pawns for open vs semi-open.
   1236   68 cb 64 b1       RLDI 11, EVAL_W_ROOK_F1
   123a   0b                LDN 11                      ; D = file
   123b   fc 18             ADI LOW(B_PAWN_FILE_CT)
   123d   ab                PLO 11
   123e   f8 67             LDI HIGH(B_PAWN_FILE_CT)
   1240   7c 00             ADCI 0
   1242   bb                PHI 11
   1243   0b                LDN 11                      ; D = black pawn count on this file
   1244   ca 12 52          LBNZ EVAL_WR1_SEMI
                            ; Fully open file: +20
   1247   89                GLO 9
   1248   fc 14             ADI 20
   124a   a9                PLO 9
   124b   99                GHI 9
   124c   7c 00             ADCI 0
   124e   b9                PHI 9
   124f   c0 12 5a          LBR EVAL_WR1_CLOSED
   1252                 EVAL_WR1_SEMI:
                            ; Semi-open: +10
   1252   89                GLO 9
   1253   fc 0a             ADI 10
   1255   a9                PLO 9
   1256   99                GHI 9
   1257   7c 00             ADCI 0
   1259   b9                PHI 9
   125a                 EVAL_WR1_CLOSED:
                        
                            ; --- White rook 2 ---
   125a   68 cb 64 b2       RLDI 11, EVAL_W_ROOK_F2
   125e   0b                LDN 11
   125f   fb ff             XRI $FF
   1261   c2 12 95          LBZ EVAL_WR_DONE
   1264   0b                LDN 11
   1265   fc 10             ADI LOW(W_PAWN_FILE_CT)
   1267   ab                PLO 11
   1268   f8 67             LDI HIGH(W_PAWN_FILE_CT)
   126a   7c 00             ADCI 0
   126c   bb                PHI 11
   126d   0b                LDN 11
   126e   ca 12 95          LBNZ EVAL_WR_DONE           ; friendly pawns, no bonus
   1271   68 cb 64 b2       RLDI 11, EVAL_W_ROOK_F2
   1275   0b                LDN 11
   1276   fc 18             ADI LOW(B_PAWN_FILE_CT)
   1278   ab                PLO 11
   1279   f8 67             LDI HIGH(B_PAWN_FILE_CT)
   127b   7c 00             ADCI 0
   127d   bb                PHI 11
   127e   0b                LDN 11
   127f   ca 12 8d          LBNZ EVAL_WR2_SEMI
   1282   89                GLO 9
