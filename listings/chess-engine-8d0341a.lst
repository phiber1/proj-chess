                            ; Recursive call to NEGAMAX
                            ; -----------------------------------------------
   22d1   d4 1c 4e          CALL NEGAMAX
                            ; Returns score in R9 (R6 is SCRT linkage - off limits!)
                        
                            ; -----------------------------------------------
                            ; Pop LMR state (reverse order)
                            ; -----------------------------------------------
                            ; Pop LMR_REDUCED and save to LMR_OUTER
   22d4   60                IRX
   22d5   f0                LDX                 ; D = saved LMR_REDUCED (R2 stays at this slot)
   22d6   a7                PLO 7               ; Save in R7.0 (temp)
   22d7   68 ca 64 a6       RLDI 10, LMR_OUTER
   22db   87                GLO 7               ; Restore LMR_REDUCED value
   22dc   5a                STR 10              ; LMR_OUTER = saved LMR_REDUCED
                            ; Pop LMR_MOVE_INDEX and restore to memory
   22dd   60                IRX
   22de   f0                LDX                 ; D = saved LMR_MOVE_INDEX
   22df   a7                PLO 7               ; Temp in R7.0
   22e0   68 ca 64 a3       RLDI 10, LMR_MOVE_INDEX
   22e4   87                GLO 7
   22e5   5a                STR 10              ; LMR_MOVE_INDEX restored
                        
                            ; Decrement ply counter after recursion
   22e6   68 ca 64 48       RLDI 10, CURRENT_PLY
   22ea   0a                LDN 10
   22eb   ff 01             SMI 1
   22ed   5a                STR 10              ; CURRENT_PLY--
                        
                            ; Negate R9 (score = -score)
   22ee   89                GLO 9               ; low byte
   22ef   fd 00             SDI 0               ; negate low
   22f1   a9                PLO 9
   22f2   99                GHI 9               ; high byte
   22f3   7d 00             SDBI 0              ; negate high with borrow
   22f5   b9                PHI 9
                        
