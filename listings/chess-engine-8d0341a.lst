                            ; ==================================================================
                            ; Enemy King Edge Bonus (endgame only, when winning)
                            ; Uses KING_EDGE_TABLE (already in binary, 64 bytes)
                            ; Values: 60 at edges/corners, 0 at center — rewards driving to edge
                            ; Scaled 2x via SHL for effective range 0-120cp
                            ; ==================================================================
                        
                            ; --- King-king proximity (the missing mating ingredient): Chebyshev
                            ; distance between the two kings (R15.0=white index, R15.1=black index,
                            ; both 0-63), look up KING_PROX_BONUS[dist], stash in EVAL_TEMP1. Added for
                            ; the winning side below so its king is pulled toward the enemy king. Mirrors
                            ; the queen-prox distance pattern. Preserves R9/R15. ---
   1609   8f                GLO 15              ; white king 0-63 index
   160a   f6                SHR
   160b   f6                SHR
   160c   f6                SHR                 ; D = white rank (0-7)
   160d   ad                PLO 13              ; R13.0 = w_rank
   160e   9f                GHI 15              ; black king index
   160f   f6                SHR
   1610   f6                SHR
   1611   f6                SHR                 ; D = black rank
   1612   52                STR 2
   1613   8d                GLO 13
   1614   f5                SD                  ; D = b_rank - w_rank
   1615   c3 16 1a          LBDF KP_RANK_OK
   1618   fd 00             SDI 0               ; |rank diff|
   161a                 KP_RANK_OK:
   161a   bd                PHI 13              ; R13.1 = |rank diff|
   161b   8f                GLO 15
   161c   fa 07             ANI $07             ; D = w_file
   161e   ad                PLO 13              ; R13.0 = w_file
   161f   9f                GHI 15
   1620   fa 07             ANI $07             ; D = b_file
   1622   52                STR 2
   1623   8d                GLO 13
   1624   f5                SD                  ; D = b_file - w_file
   1625   c3 16 2a          LBDF KP_FILE_OK
   1628   fd 00             SDI 0               ; |file diff|
   162a                 KP_FILE_OK:
   162a   ad                PLO 13              ; R13.0 = |file diff|
   162b   9d                GHI 13              ; |rank diff|
   162c   52                STR 2
   162d   8d                GLO 13              ; |file diff|
   162e   f5                SD                  ; D = |rank| - |file|
   162f   c3 16 36          LBDF KP_USE_RANK    ; rank >= file -> max = rank
   1632   8d                GLO 13              ; max = file
   1633   c0 16 37          LBR KP_HAVE_DIST
   1636                 KP_USE_RANK:
   1636   9d                GHI 13              ; max = rank
   1637                 KP_HAVE_DIST:
   1637   fc 2f             ADI LOW(KING_PROX_BONUS)
   1639   ab                PLO 11
   163a   f8 00             LDI 0
   163c   7c 1b             ADCI HIGH(KING_PROX_BONUS)
   163e   bb                PHI 11
   163f   0b                LDN 11              ; D = KING_PROX_BONUS[chebyshev dist]
   1640   68 ca 64 40       RLDI 10, EVAL_TEMP1
   1644   5a                STR 10              ; EVAL_TEMP1 = king-king proximity bonus
                        
                            ; Check if white is winning significantly (score > 200)
   1645   99                GHI 9
   1646   fa 80             ANI $80             ; sign bit
   1648   ca 16 8e          LBNZ EG_CHECK_BLACK ; negative, check if black winning
   164b   99                GHI 9
   164c   ca 16 55          LBNZ EG_DRIVE_BLACK ; high byte > 0 → score > 255
   164f   89                GLO 9
   1650   ff c8             SMI 200
   1652   cb 16 d0          LBNF EG_EDGE_DONE   ; score < 200, skip
                        
   1655                 EG_DRIVE_BLACK:
                            ; MATE-MATERIAL GATE (2026-06-26): only drive if white holds a heavy piece
                            ; (rook or queen). A pawns/minors-only side has no mating material; driving
                            ; its king toward the enemy walks it into danger (the 6/26 phantom-passer king
                            ; march, eval +1080 then -2115 once the king was cornered). Score>200 alone is
                            ; self-referential — the phantom inflates the very score that trips the drive.
   1655   68 cb 64 b1       RLDI 11, EVAL_W_ROOK_F1
   1659   0b                LDN 11
   165a   fb ff             XRI $FF
   165c   ca 16 67          LBNZ EG_DB_GO       ; white has a rook -> drive ok
   165f   68 cb 64 b5       RLDI 11, W_QUEEN_CNT
   1663   0b                LDN 11
   1664   c2 16 d0          LBZ EG_EDGE_DONE    ; no rook AND no queen -> no mate material, skip drive
   1667                 EG_DB_GO:
                            ; White winning — penalize black king for being in center
                            ; R15.1 = black king index (saved during centralization)
   1667   9f                GHI 15              ; D = black king 0-63 index
   1668   52                STR 2               ; save on stack
   1669   68 cb 1a ef       RLDI 11, KING_EDGE_TABLE
   166d   8b                GLO 11
   166e   f4                ADD
   166f   ab                PLO 11
   1670   9b                GHI 11
   1671   7c 00             ADCI 0
   1673   bb                PHI 11              ; R11 = &KING_EDGE_TABLE[black_king]
   1674   0b                LDN 11              ; D = edge value (0-60)
   1675   fe                SHL                 ; D = value * 2 (0-120)
   1676   52                STR 2               ; save bonus
   1677   89                GLO 9
   1678   f4                ADD
   1679   a9                PLO 9
   167a   99                GHI 9
   167b   7c 00             ADCI 0
   167d   b9                PHI 9               ; R9 += edge bonus (always positive, no sign extend)
                            ; + king-king proximity: white king closer to black king = better for white
   167e   68 ca 64 40       RLDI 10, EVAL_TEMP1
   1682   0a                LDN 10
   1683   52                STR 2
   1684   89                GLO 9
   1685   f4                ADD
   1686   a9                PLO 9
   1687   99                GHI 9
   1688   7c 00             ADCI 0
   168a   b9                PHI 9
   168b   c0 16 d0          LBR EG_EDGE_DONE
                        
   168e                 EG_CHECK_BLACK:
                            ; Check if black is winning (score < -200)
                            ; Score is negative. Check if <= -201 (i.e., high byte < $FF or low byte <= $37)
   168e   99                GHI 9
   168f   fb ff             XRI $FF
   1691   ca 16 9a          LBNZ EG_DRIVE_WHITE ; high byte < $FF → score < -255
   1694   89                GLO 9
   1695   fc c8             ADI 200             ; if score_lo + 200 overflows, score_lo > 55 → score > -201
   1697   c3 16 d0          LBDF EG_EDGE_DONE   ; score > -201, not winning enough
                        
   169a                 EG_DRIVE_WHITE:
                            ; MATE-MATERIAL GATE (2026-06-26): symmetric to EG_DRIVE_BLACK — only drive if
                            ; black holds a heavy piece (rook or queen). No mate material -> don't march.
   169a   68 cb 64 b3       RLDI 11, EVAL_B_ROOK_F1
   169e   0b                LDN 11
   169f   fb ff             XRI $FF
   16a1   ca 16 ac          LBNZ EG_DW_GO       ; black has a rook -> drive ok
   16a4   68 cb 64 b6       RLDI 11, B_QUEEN_CNT
   16a8   0b                LDN 11
   16a9   c2 16 d0          LBZ EG_EDGE_DONE    ; no rook AND no queen -> no mate material, skip drive
   16ac                 EG_DW_GO:
                            ; Black winning — penalize white king for being in center
                            ; R15.0 = white king index (saved during centralization)
   16ac   8f                GLO 15              ; D = white king 0-63 index
   16ad   52                STR 2
   16ae   68 cb 1a ef       RLDI 11, KING_EDGE_TABLE
   16b2   8b                GLO 11
   16b3   f4                ADD
   16b4   ab                PLO 11
   16b5   9b                GHI 11
   16b6   7c 00             ADCI 0
   16b8   bb                PHI 11              ; R11 = &KING_EDGE_TABLE[white_king]
   16b9   0b                LDN 11              ; D = edge value (0-60)
   16ba   fe                SHL                 ; D = value * 2 (0-120)
   16bb   52                STR 2               ; save penalty
   16bc   89                GLO 9
   16bd   f7                SM                  ; R9.0 - penalty (SM = D - M(R(X)))
   16be   a9                PLO 9
   16bf   99                GHI 9
   16c0   7f 00             SMBI 0
   16c2   b9                PHI 9               ; R9 -= edge penalty
                            ; - king-king proximity: black king closer to white king = better for black
   16c3   68 ca 64 40       RLDI 10, EVAL_TEMP1
   16c7   0a                LDN 10
   16c8   52                STR 2
   16c9   89                GLO 9
   16ca   f7                SM
   16cb   a9                PLO 9
   16cc   99                GHI 9
   16cd   7f 00             SMBI 0
   16cf   b9                PHI 9
                        
   16d0                 EG_EDGE_DONE:
                        
                            ; ==================================================================
                            ; Check bonus: if side-to-move is in check, credit the attacker.
                            ; Score is white-relative, so white-in-check → R9 -= CHECK_BONUS;
                            ; black-in-check → R9 += CHECK_BONUS.
                            ; IS_IN_CHECK preserves R11/R12; we save R9 ourselves.
                            ; ==================================================================
   16d0   89                GLO 9
   16d1   73                STXD
   16d2   99                GHI 9
   16d3   73                STXD
                        
   16d4   d4 01 8e          CALL IS_IN_CHECK        ; uses R12 (side to move); D = 1 if in check
   16d7   a8                PLO 8                   ; R8.0 = result
                        
   16d8   60                IRX
   16d9   72                LDXA
   16da   b9                PHI 9
   16db   f0                LDX
   16dc   a9                PLO 9                   ; R9 restored
                        
   16dd   88                GLO 8
   16de   c2 16 fc          LBZ CHECK_BONUS_DONE    ; not in check, skip
                        
   16e1   8c                GLO 12                  ; side to move: WHITE=0, BLACK=8
   16e2   c2 16 f2          LBZ CHECK_BONUS_SUB     ; white to move and white in check → penalty
                        
                            ; Black to move and black in check → bonus to white
   16e5   f8 28             LDI CHECK_BONUS
   16e7   52                STR 2
   16e8   89                GLO 9
   16e9   f4                ADD
   16ea   a9                PLO 9
   16eb   99                GHI 9
   16ec   7c 00             ADCI 0
   16ee   b9                PHI 9
   16ef   c0 16 fc          LBR CHECK_BONUS_DONE
                        
   16f2                 CHECK_BONUS_SUB:
                            ; White to move and white in check → penalty to white
   16f2   f8 28             LDI CHECK_BONUS
   16f4   52                STR 2
   16f5   89                GLO 9
   16f6   f7                SM                      ; SM = D - M(R(X)) → R9.0 - CHECK_BONUS
   16f7   a9                PLO 9
   16f8   99                GHI 9
   16f9   7f 00             SMBI 0
   16fb   b9                PHI 9
                        
   16fc                 CHECK_BONUS_DONE:
                        
   16fc                 BKS_DONE:
   16fc   d5                RETN
                        
                        ; ------------------------------------------------------------------------------
                        ; EVALUATE_MATERIAL - Material-only evaluation (fast version)
                        ; ------------------------------------------------------------------------------
                        ; Simplified evaluation for leaf nodes where speed is critical
                        ; Input:  A = board pointer
                        ; Output: R9 = material score (NOT R6 - R6 is SCRT linkage, off limits!)
                        ; ------------------------------------------------------------------------------
   16fd                 EVALUATE_MATERIAL:
                            ; Alias to main evaluate for now
                            ; Later can optimize this path
   16fd   c0 0e b4          LBR EVALUATE
                        
                        ; ------------------------------------------------------------------------------
                        ; KING_SAFETY_V3 - luft-based king danger (2026-07-03). Replaces v2 shield+storm.
                        ;   DANGER = (pressure==0) ? 0 : SHIELD_PEN[missing] + DANGER_V3_TABLE[pressure,luft]
                        ;   ENEMY_PRESSURE: weighted enemy heavies bearing on this king. Queen (weight 2)
                        ;     bears iff Chebyshev <= 3. Each rook (weight 1) bears iff Chebyshev <= 3 OR
                        ;     same file OR same rank (back-rank/file pressure). ENEMY pieces ONLY - never
                        ;     count friendly pieces (the attackers-minus-defenders misread is what missed
                        ;     the 6/17 suffocation mate). Raw 0-4, clamped to 3.
                        ;   LUFT: count of the king's 8 neighbors that are on-board and NOT occupied by a
                        ;     friendly piece (empty or enemy-capture = flight). SATURATED 8 -> 7 with an
                        ;     explicit compare - NEVER ANI $07, which would map a bare king's luft 8 to
                        ;     index 0 = maximally trapped (7/2 cold-review finding a).
                        ;   SHIELD: friendly pawns on the 3 ahead-squares (v2's logic, folded in), now
                        ;     pressure-gated: a cracked shield with no enemy heavy nearby costs nothing.
                        ;   Short-circuit (fork 4): pressure computed FIRST; 0 -> return 0, skip the
                        ;     luft + shield scans entirely (this is the cycle gate).
                        ; In:  R7.0 = king sq (0x88); R7.1 = FRIENDLY color ($00 white / $08 black)
                        ; Out: D = danger 0-255. Preserves R9,R12. Clobbers R7.1,R8,R10,R11,R13.
                        ; LEAF (no CALL). X=2 scratch byte only; KSV_COLOR is its one private memory byte.
                        ; Reads eval-scan trackers (queen sq + rook sqs), ALL gated on the $FF sentinel
                        ; (rook SQ vars are $FF-reset per eval call as of 2026-07-03).
                        ; ------------------------------------------------------------------------------
   1700                 KING_SAFETY_V3:
   1700   e2                SEX 2
                        
   1701   68 ca 64 1d       RLDI 10, TRACE_WHERE
   1705   f8 e2             LDI $E2
   1707   5a                STR 10              ; tracer: in KING_SAFETY_V3
   1708   68 ca 0d f9       RLDI 10, KSV_COLOR
   170c   97                GHI 7
   170d   5a                STR 10              ; stash friendly color (R7.1 becomes piece-sq scratch)
                            ; enemy pointer set: friendly white -> BLACK trackers (KSV_PTAB+6),
                            ; friendly black -> WHITE trackers (KSV_PTAB+0). D still = color.
   170e   68 c8 0d ed       RLDI 8, KSV_PTAB
   1712   ca 17 1d          LBNZ KSV_PSETUP     ; black -> enemy = white set (table base)
   1715   88                GLO 8
   1716   fc 06             ADI 6
   1718   a8                PLO 8
   1719   98                GHI 8
   171a   7c 00             ADCI 0
   171c   b8                PHI 8               ; white -> enemy = black set (base + 6)
   171d                 KSV_PSETUP:
   171d   f8 00             LDI 0
   171f   ab                PLO 11              ; R11.0 = pressure accumulator
   1720   f8 03             LDI 3
   1722   bb                PHI 11              ; R11.1 = phase counter (3 = queen, 2/1 = rooks)
   1723                 KSV_PLOOP:
   1723   48                LDA 8
   1724   ba                PHI 10
   1725   48                LDA 8
   1726   aa                PLO 10              ; R10 = &enemy piece square (big-endian DW entry)
   1727   0a                LDN 10
   1728   fb ff             XRI $FF
   172a   c2 17 7c          LBZ KSV_PNEXT       ; $FF sentinel: piece absent
   172d   0a                LDN 10
   172e   b7                PHI 7               ; R7.1 = piece square
                            ; |file diff| -> R13.0
   172f   97                GHI 7
   1730   fa 07             ANI $07
   1732   52                STR 2
   1733   87                GLO 7
   1734   fa 07             ANI $07
   1736   f7                SM                  ; D = k_file - p_file
   1737   c3 17 3c          LBDF KSV_FD_OK
   173a   fd 00             SDI 0
   173c                 KSV_FD_OK:
   173c   ad                PLO 13
                            ; |rank diff| kept as HIGH NIBBLE -> R13.1 (nibble compare, no shifts)
   173d   97                GHI 7
   173e   fa 70             ANI $70
   1740   52                STR 2
   1741   87                GLO 7
   1742   fa 70             ANI $70
   1744   f7                SM                  ; D = k_ranknib - p_ranknib
   1745   c3 17 4a          LBDF KSV_RD_OK
   1748   fd 00             SDI 0
   174a                 KSV_RD_OK:
   174a   bd                PHI 13
                            ; bears by Chebyshev? (filediff <= 3 AND rankdiff <= 3)
   174b   8d                GLO 13
   174c   ff 04             SMI 4
   174e   c3 17 5a          LBDF KSV_NOTCHEB    ; filediff >= 4
   1751   9d                GHI 13
   1752   ff 40             SMI $40
   1754   c3 17 5a          LBDF KSV_NOTCHEB    ; rankdiff >= 4
   1757   c0 17 6b          LBR KSV_BEARS
   175a                 KSV_NOTCHEB:
                            ; rooks only: same file or same rank still bears. The queen does NOT get
                            ; this test - blocker-blind file/rank fired phantoms (fianchetto Qg7 vs
                            ; Kg1, unmoved Rh8 vs Kh1; 7/2 cold-review finding b).
   175a   9b                GHI 11
   175b   fb 03             XRI 3
   175d   c2 17 7c          LBZ KSV_PNEXT       ; queen phase -> Chebyshev only
   1760   8d                GLO 13
   1761   c2 17 6b          LBZ KSV_BEARS       ; same file
   1764   9d                GHI 13
   1765   c2 17 6b          LBZ KSV_BEARS       ; same rank
   1768   c0 17 7c          LBR KSV_PNEXT
   176b                 KSV_BEARS:
   176b   9b                GHI 11
   176c   fb 03             XRI 3
   176e   ca 17 78          LBNZ KSV_W1
   1771   8b                GLO 11
   1772   fc 02             ADI 2               ; queen weight
   1774   ab                PLO 11
   1775   c0 17 7c          LBR KSV_PNEXT
   1778                 KSV_W1:
   1778   8b                GLO 11
   1779   fc 01             ADI 1               ; rook weight
   177b   ab                PLO 11
   177c                 KSV_PNEXT:
   177c   9b                GHI 11
   177d   ff 01             SMI 1
   177f   bb                PHI 11
   1780   ca 17 23          LBNZ KSV_PLOOP
                            ; SHORT-CIRCUIT: no pressure -> no danger, skip luft + shield
   1783   8b                GLO 11
   1784   c2 18 28          LBZ KSV_ZERO
                            ; clamp pressure to 3 (raw max 4 = Q+R+R)
   1787   ff 04             SMI 4
   1789   cb 17 8f          LBNF KSV_LUFT       ; pressure <= 3 -> keep
   178c   f8 03             LDI 3
   178e   ab                PLO 11
   178f                 KSV_LUFT:
                            ; luft = flight squares among the 8 king neighbors
   178f   f8 00             LDI 0
   1791   bb                PHI 11              ; R11.1 = luft count (phase counter is done)
   1792   68 c8 18 60       RLDI 8, QUEEN_DIRS  ; reuse the 8-direction delta table
   1796   f8 08             LDI 8
   1798   ad                PLO 13              ; R13.0 = directions remaining
   1799                 KSV_LLOOP:
   1799   48                LDA 8
   179a   52                STR 2
   179b   87                GLO 7               ; king sq (R7.0 is never modified)
   179c   f4                ADD                 ; D = neighbor square
   179d   aa                PLO 10
   179e   fa 88             ANI $88
   17a0   ca 17 ba          LBNZ KSV_LNEXT      ; off board
   17a3   f8 60             LDI HIGH(BOARD)
   17a5   ba                PHI 10
   17a6   0a                LDN 10              ; piece at neighbor
   17a7   c2 17 b6          LBZ KSV_LFLIGHT     ; empty -> flight
   17aa   fa 08             ANI $08
   17ac   52                STR 2               ; M(2) = occupant color bit
   17ad   68 ca 0d f9       RLDI 10, KSV_COLOR
   17b1   0a                LDN 10
   17b2   f3                XOR
   17b3   c2 17 ba          LBZ KSV_LNEXT       ; friendly occupant -> blocked
   17b6                 KSV_LFLIGHT:
   17b6   9b                GHI 11
   17b7   fc 01             ADI 1
   17b9   bb                PHI 11
   17ba                 KSV_LNEXT:
   17ba   2d                DEC 13
   17bb   8d                GLO 13
   17bc   ca 17 99          LBNZ KSV_LLOOP
                            ; SATURATE luft 8 -> 7 (explicit cap; masking would read bare king as boxed)
   17bf   9b                GHI 11
   17c0   ff 08             SMI 8
   17c2   cb 17 c8          LBNF KSV_SHIELD     ; luft < 8 -> keep
   17c5   f8 07             LDI 7
   17c7   bb                PHI 11
   17c8                 KSV_SHIELD:
                            ; shield: friendly pawns on the 3 ahead-squares (pressure-gated fold-in)
   17c8   68 ca 0d f9       RLDI 10, KSV_COLOR
   17cc   0a                LDN 10
   17cd   c2 17 d5          LBZ KSV_SH_W
   17d0   f8 f0             LDI $F0             ; black: ahead = one rank toward rank 1
   17d2   c0 17 d7          LBR KSV_SH_GO
   17d5                 KSV_SH_W:
   17d5   f8 10             LDI $10             ; white: ahead = one rank toward rank 8
   17d7                 KSV_SH_GO:
   17d7   52                STR 2               ; M(2) = ahead offset
   17d8   68 ca 0d f9       RLDI 10, KSV_COLOR
   17dc   0a                LDN 10
   17dd   f9 01             ORI 1
   17df   b8                PHI 8               ; R8.1 = friendly pawn code ($01 / $09 = color|1)
   17e0   87                GLO 7
   17e1   f4                ADD                 ; D = center shield square (king + ahead)
   17e2   ff 01             SMI 1
   17e4   aa                PLO 10              ; R10.0 = first shield square (center-1)
   17e5   f8 00             LDI 0
   17e7   bd                PHI 13              ; R13.1 = shield pawn count
   17e8   f8 03             LDI 3
   17ea   a8                PLO 8               ; R8.0 = loop counter (R8.1 safe: no wrap at 3..1)
   17eb                 KSV_SHL:
   17eb   8a                GLO 10
   17ec   fa 88             ANI $88
   17ee   ca 17 ff          LBNZ KSV_SHN        ; off board
   17f1   f8 60             LDI HIGH(BOARD)
   17f3   ba                PHI 10
   17f4   0a                LDN 10
   17f5   52                STR 2
   17f6   98                GHI 8
   17f7   f3                XOR
   17f8   ca 17 ff          LBNZ KSV_SHN        ; not our pawn
   17fb   9d                GHI 13
   17fc   fc 01             ADI 1
   17fe   bd                PHI 13
   17ff                 KSV_SHN:
   17ff   1a                INC 10
   1800   28                DEC 8
   1801   88                GLO 8
   1802   ca 17 eb          LBNZ KSV_SHL
                            ; SHIELD_PEN[3 - count] -> R13.0
   1805   9d                GHI 13
   1806   52                STR 2
   1807   f8 03             LDI 3
   1809   f7                SM
   180a   fc c9             ADI LOW(SHIELD_PEN)
   180c   aa                PLO 10
   180d   f8 0d             LDI HIGH(SHIELD_PEN)
   180f   7c 00             ADCI 0
   1811   ba                PHI 10
   1812   0a                LDN 10
   1813   ad                PLO 13              ; R13.0 = shield penalty (0-100)
                            ; DANGER = shield + DANGER_V3_TABLE[(pressure << 3) | luft]
   1814   8b                GLO 11
   1815   fe                SHL
   1816   fe                SHL
   1817   fe                SHL
   1818   52                STR 2
   1819   9b                GHI 11
   181a   f1                OR                  ; D = table index 0-31
   181b   fc cd             ADI LOW(DANGER_V3_TABLE)
   181d   aa                PLO 10
   181e   f8 0d             LDI HIGH(DANGER_V3_TABLE)
   1820   7c 00             ADCI 0
   1822   ba                PHI 10
   1823   0a                LDN 10              ; table entry (<= 155 by table rule)
   1824   52                STR 2
   1825   8d                GLO 13
   1826   f4                ADD                 ; D = shield + entry (<= 255 by construction, no wrap)
   1827   d5                RETN
   1828                 KSV_ZERO:
   1828   f8 00             LDI 0
   182a   d5                RETN
                        
                        ; ------------------------------------------------------------------------------
                        ; QUEEN_MOBILITY - count empty squares the queen commands (8-direction ray walk).
                        ; The RIGHT instrument for queen activity (2026-06-17): rewards an active/safe queen
                        ; (high mobility), penalizes an idle OR self-caged queen (low mobility), and never
                        ; pays for a sac (a queen moving where it's captured has the SEARCH reject it, not
                        ; this term). Pure mobility -- no per-square attack check (too costly mid-game); the
                        ; search handles tactics. Symmetric (white adds, black subtracts) so a queen trade is
                        ; ~mobility-neutral UNLESS our queen is the less active one, in which case the term
                        ; correctly nudges us to trade it off.
                        ; In:  R7.0 = queen square (0x88; caller guarantees != $FF). Out: D = mobility 0..27.
                        ; Uses R8,R10,R11,R13. Preserves R9,R12. X=2 (mirrors KING_SAFETY).
                        ; ------------------------------------------------------------------------------
   182b                 QUEEN_MOBILITY:
   182b   e2                SEX 2
                        
   182c   68 ca 64 1d       RLDI 10, TRACE_WHERE
   1830   f8 e3             LDI $E3
   1832   5a                STR 10              ; tracer: in QUEEN_MOBILITY
   1833   f8 00             LDI 0
   1835   a8                PLO 8                   ; R8.0 = mobility = 0
   1836   68 ca 18 60       RLDI 10, QUEEN_DIRS     ; R10 -> 8-direction delta table
   183a   f8 08             LDI 8
   183c   ad                PLO 13                  ; R13.0 = directions remaining
   183d                 QM_DIR:
   183d   4a                LDA 10                  ; D = delta, R10++
   183e   b8                PHI 8                   ; R8.1 = delta
   183f   f8 60             LDI HIGH(BOARD)
   1841   bb                PHI 11
   1842   87                GLO 7
   1843   ab                PLO 11                  ; R11 = &BOARD[queen sq]
   1844                 QM_STEP:
   1844   8b                GLO 11
   1845   52                STR 2                   ; M(2) = current ray square (low byte)
   1846   98                GHI 8                   ; D = delta
   1847   f4                ADD                     ; D = square + delta
   1848   ab                PLO 11                  ; R11.0 = next ray square
   1849   fa 88             ANI $88
   184b   ca 18 59          LBNZ QM_NEXT            ; off board -> end this ray
   184e   0b                LDN 11                  ; D = BOARD[next square]
   184f   ca 18 59          LBNZ QM_NEXT            ; occupied -> blocked, end this ray
   1852   88                GLO 8
   1853   fc 01             ADI 1
   1855   a8                PLO 8                   ; empty -> mobility++
   1856   c0 18 44          LBR QM_STEP
   1859                 QM_NEXT:
   1859   2d                DEC 13
   185a   8d                GLO 13
   185b   ca 18 3d          LBNZ QM_DIR
   185e   88                GLO 8                   ; D = mobility count
   185f   d5                RETN
   1860                 QUEEN_DIRS:
   1860   f0 10 01 ff       DB DIR_N, DIR_S, DIR_E, DIR_W, DIR_NE, DIR_NW, DIR_SE, DIR_SW
   1864   f1 ef 11 0f   
                        
                        ; ==============================================================================
                        ; End of Evaluation
                        ; (EVAL_WITH_PST/EVAL_PST_SCAN/EVAL_PST_NEXT stub family removed 2026-06-04 —
                        ;  zero call-sites; reclaimed for SEE. EVALUATE_MATERIAL kept, 1 live caller.)
                        ; ==============================================================================
                        ; ==============================================================================
                        ; RCA 1802/1806 Chess Engine - Piece-Square Tables
                        ; ==============================================================================
                        ; Positional bonuses based on piece placement
                        ; Values in centipawns (signed 8-bit: -128 to +127)
                        ;
                        ; Tables are from White's perspective (flip for Black)
                        ; Total size: 6 tables x 64 squares = 384 bytes
                        ; ==============================================================================
                        
                        ; ------------------------------------------------------------------------------
                        ; PAWN PST - Encourage central pawns and advancement
                        ; ------------------------------------------------------------------------------
                        ; Index 0-7 = Rank 1 (a1-h1), Index 56-63 = Rank 8 (a8-h8)
                        ; For White: index = rank*8 + file (rank 0 = Rank 1)
                        ; For Black: index XOR $38 flips rank (Black's Rank 8 maps to Rank 1 values)
                        ; ------------------------------------------------------------------------------
   1868                 PST_PAWN:
                            ; Rank 1 (index 0-7) - pawns never here
   1868   00 00 00 00       DB  0,  0,  0,  0,  0,  0,  0,  0
   186c   00 00 00 00   
                            ; Rank 2 (index 8-15) - starting position
   1870   05 0a 0a ec       DB  5, 10, 10,-20,-20, 10, 10,  5
   1874   ec 0a 0a 05   
                            ; Rank 3 (index 16-23)
   1878   05 fb f6 00       DB  5, -5,-10,  0,  0,-10, -5,  5
   187c   00 f6 fb 05   
                            ; Rank 4 (index 24-31) - center control
   1880   00 00 00 14       DB  0,  0,  0, 20, 20,  0,  0,  0
   1884   14 00 00 00   
                            ; Rank 5 (index 32-39)
   1888   05 05 0a 19       DB  5,  5, 10, 25, 25, 10,  5,  5
   188c   19 0a 05 05   
                            ; Rank 6 (index 40-47)
   1890   0a 0a 14 1e       DB 10, 10, 20, 30, 30, 20, 10, 10
   1894   1e 14 0a 0a   
                            ; Rank 7 (index 48-55) - about to promote!
   1898   32 32 32 32       DB 50, 50, 50, 50, 50, 50, 50, 50
   189c   32 32 32 32   
                            ; Rank 8 (index 56-63) - promotion rank
   18a0   00 00 00 00       DB  0,  0,  0,  0,  0,  0,  0,  0
   18a4   00 00 00 00   
                        
                        ; ------------------------------------------------------------------------------
                        ; KNIGHT PST - Knights love the center, hate the rim
                        ; ------------------------------------------------------------------------------
   18a8                 PST_KNIGHT:
                            ; Rank 1
   18a8   ce d8 e2 e2       DB -50,-40,-30,-30,-30,-30,-40,-50
   18ac   e2 e2 d8 ce   
                            ; Rank 2
   18b0   d8 ec 00 05       DB -40,-20,  0,  5,  5,  0,-20,-40
   18b4   05 00 ec d8   
                            ; Rank 3
   18b8   e2 05 0a 0f       DB -30,  5, 10, 15, 15, 10,  5,-30
   18bc   0f 0a 05 e2   
                            ; Rank 4
   18c0   e2 00 0f 14       DB -30,  0, 15, 20, 20, 15,  0,-30
   18c4   14 0f 00 e2   
                            ; Rank 5
   18c8   e2 05 0f 14       DB -30,  5, 15, 20, 20, 15,  5,-30
   18cc   14 0f 05 e2   
                            ; Rank 6
   18d0   e2 00 0a 0f       DB -30,  0, 10, 15, 15, 10,  0,-30
   18d4   0f 0a 00 e2   
                            ; Rank 7
   18d8   d8 ec 00 00       DB -40,-20,  0,  0,  0,  0,-20,-40
   18dc   00 00 ec d8   
                            ; Rank 8
   18e0   ce d8 e2 e2       DB -50,-40,-30,-30,-30,-30,-40,-50
   18e4   e2 e2 d8 ce   
                        
                        ; ------------------------------------------------------------------------------
                        ; BISHOP PST - Avoid corners, prefer long diagonals
                        ; ------------------------------------------------------------------------------
   18e8                 PST_BISHOP:
                            ; Rank 1 - penalize undeveloped bishops on c1/f1
   18e8   ec f6 f1 f6       DB -20,-10,-15,-10,-10,-15,-10,-20
   18ec   f6 f1 f6 ec   
                            ; Rank 2
   18f0   f6 05 00 00       DB -10,  5,  0,  0,  0,  0,  5,-10
   18f4   00 00 05 f6   
                            ; Rank 3
   18f8   f6 0a 0a 0a       DB -10, 10, 10, 10, 10, 10, 10,-10
   18fc   0a 0a 0a f6   
                            ; Rank 4
   1900   f6 00 0a 0a       DB -10,  0, 10, 10, 10, 10,  0,-10
   1904   0a 0a 00 f6   
                            ; Rank 5
   1908   f6 05 05 0a       DB -10,  5,  5, 10, 10,  5,  5,-10
   190c   0a 05 05 f6   
                            ; Rank 6
   1910   f6 00 05 0a       DB -10,  0,  5, 10, 10,  5,  0,-10
   1914   0a 05 00 f6   
                            ; Rank 7
   1918   f6 00 00 00       DB -10,  0,  0,  0,  0,  0,  0,-10
   191c   00 00 00 f6   
                            ; Rank 8
   1920   ec f6 f6 f6       DB -20,-10,-10,-10,-10,-10,-10,-20
   1924   f6 f6 f6 ec   
                        
                        ; ------------------------------------------------------------------------------
                        ; ROOK PST - 7th rank is golden, open files later
                        ; ------------------------------------------------------------------------------
   1928                 PST_ROOK:
                            ; Rank 1 - penalize undeveloped corner rooks, prefer central
   1928   f1 00 00 05       DB -15,  0,  0,  5,  5,  0,  0,-15
   192c   05 00 00 f1   
                            ; Rank 2
   1930   fb 00 00 00       DB -5,  0,  0,  0,  0,  0,  0, -5
   1934   00 00 00 fb   
                            ; Rank 3
   1938   fb 00 00 00       DB -5,  0,  0,  0,  0,  0,  0, -5
   193c   00 00 00 fb   
                            ; Rank 4
   1940   fb 00 00 00       DB -5,  0,  0,  0,  0,  0,  0, -5
   1944   00 00 00 fb   
                            ; Rank 5
   1948   fb 00 00 00       DB -5,  0,  0,  0,  0,  0,  0, -5
   194c   00 00 00 fb   
                            ; Rank 6
   1950   fb 00 00 00       DB -5,  0,  0,  0,  0,  0,  0, -5
   1954   00 00 00 fb   
                            ; Rank 7 - "pig" on 7th rank
   1958   05 0a 0a 0a       DB  5, 10, 10, 10, 10, 10, 10,  5
   195c   0a 0a 0a 05   
                            ; Rank 8
   1960   00 00 00 00       DB  0,  0,  0,  0,  0,  0,  0,  0
   1964   00 00 00 00   
                        
                        ; ------------------------------------------------------------------------------
                        ; QUEEN PST - Slight preference for center, avoid early development
                        ; ------------------------------------------------------------------------------
   1968                 PST_QUEEN:
                            ; Rank 1 - starting position OK
   1968   ec f6 f6 fb       DB -20,-10,-10, -5, -5,-10,-10,-20
   196c   fb f6 f6 ec   
                            ; Rank 2
   1970   f6 00 05 00       DB -10,  0,  5,  0,  0,  0,  0,-10
   1974   00 00 00 f6   
                            ; Rank 3
   1978   f6 05 05 05       DB -10,  5,  5,  5,  5,  5,  0,-10
   197c   05 05 00 f6   
                            ; Rank 4
   1980   00 00 05 05       DB   0,  0,  5,  5,  5,  5,  0, -5
   1984   05 05 00 fb   
                            ; Rank 5
   1988   fb 00 05 05       DB  -5,  0,  5,  5,  5,  5,  0, -5
   198c   05 05 00 fb   
                            ; Rank 6
   1990   f6 00 05 05       DB -10,  0,  5,  5,  5,  5,  0,-10
   1994   05 05 00 f6   
                            ; Rank 7 - penalize edge squares in enemy territory
   1998   ec f6 00 00       DB -20,-10,  0,  0,  0,  0,-10,-20
   199c   00 00 f6 ec   
                            ; Rank 8 - heavy penalty for deep queen raids
   19a0   e2 ec ec f6       DB -30,-20,-20,-10,-10,-20,-20,-30
   19a4   f6 ec ec e2   
                        
                        ; ------------------------------------------------------------------------------
                        ; KING PST (Middlegame) - Castle! Stay safe on the side
                        ; ------------------------------------------------------------------------------
   19a8                 PST_KING:
                            ; Rank 1 - castled king is safest (b1/g1 kingside, c1 queenside).
                            ; NOTE (2026-07-08): a context-free kingside-over-queenside notch was
                            ; tried here (10,30,15,...) and REVERTED same day — control probe
                            ; test_castle_control2_win17 showed it taxing quiet-queen O-O-O wins
                            ; (displaced a game-winning castle at balanced eval). The anti-storm
                            ; bias lives in OOO_DISCOMFORT (overflow-7b00.asm) instead, gated on
                            ; an actual developed enemy queen — zero tax on quiet positions.
   19a8   14 3c 28 ec       DB  20, 60, 40,-20,-20, 10, 60, 20
   19ac   ec 0a 3c 14   
                            ; Rank 2 - behind pawn shelter OK
   19b0   14 14 f6 e2       DB  20, 20,-10,-30,-30,-10, 20, 20
   19b4   e2 f6 14 14   
                            ; Rank 3
   19b8   f6 ec ec ec       DB -10,-20,-20,-20,-20,-20,-20,-10
   19bc   ec ec ec f6   
                            ; Rank 4
   19c0   ec e2 e2 d8       DB -20,-30,-30,-40,-40,-30,-30,-20
   19c4   d8 e2 e2 ec   
                            ; Rank 5
   19c8   e2 d8 d8 ce       DB -30,-40,-40,-50,-50,-40,-40,-30
   19cc   ce d8 d8 e2   
                            ; Rank 6
   19d0   e2 d8 d8 ce       DB -30,-40,-40,-50,-50,-40,-40,-30
   19d4   ce d8 d8 e2   
                            ; Rank 7
   19d8   e2 d8 d8 ce       DB -30,-40,-40,-50,-50,-40,-40,-30
   19dc   ce d8 d8 e2   
                            ; Rank 8
   19e0   e2 d8 d8 ce       DB -30,-40,-40,-50,-50,-40,-40,-30
   19e4   ce d8 d8 e2   
                        
                        ; ==============================================================================
                        ; PST Table Address Lookup
                        ; ==============================================================================
                        ; Index by piece type (1-6) to get table address
   19e8                 PST_TABLE_LO:
   19e8   00                DB 0                    ; 0 = empty (unused)
   19e9   68                DB LOW(PST_PAWN)        ; 1 = pawn
   19ea   a8                DB LOW(PST_KNIGHT)      ; 2 = knight
   19eb   e8                DB LOW(PST_BISHOP)      ; 3 = bishop
   19ec   28                DB LOW(PST_ROOK)        ; 4 = rook
   19ed   68                DB LOW(PST_QUEEN)       ; 5 = queen
   19ee   a8                DB LOW(PST_KING)        ; 6 = king
                        
   19ef                 PST_TABLE_HI:
   19ef   00                DB 0
   19f0   18                DB HIGH(PST_PAWN)
   19f1   18                DB HIGH(PST_KNIGHT)
   19f2   18                DB HIGH(PST_BISHOP)
   19f3   19                DB HIGH(PST_ROOK)
   19f4   19                DB HIGH(PST_QUEEN)
   19f5   19                DB HIGH(PST_KING)
                        
                        ; ==============================================================================
                        ; EVAL_PST - Add piece-square table bonuses to score
                        ; ==============================================================================
                        ; Input:  6 = current score (material)
                        ; Output: 6 = score + PST bonuses
                        ; Uses:   A, D, E, F
                        ;
                        ; Algorithm:
                        ;   For each piece on board:
                        ;     1. Get piece type and color
                        ;     2. Convert 0x88 square to 0-63 index
                        ;     3. For black pieces, flip the rank (mirror vertically)
                        ;     4. Look up PST value
                        ;     5. Add (white) or subtract (black) from score
                        ; ==============================================================================
   19f6                 EVAL_PST:
                            ; Ensure X=2 for all stack operations
   19f6   e2                SEX 2
                        
                            ; Save score (R9 is score accumulator, NOT R6 which is SCRT linkage!)
   19f7   89                GLO 9
   19f8   73                STXD
   19f9   99                GHI 9
   19fa   73                STXD
                        
                            ; Save R15 (used by caller for move count in quiescence search)
   19fb   8f                GLO 15
   19fc   73                STXD
   19fd   9f                GHI 15
   19fe   73                STXD
                        
                            ; Initialize PST accumulator
   19ff   f8 00             LDI 0
   1a01   b7                PHI 7
   1a02   a7                PLO 7               ; 7 = 0
                        
                            ; Point to board
   1a03   68 ca 60 00       RLDI 10, BOARD
                        
                            ; Loop counter in memory (R14 is off-limits - BIOS uses it!)
   1a07   68 c8 64 40       RLDI 8, EVAL_TEMP1
   1a0b   f8 00             LDI 0
   1a0d   58                STR 8               ; EVAL_TEMP1 = 0 (square index)
                        
   1a0e                 EVAL_PST_LOOP:
                            ; Check if valid square (load from memory)
   1a0e   68 c8 64 40       RLDI 8, EVAL_TEMP1
   1a12   08                LDN 8               ; D = square index
   1a13   fa 88             ANI $88
   1a15   ca 1a 8c          LBNZ EVAL_PST_NEXT_SQ
                        
                            ; Load piece
   1a18   0a                LDN 10
   1a19   c2 1a 8c          LBZ EVAL_PST_NEXT_SQ ; Empty square
                        
                            ; Save piece
   1a1c   af                PLO 15               ; F.0 = piece
                        
                            ; Get piece type
   1a1d   fa 07             ANI PIECE_MASK
   1a1f   ad                PLO 13               ; D.0 = piece type (1-6)
                        
                            ; Get PST table address for this piece type
   1a20   68 cb 19 e8       RLDI 11, PST_TABLE_LO
   1a24   8d                GLO 13               ; Piece type
   1a25   52                STR 2
   1a26   8b                GLO 11
   1a27   f4                ADD
   1a28   ab                PLO 11
   1a29   9b                GHI 11
   1a2a   7c 00             ADCI 0
   1a2c   bb                PHI 11               ; Propagate carry across page boundary
   1a2d   0b                LDN 11               ; D = low byte of PST address
   1a2e   bd                PHI 13               ; Save in D.1 temporarily
                        
   1a2f   68 cb 19 ef       RLDI 11, PST_TABLE_HI
   1a33   8d                GLO 13               ; Piece type (still in D.0? No, need to reload)
   1a34   8f                GLO 15               ; Get piece back
   1a35   fa 07             ANI PIECE_MASK
   1a37   52                STR 2
   1a38   8b                GLO 11
   1a39   f4                ADD
   1a3a   ab                PLO 11
   1a3b   0b                LDN 11               ; High byte of PST address
   1a3c   bb                PHI 11
   1a3d   9d                GHI 13               ; Low byte (saved earlier)
   1a3e   ab                PLO 11               ; B = PST table base for this piece
                        
                            ; Convert 0x88 square to 0-63 index
                            ; Index = (rank * 8) + file
                            ; For 0x88: rank = sq >> 4, file = sq & 7
                            ; Load square from memory (R14 is off-limits!)
   1a3f   68 c8 64 40       RLDI 8, EVAL_TEMP1
   1a43   08                LDN 8               ; D = square (0x88 format)
   1a44   73                STXD                ; Save square on stack for reuse
   1a45   fa 07             ANI $07             ; File (0-7)
   1a47   ad                PLO 13               ; D.0 = file
                        
   1a48   60                IRX
   1a49   f0                LDX                 ; D = square again
   1a4a   fa 70             ANI $70             ; Rank * 16
   1a4c   f6                SHR                 ; Rank * 8
   1a4d   52                STR 2
   1a4e   8d                GLO 13
   1a4f   f4                ADD                 ; Index = rank*8 + file
   1a50   ad                PLO 13               ; D.0 = 0-63 index
                        
                            ; For black pieces, flip the index (mirror board)
                            ; New index = 63 - index = (7-rank)*8 + (7-file)
                            ; Simpler: XOR with $38 flips rank (keeps file same within rank)
   1a51   8f                GLO 15               ; Get piece
   1a52   fa 08             ANI COLOR_MASK
   1a54   c2 1a 5b          LBZ EVAL_PST_WHITE   ; long branch: insertion shifted page boundary
                        
                            ; Black piece - flip rank
   1a57   8d                GLO 13
   1a58   fb 38             XRI $38             ; Flip rank bits
   1a5a   ad                PLO 13
                        
   1a5b                 EVAL_PST_WHITE:
                            ; Look up PST value
   1a5b   8d                GLO 13               ; Index
   1a5c   52                STR 2
   1a5d   8b                GLO 11
   1a5e   f4                ADD
   1a5f   ab                PLO 11
   1a60   9b                GHI 11
   1a61   7c 00             ADCI 0
   1a63   bb                PHI 11
   1a64   0b                LDN 11               ; D = PST value (signed 8-bit)
                        
                            ; Extend sign to 16-bit
   1a65   ad                PLO 13               ; D.0 = PST value
   1a66   fa 80             ANI $80             ; Check sign bit
   1a68   c2 1a 71          LBZ EVAL_PST_POSITIVE
   1a6b   f8 ff             LDI $FF
   1a6d   bd                PHI 13               ; D = sign-extended negative
   1a6e   c0 1a 74          LBR EVAL_PST_ADD
                        
   1a71                 EVAL_PST_POSITIVE:
   1a71   f8 00             LDI 0
   1a73   bd                PHI 13               ; D = sign-extended positive
                        
   1a74                 EVAL_PST_ADD:
                            ; Add or subtract based on color
   1a74   8f                GLO 15               ; Get piece
   1a75   fa 08             ANI COLOR_MASK
   1a77   c2 1a 82          LBZ EVAL_PST_ADD_WHITE
                        
                            ; Black - subtract from accumulator (7 = 7 - D)
                            ; Actually: negate D, then add
   1a7a   8d                GLO 13
   1a7b   fd 00             SDI 0               ; D.0 = -D.0
   1a7d   ad                PLO 13
   1a7e   9d                GHI 13
   1a7f   7d 00             SDBI 0              ; D.1 = -D.1 - borrow
   1a81   bd                PHI 13
                        
   1a82                 EVAL_PST_ADD_WHITE:
                            ; Add D to accumulator (7)
   1a82   8d                GLO 13
   1a83   52                STR 2
   1a84   87                GLO 7
   1a85   f4                ADD
   1a86   a7                PLO 7
                        
   1a87   9d                GHI 13
   1a88   52                STR 2
   1a89   97                GHI 7
   1a8a   74                ADC
   1a8b   b7                PHI 7
                        
   1a8c                 EVAL_PST_NEXT_SQ:
   1a8c   1a                INC 10               ; Next board position
                            ; Increment square index in memory (R14 is off-limits!)
   1a8d   68 c8 64 40       RLDI 8, EVAL_TEMP1
   1a91   08                LDN 8               ; D = square index
   1a92   fc 01             ADI 1               ; Increment
   1a94   58                STR 8               ; Store back
   1a95   fb 80             XRI $80             ; Done when index = 128
   1a97   ca 1a 0e          LBNZ EVAL_PST_LOOP
                        
                            ; Add PST accumulator to score
                            ; Restore R15 first (LIFO - it was pushed last)
   1a9a   60                IRX
   1a9b   72                LDXA
   1a9c   bf                PHI 15
   1a9d   f0                LDX
   1a9e   af                PLO 15
                        
                            ; Now restore material score (R9)
   1a9f   60                IRX
   1aa0   72                LDXA
   1aa1   b9                PHI 9
   1aa2   f0                LDX
   1aa3   a9                PLO 9
                        
                            ; R9 = R9 + R7
   1aa4   87                GLO 7
   1aa5   52                STR 2
   1aa6   89                GLO 9
   1aa7   f4                ADD
   1aa8   a9                PLO 9
                        
   1aa9   97                GHI 7
   1aaa   52                STR 2
   1aab   99                GHI 9
   1aac   74                ADC
   1aad   b9                PHI 9
                        
   1aae   d5                RETN
                        
                        ; ==============================================================================
                        ; End of Piece-Square Tables
                        ; ==============================================================================
                        ; ==============================================================================
                        ; RCA 1802/1806 Chess Engine - Endgame Heuristics
                        ; ==============================================================================
                        ; Special evaluation bonuses for endgame positions:
                        ; 1. King centralization when material is low
                        ; 2. Drive enemy king to edge/corner in winning positions
                        ; 3. Passed pawn bonus
                        ; ==============================================================================
                        
                        ; Endgame threshold (in centipawns of total material)
                        ; Below this, we're in the endgame
                        ; Roughly: 2 rooks + 2 minor = 2*500 + 2*325 = 1650
   0068                 ENDGAME_THRESHOLD_LO    EQU $68     ; 1640 = $0668
   0006                 ENDGAME_THRESHOLD_HI    EQU $06
                        
                        ; King centralization table (bonus for king being in center during endgame)
                        ; Higher values in center, lower on edges
   1aaf                 KING_CENTER_TABLE:
                            ; Rank 8
   1aaf   e2 ec f6 00       DB -30,-20,-10,  0,  0,-10,-20,-30
   1ab3   00 f6 ec e2   
                            ; Rank 7
   1ab7   ec f6 00 0a       DB -20,-10,  0, 10, 10,  0,-10,-20
   1abb   0a 00 f6 ec   
                            ; Rank 6
   1abf   f6 00 0a 14       DB -10,  0, 10, 20, 20, 10,  0,-10
   1ac3   14 0a 00 f6   
                            ; Rank 5
   1ac7   00 0a 14 1e       DB   0, 10, 20, 30, 30, 20, 10,  0
   1acb   1e 14 0a 00   
                            ; Rank 4
   1acf   00 0a 14 1e       DB   0, 10, 20, 30, 30, 20, 10,  0
   1ad3   1e 14 0a 00   
                            ; Rank 3
   1ad7   f6 00 0a 14       DB -10,  0, 10, 20, 20, 10,  0,-10
   1adb   14 0a 00 f6   
                            ; Rank 2
   1adf   ec f6 00 0a       DB -20,-10,  0, 10, 10,  0,-10,-20
   1ae3   0a 00 f6 ec   
                            ; Rank 1
   1ae7   e2 ec f6 00       DB -30,-20,-10,  0,  0,-10,-20,-30
   1aeb   00 f6 ec e2   
                        
                        ; King to edge table (bonus for enemy king on edge/corner — drive-to-mate)
                        ; Use this when we're winning to drive enemy king to corner.
                        ; Higher values at edges/corners, lower in center.
                        ; Retuned 2026-06-15: steepened ~1.5x toward corners (proven mate-shuffle:
                        ; R+Q+5P vs lone K dawdled ~22 moves, eval flat — the edge gradient was too
                        ; shallow to actively squeeze the enemy king to a corner). Max 90, SHL'd to
                        ; 180cp at the corner (still <256, no byte overflow). Zero new bytes.
   1aef                 KING_EDGE_TABLE:
                            ; Rank 8
   1aef   5a 4b 3c 2d       DB  90, 75, 60, 45, 45, 60, 75, 90
   1af3   2d 3c 4b 5a   
                            ; Rank 7
   1af7   4b 3c 2d 1e       DB  75, 60, 45, 30, 30, 45, 60, 75
   1afb   1e 2d 3c 4b   
                            ; Rank 6
   1aff   3c 2d 1e 0f       DB  60, 45, 30, 15, 15, 30, 45, 60
   1b03   0f 1e 2d 3c   
                            ; Rank 5
   1b07   2d 1e 0f 00       DB  45, 30, 15,  0,  0, 15, 30, 45
   1b0b   00 0f 1e 2d   
                            ; Rank 4
   1b0f   2d 1e 0f 00       DB  45, 30, 15,  0,  0, 15, 30, 45
   1b13   00 0f 1e 2d   
                            ; Rank 3
   1b17   3c 2d 1e 0f       DB  60, 45, 30, 15, 15, 30, 45, 60
   1b1b   0f 1e 2d 3c   
                            ; Rank 2
   1b1f   4b 3c 2d 1e       DB  75, 60, 45, 30, 30, 45, 60, 75
   1b23   1e 2d 3c 4b   
                            ; Rank 1
   1b27   5a 4b 3c 2d       DB  90, 75, 60, 45, 45, 60, 75, 90
   1b2b   2d 3c 4b 5a   
                        
                        ; ------------------------------------------------------------------------------
                        ; KING_PROX_BONUS - friendly-king-to-enemy-king proximity, indexed by Chebyshev
                        ; distance (0-7). The missing mating ingredient: edging the enemy king alone
                        ; never mates — the winning side's king must march up to support. Small-distance
                        ; = high bonus gives the shallow search a downhill gradient to walk the king in.
                        ; Kings can never be adjacent (dist<2 illegal), so 2 = closest = max pull.
                        ; ------------------------------------------------------------------------------
                        ; Retuned 2026-06-15: ~4x stronger (was 0,0,40,32,24,16,8,0 = 8cp/step).
                        ; PROVEN bottleneck: in the R+Q+5P vs K mate the winning king refused to march
                        ; (g1<->h1<->f1 shuffle for ~11 moves) because closing toward the enemy king
                        ; netted only +8cp — tied with shuffling, so the engine wouldn't commit. The
                        ; mate appeared the instant the king finally reached the enemy. Now ~30-35cp/
                        ; step so each marching step clearly beats a wait move. Max 150 < passer/runner
                        ; bonuses (250-600) so this never pulls the king off a passer in a K+P race.
   1b2f                 KING_PROX_BONUS:
   1b2f   00 00 96 73       DB   0,  0,150,115, 80, 50, 25,  0   ; dist 0..7 (~30-35cp/step march)
   1b33   50 32 19 00   
                        
                        ; ==============================================================================
                        ; EVAL_ENDGAME - Add endgame-specific bonuses
                        ; ==============================================================================
                        ; Input:  6 = current score (material + PST)
                        ;         7 = total material on board (calculated externally, or we calculate)
                        ; Output: 6 = score with endgame bonuses
                        ; Uses:   A, B, D, E, F
                        ;
                        ; Logic:
                        ;   1. Check if we're in endgame (material below threshold)
                        ;   2. If endgame:
                        ;      - Add king centralization bonus for friendly king
                        ;      - If winning significantly, add enemy king edge bonus
                        ; ==============================================================================
   1b37                 EVAL_ENDGAME:
                            ; First, calculate total material to determine if we're in endgame
                            ; We'll do a quick scan counting major/minor pieces
   1b37   d4 1b f1          CALL CALC_TOTAL_MATERIAL
                            ; Returns: 7 = total material (both sides combined, no pawns)
                        
                            ; Compare with endgame threshold
                            ; If 7 < threshold, we're in endgame
   1b3a   f8 68             LDI ENDGAME_THRESHOLD_LO
   1b3c   52                STR 2
   1b3d   87                GLO 7
   1b3e   f7                SM                  ; D = 7.0 - threshold.0
   1b3f   ad                PLO 13
   1b40   f8 06             LDI ENDGAME_THRESHOLD_HI
   1b42   52                STR 2
   1b43   97                GHI 7
   1b44   77                SMB                 ; D = 7.1 - threshold.1 - borrow
                        
                            ; If result is negative (DF=0), we're in endgame
   1b45   c3 1b f0          LBDF EVAL_EG_DONE    ; Not in endgame, skip
                        
                            ; === IN ENDGAME ===
                        
                            ; Get our king position and add centralization bonus
   1b48   68 ca 60 80       RLDI 10, GAME_STATE + STATE_SIDE_TO_MOVE
   1b4c   0a                LDN 10               ; D = side to move
                        
   1b4d   c2 1b 66          LBZ EVAL_EG_WHITE_KING
                        
   1b50                 EVAL_EG_BLACK_KING:
                            ; Black to move - get black king position
   1b50   68 ca 60 87       RLDI 10, GAME_STATE + STATE_B_KING_SQ
   1b54   0a                LDN 10               ; D = black king square
                            ; Store our king square in memory (R14 is off-limits!)
   1b55   73                STXD                 ; Save on stack temporarily
   1b56   68 c8 64 40       RLDI 8, EVAL_TEMP1
   1b5a   60                IRX
   1b5b   f0                LDX
   1b5c   58                STR 8               ; EVAL_TEMP1 = our king square
                        
                            ; Get enemy (white) king for edge penalty
   1b5d   68 ca 60 86       RLDI 10, GAME_STATE + STATE_W_KING_SQ
   1b61   0a                LDN 10
   1b62   af                PLO 15               ; F.0 = enemy king square
   1b63   c0 1b 79          LBR EVAL_EG_CALC
                        
   1b66                 EVAL_EG_WHITE_KING:
                            ; White to move - get white king position
   1b66   68 ca 60 86       RLDI 10, GAME_STATE + STATE_W_KING_SQ
   1b6a   0a                LDN 10
                            ; Store our king square in memory (R14 is off-limits!)
   1b6b   73                STXD                 ; Save on stack temporarily
   1b6c   68 c8 64 40       RLDI 8, EVAL_TEMP1
   1b70   60                IRX
   1b71   f0                LDX
   1b72   58                STR 8               ; EVAL_TEMP1 = our king square
                        
                            ; Get enemy (black) king for edge penalty
   1b73   68 ca 60 87       RLDI 10, GAME_STATE + STATE_B_KING_SQ
   1b77   0a                LDN 10
   1b78   af                PLO 15               ; F.0 = enemy king square
                        
   1b79                 EVAL_EG_CALC:
                            ; Convert our king square to 0-63 index (load from EVAL_TEMP1)
   1b79   68 c8 64 40       RLDI 8, EVAL_TEMP1
   1b7d   08                LDN 8               ; D = our king square
   1b7e   73                STXD                ; Save for reuse
   1b7f   fa 07             ANI $07             ; File
   1b81   ad                PLO 13
   1b82   60                IRX
   1b83   f0                LDX                 ; D = king square again
   1b84   fa 70             ANI $70             ; Rank * 16
   1b86   f6                SHR                 ; Rank * 8
   1b87   52                STR 2
   1b88   8d                GLO 13
   1b89   f4                ADD                 ; Index = rank*8 + file
   1b8a   ad                PLO 13               ; D.0 = index
                        
                            ; Look up centralization bonus
   1b8b   68 cb 1a af       RLDI 11, KING_CENTER_TABLE
   1b8f   8d                GLO 13
   1b90   52                STR 2
   1b91   8b                GLO 11
   1b92   f4                ADD
   1b93   ab                PLO 11
   1b94   9b                GHI 11
   1b95   7c 00             ADCI 0
   1b97   bb                PHI 11
   1b98   0b                LDN 11               ; D = centralization bonus (signed)
                        
                            ; Add to score (6) - sign extend and add using memory temps
                            ; (R14 is off-limits - BIOS uses it!)
   1b99   73                STXD                ; Save value on stack
   1b9a   68 c8 64 40       RLDI 8, EVAL_TEMP1
   1b9e   60                IRX
   1b9f   f0                LDX                 ; D = value
   1ba0   58                STR 8               ; EVAL_TEMP1 = low byte
   1ba1   fa 80             ANI $80
   1ba3   c2 1b ab          LBZ EVAL_EG_CENTER_POS
   1ba6   f8 ff             LDI $FF
   1ba8   c0 1b ad          LBR EVAL_EG_CENTER_STORE_HI
   1bab                 EVAL_EG_CENTER_POS:
   1bab   f8 00             LDI 0
   1bad                 EVAL_EG_CENTER_STORE_HI:
   1bad   18                INC 8               ; Point to EVAL_TEMP2
   1bae   58                STR 8               ; EVAL_TEMP2 = high byte (sign extension)
                        
   1baf                 EVAL_EG_CENTER_ADD:
                            ; Add 16-bit value from memory to R9 (score accumulator, NOT R6!)
   1baf   68 c8 64 40       RLDI 8, EVAL_TEMP1
   1bb3   08                LDN 8               ; D = low byte
   1bb4   52                STR 2
   1bb5   89                GLO 9
   1bb6   f4                ADD
   1bb7   a9                PLO 9
   1bb8   18                INC 8
   1bb9   08                LDN 8               ; D = high byte
   1bba   52                STR 2
   1bbb   99                GHI 9
   1bbc   74                ADC
   1bbd   b9                PHI 9
                        
                            ; Now check if we're winning significantly (score > 200 centipawns)
                            ; If so, add bonus for enemy king being on edge
   1bbe   99                GHI 9
   1bbf   fa 80             ANI $80             ; Check sign
   1bc1   ca 1b f0          LBNZ EVAL_EG_DONE    ; We're losing, don't push enemy king
                        
                            ; Check if score > 200
   1bc4   99                GHI 9
   1bc5   ca 1b ce          LBNZ EVAL_EG_ENEMY_KING ; High byte > 0, definitely > 200
   1bc8   89                GLO 9
   1bc9   ff c8             SMI 200
   1bcb   cb 1b f0          LBNF EVAL_EG_DONE    ; Score < 200, skip enemy king bonus
                        
   1bce                 EVAL_EG_ENEMY_KING:
                            ; Convert enemy king square (F.0) to 0-63 index
   1bce   8f                GLO 15
   1bcf   fa 07             ANI $07             ; File
   1bd1   ad                PLO 13
   1bd2   8f                GLO 15
   1bd3   fa 70             ANI $70             ; Rank * 16
   1bd5   f6                SHR                 ; Rank * 8
   1bd6   52                STR 2
   1bd7   8d                GLO 13
   1bd8   f4                ADD
   1bd9   ad                PLO 13               ; D.0 = index
                        
                            ; Look up edge bonus (penalty for enemy king in center)
   1bda   68 cb 1a ef       RLDI 11, KING_EDGE_TABLE
   1bde   8d                GLO 13
   1bdf   52                STR 2
   1be0   8b                GLO 11
   1be1   f4                ADD
   1be2   ab                PLO 11
   1be3   9b                GHI 11
   1be4   7c 00             ADCI 0
   1be6   bb                PHI 11
   1be7   0b                LDN 11               ; D = edge bonus
                        
                            ; Add to score (unsigned, always positive) - R9 is score!
   1be8   52                STR 2
   1be9   89                GLO 9
   1bea   f4                ADD
   1beb   a9                PLO 9
   1bec   99                GHI 9
   1bed   7c 00             ADCI 0
   1bef   b9                PHI 9
                        
   1bf0                 EVAL_EG_DONE:
   1bf0   d5                RETN
                        
                        ; ==============================================================================
                        ; CALC_TOTAL_MATERIAL - Calculate total non-pawn material on board
                        ; ==============================================================================
                        ; Output: 7 = total material (knights, bishops, rooks, queens)
                        ; Used to determine if we're in endgame
                        ; ==============================================================================
   1bf1                 CALC_TOTAL_MATERIAL:
                            ; Initialize
   1bf1   f8 00             LDI 0
   1bf3   b7                PHI 7
   1bf4   a7                PLO 7               ; 7 = 0
                        
   1bf5   68 ca 60 00       RLDI 10, BOARD
                        
                            ; Square counter in memory (R14 is off-limits!)
   1bf9   68 c8 64 40       RLDI 8, EVAL_TEMP1
   1bfd   f8 00             LDI 0
   1bff   58                STR 8               ; EVAL_TEMP1 = 0
                        
   1c00                 CALC_MAT_LOOP:
                            ; Check valid square (load from memory)
   1c00   68 c8 64 40       RLDI 8, EVAL_TEMP1
   1c04   08                LDN 8               ; D = square counter
   1c05   fa 88             ANI $88
   1c07   ca 1c 3f          LBNZ CALC_MAT_NEXT
                        
                            ; Load piece
   1c0a   0a                LDN 10
   1c0b   c2 1c 3f          LBZ CALC_MAT_NEXT    ; Empty
                        
                            ; Get piece type
   1c0e   fa 07             ANI PIECE_MASK
                        
                            ; Skip pawns and kings
   1c10   fb 01             XRI PAWN_TYPE
   1c12   c2 1c 3f          LBZ CALC_MAT_NEXT
                        
   1c15   8a                GLO 10               ; Get piece again (can't, A is pointer)
                            ; Actually need to reload
   1c16   0a                LDN 10
   1c17   fa 07             ANI PIECE_MASK
   1c19   fb 06             XRI KING_TYPE
   1c1b   c2 1c 3f          LBZ CALC_MAT_NEXT
                        
                            ; It's a minor or major piece - add its value
   1c1e   0a                LDN 10
   1c1f   fa 07             ANI PIECE_MASK      ; Piece type
   1c21   ad                PLO 13               ; D.0 = type
                        
                            ; Get value from table
   1c22   fe                SHL                 ; type * 2 (16-bit values)
   1c23   ab                PLO 11
   1c24   f8 0e             LDI HIGH(PIECE_VALUES)
   1c26   bb                PHI 11
   1c27   f8 00             LDI LOW(PIECE_VALUES)
   1c29   52                STR 2
   1c2a   8b                GLO 11
   1c2b   f4                ADD
   1c2c   ab                PLO 11
   1c2d   9b                GHI 11
   1c2e   7c 00             ADCI 0
   1c30   bb                PHI 11
                        
   1c31   4b                LDA 11               ; High byte of value
   1c32   bd                PHI 13
   1c33   0b                LDN 11               ; Low byte
   1c34   ad                PLO 13               ; D = piece value
                        
                            ; Add to total (7 = 7 + D)
   1c35   8d                GLO 13
   1c36   52                STR 2
   1c37   87                GLO 7
   1c38   f4                ADD
   1c39   a7                PLO 7
   1c3a   9d                GHI 13
   1c3b   52                STR 2
   1c3c   97                GHI 7
   1c3d   74                ADC
   1c3e   b7                PHI 7
                        
   1c3f                 CALC_MAT_NEXT:
   1c3f   1a                INC 10
                            ; Increment square counter in memory (R14 is off-limits!)
   1c40   68 c8 64 40       RLDI 8, EVAL_TEMP1
   1c44   08                LDN 8               ; D = counter
   1c45   fc 01             ADI 1               ; Increment
   1c47   58                STR 8               ; Store back
   1c48   fb 80             XRI $80             ; Check if done (128)
   1c4a   ca 1c 00          LBNZ CALC_MAT_LOOP
                        
   1c4d   d5                RETN
                        
                        ; ==============================================================================
                        ; End of Endgame Heuristics
                        ; ==============================================================================
                        ; ==============================================================================
                        ; RCA 1802/1806 Chess Engine - Negamax Search with Alpha-Beta Pruning
                        ; ==============================================================================
                        ; Core search algorithm
                        ; ==============================================================================
                        
                        ; ------------------------------------------------------------------------------
                        ; Register Usage During Search
                        ; ------------------------------------------------------------------------------
                        ; 0:  Reserved for interrupts/DMA
                        ; 1:  Reserved for interrupt PC
                        ; 2:  Stack pointer (X register) - CRITICAL
                        ; 3:  Program counter (P register) - CRITICAL
                        ; 4:  SCALL routine pointer (BIOS SCRT)
                        ; 5:  SRET routine pointer (BIOS SCRT) - DO NOT USE FOR DATA!
                        ; 6:  SCRT linkage register - DO NOT USE FOR DATA! (corrupted by every CALL)
                        ; 7:  Temp for alpha/beta operations (beta loaded from memory when needed)
                        ; 8:  Best score accumulator
                        ; 9:  Move list pointer / score return value
                        ; A:  Board state pointer (set before search)
                        ; B:  Current move being evaluated
                        ; C:  Color/side to move (0 for white, 8 for black - matches COLOR_MASK)
                        ; D:  Temp/scratch register 1
                        ; E:  Temp/scratch register 2 (move counter)
                        ; F:  Temp/scratch register 3
                        ; NOTE: Alpha/beta stored in memory at ALPHA_HI/LO, BETA_HI/LO (big-endian)
                        ; NOTE: Search depth stored in memory at SEARCH_DEPTH (not in a register)
                        ; ------------------------------------------------------------------------------
                        
                        ; Memory locations for search state - defined in board.asm:
                        ;   BEST_MOVE, NODES_SEARCHED, SEARCH_DEPTH, QS_*, EVAL_SQ_INDEX, KILLER_MOVES
                        ;   ALPHA_HI/LO, BETA_HI/LO, SCORE_HI/LO (big-endian: high byte at lower address)
                        ; All engine variables consolidated at $6400+ region
                        
                        ; ------------------------------------------------------------------------------
                        ; NEGAMAX - Main recursive search function
                        ; ------------------------------------------------------------------------------
                        ; Input:  SEARCH_DEPTH = depth remaining in memory (0 = leaf node, evaluate)
                        ;         ALPHA_HI/LO = alpha (lower bound) in memory (big-endian)
                        ;         BETA_HI/LO = beta (upper bound) in memory (big-endian)
                        ;         C = color (0 for white, 8 for black - matches COLOR_MASK)
                        ;         A = board state pointer
                        ; Output: R9 = score from current position
                        ;         BEST_MOVE = best move found (if at root)
                        ; Uses:   All registers 7-F, stack
                        ; NOTE:   R6 is SCRT linkage register - never used for data!
                        ; ------------------------------------------------------------------------------
   1c4e                 NEGAMAX:
                            ; Ensure X=2 for stack operations
   1c4e   e2                SEX 2
                        
                            ; Stack overflow detection (added 2026-05-12). MOVE_LIST at $7800-$7A7F
                            ; sits directly below stack guard $7B00. If recursion pushes R2 below
                            ; $7B00, MOVE_LIST gets silently corrupted — the suspected cause of the
                            ; 2026-05-11 g8h7 illegal-move output. Flag is checked + emitted as
                            ; UCI info string at each IDS iteration boundary.
   1c4f   d4 00 87          CALL CHECK_STACK_OVERFLOW
                        
                            ; -----------------------------------------------
                            ; PLY LIMIT CHECK: Prevent array overflow
                            ; -----------------------------------------------
                            ; If CURRENT_PLY >= MAX_PLY (8), return static eval
   1c52   68 ca 64 48       RLDI 10, CURRENT_PLY
   1c56   0a                LDN 10              ; D = current ply
   1c57   ff 08             SMI 8               ; D = ply - MAX_PLY
   1c59   cb 1c 6e          LBNF NEGAMAX_PLY_OK ; ply < 8, continue
                        
                            ; Ply limit reached - return static evaluation
   1c5c   d4 0e b4          CALL EVALUATE
                            ; Negate R9 if black to move (white-perspective → side-to-move)
   1c5f   8c                GLO 12
   1c60   fa 08             ANI $08
   1c62   c2 1c 6d          LBZ NEGAMAX_PLY_RET
   1c65   89                GLO 9               ; low byte
   1c66   fd 00             SDI 0               ; negate low
   1c68   a9                PLO 9
   1c69   99                GHI 9               ; high byte
   1c6a   7d 00             SDBI 0              ; negate high with borrow
   1c6c   b9                PHI 9
   1c6d                 NEGAMAX_PLY_RET:
   1c6d   d5                RETN
                        
   1c6e                 NEGAMAX_PLY_OK:
                            ; Save context to ply-indexed state array (no stack manipulation!)
   1c6e   d4 00 18          CALL SAVE_PLY_STATE
                        
   1c71   68 ca 64 1d       RLDI 10, TRACE_WHERE
   1c75   f8 a1             LDI $A1
   1c77   5a                STR 10              ; tracer: in NEGAMAX node
                        
                            ; -- TT node flag: default ALPHA (upper bound) --
   1c78   68 ca 64 48       RLDI 10, CURRENT_PLY
   1c7c   0a                LDN 10
   1c7d   fc d2             ADI LOW(NODE_TT_FLAGS)
   1c7f   aa                PLO 10
   1c80   f8 64             LDI HIGH(NODE_TT_FLAGS)
   1c82   ba                PHI 10
   1c83   f8 02             LDI TT_FLAG_ALPHA
   1c85   5a                STR 10
                        
                            ; Increment node counter (for statistics)
   1c86   d4 2a f4          CALL INC_NODE_COUNT
                        
                            ; -----------------------------------------------
                            ; RTC TIME TRACKING: Always update elapsed time
                            ; -----------------------------------------------
                            ; Read RTC on every node so elapsed time is accurate.
                            ; Only check abort flag and enforce budget during d3+.
                        
                            ; --- RTC elapsed time check ---
                            ; Read current seconds from DS12887 (binary mode)
   1c89   f8 80             LDI $80                     ; Seconds register
   1c8b   52                STR 2
   1c8c   62                OUT 2                       ; Select register, R2++
   1c8d   22                DEC 2                       ; Restore R2
   1c8e   6b                INP 3                       ; D = current_secs, M(R2) = current_secs
   1c8f   a7                PLO 7                       ; R7.0 = current_secs (R7 saved by SAVE_PLY_STATE)
                        
                            ; Load prev_secs, save for delta computation
   1c90   68 cd 64 ca       RLDI 13, SEARCH_PREV_SECS
   1c94   0d                LDN 13                      ; D = prev_secs
   1c95   b7                PHI 7                       ; R7.1 = prev_secs
                        
                            ; Update prev = current
   1c96   87                GLO 7                       ; D = current_secs
   1c97   5d                STR 13                      ; SEARCH_PREV_SECS = current_secs
                        
                            ; Compute delta = current - prev
   1c98   97                GHI 7                       ; D = prev_secs
   1c99   52                STR 2                       ; M(R2) = prev_secs
   1c9a   87                GLO 7                       ; D = current_secs
   1c9b   f7                SM                          ; D = current - prev (SM = D - M(R(X)))
   1c9c   c3 1c a1          LBDF RTC_DELTA_POS          ; DF=1: no borrow, delta >= 0
   1c9f   fc 3c             ADI 60                      ; Wrapped past 59→0: add 60
   1ca1                 RTC_DELTA_POS:
                            ; D = delta seconds (typically 0 or 1)
                        
                            ; Add delta to elapsed counter
   1ca1   52                STR 2                       ; M(R2) = delta
   1ca2   68 cd 64 cb       RLDI 13, SEARCH_ELAPSED
   1ca6   0d                LDN 13                      ; D = elapsed so far
   1ca7   f4                ADD                         ; D = elapsed + delta
   1ca8   cb 1c ad          LBNF RTC_NO_SAT             ; DF=0: no carry, fits in 8 bits
   1cab   f8 ff             LDI 255                     ; Saturate at 255
   1cad                 RTC_NO_SAT:
   1cad   5d                STR 13                      ; SEARCH_ELAPSED = updated value
                        
                            ; -----------------------------------------------
                            ; ABORT CHECK: Only enforce budget during d3+
                            ; -----------------------------------------------
                            ; Depth 1-2 always complete; only abort d3+ if over budget
   1cae   68 cd 64 c5       RLDI 13, CURRENT_MAX_DEPTH
   1cb2   0d                LDN 13                      ; D = current iteration depth
   1cb3   ff 03             SMI 3
   1cb5   cb 1c d9          LBNF NEGAMAX_BUDGET_OK      ; depth < 3, skip abort check
                        
                            ; --- Abort flag check (propagate up recursion during d3) ---
   1cb8   68 cd 64 c4       RLDI 13, SEARCH_ABORTED
   1cbc   0d                LDN 13
   1cbd   ca 1c d1          LBNZ NEGAMAX_ABORT_RETURN   ; Already aborted, bail out
                        
                            ; Check: elapsed >= 180 seconds?
   1cc0   68 cd 64 cb       RLDI 13, SEARCH_ELAPSED
   1cc4   0d                LDN 13                      ; Reload elapsed (clobbered above)
   1cc5   ff b4             SMI 180                     ; D = elapsed - 180 (budget bumped 2026-04-23)
   1cc7   cb 1c d9          LBNF NEGAMAX_BUDGET_OK      ; DF=0: elapsed < 180, continue
                        
                            ; Time exceeded — set abort flag
   1cca   68 cd 64 c4       RLDI 13, SEARCH_ABORTED
   1cce   f8 01             LDI 1
   1cd0   5d                STR 13
                        
   1cd1                 NEGAMAX_ABORT_RETURN:
                            ; Restore ply state and return dummy score
   1cd1   d4 00 54          CALL RESTORE_PLY_STATE
   1cd4   f8 00             LDI 0
   1cd6   b9                PHI 9
   1cd7   a9                PLO 9                       ; R9 = 0 (score irrelevant, will be discarded)
   1cd8   d5                RETN
                        
   1cd9                 NEGAMAX_BUDGET_OK:
                        
                            ; -----------------------------------------------
                            ; FIFTY-MOVE RULE: Check for draw
                            ; -----------------------------------------------
                            ; If halfmove clock >= 100, position is a draw
   1cd9   68 cd 60 83       RLDI 13, GAME_STATE + STATE_HALFMOVE
   1cdd   0d                LDN 13               ; D = halfmove clock
   1cde   ff 64             SMI 100             ; D = halfmove - 100
   1ce0   cb 1c fc          LBNF NEGAMAX_NOT_FIFTY ; If < 100, continue normally (long branch - crosses page)
                        
                            ; Draw return — shared by fifty-move rule and repetition detection
   1ce3                 RETURN_DRAW:
   1ce3   f8 00             LDI 0
   1ce5   b9                PHI 9
   1ce6   a9                PLO 9               ; R9 = 0 (draw score) - R6 is SCRT linkage!
                            ; Save score to SCORE_HI/LO BEFORE restore (RESTORE clobbers R9!)
   1ce7   68 ca 64 46       RLDI 10, SCORE_HI
   1ceb   99                GHI 9
   1cec   5a                STR 10
   1ced   1a                INC 10
   1cee   89                GLO 9
   1cef   5a                STR 10              ; SCORE_HI/LO = 0 (draw)
   1cf0   d4 00 54          CALL RESTORE_PLY_STATE
                            ; Reload R9 from SCORE_HI/LO AFTER restore
   1cf3   68 ca 64 46       RLDI 10, SCORE_HI
   1cf7   4a                LDA 10
   1cf8   b9                PHI 9
   1cf9   0a                LDN 10
   1cfa   a9                PLO 9               ; R9 = draw score (0)
   1cfb   d5                RETN
                        
   1cfc                 NEGAMAX_NOT_FIFTY:
                            ; -----------------------------------------------
                            ; REPETITION DETECTION: Check game position history
                            ; -----------------------------------------------
                            ; Skip at root (ply 0) — root position is the last HASH_HIST
                            ; entry and would always match itself.
   1cfc   68 ca 64 48       RLDI 10, CURRENT_PLY
   1d00   0a                LDN 10
   1d01   c2 1d 3a          LBZ REP_NO_MATCH
                        
                            ; Skip if halfmove clock < 4 — after pawn moves or captures,
                            ; repetition is impossible. Scanning the full hash history with
                            ; 16-bit hashes causes false collisions (~5% with 80+ entries),
                            ; which makes the engine return draw (0) for promotion lines.
   1d04   68 ca 60 83       RLDI 10, GAME_STATE + STATE_HALFMOVE
   1d08   0a                LDN 10              ; D = halfmove clock
   1d09   ff 04             SMI 4
   1d0b   cb 1d 3a          LBNF REP_NO_MATCH   ; halfmove < 4, can't be repetition
                        
                            ; Load current hash into R8
   1d0e   68 ca 64 b9       RLDI 10, HASH_HI
   1d12   4a                LDA 10              ; D = HASH_HI
   1d13   b8                PHI 8
   1d14   0a                LDN 10              ; D = HASH_LO
   1d15   a8                PLO 8               ; R8 = current position hash
                        
                            ; Load history count
   1d16   68 cd 64 eb       RLDI 13, HASH_HIST_COUNT
   1d1a   0d                LDN 13
   1d1b   c2 1d 3a          LBZ REP_NO_MATCH    ; Empty history
   1d1e   ab                PLO 11              ; R11.0 = loop counter
                        
   1d1f   68 c9 65 00       RLDI 9, HASH_HIST   ; R9 → first entry
                        
   1d23                 REP_CHECK_LOOP:
                            ; Compare hi byte
   1d23   49                LDA 9               ; D = hist[i].hi, R9→lo byte
   1d24   52                STR 2               ; temp at M(R2)
   1d25   98                GHI 8               ; D = current.hi
   1d26   f3                XOR                 ; compare
   1d27   ca 1d 34          LBNZ REP_SKIP_LO   ; Hi mismatch
                        
                            ; Hi matched — compare lo byte
   1d2a   49                LDA 9               ; D = hist[i].lo, R9→next entry
   1d2b   52                STR 2
   1d2c   88                GLO 8               ; D = current.lo
   1d2d   f3                XOR
   1d2e   c2 1c e3          LBZ RETURN_DRAW     ; MATCH! Return draw (shared code)
   1d31   c0 1d 35          LBR REP_DEC         ; Mismatch, R9 already past both bytes
                        
   1d34                 REP_SKIP_LO:
   1d34   19                INC 9               ; Skip lo byte
                        
   1d35                 REP_DEC:
   1d35   2b                DEC 11
   1d36   8b                GLO 11
   1d37   ca 1d 23          LBNZ REP_CHECK_LOOP
                        
   1d3a                 REP_NO_MATCH:
                            ; -----------------------------------------------
                            ; Snapshot CHECK_EXT_FLAG → NODE_IN_CHECK[CURRENT_PLY]
                            ; -----------------------------------------------
                            ; CHECK_EXT_FLAG was just set by parent's move-loop iteration to
                            ; indicate "did my (parent's) move give check to opponent (us)". We
                            ; capture it here at NEGAMAX entry — before our own move loop starts
                            ; overwriting it — so downstream pruning code (LMP especially) can
                            ; tell whether THIS node is in check.
                            ;
                            ; Cost: ~10 instructions per node call. Negligible relative to per-
                            ; node search cost (~30K instructions median).
   1d3a   68 ca 64 da       RLDI 10, CHECK_EXT_FLAG
   1d3e   0a                LDN 10              ; D = current check flag (from parent)
   1d3f   ad                PLO 13              ; R13.0 = check flag (temp)
   1d40   68 ca 64 48       RLDI 10, CURRENT_PLY
   1d44   0a                LDN 10              ; D = ply
   1d45   fc 42             ADI LOW(NODE_IN_CHECK)
   1d47   aa                PLO 10
   1d48   f8 67             LDI HIGH(NODE_IN_CHECK)
   1d4a   7c 00             ADCI 0
   1d4c   ba                PHI 10              ; R10 = NODE_IN_CHECK + ply
   1d4d   8d                GLO 13              ; D = saved check flag
   1d4e   5a                STR 10              ; NODE_IN_CHECK[ply] = check flag
                        
                            ; -----------------------------------------------
                            ; Transposition Table Probe
                            ; -----------------------------------------------
                            ; Hash is updated incrementally in MAKE/UNMAKE_MOVE,
                            ; so TT works correctly at all nodes.
                            ;
                            ; Skip TT at root (ply 0): TT_STORE saves the root's BEST_MOVE
                            ; globally, so non-root TT entries have stale/sentinel move data.
                            ; Root must always search fully to guarantee a valid BEST_MOVE.
   1d4f   68 ca 64 48       RLDI 10, CURRENT_PLY
   1d53   0a                LDN 10              ; D = current ply
   1d54   c2 1d 95          LBZ NEGAMAX_TT_MISS ; Root: always search fully
                        
                            ; Load current search depth for comparison
   1d57   68 cd 64 17       RLDI 13, SEARCH_DEPTH + 1
   1d5b   0d                LDN 13              ; D = depth low byte (SEARCH_DEPTH+1 = low byte)
   1d5c   d4 57 d8          CALL TT_PROBE       ; D = required depth, returns D = 1 if hit
   1d5f   c2 1d 95          LBZ NEGAMAX_TT_MISS ; No hit, continue with search
                        
                            ; TT hit - check if it's usable (EXACT bound)
   1d62   68 ca 64 bf       RLDI 10, TT_FLAG
   1d66   0a                LDN 10              ; D = TT flag
   1d67   fb 01             XRI TT_FLAG_EXACT
   1d69   ca 1d 95          LBNZ NEGAMAX_TT_MISS    ; Not exact, can't use directly (for now)
                        
                            ; EXACT hit at non-root node - use the stored score
                            ; (Root is excluded above, so no BEST_MOVE copy needed)
                        
                            ; Get the score and save to SCORE_HI/LO BEFORE restore
                            ; (RESTORE_PLY_STATE clobbers R9!)
                            ; CRITICAL: Reject mate scores from TT to prevent hash collision
                            ; causing stalemate/checkmate misidentification (16-bit hash limit)
   1d6c   68 ca 64 bc       RLDI 10, TT_SCORE_HI
   1d70   0a                LDN 10              ; D = score_hi
   1d71   fb 7f             XRI $7F
   1d73   c2 1d 95          LBZ NEGAMAX_TT_MISS ; Positive mate score → re-search to verify
   1d76   0a                LDN 10              ; D = score_hi (reload)
   1d77   fb 80             XRI $80
   1d79   c2 1d 95          LBZ NEGAMAX_TT_MISS ; Negative mate score → re-search to verify
   1d7c   4a                LDA 10              ; D = score_hi, R10 → score_lo
   1d7d   b9                PHI 9
   1d7e   0a                LDN 10              ; score_lo
   1d7f   a9                PLO 9               ; R9 = stored score
                            ; Save to SCORE_HI/LO so it survives RESTORE
   1d80   68 ca 64 46       RLDI 10, SCORE_HI
   1d84   99                GHI 9
   1d85   5a                STR 10
   1d86   1a                INC 10
   1d87   89                GLO 9
   1d88   5a                STR 10              ; SCORE_HI/LO = TT score
   1d89   d4 00 54          CALL RESTORE_PLY_STATE
                            ; Reload R9 from SCORE_HI/LO AFTER restore
   1d8c   68 ca 64 46       RLDI 10, SCORE_HI
   1d90   4a                LDA 10
   1d91   b9                PHI 9
   1d92   0a                LDN 10
   1d93   a9                PLO 9               ; R9 = TT score (preserved through restore)
   1d94   d5                RETN                ; Return TT score
                        
   1d95                 NEGAMAX_TT_MISS:
                            ; -----------------------------------------------
                            ; Check if we're at a leaf node (depth == 0)
                            ; -----------------------------------------------
                            ; Load depth from memory (SEARCH_DEPTH)
   1d95   68 cd 64 16       RLDI 13, SEARCH_DEPTH
   1d99   4d                LDA 13              ; D = depth high byte
   1d9a   ca 1d a4          LBNZ NEGAMAX_CONTINUE
   1d9d   0d                LDN 13              ; D = depth low byte
   1d9e   ca 1d a4          LBNZ NEGAMAX_CONTINUE
                            ; Depth is 0, evaluate leaf node
   1da1   c0 26 0b          LBR NEGAMAX_LEAF
                        
   1da4                 NEGAMAX_CONTINUE:
                            ; ===============================================
                            ; NULL MOVE PRUNING CHECK
                            ; ===============================================
                            ; If position is so strong that passing still beats beta, prune.
                            ; Conditions: depth >= 3, not in check, NULL_MOVE_OK, ply > 0
                        
                            ; Condition 1: depth >= 3?
   1da4   68 ca 64 17       RLDI 10, SEARCH_DEPTH + 1
   1da8   0a                LDN 10              ; D = depth low byte
   1da9   ff 03             SMI 3               ; D = depth - 3
   1dab   cb 1e c2          LBNF NMP_SKIP       ; depth < 3, skip null move
                        
                            ; Condition 2: ply > 0? (don't do at root)
   1dae   68 ca 64 48       RLDI 10, CURRENT_PLY
   1db2   0a                LDN 10              ; D = current ply
   1db3   c2 1e c2          LBZ NMP_SKIP        ; ply == 0, skip null move
                        
                            ; Condition 3: NULL_MOVE_OK?
   1db6   68 ca 64 a7       RLDI 10, NULL_MOVE_OK
   1dba   0a                LDN 10
   1dbb   c2 1e c2          LBZ NMP_SKIP        ; null move not allowed (already did one)
                        
                            ; Condition 4: NOT in check? (already verified above for non-CE path)
   1dbe   d4 01 8e          CALL IS_IN_CHECK
                            ; D = 1 if in check, 0 if safe
   1dc1   ca 1e c2          LBNZ NMP_SKIP       ; in check, can't pass
                        
                            ; --- All conditions met, try null move ---
                        
                            ; Disable null move for child (prevent consecutive)
   1dc4   68 ca 64 a7       RLDI 10, NULL_MOVE_OK
   1dc8   f8 00             LDI 0
   1dca   5a                STR 10              ; NULL_MOVE_OK = 0
                        
                            ; Save depth to stack
   1dcb   68 cd 64 16       RLDI 13, SEARCH_DEPTH
   1dcf   4d                LDA 13              ; depth_hi
   1dd0   73                STXD
   1dd1   0d                LDN 13              ; depth_lo
   1dd2   73                STXD
                        
                            ; Save alpha/beta to stack
   1dd3   68 cd 64 42       RLDI 13, ALPHA_HI
   1dd7   4d                LDA 13              ; alpha_hi
   1dd8   73                STXD
   1dd9   0d                LDN 13              ; alpha_lo
   1dda   73                STXD
   1ddb   68 cd 64 44       RLDI 13, BETA_HI
   1ddf   4d                LDA 13              ; beta_hi
   1de0   73                STXD
   1de1   0d                LDN 13              ; beta_lo
   1de2   73                STXD
                        
                            ; Make null move (toggle side, update hash, clear EP)
   1de3   d4 0d 92          CALL NULL_MAKE_MOVE
                        
                            ; Set child depth = depth - 3 (R=2 reduction + normal -1)
                            ; Peek depth from stack (at R2+5, R2+6)
   1de6   82                GLO 2
   1de7   fc 06             ADI 6
   1de9   aa                PLO 10
   1dea   92                GHI 2
   1deb   7c 00             ADCI 0
   1ded   ba                PHI 10              ; R10 = &depth_hi on stack
   1dee   0a                LDN 10              ; depth_hi
   1def   b7                PHI 7               ; R7.1 = depth_hi
   1df0   2a                DEC 10
   1df1   0a                LDN 10              ; depth_lo
   1df2   ff 03             SMI 3               ; depth_lo - 3
   1df4   a7                PLO 7
   1df5   97                GHI 7
   1df6   7f 00             SMBI 0              ; depth_hi - borrow
   1df8   b7                PHI 7               ; R7 = depth - 3
                        
                            ; Store child depth to memory
   1df9   68 ca 64 16       RLDI 10, SEARCH_DEPTH
   1dfd   97                GHI 7
   1dfe   5a                STR 10
   1dff   1a                INC 10
   1e00   87                GLO 7
   1e01   5a                STR 10              ; SEARCH_DEPTH = depth - 3
                        
                            ; Set child alpha = -beta (zero window)
                            ; Peek beta from stack (at R2+1, R2+2)
   1e02   82                GLO 2
   1e03   fc 02             ADI 2
   1e05   aa                PLO 10
   1e06   92                GHI 2
   1e07   7c 00             ADCI 0
   1e09   ba                PHI 10              ; R10 = &beta_hi on stack
   1e0a   0a                LDN 10              ; beta_hi
   1e0b   b7                PHI 7
   1e0c   2a                DEC 10
   1e0d   0a                LDN 10              ; beta_lo
   1e0e   a7                PLO 7               ; R7 = beta
                        
                            ; Negate R7 (beta) → R8 = -beta (child alpha)
   1e0f   87                GLO 7               ; low byte
   1e10   fd 00             SDI 0               ; negate low
   1e12   a8                PLO 8
   1e13   97                GHI 7               ; high byte
   1e14   7d 00             SDBI 0              ; negate high with borrow
   1e16   b8                PHI 8               ; R8 = -beta
                        
                            ; Store as new alpha
   1e17   68 ca 64 42       RLDI 10, ALPHA_HI
   1e1b   98                GHI 8
   1e1c   5a                STR 10
   1e1d   1a                INC 10
   1e1e   88                GLO 8
   1e1f   5a                STR 10              ; ALPHA = -beta
                        
                            ; Set child beta = -beta + 1 (zero window)
   1e20   88                GLO 8
   1e21   fc 01             ADI 1
   1e23   a8                PLO 8
   1e24   98                GHI 8
   1e25   7c 00             ADCI 0
   1e27   b8                PHI 8               ; R8 = -beta + 1
                        
   1e28   68 ca 64 44       RLDI 10, BETA_HI
   1e2c   98                GHI 8
   1e2d   5a                STR 10
   1e2e   1a                INC 10
   1e2f   88                GLO 8
   1e30   5a                STR 10              ; BETA = -beta + 1
                        
                            ; Toggle color for child
   1e31   8c                GLO 12
   1e32   fb 08             XRI $08
   1e34   ac                PLO 12
                        
                            ; Increment ply
   1e35   68 ca 64 48       RLDI 10, CURRENT_PLY
   1e39   0a                LDN 10
   1e3a   fc 01             ADI 1
   1e3c   5a                STR 10              ; CURRENT_PLY++
                        
                            ; Recursive call
   1e3d   d4 1c 4e          CALL NEGAMAX
                            ; R9 = score
                        
                            ; Decrement ply
   1e40   68 ca 64 48       RLDI 10, CURRENT_PLY
   1e44   0a                LDN 10
   1e45   ff 01             SMI 1
   1e47   5a                STR 10              ; CURRENT_PLY--
                        
                            ; Toggle color back
   1e48   8c                GLO 12
   1e49   fb 08             XRI $08
   1e4b   ac                PLO 12
                        
                            ; Negate R9 (score = -score)
   1e4c   89                GLO 9               ; low byte
   1e4d   fd 00             SDI 0               ; negate low
   1e4f   a9                PLO 9
   1e50   99                GHI 9               ; high byte
   1e51   7d 00             SDBI 0              ; negate high with borrow
   1e53   b9                PHI 9
                        
                            ; Unmake null move (toggle side back, restore EP, update hash)
   1e54   d4 0d b1          CALL NULL_UNMAKE_MOVE
                        
                            ; Re-enable null move for this level
   1e57   68 ca 64 a7       RLDI 10, NULL_MOVE_OK
   1e5b   f8 01             LDI 1
   1e5d   5a                STR 10              ; NULL_MOVE_OK = 1
                        
                            ; Pop beta from stack into R7
   1e5e   60                IRX
   1e5f   72                LDXA                ; beta_lo
   1e60   a7                PLO 7
   1e61   f0                LDX                 ; beta_hi (R2 now at beta_hi slot)
   1e62   b7                PHI 7               ; R7 = original beta
                        
                            ; Pop alpha from stack into R8
   1e63   60                IRX
   1e64   72                LDXA                ; alpha_lo
   1e65   a8                PLO 8
   1e66   f0                LDX                 ; alpha_hi
   1e67   b8                PHI 8               ; R8 = original alpha
                        
                            ; Pop depth from stack and restore to memory
   1e68   60                IRX
   1e69   72                LDXA                ; depth_lo
   1e6a   ad                PLO 13
   1e6b   f0                LDX                 ; depth_hi
   1e6c   bd                PHI 13              ; R13 = original depth
                        
   1e6d   68 ca 64 16       RLDI 10, SEARCH_DEPTH
   1e71   9d                GHI 13
   1e72   5a                STR 10
   1e73   1a                INC 10
   1e74   8d                GLO 13
   1e75   5a                STR 10              ; SEARCH_DEPTH restored
                            ; R7 = original beta, R8 = original alpha (for NMP_NO_CUTOFF path)
                        
                            ; Compare: score (R9) >= beta (R7)? If so, prune!
                            ; Signed 16-bit comparison
                        
   1e76   68 ca 64 49       RLDI 10, COMPARE_TEMP
   1e7a   ea                SEX 10
                        
                            ; Check if signs differ
   1e7b   99                GHI 9               ; score_hi
   1e7c   5a                STR 10
   1e7d   97                GHI 7               ; beta_hi
   1e7e   f3                XOR
   1e7f   fa 80             ANI $80             ; Check sign bit difference
   1e81   e2                SEX 2
   1e82   ca 1e 95          LBNZ NMP_CHECK_SIGN
                        
                            ; Same sign: score >= beta if (score - beta) has no borrow
   1e85   ea                SEX 10
   1e86   87                GLO 7               ; beta_lo
   1e87   5a                STR 10
   1e88   89                GLO 9               ; score_lo
   1e89   f7                SM                  ; score_lo - beta_lo
   1e8a   97                GHI 7               ; beta_hi
   1e8b   5a                STR 10
   1e8c   99                GHI 9               ; score_hi
   1e8d   77                SMB                 ; score_hi - beta_hi - borrow
   1e8e   e2                SEX 2
   1e8f   cb 1e b0          LBNF NMP_NO_CUTOFF  ; Borrow set = score < beta
   1e92   c0 1e 9b          LBR NMP_CUTOFF      ; No borrow = score >= beta
                        
   1e95                 NMP_CHECK_SIGN:
                            ; Different signs: positive >= negative always
                            ; If score positive (hi bit 0) and beta negative (hi bit 1): score >= beta
   1e95   99                GHI 9               ; score_hi
   1e96   fa 80             ANI $80
   1e98   ca 1e b0          LBNZ NMP_NO_CUTOFF  ; score negative, beta positive: score < beta
                            ; score positive, beta negative: score >= beta
                            ; Fall through to cutoff
                        
   1e9b                 NMP_CUTOFF:
                            ; Null move cutoff! Return beta
                            ; Save beta to SCORE memory (same pattern as NEGAMAX_RETURN)
   1e9b   68 ca 64 46       RLDI 10, SCORE_HI
   1e9f   97                GHI 7               ; beta_hi
   1ea0   5a                STR 10
   1ea1   1a                INC 10
   1ea2   87                GLO 7               ; beta_lo
   1ea3   5a                STR 10              ; SCORE = beta
                        
   1ea4   d4 00 54          CALL RESTORE_PLY_STATE
                        
                            ; Load return value from SCORE memory into R9 (after restore)
   1ea7   68 ca 64 46       RLDI 10, SCORE_HI
   1eab   4a                LDA 10              ; SCORE_HI
   1eac   b9                PHI 9
   1ead   0a                LDN 10              ; SCORE_LO
   1eae   a9                PLO 9               ; R9 = beta
                        
   1eaf   d5                RETN
                        
   1eb0                 NMP_NO_CUTOFF:
                            ; Null move didn't cause cutoff - restore alpha/beta to memory
                            ; R8 = original alpha, R7 = original beta
   1eb0   68 ca 64 42       RLDI 10, ALPHA_HI
   1eb4   98                GHI 8
   1eb5   5a                STR 10
   1eb6   1a                INC 10
   1eb7   88                GLO 8
   1eb8   5a                STR 10              ; ALPHA = original alpha
                        
   1eb9   68 ca 64 44       RLDI 10, BETA_HI
   1ebd   97                GHI 7
   1ebe   5a                STR 10
   1ebf   1a                INC 10
   1ec0   87                GLO 7
   1ec1   5a                STR 10              ; BETA = original beta
                            ; Fall through to normal move generation
                        
   1ec2                 NMP_SKIP:
                            ; -----------------------------------------------
                            ; REVERSE FUTILITY PRUNING (RFP) - DISABLED
                            ; -----------------------------------------------
                            ; RFP margins (150/300cp) are too aggressive for material+PST eval.
                            ; The coarse eval causes search collapse when any PV child finds
                            ; tactical improvement: beta drops and RFP prunes all siblings.
                            ; R7 beta-reload fix (below) is preserved for future re-enable.
                            ;
                            ; Conditions: depth <= 2, ply > 0, not in check
                        
                            ; Condition 1: depth <= 2?
   1ec2   68 ca 64 17       RLDI 10, SEARCH_DEPTH + 1
   1ec6   0a                LDN 10              ; D = depth low byte
   1ec7   ff 03             SMI 3               ; D = depth - 3
   1ec9   c3 1f 4a          LBDF RFP_SKIP       ; depth >= 3, skip RFP
                        
                            ; Condition 2: ply > 0? (don't prune at root)
   1ecc   68 ca 64 48       RLDI 10, CURRENT_PLY
   1ed0   0a                LDN 10              ; D = current ply
   1ed1   c2 1f 4a          LBZ RFP_SKIP        ; ply == 0, skip
                        
                            ; Condition 3: not in check?
   1ed4   d4 01 8e          CALL IS_IN_CHECK
                            ; D = 1 if in check, 0 if safe
   1ed7   ca 1f 4a          LBNZ RFP_SKIP       ; in check, can't prune
                        
                            ; --- All conditions met ---
                            ; Get static eval
   1eda   d4 0e b4          CALL EVALUATE
                            ; R9 = score from white's perspective
                        
                            ; Negate R9 if black to move (white-perspective → side-to-move)
   1edd   8c                GLO 12
   1ede   fa 08             ANI $08
   1ee0   c2 1e eb          LBZ RFP_NO_NEG
   1ee3   89                GLO 9               ; low byte
   1ee4   fd 00             SDI 0               ; negate low
   1ee6   a9                PLO 9
   1ee7   99                GHI 9               ; high byte
   1ee8   7d 00             SDBI 0              ; negate high with borrow
   1eea   b9                PHI 9
   1eeb                 RFP_NO_NEG:
                        
                            ; Save eval in SCORE_HI/LO (for return value if we prune)
   1eeb   68 ca 64 46       RLDI 10, SCORE_HI
   1eef   99                GHI 9
   1ef0   5a                STR 10
   1ef1   1a                INC 10
   1ef2   89                GLO 9
   1ef3   5a                STR 10              ; SCORE_HI/LO = eval
                        
                            ; Select margin based on depth
                            ; Load depth again
   1ef4   68 ca 64 17       RLDI 10, SEARCH_DEPTH + 1
   1ef8   0a                LDN 10              ; D = depth (1 or 2)
   1ef9   ff 02             SMI 2
   1efb   cb 1f 09          LBNF RFP_DEPTH1     ; depth < 2, so depth == 1
                        
                            ; Depth 2: subtract 300cp margin
   1efe   89                GLO 9
   1eff   ff 2c             SMI RFP_MARGIN_D2_LO
   1f01   a9                PLO 9
   1f02   99                GHI 9
   1f03   7f 01             SMBI RFP_MARGIN_D2_HI
   1f05   b9                PHI 9
   1f06   c0 1f 11          LBR RFP_COMPARE
                        
   1f09                 RFP_DEPTH1:
                            ; Depth 1: subtract 150cp margin
   1f09   89                GLO 9
   1f0a   ff 96             SMI RFP_MARGIN_D1_LO
   1f0c   a9                PLO 9
   1f0d   99                GHI 9
   1f0e   7f 00             SMBI RFP_MARGIN_D1_HI
   1f10   b9                PHI 9
                        
   1f11                 RFP_COMPARE:
                            ; R9 = eval - margin
                            ; Compare: (eval - margin) >= beta (R7)?
                            ; Signed 16-bit comparison using same pattern as NMP
                        
                            ; Load beta from memory into R7
                            ; (R7 was clobbered by time tracking code at NEGAMAX entry!)
   1f11   68 ca 64 44       RLDI 10, BETA_HI
   1f15   4a                LDA 10              ; D = beta_hi
   1f16   b7                PHI 7
   1f17   0a                LDN 10              ; D = beta_lo
   1f18   a7                PLO 7               ; R7 = beta
                        
   1f19   68 ca 64 49       RLDI 10, COMPARE_TEMP
   1f1d   ea                SEX 10
                        
                            ; Check if signs differ
   1f1e   99                GHI 9               ; (eval-margin)_hi
   1f1f   5a                STR 10
   1f20   97                GHI 7               ; beta_hi
   1f21   f3                XOR
   1f22   fa 80             ANI $80             ; Check sign bit difference
   1f24   e2                SEX 2
   1f25   ca 1f 38          LBNZ RFP_CHECK_SIGN
                        
                            ; Same sign: (eval-margin) >= beta if no borrow
   1f28   ea                SEX 10
   1f29   87                GLO 7               ; beta_lo
   1f2a   5a                STR 10
   1f2b   89                GLO 9               ; (eval-margin)_lo
   1f2c   f7                SM                  ; (eval-margin)_lo - beta_lo
   1f2d   97                GHI 7               ; beta_hi
   1f2e   5a                STR 10
   1f2f   99                GHI 9               ; (eval-margin)_hi
   1f30   77                SMB                 ; (eval-margin)_hi - beta_hi - borrow
   1f31   e2                SEX 2
   1f32   cb 1f 4a          LBNF RFP_SKIP       ; Borrow = eval-margin < beta, don't prune
   1f35   c0 1f 3e          LBR RFP_PRUNE       ; No borrow = eval-margin >= beta, prune!
                        
   1f38                 RFP_CHECK_SIGN:
                            ; Different signs: positive >= negative always
   1f38   99                GHI 9               ; (eval-margin)_hi
   1f39   fa 80             ANI $80
   1f3b   ca 1f 4a          LBNZ RFP_SKIP       ; eval-margin negative, beta positive: don't prune
                            ; eval-margin positive, beta negative: prune
                            ; Fall through to RFP_PRUNE
                        
   1f3e                 RFP_PRUNE:
                            ; Return eval (saved in SCORE_HI/LO)
   1f3e   d4 00 54          CALL RESTORE_PLY_STATE
                            ; Reload R9 from SCORE_HI/LO after restore
   1f41   68 ca 64 46       RLDI 10, SCORE_HI
   1f45   4a                LDA 10
   1f46   b9                PHI 9
   1f47   0a                LDN 10
   1f48   a9                PLO 9               ; R9 = eval score
   1f49   d5                RETN
                        
   1f4a                 RFP_SKIP:
                            ; -----------------------------------------------
                            ; Generate moves for current position
                            ; -----------------------------------------------
                            ; Use ply-indexed move list to avoid overwrites during recursion!
                            ; Each ply gets 128 bytes (64 moves): PLY 0 at $6200, PLY 1 at $6280, etc.
                            ; ply × 128 overflows 8 bits for ply >= 2, so use 16-bit math:
                            ;   offset_hi = ply >> 1, offset_lo = (ply & 1) << 7
                        
   1f4a   68 ca 64 48       RLDI 10, CURRENT_PLY
   1f4e   0a                LDN 10              ; D = current ply (0-4 with d=5)
                        
                            ; Calculate high byte: HIGH(MOVE_LIST) + (ply >> 1)
   1f4f   f6                SHR                 ; D = ply >> 1 (0 or 1)
   1f50   fc 78             ADI HIGH(MOVE_LIST) ; D = $78 + (ply >> 1)
   1f52   b9                PHI 9               ; R9.1 = high byte
                        
                            ; Calculate low byte: (ply & 1) << 7 = $00 or $80
   1f53   0a                LDN 10              ; D = ply (reload)
   1f54   fa 01             ANI $01             ; D = ply & 1
   1f56   c2 1f 5e          LBZ NEGAMAX_PLY_EVEN
   1f59   f8 80             LDI $80             ; Odd ply: low byte = $80
   1f5b   c0 1f 60          LBR NEGAMAX_PLY_DONE
   1f5e                 NEGAMAX_PLY_EVEN:
   1f5e   f8 00             LDI $00             ; Even ply: low byte = $00
   1f60                 NEGAMAX_PLY_DONE:
   1f60   a9                PLO 9               ; R9 = ply-indexed move list
                        
   1f61   d4 04 d7          CALL GENERATE_MOVES
                            ; Returns: D = move count
                            ; NOTE: R9 now points PAST the end of the move list!
                        
                            ; Save move count to ply-indexed memory (NOT the stack — see LOOP_MOVE_CNT).
                            ; D = count from GENERATE_MOVES; R11 is movegen scratch (dead on return).
   1f64   ab                PLO 11             ; stash count in R11.0
   1f65   68 ca 64 48       RLDI 10, CURRENT_PLY
   1f69   0a                LDN 10             ; D = ply
   1f6a   fc ef             ADI LOW(LOOP_MOVE_CNT)
   1f6c   aa                PLO 10
   1f6d   f8 64             LDI HIGH(LOOP_MOVE_CNT)
   1f6f   ba                PHI 10             ; R10 = &LOOP_MOVE_CNT[ply]
   1f70   8b                GLO 11             ; D = count
   1f71   5a                STR 10             ; LOOP_MOVE_CNT[ply] = count
                        
                            ; Reset R9 to START of ply-indexed move list (128 bytes per ply)
   1f72   68 ca 64 48       RLDI 10, CURRENT_PLY
   1f76   0a                LDN 10              ; D = current ply
                        
                            ; Calculate high byte: HIGH(MOVE_LIST) + (ply >> 1)
   1f77   f6                SHR                 ; D = ply >> 1
   1f78   fc 78             ADI HIGH(MOVE_LIST)
   1f7a   b9                PHI 9
                        
                            ; Calculate low byte: (ply & 1) << 7
   1f7b   0a                LDN 10              ; D = ply (reload)
   1f7c   fa 01             ANI $01
   1f7e   c2 1f 86          LBZ NEGAMAX_RESET_EVEN
   1f81   f8 80             LDI $80
   1f83   c0 1f 88          LBR NEGAMAX_RESET_DONE
   1f86                 NEGAMAX_RESET_EVEN:
   1f86   f8 00             LDI $00
   1f88                 NEGAMAX_RESET_DONE:
   1f88   a9                PLO 9               ; R9 = ply-indexed move list start
                        
                            ; -----------------------------------------------
                            ; Apply killer move ordering (search killers first)
                            ; Apply at plies 0-4: with d=5 search now active, plies 3 and 4 are
                            ; non-leaves with rich subtrees where alpha-beta cutoffs from a
                            ; well-ordered list save exponentially more work. Skip only at ply >= 5
                            ; (where remaining depth is too shallow for ordering to pay off).
                            ; -----------------------------------------------
   1f89   68 ca 64 48       RLDI 10, CURRENT_PLY
   1f8d   0a                LDN 10              ; D = current ply
   1f8e   ff 05             SMI 5               ; Check if ply >= 5
   1f90   c3 1f a2          LBDF NEGAMAX_SKIP_KILLER  ; Skip if ply >= 5
                        
   1f93   68 ca 64 48       RLDI 10, CURRENT_PLY
   1f97   0a                LDN 10              ; D = ply
   1f98   fc ef             ADI LOW(LOOP_MOVE_CNT)
   1f9a   aa                PLO 10
   1f9b   f8 64             LDI HIGH(LOOP_MOVE_CNT)
   1f9d   ba                PHI 10              ; R10 = &LOOP_MOVE_CNT[ply]
   1f9e   0a                LDN 10              ; D = move count (read from memory)
   1f9f   d4 29 b1          CALL ORDER_KILLER_MOVES
                        
   1fa2                 NEGAMAX_SKIP_KILLER:
                            ; -----------------------------------------------
                            ; Order captures first (MVV-LVA preparation)
                            ; Apply at plies 0-4 (same rationale as killers above).
                            ; -----------------------------------------------
   1fa2   68 ca 64 48       RLDI 10, CURRENT_PLY
   1fa6   0a                LDN 10              ; D = current ply
   1fa7   ff 05             SMI 5               ; Check if ply >= 5
   1fa9   c3 1f bb          LBDF NEGAMAX_SKIP_CAPTURE_ORDER  ; Skip if ply >= 5
                        
   1fac   68 ca 64 48       RLDI 10, CURRENT_PLY
   1fb0   0a                LDN 10              ; D = ply
   1fb1   fc ef             ADI LOW(LOOP_MOVE_CNT)
   1fb3   aa                PLO 10
   1fb4   f8 64             LDI HIGH(LOOP_MOVE_CNT)
   1fb6   ba                PHI 10              ; R10 = &LOOP_MOVE_CNT[ply]
   1fb7   0a                LDN 10              ; D = move count (read from memory)
   1fb8   d4 2a 7c          CALL ORDER_CAPTURES_FIRST
                        
   1fbb                 NEGAMAX_SKIP_CAPTURE_ORDER:
                            ; -----------------------------------------------
                            ; Order TT/PV move first (highest-priority ordering hint)
                            ; At ply >= 1: TT_PROBE has populated TT_MOVE_HI/LO (or left empty zeros).
                            ; At root: ITER_BEST_FROM/TO holds the principal-variation move from the
                            ; prior iterative-deepening iteration. Copy it into TT_MOVE_HI/LO so the
                            ; existing ORDER_TT_MOVE puts it at the front. This PV-move-first
                            ; ordering is essentially free (no extra search; the move is already
                            ; computed) and typically halves node counts at the next depth via
                            ; immediate alpha-beta cutoffs.
                            ; ITER_BEST is initialized to $FF/$FF in SEARCH_POSITION; only valid
                            ; after at least one successful iteration completes.
                            ; -----------------------------------------------
   1fbb   68 ca 64 48       RLDI 10, CURRENT_PLY
   1fbf   0a                LDN 10              ; D = current ply
   1fc0   ca 1f de          LBNZ NEGAMAX_TT_ORDER_CALL  ; ply >= 1: TT_PROBE has populated TT_MOVE
                        
                            ; Root: copy ITER_BEST into TT_MOVE if valid, else skip ordering pass.
   1fc3   68 ca 64 c2       RLDI 10, ITER_BEST_FROM
   1fc7   0a                LDN 10
   1fc8   fb ff             XRI $FF
   1fca   c2 1f de          LBZ NEGAMAX_SKIP_TT_ORDER   ; first iteration: no PV — skip
                        
   1fcd   68 ca 64 c2       RLDI 10, ITER_BEST_FROM
   1fd1   4a                LDA 10                      ; D = ITER_BEST_FROM, R10 -> ITER_BEST_TO
   1fd2   bd                PHI 13
   1fd3   0a                LDN 10                      ; D = ITER_BEST_TO
   1fd4   ad                PLO 13
   1fd5   68 ca 64 c0       RLDI 10, TT_MOVE_HI
   1fd9   9d                GHI 13
   1fda   5a                STR 10                      ; TT_MOVE_HI = ITER_BEST_FROM
   1fdb   1a                INC 10
   1fdc   8d                GLO 13
   1fdd   5a                STR 10                      ; TT_MOVE_LO = ITER_BEST_TO
                        
   1fde                 NEGAMAX_TT_ORDER_CALL:
                            ; (move-count peek removed: ORDER_TT_MOVE below is disabled, so nothing
                            ;  consumed it. When re-enabled, read LOOP_MOVE_CNT[ply] into D first.)
                            ; --- ORDER_TT_MOVE disabled 2026-05-13 pending 32-bit TT hash widening ---
                            ; The byte-order fix in ORDER_TT_MOVE (commit 8aa04e6) is correct, but
                            ; enabling it surfaced a regression: with TT keyed on only 16 hash bits,
                            ; collisions are frequent (2^16 = 65k positions per slot). A TT_MOVE
                            ; from a colliding position gets promoted to the front of the move list
                            ; for the WRONG position; alpha-beta commits to that move's search line;
                            ; depth-limited search can't refute it. Observed concretely 2026-05-13:
                            ; engine chose Qg4-g7-h8 (queen sac into rook taking + queen recapture)
                            ; with ordering enabled; chose sensible Qg4-c8 with ordering disabled.
                            ; Killer ordering above is safe (not hash-keyed; per-ply table only).
                            ; Re-enable this CALL when TT_HASH is widened to 32 bits.
                            ; CALL ORDER_TT_MOVE
                        
   1fde                 NEGAMAX_SKIP_TT_ORDER:
                        
                            ; -----------------------------------------------
                            ; Initialize best score to -INFINITY in memory
                            ; -----------------------------------------------
                            ; Using memory avoids register clobbering bugs!
   1fde   68 ca 64 0e       RLDI 10, BEST_SCORE_HI
   1fe2   f8 80             LDI $80
   1fe4   5a                STR 10              ; BEST_SCORE_HI = $80
   1fe5   1a                INC 10
   1fe6   f8 01             LDI $01
   1fe8   5a                STR 10              ; BEST_SCORE_LO = $01 (best = $8001 = -32767, safe to negate)
                        
                            ; -----------------------------------------------
                            ; Initialize node best move to 0/0 (no move yet)
                            ; -----------------------------------------------
   1fe9   68 ca 64 48       RLDI 10, CURRENT_PLY
   1fed   0a                LDN 10              ; D = ply
   1fee   fe                SHL                 ; D = ply * 2
   1fef   aa                PLO 10
   1ff0   f8 67             LDI HIGH(NODE_BEST_MOVE)
   1ff2   ba                PHI 10              ; R10 = &NODE_BEST_MOVE[ply]
   1ff3   f8 00             LDI 0
   1ff5   5a                STR 10              ; from = 0
   1ff6   1a                INC 10
   1ff7   5a                STR 10              ; to = 0
                        
                            ; -----------------------------------------------
                            ; Futility Pruning Setup (depth 1 only)
                            ; -----------------------------------------------
                            ; Clear futility flag for THIS ply (per-ply table prevents recursion corruption)
   1ff8   68 ca 64 48       RLDI 10, CURRENT_PLY
   1ffc   0a                LDN 10              ; D = ply
   1ffd   fe                SHL
   1ffe   fe                SHL                 ; D = ply * 4
   1fff   fc 22             ADI LOW(FUTILITY_TABLE)
   2001   aa                PLO 10
   2002   f8 67             LDI HIGH(FUTILITY_TABLE)
   2004   7c 00             ADCI 0
   2006   ba                PHI 10              ; R10 = &FUTILITY_TABLE[ply*4] (flag byte)
   2007   f8 00             LDI 0
   2009   5a                STR 10              ; flag = 0 (disabled by default)
                        
                            ; Check if depth == 1 (frontier node)
   200a   68 cd 64 16       RLDI 13, SEARCH_DEPTH
   200e   4d                LDA 13              ; D = depth high byte
   200f   ca 20 66          LBNZ NEGAMAX_SKIP_FUTILITY  ; depth > 255, skip
   2012   0d                LDN 13              ; D = depth low byte
   2013   fb 01             XRI 1               ; Check if depth == 1
   2015   ca 20 66          LBNZ NEGAMAX_SKIP_FUTILITY  ; Not depth 1, skip
                        
                            ; Don't enable futility at root — must always search all root moves
   2018   68 ca 64 48       RLDI 10, CURRENT_PLY
   201c   0a                LDN 10              ; D = current ply
   201d   c2 20 66          LBZ NEGAMAX_SKIP_FUTILITY  ; ply == 0, skip
                        
                            ; Check guard: don't enable futility if side is in check
                            ; (escape moves must not be pruned — mirrors RFP guard at line 563)
   2020   d4 01 8e          CALL IS_IN_CHECK    ; R12 = our color; D = 1 if in check
   2023   ca 20 66          LBNZ NEGAMAX_SKIP_FUTILITY  ; in check, skip futility
                        
                            ; Depth == 1: Cache static eval for futility pruning (per-ply table)
   2026   d4 0e b4          CALL EVALUATE       ; Returns score in R9 (white perspective)
                            ; Negate R9 if black to move (white-perspective → side-to-move)
   2029   8c                GLO 12
   202a   fa 08             ANI $08
   202c   c2 20 37          LBZ FUTILITY_NO_NEG
   202f   89                GLO 9               ; low byte
   2030   fd 00             SDI 0               ; negate low
   2032   a9                PLO 9
   2033   99                GHI 9               ; high byte
   2034   7d 00             SDBI 0              ; negate high with borrow
   2036   b9                PHI 9
   2037                 FUTILITY_NO_NEG:
                            ; Store flag + eval in FUTILITY_TABLE[ply*4]: [flag][eval_hi][eval_lo]
   2037   68 ca 64 48       RLDI 10, CURRENT_PLY
   203b   0a                LDN 10              ; D = ply
   203c   fe                SHL
   203d   fe                SHL                 ; D = ply * 4
   203e   fc 22             ADI LOW(FUTILITY_TABLE)
   2040   aa                PLO 10
   2041   f8 67             LDI HIGH(FUTILITY_TABLE)
   2043   7c 00             ADCI 0
   2045   ba                PHI 10              ; R10 = &FUTILITY_TABLE[ply*4]
   2046   f8 01             LDI 1               ; DEBUG: flag=1 (futility active, negate LBR'd = unsigned eval like bd6e4b5)
   2048   5a                STR 10              ; flag = 1 (futility enabled)
   2049   1a                INC 10
   204a   99                GHI 9
   204b   5a                STR 10              ; eval_hi
   204c   1a                INC 10
   204d   89                GLO 9
   204e   5a                STR 10              ; eval_lo
                        
                            ; FIX: EVALUATE clobbered R9 (move list pointer) with eval score.
                            ; Re-initialize R9 to move list start for this ply.
   204f   68 ca 64 48       RLDI 10, CURRENT_PLY
   2053   0a                LDN 10              ; D = current ply
   2054   f6                SHR                 ; D = ply >> 1
   2055   fc 78             ADI HIGH(MOVE_LIST)
   2057   b9                PHI 9               ; R9.1 = HIGH(MOVE_LIST) + (ply >> 1)
   2058   0a                LDN 10              ; D = ply (reload)
   2059   fa 01             ANI $01
   205b   c2 20 63          LBZ NEGAMAX_FUTILITY_R9_EVEN
   205e   f8 80             LDI $80
   2060   c0 20 65          LBR NEGAMAX_FUTILITY_R9_DONE
   2063                 NEGAMAX_FUTILITY_R9_EVEN:
   2063   f8 00             LDI $00
   2065                 NEGAMAX_FUTILITY_R9_DONE:
   2065   a9                PLO 9               ; R9 = ply-indexed move list start
                        
   2066                 NEGAMAX_SKIP_FUTILITY:
                        
                            ; Initialize LMR move counter to 0
   2066   68 ca 64 a3       RLDI 10, LMR_MOVE_INDEX
   206a   f8 00             LDI 0
   206c   5a                STR 10              ; LMR_MOVE_INDEX = 0
                        
                            ; Check if there are any legal moves
   206d   68 ca 64 48       RLDI 10, CURRENT_PLY
   2071   0a                LDN 10              ; D = ply
   2072   fc ef             ADI LOW(LOOP_MOVE_CNT)
   2074   aa                PLO 10
   2075   f8 64             LDI HIGH(LOOP_MOVE_CNT)
   2077   ba                PHI 10              ; R10 = &LOOP_MOVE_CNT[ply]
   2078   0a                LDN 10              ; D = move count (read from memory)
   2079   ca 20 7f          LBNZ NEGAMAX_HAS_MOVES  ; Long branch (may cross page boundary)
                            ; No legal moves - checkmate or stalemate
   207c   c0 26 23          LBR NEGAMAX_NO_MOVES
                        
   207f                 NEGAMAX_HAS_MOVES:
   207f                 NEGAMAX_MOVE_LOOP:
                            ; -----------------------------------------------
                            ; Loop through all moves
                            ; -----------------------------------------------
                            ; Read move count from ply-indexed memory
   207f   68 ca 64 48       RLDI 10, CURRENT_PLY
   2083   0a                LDN 10             ; D = ply
   2084   fc ef             ADI LOW(LOOP_MOVE_CNT)
   2086   aa                PLO 10
   2087   f8 64             LDI HIGH(LOOP_MOVE_CNT)
   2089   ba                PHI 10             ; R10 = &LOOP_MOVE_CNT[ply]
   208a   0a                LDN 10             ; D = move count (read from memory)
   208b   c2 25 d9          LBZ NEGAMAX_RETURN  ; No moves left
                        
                            ; Get next move from list (big-endian: high byte first)
   208e   49                LDA 9              ; Load high byte of move
   208f   b8                PHI 8
   2090   49                LDA 9              ; Load low byte of move
   2091   a8                PLO 8              ; R8 = current move (16-bit encoded)
                        
                            ; Save R9 (move pointer) to ply-indexed memory (not stack!)
                            ; This avoids stack alignment bugs across the large move loop
   2092   68 ca 64 48       RLDI 10, CURRENT_PLY
   2096   0a                LDN 10              ; D = ply
   2097   fe                SHL                 ; D = ply * 2
   2098   fc db             ADI LOW(LOOP_MOVE_PTR)
   209a   aa                PLO 10
   209b   f8 64             LDI HIGH(LOOP_MOVE_PTR)
   209d   ba                PHI 10              ; R10 = LOOP_MOVE_PTR + ply*2
   209e   99                GHI 9
   209f   5a                STR 10              ; Save R9.hi
   20a0   1a                INC 10
   20a1   89                GLO 9
   20a2   5a                STR 10              ; Save R9.lo
                        
                            ; Decode move: R8 → R13 (from/to)
   20a3   d4 03 c7          CALL DECODE_MOVE_16BIT
                            ; R13.1 = from square, R13.0 = to square
                        
                            ; Store to MOVE_FROM/MOVE_TO for MAKE_MOVE
   20a6   68 ca 64 02       RLDI 10, MOVE_FROM
   20aa   9d                GHI 13              ; from
   20ab   5a                STR 10
   20ac   1a                INC 10
   20ad   8d                GLO 13              ; to
   20ae   5a                STR 10
                        
                            ; -----------------------------------------------
                            ; Set LMR_IS_CAPTURE flag based on target square
                            ; -----------------------------------------------
                            ; R13.0 still has 'to' square from DECODE_MOVE_16BIT
   20af   f8 60             LDI HIGH(BOARD)
   20b1   ba                PHI 10
   20b2   8d                GLO 13              ; D = to square
   20b3   aa                PLO 10              ; R10 = BOARD + to_square
   20b4   0a                LDN 10              ; D = piece at target (0 if empty)
   20b5   a7                PLO 7               ; Save piece in R7.0 (temp)
   20b6   68 ca 64 a5       RLDI 10, LMR_IS_CAPTURE
   20ba   87                GLO 7               ; Restore piece
   20bb   c2 20 c3          LBZ LMR_NOT_CAPTURE
   20be   f8 01             LDI 1               ; Non-empty = capture
   20c0   c0 20 c5          LBR LMR_CAPTURE_DONE
   20c3                 LMR_NOT_CAPTURE:
   20c3   f8 00             LDI 0               ; Empty = not capture
   20c5                 LMR_CAPTURE_DONE:
   20c5   5a                STR 10              ; Store flag
                        
                            ; -----------------------------------------------
                            ; Castling Legality (moved from movegen for performance)
                            ; Only runs when the search actually tries a castling move,
                            ; not at every node during move generation.
                            ; -----------------------------------------------
   20c6   68 ca 64 05       RLDI 10, DECODED_FLAGS
   20ca   0a                LDN 10
   20cb   fb 01             XRI MOVE_CASTLE         ; Zero if castling
   20cd   ca 20 ff          LBNZ NM_NOT_CASTLE
                        
                            ; Castling — check king not in check (can't castle out of check)
   20d0   68 ca 64 02       RLDI 10, MOVE_FROM
   20d4   0a                LDN 10                  ; D = from (king square)
   20d5   ab                PLO 11                  ; R11.0 = king square
   20d6   d4 01 a4          CALL IS_SQUARE_ATTACKED ; D = 1 if in check
   20d9   ca 20 ec          LBNZ NM_CASTLE_ILLEGAL
                        
                            ; Check transit square not attacked (can't castle through check)
                            ; Transit = (from + to) / 2
   20dc   68 ca 64 02       RLDI 10, MOVE_FROM
   20e0   4a                LDA 10                  ; D = from, R10 -> MOVE_TO
   20e1   52                STR 2                   ; M[R2] = from
   20e2   0a                LDN 10                  ; D = to
   20e3   f4                ADD                     ; D = from + to
   20e4   f6                SHR                     ; D = transit square
   20e5   ab                PLO 11                  ; R11.0 = transit
   20e6   d4 01 a4          CALL IS_SQUARE_ATTACKED
   20e9   c2 20 ff          LBZ NM_NOT_CASTLE       ; Transit safe, proceed
                        
   20ec                 NM_CASTLE_ILLEGAL:
                            ; Restore R9 from ply-indexed memory
   20ec   68 ca 64 48       RLDI 10, CURRENT_PLY
   20f0   0a                LDN 10
   20f1   fe                SHL
   20f2   fc db             ADI LOW(LOOP_MOVE_PTR)
   20f4   aa                PLO 10
   20f5   f8 64             LDI HIGH(LOOP_MOVE_PTR)
   20f7   ba                PHI 10
   20f8   4a                LDA 10
   20f9   b9                PHI 9
   20fa   0a                LDN 10
   20fb   a9                PLO 9
   20fc   c0 25 a9          LBR NEGAMAX_NEXT_MOVE
                        
   20ff                 NM_NOT_CASTLE:
                        
                            ; -----------------------------------------------
                            ; Futility Pruning Check (per-ply, depth 1 quiet moves)
                            ; -----------------------------------------------
                        
                            ; Check: is futility pruning enabled for this ply? (per-ply table)
   20ff   68 ca 64 48       RLDI 10, CURRENT_PLY
   2103   0a                LDN 10              ; D = ply
   2104   fe                SHL
   2105   fe                SHL                 ; D = ply * 4
   2106   fc 22             ADI LOW(FUTILITY_TABLE)
   2108   aa                PLO 10
   2109   f8 67             LDI HIGH(FUTILITY_TABLE)
   210b   7c 00             ADCI 0
   210d   ba                PHI 10              ; R10 = &FUTILITY_TABLE[ply*4]
   210e   4a                LDA 10              ; D = flag, R10 → eval_hi
   210f   c2 21 58          LBZ NEGAMAX_NOT_FUTILE  ; Flag=0, skip futility
                            ; Pre-load static eval while R10 is positioned
   2112   4a                LDA 10              ; D = eval_hi, R10 → eval_lo
   2113   bb                PHI 11
   2114   0a                LDN 10              ; D = eval_lo
   2115   ab                PLO 11              ; R11 = static eval (from per-ply table)
                        
                            ; Check if move is a capture (target square non-empty)
   2116   68 ca 64 03       RLDI 10, MOVE_TO
   211a   0a                LDN 10              ; D = to square
   211b   aa                PLO 10              ; R10.0 = to square
   211c   f8 60             LDI HIGH(BOARD)
   211e   ba                PHI 10              ; R10 = BOARD + to_square
   211f   0a                LDN 10              ; D = piece at target
   2120   ca 21 58          LBNZ NEGAMAX_NOT_FUTILE  ; Non-empty = capture, don't prune
                        
                            ; Check if move is a promotion (never prune — changes material)
   2123   68 ca 64 05       RLDI 10, DECODED_FLAGS
   2127   0a                LDN 10              ; D = move flags
   2128   fb 03             XRI MOVE_PROMOTION  ; Zero if promotion
   212a   c2 21 58          LBZ NEGAMAX_NOT_FUTILE  ; Promotion, don't prune
                        
                            ; Add FUTILITY_MARGIN (150 = $0096)
   212d   8b                GLO 11
   212e   fc 96             ADI FUTILITY_MARGIN_D1_LO  ; Add low byte
   2130   ab                PLO 11
   2131   9b                GHI 11
   2132   7c 00             ADCI FUTILITY_MARGIN_D1_HI ; Add high byte with carry
   2134   bb                PHI 11              ; R11 = static_eval + margin
                        
                            ; Safety: don't prune if no move has been searched yet (BEST_SCORE
                            ; is still sentinel $8001). Otherwise all quiet moves get pruned,
                            ; BEST_SCORE stays at sentinel, and the engine detects false checkmate.
   2135   68 ca 64 0e       RLDI 10, BEST_SCORE_HI
   2139   0a                LDN 10              ; D = BEST_SCORE_HI
   213a   fb 80             XRI $80             ; Zero if still sentinel high byte
   213c   c2 21 58          LBZ NEGAMAX_NOT_FUTILE  ; Sentinel → must search this move
                        
                            ; Futility: prune if static_eval + margin < 0 (losing by more than margin)
   213f   9b                GHI 11              ; (eval+margin) high byte
   2140   fa 80             ANI $80             ; Check sign bit
   2142   c2 21 58          LBZ NEGAMAX_NOT_FUTILE  ; Sign bit clear = positive, don't prune
                        
                            ; Futile! Skip this move
                            ; Restore R9 from ply-indexed memory
   2145   68 ca 64 48       RLDI 10, CURRENT_PLY
   2149   0a                LDN 10              ; D = ply
   214a   fe                SHL                 ; D = ply * 2
   214b   fc db             ADI LOW(LOOP_MOVE_PTR)
   214d   aa                PLO 10
   214e   f8 64             LDI HIGH(LOOP_MOVE_PTR)
   2150   ba                PHI 10              ; R10 = LOOP_MOVE_PTR + ply*2
   2151   4a                LDA 10
   2152   b9                PHI 9               ; R9.hi
   2153   0a                LDN 10
   2154   a9                PLO 9               ; R9 = move list pointer restored
                        
                            ; Jump to decrement move count and continue loop
   2155   c0 25 a9          LBR NEGAMAX_NEXT_MOVE
                        
   2158                 NEGAMAX_NOT_FUTILE:
                        
                            ; -----------------------------------------------
                            ; Late Move Pruning (LMP) — at low depth, after first N quiet moves
                            ; have been searched, skip remaining quiet moves entirely. Empirical
                            ; literature: 20-40% node reduction at low depths with low risk.
                            ; Conditions (all must hold to prune):
                            ;   1. CURRENT_PLY > 0      — never prune at root (highest cost of error)
                            ;   2. NODE_IN_CHECK == 0   — never prune when we're in check (legal
                            ;                             escape moves can be late in ordering, and
                            ;                             pruning them = false mate detection)
                            ;   3. SEARCH_DEPTH <= 2    — only at low depths (small subtrees)
                            ;   4. LMR_MOVE_INDEX >= 8  — first 8 moves search normally
                            ;   5. LMR_IS_CAPTURE == 0  — never prune captures
                            ;   6. DECODED_FLAGS != MOVE_PROMOTION
                            ; The in-check guard (cond 2) was added 2026-05-05 after the move-21
                            ; replay surfaced a false +32766 mate at d=1/2/3: opponent in check
                            ; from our Qh5+, with many illegal pseudo-legal moves filling indices
                            ; 0-7, leaving the legal escapes (Ng6, gxh6) at index 9+ where LMP
                            ; pruned them, causing NEGAMAX_NO_MOVES to fire and report mate.
                            ; -----------------------------------------------
                        
                            ; Cond 1: ply > 0?
   2158   68 ca 64 48       RLDI 10, CURRENT_PLY
   215c   0a                LDN 10
   215d   c2 21 95          LBZ NEGAMAX_LMP_DONE        ; root: never prune
                        
                            ; Cond 2: not in check at this node?
   2160   fc 42             ADI LOW(NODE_IN_CHECK)
   2162   aa                PLO 10
   2163   f8 67             LDI HIGH(NODE_IN_CHECK)
   2165   7c 00             ADCI 0
   2167   ba                PHI 10                      ; R10 = NODE_IN_CHECK + ply
   2168   0a                LDN 10                      ; D = node-in-check flag
   2169   ca 21 95          LBNZ NEGAMAX_LMP_DONE       ; in check: skip LMP (legal escapes may be late)
                        
                            ; Cond 3: depth <= 2?
   216c   68 ca 64 17       RLDI 10, SEARCH_DEPTH + 1
   2170   0a                LDN 10
   2171   ff 03             SMI 3
   2173   c3 21 95          LBDF NEGAMAX_LMP_DONE       ; depth >= 3: skip LMP
                        
                            ; Cond 4: index >= 8?
   2176   68 ca 64 a3       RLDI 10, LMR_MOVE_INDEX
   217a   0a                LDN 10
   217b   ff 08             SMI 8
   217d   cb 21 95          LBNF NEGAMAX_LMP_DONE       ; index < 8: search normally
                        
                            ; Cond 5: not a capture?
   2180   68 ca 64 a5       RLDI 10, LMR_IS_CAPTURE
   2184   0a                LDN 10
   2185   ca 21 95          LBNZ NEGAMAX_LMP_DONE       ; capture: search normally
                        
                            ; Cond 6: not a promotion?
   2188   68 ca 64 05       RLDI 10, DECODED_FLAGS
   218c   0a                LDN 10
   218d   fb 03             XRI MOVE_PROMOTION
   218f   c2 21 95          LBZ NEGAMAX_LMP_DONE        ; promotion: search normally
                        
                            ; All conditions met — skip this move (LMP prune)
   2192   c0 25 a9          LBR NEGAMAX_NEXT_MOVE
                        
   2195                 NEGAMAX_LMP_DONE:
                        
                            ; Set UNDO_PROMOTION based on move flags
                            ; Must be done before MAKE_MOVE so promotions work correctly
   2195   68 ca 64 04       RLDI 10, UNDO_PROMOTION
   2199   68 cd 64 05       RLDI 13, DECODED_FLAGS
   219d   0d                LDN 13              ; D = flags
   219e   fb 03             XRI MOVE_PROMOTION  ; == $03?
   21a0   ca 21 a8          LBNZ NM_NOT_PROMO
   21a3   f8 05             LDI QUEEN_TYPE      ; Promote to queen ($05)
   21a5   c0 21 aa          LBR NM_SET_PROMO
   21a8                 NM_NOT_PROMO:
   21a8   f8 00             LDI 0               ; Not a promotion
   21aa                 NM_SET_PROMO:
   21aa   5a                STR 10              ; UNDO_PROMOTION = QUEEN_TYPE or 0
                        
                            ; Make the move on the board
   21ab   d4 09 b4          CALL MAKE_MOVE
                        
                            ; -----------------------------------------------
                            ; LEGALITY CHECK: Does this move leave our king in check?
                            ; MAKE_MOVE does NOT toggle R12 - only SIDE in memory.
                            ; R12 still contains our color (the side that just moved).
                            ; -----------------------------------------------
   21ae   d4 01 8e          CALL IS_IN_CHECK
                            ; D = 1 if our king is in check (illegal move), 0 if safe
                        
                            ; If in check, this move is illegal - unmake and skip
   21b1   c2 21 ca          LBZ NEGAMAX_MOVE_LEGAL  ; D=0 means not in check, move is legal
                        
                            ; ILLEGAL MOVE: Our king is in check after this move
   21b4   d4 0c 20          CALL UNMAKE_MOVE
                        
                            ; R12 stays as our color (UNMAKE_MOVE doesn't toggle R12)
                        
                            ; Restore R9 from ply-indexed memory and skip to next move
   21b7   68 ca 64 48       RLDI 10, CURRENT_PLY
   21bb   0a                LDN 10              ; D = ply
   21bc   fe                SHL                 ; D = ply * 2
   21bd   fc db             ADI LOW(LOOP_MOVE_PTR)
   21bf   aa                PLO 10
   21c0   f8 64             LDI HIGH(LOOP_MOVE_PTR)
   21c2   ba                PHI 10              ; R10 = LOOP_MOVE_PTR + ply*2
   21c3   4a                LDA 10
   21c4   b9                PHI 9               ; R9.hi
   21c5   0a                LDN 10
   21c6   a9                PLO 9               ; R9 = move list pointer restored
                        
   21c7   c0 25 a9          LBR NEGAMAX_NEXT_MOVE   ; Skip this illegal move
                        
   21ca                 NEGAMAX_MOVE_LEGAL:
                            ; --- Check extension: does this move give check? ---
   21ca   8c                GLO 12
   21cb   fb 08             XRI 8
   21cd   ac                PLO 12              ; R12 = opponent's color
   21ce   d4 01 8e          CALL IS_IN_CHECK    ; Check opponent's king
                            ; D = 1 if giving check (RLDI does NOT clobber D)
   21d1   68 ca 64 da       RLDI 10, CHECK_EXT_FLAG
   21d5   5a                STR 10              ; Save result (0 or 1)
   21d6   8c                GLO 12
   21d7   fb 08             XRI 8
   21d9   ac                PLO 12              ; R12 = our color restored
                        
                            ; -----------------------------------------------
                            ; LMR Check: Should we reduce this move's search?
                            ; -----------------------------------------------
                            ; Clear LMR_REDUCED flag first
   21da   68 ca 64 a4       RLDI 10, LMR_REDUCED
   21de   f8 00             LDI 0
   21e0   5a                STR 10              ; LMR_REDUCED = 0 (default)
                        
                            ; Condition 1: LMR_MOVE_INDEX >= 4?
   21e1   68 ca 64 a3       RLDI 10, LMR_MOVE_INDEX
   21e5   0a                LDN 10              ; D = moves searched so far
   21e6   ff 04             SMI 4               ; D = index - 4
   21e8   cb 22 0e          LBNF LMR_SKIP       ; < 4, skip LMR
                        
                            ; Condition 2: SEARCH_DEPTH >= 3?
   21eb   68 ca 64 17       RLDI 10, SEARCH_DEPTH + 1
   21ef   0a                LDN 10              ; D = depth low byte
   21f0   ff 03             SMI 3               ; D = depth - 3
   21f2   cb 22 0e          LBNF LMR_SKIP       ; < 3, skip LMR
                        
                            ; Condition 3: Not a capture?
   21f5   68 ca 64 a5       RLDI 10, LMR_IS_CAPTURE
   21f9   0a                LDN 10              ; D = capture flag
   21fa   ca 22 0e          LBNZ LMR_SKIP       ; Is capture, skip LMR
                        
                            ; Condition 4: Not a promotion? (promotions change material, never reduce)
   21fd   68 ca 64 05       RLDI 10, DECODED_FLAGS
   2201   0a                LDN 10              ; D = move flags
   2202   fb 03             XRI MOVE_PROMOTION  ; Zero if promotion
   2204   c2 22 0e          LBZ LMR_SKIP        ; Promotion, skip LMR
                        
                            ; All conditions met - set LMR_REDUCED = 1
   2207   68 ca 64 a4       RLDI 10, LMR_REDUCED
   220b   f8 01             LDI 1
   220d   5a                STR 10              ; LMR_REDUCED = 1
                        
   220e                 LMR_SKIP:
                        
                            ; -----------------------------------------------
                            ; Save depth to stack and decrement for recursive call
                            ; (PUSH ORDER: R9/R8, depth, alpha/beta, UNDO_* - pop in reverse!)
                            ; -----------------------------------------------
                            ; First, save current depth to stack for later restore
   220e   68 cd 64 16       RLDI 13, SEARCH_DEPTH
   2212   4d                LDA 13              ; D = depth high
   2213   73                STXD
   2214   0d                LDN 13              ; D = depth low
   2215   73                STXD                ; Stack now has: ... [depth_hi] [depth_lo]
                        
                            ; Now decrement depth in memory
   2216   68 cd 64 17       RLDI 13, SEARCH_DEPTH + 1
   221a   0d                LDN 13              ; D = depth low
   221b   ff 01             SMI 1
   221d   5d                STR 13              ; Store decremented low byte
   221e   2d                DEC 13              ; Point to high byte
   221f   0d                LDN 13              ; D = depth high
   2220   7f 00             SMBI 0              ; Subtract borrow
   2222   5d                STR 13              ; Store decremented high byte
                        
                            ; -----------------------------------------------
                            ; LMR: Extra depth decrement if flag is set
                            ; -----------------------------------------------
   2223   68 ca 64 a4       RLDI 10, LMR_REDUCED
   2227   0a                LDN 10              ; D = LMR_REDUCED flag
   2228   c2 22 38          LBZ LMR_NO_EXTRA_DEC ; Not reduced, skip extra decrement
                        
                            ; LMR applies - decrement depth by 1 MORE (depth now = original - 2)
   222b   68 cd 64 17       RLDI 13, SEARCH_DEPTH + 1
   222f   0d                LDN 13              ; D = depth low
   2230   ff 01             SMI 1
   2232   5d                STR 13              ; depth_lo--
   2233   2d                DEC 13              ; Point to high byte
   2234   0d                LDN 13              ; D = depth high
   2235   7f 00             SMBI 0              ; Subtract borrow
   2237   5d                STR 13              ; depth_hi-- (with borrow)
                        
   2238                 LMR_NO_EXTRA_DEC:
                            ; -----------------------------------------------
                            ; Check extension: if move gives check AND depth is
                            ; at the horizon (depth <= 0 after decrement), undo
                            ; the decrement so checking move stays in main search
                            ; where checkmate can be detected (QS can't detect it)
                            ; -----------------------------------------------
   2238   68 ca 64 da       RLDI 10, CHECK_EXT_FLAG
   223c   0a                LDN 10              ; D = check flag
   223d   c2 22 59          LBZ CE_DONE         ; Not giving check, skip
                        
                            ; Ply guard: don't extend if ply >= 4 (child would be ply 5).
                            ; With MAX_PLY=8 and MOVE_LIST sized for 5 plies + QS scratch beyond,
                            ; ply 4 extending to 5 stays within bounds.
   2240   68 ca 64 48       RLDI 10, CURRENT_PLY
   2244   0a                LDN 10              ; D = current ply
   2245   ff 04             SMI 4
   2247   c3 22 59          LBDF CE_DONE        ; ply >= 4, skip extension
                        
                            ; Only extend at horizon: depth <= 0 after decrement
   224a   68 cd 64 16       RLDI 13, SEARCH_DEPTH
   224e   4d                LDA 13              ; D = depth_hi
   224f   ca 22 59          LBNZ CE_DONE        ; depth_hi != 0, not at horizon
   2252   0d                LDN 13              ; D = depth_lo
   2253   ca 22 59          LBNZ CE_DONE        ; depth_lo != 0, not at horizon
                        
                            ; Depth is 0 — about to drop to QS. Undo decrement (+1)
   2256   f8 01             LDI 1
   2258   5d                STR 13              ; depth_lo = 1
                            ; depth_hi stays 0 (already confirmed)
                        
   2259                 CE_DONE:
                            ; -----------------------------------------------
                            ; Negate and swap alpha/beta (memory-based - R6 is SCRT linkage!)
                            ; -----------------------------------------------
                            ; For negamax: score = -negamax(depth-1, -beta, -alpha, -color)
                        
                            ; Save current alpha and beta from memory to stack
                            ; Load alpha from memory (big-endian: HI at lower address)
   2259   68 cd 64 42       RLDI 13, ALPHA_HI
   225d   4d                LDA 13              ; D = alpha_hi
   225e   73                STXD
   225f   0d                LDN 13              ; D = alpha_lo
   2260   73                STXD
                            ; Load beta from memory (big-endian: HI at lower address)
   2261   68 cd 64 44       RLDI 13, BETA_HI
   2265   4d                LDA 13              ; D = beta_hi
   2266   73                STXD
   2267   0d                LDN 13              ; D = beta_lo
   2268   73                STXD
                            ; Stack now has: [beta_lo][beta_hi][alpha_lo][alpha_hi][depth]...
                        
                            ; -----------------------------------------------
                            ; Save UNDO_* to stack (7 bytes) for recursive safety
                            ; Child calls will overwrite UNDO_*, so we must save it
                            ; Push LAST so it gets popped FIRST (LIFO order!)
                            ; -----------------------------------------------
   2269   68 ca 64 08       RLDI 10, UNDO_CAPTURED
   226d   4a                LDA 10              ; UNDO_CAPTURED
   226e   73                STXD
   226f   4a                LDA 10              ; UNDO_FROM
   2270   73                STXD
   2271   4a                LDA 10              ; UNDO_TO
   2272   73                STXD
   2273   4a                LDA 10              ; UNDO_CASTLING
   2274   73                STXD
   2275   4a                LDA 10              ; UNDO_EP
   2276   73                STXD
   2277   0a                LDN 10              ; UNDO_HALFMOVE
   2278   73                STXD
                            ; UNDO_PROMOTION is at $6404 (not contiguous)
   2279   68 ca 64 04       RLDI 10, UNDO_PROMOTION
   227d   0a                LDN 10              ; UNDO_PROMOTION
   227e   73                STXD
                            ; UNDO_CAP_SQ is at $64FF (not contiguous)
   227f   68 ca 64 ff       RLDI 10, UNDO_CAP_SQ
   2283   0a                LDN 10              ; UNDO_CAP_SQ
   2284   73                STXD
                        
                            ; -----------------------------------------------
                            ; Save BEST_SCORE to stack (2 bytes) for recursive safety
                            ; Child calls will reinitialize BEST_SCORE to -infinity!
                            ; -----------------------------------------------
   2285   68 ca 64 0e       RLDI 10, BEST_SCORE_HI
   2289   4a                LDA 10              ; BEST_SCORE_HI
   228a   73                STXD
   228b   0a                LDN 10              ; BEST_SCORE_LO
   228c   73                STXD
                            ; Stack now has: [BEST_SCORE][UNDO_CAP_SQ][UNDO_*][beta][alpha][depth][R9]...
                        
                            ; Negate beta from memory → R7 = -beta (new alpha)
                            ; Read low byte first for borrow propagation, then high byte
   228d   68 cd 64 45       RLDI 13, BETA_LO
   2291   0d                LDN 13              ; low byte (BETA_LO at higher address)
   2292   fd 00             SDI 0               ; negate low
   2294   a7                PLO 7
   2295   2d                DEC 13              ; → BETA_HI (lower address)
   2296   0d                LDN 13              ; high byte
   2297   7d 00             SDBI 0              ; negate high with borrow
   2299   b7                PHI 7               ; R7 = -beta
                        
                            ; Negate alpha from memory → R8 = -alpha (new beta)
   229a   68 cd 64 43       RLDI 13, ALPHA_LO
   229e   0d                LDN 13              ; low byte (ALPHA_LO at higher address)
   229f   fd 00             SDI 0               ; negate low
   22a1   a8                PLO 8
   22a2   2d                DEC 13              ; → ALPHA_HI (lower address)
   22a3   0d                LDN 13              ; high byte
   22a4   7d 00             SDBI 0              ; negate high with borrow
   22a6   b8                PHI 8               ; R8 = -alpha
                        
                            ; Now swap: new_alpha = -beta (in R7), new_beta = -alpha (in R8)
                            ; Store to memory (big-endian: high byte at lower address)
   22a7   68 cd 64 42       RLDI 13, ALPHA_HI
   22ab   97                GHI 7
   22ac   5d                STR 13              ; ALPHA_HI = -beta high
   22ad   1d                INC 13
   22ae   87                GLO 7
   22af   5d                STR 13              ; ALPHA_LO = -beta low
                        
   22b0   68 cd 64 44       RLDI 13, BETA_HI
   22b4   98                GHI 8
   22b5   5d                STR 13              ; BETA_HI = -alpha high
   22b6   1d                INC 13
   22b7   88                GLO 8
   22b8   5d                STR 13              ; BETA_LO = -alpha low
                        
                            ; Toggle color (C): 0=white, 8=black (matches COLOR_MASK)
   22b9   8c                GLO 12
   22ba   fb 08             XRI $08             ; Toggle between 0 and 8
   22bc   ac                PLO 12
                        
                            ; Increment ply counter before recursion
   22bd   68 ca 64 48       RLDI 10, CURRENT_PLY
   22c1   0a                LDN 10
   22c2   fc 01             ADI 1
   22c4   5a                STR 10              ; CURRENT_PLY++
                        
                            ; -----------------------------------------------
                            ; Push LMR state to stack (overwritten by recursive call)
                            ; -----------------------------------------------
                            ; Push LMR_MOVE_INDEX first (popped last)
   22c5   68 ca 64 a3       RLDI 10, LMR_MOVE_INDEX
   22c9   0a                LDN 10              ; D = LMR_MOVE_INDEX
   22ca   73                STXD                ; Push to stack
                            ; Push LMR_REDUCED second (popped first)
   22cb   68 ca 64 a4       RLDI 10, LMR_REDUCED
   22cf   0a                LDN 10              ; D = LMR_REDUCED flag
   22d0   73                STXD                ; Push to stack
                        
