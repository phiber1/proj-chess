   15f9   89                GLO 9
   15fa   f7                SM                  ; R9.lo -= bonus lo
   15fb   a9                PLO 9
   15fc   97                GHI 7               ; bonus hi
   15fd   52                STR 2
   15fe   99                GHI 9
   15ff   77                SMB                 ; R9.hi -= bonus hi - borrow
   1600   b9                PHI 9
                        
