   1285   a9                PLO 9
   1286   99                GHI 9
   1287   7c 00             ADCI 0
   1289   b9                PHI 9
   128a   c0 12 95          LBR EVAL_WR_DONE
   128d                 EVAL_WR2_SEMI:
   128d   89                GLO 9
   128e   fc 0a             ADI 10
   1290   a9                PLO 9
   1291   99                GHI 9
   1292   7c 00             ADCI 0
   1294   b9                PHI 9
   1295                 EVAL_WR_DONE:
                        
                            ; --- Black rook 1 ---
   1295   68 cb 64 b3       RLDI 11, EVAL_B_ROOK_F1
   1299   0b                LDN 11
   129a   fb ff             XRI $FF
   129c   c2 13 0b          LBZ EVAL_BR_DONE
   129f   0b                LDN 11
   12a0   fc 18             ADI LOW(B_PAWN_FILE_CT)
   12a2   ab                PLO 11
