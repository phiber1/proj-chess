   132b   fa 80             ANI $80
   132d   c2 13 38          LBZ HM_AMP_DONE     ; (R9 + 250) >= 0 -> R9 >= -250, not hopeless, skip
   1330   89                GLO 9               ; hopeless: R9 -= 2000
   1331   ff d0             SMI LOW(2000)
   1333   a9                PLO 9
   1334   99                GHI 9
   1335   7f 07             SMBI HIGH(2000)
   1337   b9                PHI 9
