   22f6   68 ca 64 46       RLDI 10, SCORE_HI
   22fa   99                GHI 9               ; high byte → SCORE_HI (lower address)
   22fb   5a                STR 10
   22fc   1a                INC 10
   22fd   89                GLO 9               ; low byte → SCORE_LO (higher address)
   22fe   5a                STR 10
                        
                            ; -----------------------------------------------
                            ; LMR Re-search Check: Did reduced search beat alpha?
                            ; -----------------------------------------------
                            ; Read LMR_OUTER from memory (LMR_REDUCED was cleared by recursive call)
   22ff   68 ca 64 a6       RLDI 10, LMR_OUTER
   2303   0a                LDN 10              ; D = LMR_OUTER flag
   2304   c2 23 d4          LBZ LMR_NO_RESEARCH ; Not reduced, skip re-search check
                        
