   23f1   98                GHI 8
   23f2   bb                PHI 11
   23f3   88                GLO 8
   23f4   ab                PLO 11              ; R11 = properly encoded cutoff move
   23f5   d4 28 52          CALL STORE_KILLER_MOVE
                        
                            ; -- TT node flag: BETA (lower bound) --
   23f8   68 ca 64 48       RLDI 10, CURRENT_PLY
   23fc   0a                LDN 10
   23fd   fc d2             ADI LOW(NODE_TT_FLAGS)
   23ff   aa                PLO 10
   2400   f8 64             LDI HIGH(NODE_TT_FLAGS)
   2402   ba                PHI 10
   2403   f8 03             LDI TT_FLAG_BETA
   2405   5a                STR 10
                        
   2406   c0 24 fb          LBR NEGAMAX_RETURN
                        
   2409                 NEGAMAX_NO_BETA_CUTOFF:
                            ; Score is already in R13 from earlier load (before beta check)
                            ; R9 = move list pointer (preserved)
                        
