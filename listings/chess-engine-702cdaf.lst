   2417   5a                STR 10
   2418   98                GHI 8               ; best high byte
   2419   f3                XOR                 ; XOR high bytes
   241a   fa 80             ANI $80             ; Check if sign bits differ
   241c   e2                SEX 2               ; X = R2 (restore for branches)
   241d   ca 24 3e          LBNZ NEGAMAX_DIFF_SIGN
                        
                            ; Same sign - use subtraction result
   2420   ea                SEX 10
   2421   98                GHI 8
   2422   5a                STR 10
   2423   9d                GHI 13
   2424   f5                SD                  ; D = score_hi - best_hi
   2425   e2                SEX 2
   2426   ca 24 38          LBNZ NEGAMAX_HI_DIFF
                            ; High bytes equal, compare low
   2429   ea                SEX 10
   242a   88                GLO 8
   242b   5a                STR 10
   242c   8d                GLO 13
   242d   f5                SD                  ; D = score_lo - best_lo
   242e   e2                SEX 2
   242f   c2 24 cb          LBZ NEGAMAX_NEXT_MOVE       ; Equal, don't update (keep first move)
   2432   cb 24 44          LBNF NEGAMAX_SCORE_BETTER   ; DF=0: score > best
   2435   c0 24 cb          LBR NEGAMAX_NEXT_MOVE       ; DF=1: score < best
                        
   2438                 NEGAMAX_HI_DIFF:
   2438   cb 24 44          LBNF NEGAMAX_SCORE_BETTER   ; DF=0: score > best
   243b   c0 24 cb          LBR NEGAMAX_NEXT_MOVE       ; DF=1: score < best
                        
   243e                 NEGAMAX_DIFF_SIGN:
                            ; Different signs - positive number is greater
   243e   9d                GHI 13
   243f   fa 80             ANI $80
   2441   ca 24 cb          LBNZ NEGAMAX_NEXT_MOVE      ; Score negative, best positive - skip
                            ; Score positive/zero, best negative - update (fall through)
                        
   2444                 NEGAMAX_SCORE_BETTER:
                            ; Score is better, update best score in memory (R13 -> BEST_SCORE)
   2444   68 ca 64 0e       RLDI 10, BEST_SCORE_HI
