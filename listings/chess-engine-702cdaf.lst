   2468   68 ca 64 09       RLDI 10, UNDO_FROM
   246c   4a                LDA 10              ; UNDO_FROM
   246d   b7                PHI 7               ; Temp
   246e   0a                LDN 10              ; UNDO_TO
   246f   a7                PLO 7               ; R7 = from/to
                        
