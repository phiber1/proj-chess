   2475   5a                STR 10              ; BEST_MOVE[0] = from
   2476   1a                INC 10
   2477   87                GLO 7
   2478   5a                STR 10              ; BEST_MOVE[1] = to
                        
                            ; Fall through to alpha update
                        
   2479                 NEGAMAX_UPDATE_ALPHA:
                            ; -----------------------------------------------
                            ; Update alpha: if (score > alpha) alpha = score
                            ; -----------------------------------------------
                            ; R13 = score (preserved from NEGAMAX_SCORE_BETTER entry)
                            ; Load alpha from memory into R8
   2479   68 ca 64 42       RLDI 10, ALPHA_HI
   247d   4a                LDA 10
   247e   b8                PHI 8               ; R8.1 = alpha_hi
   247f   0a                LDN 10
   2480   a8                PLO 8               ; R8 = alpha
                        
                            ; Signed compare: score (R13) > alpha (R8)?
   2481   68 ca 64 49       RLDI 10, COMPARE_TEMP
   2485   ea                SEX 10
                        
                            ; Check if signs differ
   2486   9d                GHI 13              ; score_hi
   2487   5a                STR 10
   2488   98                GHI 8               ; alpha_hi
   2489   f3                XOR
   248a   fa 80             ANI $80
   248c   e2                SEX 2
   248d   ca 24 ae          LBNZ NEGAMAX_ALPHA_DIFF_SIGN
                        
                            ; Same sign: score > alpha if (score - alpha) > 0
   2490   ea                SEX 10
   2491   98                GHI 8               ; alpha_hi
   2492   5a                STR 10
   2493   9d                GHI 13              ; score_hi
   2494   f5                SD                  ; D = score_hi - alpha_hi
   2495   e2                SEX 2
   2496   ca 24 a8          LBNZ NEGAMAX_ALPHA_HI_DIFF
                            ; High bytes equal, compare low
   2499   ea                SEX 10
   249a   88                GLO 8               ; alpha_lo
   249b   5a                STR 10
   249c   8d                GLO 13              ; score_lo
   249d   f5                SD                  ; D = score_lo - alpha_lo
   249e   e2                SEX 2
   249f   c2 24 cb          LBZ NEGAMAX_NEXT_MOVE           ; Equal, don't update
   24a2   cb 24 b4          LBNF NEGAMAX_ALPHA_DO_UPDATE    ; DF=0: score > alpha
   24a5   c0 24 cb          LBR NEGAMAX_NEXT_MOVE           ; DF=1: score < alpha
                        
   24a8                 NEGAMAX_ALPHA_HI_DIFF:
   24a8   cb 24 b4          LBNF NEGAMAX_ALPHA_DO_UPDATE    ; DF=0: score > alpha
   24ab   c0 24 cb          LBR NEGAMAX_NEXT_MOVE           ; DF=1: score < alpha
                        
   24ae                 NEGAMAX_ALPHA_DIFF_SIGN:
                            ; Different signs: positive > negative
   24ae   9d                GHI 13              ; score_hi
   24af   fa 80             ANI $80
   24b1   ca 24 cb          LBNZ NEGAMAX_NEXT_MOVE          ; Score negative, alpha positive - skip
                            ; Score positive, alpha negative - update (fall through)
                        
   24b4                 NEGAMAX_ALPHA_DO_UPDATE:
                            ; alpha = score
   24b4   68 ca 64 42       RLDI 10, ALPHA_HI
   24b8   9d                GHI 13
   24b9   5a                STR 10
   24ba   1a                INC 10
   24bb   8d                GLO 13
   24bc   5a                STR 10              ; ALPHA = score
                        
                            ; -- TT node flag: EXACT (PV node) --
   24bd   68 ca 64 48       RLDI 10, CURRENT_PLY
   24c1   0a                LDN 10
   24c2   fc d2             ADI LOW(NODE_TT_FLAGS)
   24c4   aa                PLO 10
   24c5   f8 64             LDI HIGH(NODE_TT_FLAGS)
   24c7   ba                PHI 10
   24c8   f8 01             LDI TT_FLAG_EXACT
   24ca   5a                STR 10
                        
   24cb                 NEGAMAX_NEXT_MOVE:
                            ; -----------------------------------------------
                            ; Increment LMR move counter (move was processed)
                            ; -----------------------------------------------
   24cb   68 ca 64 a3       RLDI 10, LMR_MOVE_INDEX
   24cf   0a                LDN 10
   24d0   fc 01             ADI 1
   24d2   5a                STR 10              ; LMR_MOVE_INDEX++
                        
                            ; -----------------------------------------------
                            ; Decrement move counter and continue loop
                            ; -----------------------------------------------
   24d3   68 ca 64 48       RLDI 10, CURRENT_PLY
   24d7   0a                LDN 10             ; D = ply
   24d8   fc ef             ADI LOW(LOOP_MOVE_CNT)
   24da   aa                PLO 10
   24db   f8 64             LDI HIGH(LOOP_MOVE_CNT)
   24dd   ba                PHI 10             ; R10 = &LOOP_MOVE_CNT[ply]
   24de   0a                LDN 10             ; D = move count
   24df   ff 01             SMI 1              ; Decrement
   24e1   5a                STR 10             ; LOOP_MOVE_CNT[ply]-- (D still holds new value)
   24e2   c2 24 e8          LBZ NEGAMAX_LOOP_DONE ; If count == 0, exit loop (long branch)
   24e5   c0 1f 90          LBR NEGAMAX_MOVE_LOOP
                        
   24e8                 NEGAMAX_LOOP_DONE:
                            ; Count (now in LOOP_MOVE_CNT[ply], not the stack) reached 0.
                            ; R2 was never perturbed by count management — no stack re-sync needed.
                        
                            ; Check if any legal move updated BEST_SCORE.
                            ; If BEST_SCORE is still $8001 (initial sentinel), no legal move
                            ; was found - all pseudo-legal moves left king in check.
                            ; This is checkmate or stalemate; handle via NEGAMAX_NO_MOVES.
                            ; (R2 is at the function-entry position; count is in LOOP_MOVE_CNT, not stack)
   24e8   68 ca 64 0e       RLDI 10, BEST_SCORE_HI
   24ec   4a                LDA 10              ; D = BEST_SCORE_HI
   24ed   fb 80             XRI $80
   24ef   ca 24 fb          LBNZ NEGAMAX_RETURN ; BEST_SCORE_HI != $80 → a legal move was scored
   24f2   0a                LDN 10              ; D = BEST_SCORE_LO
   24f3   fb 01             XRI $01
   24f5   ca 24 fb          LBNZ NEGAMAX_RETURN ; BEST_SCORE_LO != $01 → a legal move was scored
                        
                            ; BEST_SCORE == $8001: no legal move improved the sentinel.
                            ; All pseudo-legal moves were illegal → checkmate or stalemate.
   24f8   c0 25 4c          LBR NEGAMAX_NO_MOVES
                        
   24fb                 NEGAMAX_RETURN:
                            ; -----------------------------------------------
                            ; Return best score (from BEST_SCORE memory) via R9
                            ; -----------------------------------------------
                            ; Move count now lives in LOOP_MOVE_CNT[ply], never on the stack, so R2
                            ; is already at the function-entry position here — no count byte to pop.
                            ; (Was: IRX to skip a stack-resident move count. See LOOP_MOVE_CNT.)
                        
                            ; Copy BEST_SCORE to SCORE memory BEFORE restore (RESTORE clobbers R9!)
                            ; Best score is in BEST_SCORE_HI/LO, copy to SCORE_HI/LO for return
   24fb   68 ca 64 0e       RLDI 10, BEST_SCORE_HI
   24ff   4a                LDA 10              ; BEST_SCORE_HI
   2500   b8                PHI 8               ; Temp in R8.1
   2501   0a                LDN 10              ; BEST_SCORE_LO
   2502   a8                PLO 8               ; Temp in R8.0
                        
   2503   68 ca 64 46       RLDI 10, SCORE_HI
   2507   98                GHI 8               ; Best score high byte
   2508   5a                STR 10
   2509   1a                INC 10
   250a   88                GLO 8               ; Best score low byte
   250b   5a                STR 10
                        
                            ; -----------------------------------------------
                            ; Store result in Transposition Table
                            ; -----------------------------------------------
                            ; Hash is updated incrementally in MAKE/UNMAKE_MOVE,
                            ; so TT works correctly at all nodes.
                        
                            ; TT_STORE expects: D = depth, R8.0 = flag, SCORE_HI/LO and BEST_MOVE set
                            ; -- Load TT node flag for current ply --
   250c   68 ca 64 48       RLDI 10, CURRENT_PLY
   2510   0a                LDN 10
   2511   fc d2             ADI LOW(NODE_TT_FLAGS)
   2513   aa                PLO 10
   2514   f8 64             LDI HIGH(NODE_TT_FLAGS)
   2516   ba                PHI 10
   2517   0a                LDN 10              ; D = flag
   2518   a8                PLO 8               ; R8.0 = flag
   2519   68 ca 64 17       RLDI 10, SEARCH_DEPTH + 1
   251d   0a                LDN 10              ; D = depth (low byte = actual depth)
   251e   d4 57 a8          CALL TT_STORE
                        
                            ; Restore caller's context (clobbers R7, R8, R9, R11, R12)
   2521   d4 00 54          CALL RESTORE_PLY_STATE
                        
                            ; Load return value back into R9 AFTER restore
                            ; Big-endian: load high byte from lower address first
   2524   68 ca 64 46       RLDI 10, SCORE_HI
   2528   4a                LDA 10              ; SCORE_HI -> high byte
   2529   b9                PHI 9
   252a   0a                LDN 10              ; SCORE_LO -> low byte
   252b   a9                PLO 9
                        
   252c   d5                RETN
                        
   252d                 NEGAMAX_LEAF:
                            ; -----------------------------------------------
                            ; Leaf node - do quiescence search
                            ; -----------------------------------------------
   252d   d4 25 9b          CALL QUIESCENCE_SEARCH
                            ; Returns score in R9 (already from side-to-move's perspective)
                        
                            ; DIAG stamp (2026-07-17 hang hunt): leaf bookkeeping after QSEARCH.
   2530   68 ca 64 1d       RLDI 10, TRACE_WHERE
   2534   f8 a6             LDI $A6
   2536   5a                STR 10              ; tracer: back from QSEARCH (R10 reloaded below)
                        
                            ; Save return value to SCORE memory BEFORE restore (RESTORE clobbers R9!)
                            ; Big-endian: store high byte at lower address (SCORE_HI), low at SCORE_LO
   2537   68 ca 64 46       RLDI 10, SCORE_HI
   253b   99                GHI 9               ; Score high byte first
   253c   5a                STR 10
   253d   1a                INC 10
   253e   89                GLO 9               ; Score low byte second
   253f   5a                STR 10
                        
                            ; Restore caller's context (clobbers R7, R8, R9, R11, R12)
   2540   d4 00 54          CALL RESTORE_PLY_STATE
                        
                            ; Load return value back into R9 AFTER restore
                            ; Big-endian: load high byte from lower address first
   2543   68 ca 64 46       RLDI 10, SCORE_HI
   2547   4a                LDA 10              ; SCORE_HI -> high byte
   2548   b9                PHI 9
   2549   0a                LDN 10              ; SCORE_LO -> low byte
   254a   a9                PLO 9
                        
   254b   d5                RETN
                        
   254c                 NEGAMAX_NO_MOVES:
                            ; -----------------------------------------------
                            ; No legal moves - checkmate or stalemate
                            ; -----------------------------------------------
                            ; Check if in check
   254c   d4 01 8e          CALL IS_IN_CHECK
                            ; Returns: D = 1 if in check, 0 if not
                        
   254f   c2 25 81          LBZ NEGAMAX_STALEMATE   ; Long branch - may cross page
                        
                            ; Checkmate - return mate-score adjusted by ply so shorter mates score higher.
                            ; Formula: score = -MATE_VAL + ply  (standard negamax mate convention)
                            ; The mated side's score is "less negative" the farther from root we are,
                            ; so after the negation chain back to root, the side delivering the mate
                            ; sees a HIGHER score for SHORTER mate sequences (mate-in-1 > mate-in-2 > ...).
                            ;
                            ; FIXED 2026-04-27: previously used SEARCH_DEPTH+1 (depth_remaining), which
                            ; INVERTED the preference — engine consistently picked longer mates over
                            ; shorter ones at d>=3. Manifested visibly only after 2271af2 enabled real
                            ; promotions (positions with multiple forced-mate sequences became reachable).
                            ;
                            ; NOTE: Use $8001 (-32767) not $8000 (-32768) to avoid overflow when negating!
                            ; -(-32768) = -32768 due to two's complement overflow, breaking score propagation!
   2552   f8 80             LDI $80
   2554   b9                PHI 9
   2555   f8 01             LDI $01
   2557   a9                PLO 9              ; R9 = -32767 (R6 is SCRT linkage - off limits!)
                        
                            ; Add ply (distance from root) so shorter mates score higher
   2558   68 cd 64 48       RLDI 13, CURRENT_PLY
   255c   0d                LDN 13              ; D = current ply (0 at root, increases with depth)
                            ; Use COMPARE_TEMP for ADD scratch (NEVER use STR 2!)
   255d   68 ca 64 49       RLDI 10, COMPARE_TEMP
   2561   ea                SEX 10
   2562   5a                STR 10
   2563   89                GLO 9
   2564   f4                ADD
   2565   e2                SEX 2
   2566   a9                PLO 9
                            ; High byte stays same (adding small depth won't overflow)
                        
                            ; Store checkmate score to BEST_SCORE memory for return
   2567   68 ca 64 0e       RLDI 10, BEST_SCORE_HI
   256b   99                GHI 9               ; Score high byte
   256c   5a                STR 10
   256d   1a                INC 10
   256e   89                GLO 9               ; Score low byte
   256f   5a                STR 10
                        
                            ; -- TT node flag: EXACT (checkmate) --
   2570   68 ca 64 48       RLDI 10, CURRENT_PLY
   2574   0a                LDN 10
   2575   fc d2             ADI LOW(NODE_TT_FLAGS)
   2577   aa                PLO 10
   2578   f8 64             LDI HIGH(NODE_TT_FLAGS)
   257a   ba                PHI 10
   257b   f8 01             LDI TT_FLAG_EXACT
   257d   5a                STR 10
                        
   257e   c0 24 fb          LBR NEGAMAX_RETURN
                        
   2581                 NEGAMAX_STALEMATE:
                            ; Stalemate - return 0 (draw)
                            ; Store 0 to BEST_SCORE memory for return
   2581   68 ca 64 0e       RLDI 10, BEST_SCORE_HI
   2585   f8 00             LDI 0
   2587   5a                STR 10              ; BEST_SCORE_HI = 0
   2588   1a                INC 10
   2589   5a                STR 10              ; BEST_SCORE_LO = 0
                        
                            ; -- TT node flag: EXACT (stalemate) --
   258a   68 ca 64 48       RLDI 10, CURRENT_PLY
   258e   0a                LDN 10
   258f   fc d2             ADI LOW(NODE_TT_FLAGS)
   2591   aa                PLO 10
   2592   f8 64             LDI HIGH(NODE_TT_FLAGS)
   2594   ba                PHI 10
   2595   f8 01             LDI TT_FLAG_EXACT
   2597   5a                STR 10
                        
   2598   c0 24 fb          LBR NEGAMAX_RETURN
                        
                        ; ==============================================================================
                        ; QUIESCENCE_SEARCH - Search captures at leaf nodes
                        ; ==============================================================================
                        ; Avoids horizon effect by extending search for captures
                        ; Input:  C = color (0 for white, 8 for black - matches COLOR_MASK)
                        ;         A = board pointer
                        ; Output: R9 = best score (from side-to-move's perspective)
                        ; NOTE:   R6 is SCRT linkage register - off limits for application data!
                        ; ==============================================================================
   259b                 QUIESCENCE_SEARCH:
                            ; Ensure X=2 for stack operations
   259b   e2                SEX 2
                        
   259c   68 ca 64 1d       RLDI 10, TRACE_WHERE
   25a0   f8 c1             LDI $C1
   25a2   5a                STR 10              ; tracer: in QSEARCH
                        
                            ; Stack overflow detection (see NEGAMAX comment).
   25a3   d4 00 87          CALL CHECK_STACK_OVERFLOW
                        
                            ; Stand-pat: evaluate current position
   25a6   d4 0e a7          CALL EVALUATE
                            ; Returns score in R9 (from white's perspective)
                        
                            ; DIAG stamp (2026-07-17 hang hunt): QS stand-pat/capture-gen window.
   25a9   68 ca 64 1d       RLDI 10, TRACE_WHERE
   25ad   f8 c2             LDI $C2
   25af   5a                STR 10              ; tracer: QS post-eval (R10 reloaded below)
                        
                            ; Negate R9 if black to move (white-perspective → side-to-move)
   25b0   8c                GLO 12
   25b1   fa 08             ANI $08
   25b3   c2 25 be          LBZ QS_SAVE_STANDPAT
   25b6   89                GLO 9               ; low byte
   25b7   fd 00             SDI 0               ; negate low
   25b9   a9                PLO 9
   25ba   99                GHI 9               ; high byte
   25bb   7d 00             SDBI 0              ; negate high with borrow
   25bd   b9                PHI 9
                        
   25be                 QS_SAVE_STANDPAT:
                            ; Save stand-pat score to QS_BEST_HI/LO
   25be   68 ca 64 18       RLDI 10, QS_BEST_HI
   25c2   99                GHI 9               ; high byte → QS_BEST_HI (lower address)
   25c3   5a                STR 10
   25c4   1a                INC 10
   25c5   89                GLO 9               ; low byte → QS_BEST_LO (higher address)
   25c6   5a                STR 10
                        
                            ; -----------------------------------------------
                            ; Stand-pat beta cutoff: if stand-pat >= beta, return
                            ; (Position is already good enough, no need to search captures)
                            ; -----------------------------------------------
                            ; Load beta from memory (big-endian: HI at lower address)
   25c7   68 ca 64 44       RLDI 10, BETA_HI
   25cb   4a                LDA 10              ; beta high
   25cc   b7                PHI 7
   25cd   0a                LDN 10              ; beta low
   25ce   a7                PLO 7               ; R7 = beta
                        
                            ; Compare: stand-pat (R9) >= beta (R7)?
                            ; Signed comparison using COMPARE_TEMP
   25cf   68 ca 64 49       RLDI 10, COMPARE_TEMP
   25d3   ea                SEX 10
   25d4   99                GHI 9               ; stand-pat high
   25d5   5a                STR 10
   25d6   97                GHI 7               ; beta high
   25d7   f3                XOR
   25d8   fa 80             ANI $80             ; Check if different signs
   25da   e2                SEX 2
   25db   ca 25 ee          LBNZ QS_BETA_DIFF_SIGN
                        
                            ; Same sign - compare magnitudes
                            ; stand-pat >= beta means stand-pat - beta >= 0, i.e., no borrow
   25de   ea                SEX 10
   25df   87                GLO 7               ; beta low
   25e0   5a                STR 10
   25e1   89                GLO 9               ; stand-pat low
   25e2   f7                SM                  ; D = stand-pat_lo - beta_lo
   25e3   97                GHI 7               ; beta high
   25e4   5a                STR 10
   25e5   99                GHI 9               ; stand-pat high
   25e6   77                SMB                 ; D = stand-pat_hi - beta_hi - borrow
   25e7   e2                SEX 2
   25e8   c3 28 49          LBDF QS_RETURN      ; No borrow = stand-pat >= beta, cutoff!
   25eb   c0 25 f4          LBR QS_NO_BETA_CUTOFF
                        
   25ee                 QS_BETA_DIFF_SIGN:
                            ; Different signs: positive >= negative always
                            ; stand-pat positive (bit 7 = 0) means stand-pat >= beta
   25ee   99                GHI 9
   25ef   fa 80             ANI $80
   25f1   c2 28 49          LBZ QS_RETURN       ; stand-pat positive, beta negative -> cutoff
                        
   25f4                 QS_NO_BETA_CUTOFF:
                            ; -----------------------------------------------
                            ; Alpha update: if stand-pat > alpha, alpha = stand-pat
                            ; (Tightens window, makes beta cutoffs more likely)
                            ; -----------------------------------------------
                            ; Load alpha (R9 still has stand-pat)
   25f4   68 ca 64 42       RLDI 10, ALPHA_HI
   25f8   4a                LDA 10              ; alpha high
   25f9   b7                PHI 7
   25fa   0a                LDN 10              ; alpha low
   25fb   a7                PLO 7               ; R7 = alpha
                        
                            ; Compare: stand-pat (R9) > alpha (R7)?
   25fc   68 ca 64 49       RLDI 10, COMPARE_TEMP
   2600   ea                SEX 10
   2601   99                GHI 9
   2602   5a                STR 10
   2603   97                GHI 7
   2604   f3                XOR
   2605   fa 80             ANI $80
   2607   e2                SEX 2
   2608   ca 26 23          LBNZ QS_ALPHA_DIFF_SIGN
                        
                            ; Same sign - R9 > R7 means R9 - R7 > 0 (positive, no borrow, not zero)
   260b   ea                SEX 10
   260c   87                GLO 7
   260d   5a                STR 10
   260e   89                GLO 9
   260f   f7                SM                  ; D = stand-pat_lo - alpha_lo
   2610   b8                PHI 8               ; Save low result
   2611   97                GHI 7
   2612   5a                STR 10
   2613   99                GHI 9
   2614   77                SMB                 ; D = stand-pat_hi - alpha_hi - borrow
   2615   e2                SEX 2
   2616   cb 26 32          LBNF QS_NO_ALPHA_UPDATE  ; Borrow = stand-pat <= alpha
   2619   ca 26 29          LBNZ QS_UPDATE_ALPHA     ; High diff non-zero and positive
   261c   98                GHI 8                    ; Check low diff
   261d   c2 26 32          LBZ QS_NO_ALPHA_UPDATE   ; Both zero = equal, don't update
   2620   c0 26 29          LBR QS_UPDATE_ALPHA
                        
   2623                 QS_ALPHA_DIFF_SIGN:
                            ; Different signs: positive > negative
   2623   99                GHI 9
   2624   fa 80             ANI $80
   2626   ca 26 32          LBNZ QS_NO_ALPHA_UPDATE  ; stand-pat negative, alpha positive
                            ; stand-pat positive, alpha negative -> update
                        
   2629                 QS_UPDATE_ALPHA:
                            ; alpha = stand-pat
   2629   68 ca 64 42       RLDI 10, ALPHA_HI
   262d   99                GHI 9
   262e   5a                STR 10
   262f   1a                INC 10
   2630   89                GLO 9
   2631   5a                STR 10
                        
   2632                 QS_NO_ALPHA_UPDATE:
                            ; -----------------------------------------------
                            ; Delta pruning: if stand-pat + QUEEN_VALUE < alpha, return alpha
                            ; (Even capturing a queen can't raise alpha - futile to search)
                            ; -----------------------------------------------
                            ; Load alpha from memory (big-endian: HI at lower address)
   2632   68 ca 64 42       RLDI 10, ALPHA_HI
   2636   4a                LDA 10              ; alpha high
   2637   b7                PHI 7
   2638   0a                LDN 10              ; alpha low
   2639   a7                PLO 7               ; R7 = alpha
                        
                            ; Calculate stand-pat + QUEEN_VALUE (900 = $0384)
                            ; R9 = stand-pat, add 900
   263a   89                GLO 9
   263b   fc 84             ADI LOW(900)        ; Add low byte of 900 ($84)
   263d   a8                PLO 8
   263e   99                GHI 9
   263f   7c 03             ADCI HIGH(900)      ; Add high byte of 900 ($03) + carry
   2641   b8                PHI 8               ; R8 = stand-pat + 900
                        
                            ; Compare: (stand-pat + 900) < alpha?
                            ; If R8 < R7, then delta prune
   2642   68 ca 64 49       RLDI 10, COMPARE_TEMP
   2646   ea                SEX 10
   2647   98                GHI 8               ; (stand-pat + 900) high
   2648   5a                STR 10
   2649   97                GHI 7               ; alpha high
   264a   f3                XOR
   264b   fa 80             ANI $80             ; Check if different signs
   264d   e2                SEX 2
   264e   ca 26 61          LBNZ QS_DELTA_DIFF_SIGN
                        
                            ; Same sign - compare: R8 < R7 means R8 - R7 has borrow
   2651   ea                SEX 10
   2652   87                GLO 7               ; alpha low
   2653   5a                STR 10
   2654   88                GLO 8               ; (stand-pat + 900) low
   2655   f7                SM                  ; D = (sp+900)_lo - alpha_lo
   2656   97                GHI 7               ; alpha high
   2657   5a                STR 10
   2658   98                GHI 8               ; (stand-pat + 900) high
   2659   77                SMB                 ; D = (sp+900)_hi - alpha_hi - borrow
   265a   e2                SEX 2
   265b   cb 26 67          LBNF QS_DELTA_PRUNE ; Borrow = (stand-pat + 900) < alpha, prune!
   265e   c0 26 6c          LBR QS_NO_DELTA_PRUNE
                        
   2661                 QS_DELTA_DIFF_SIGN:
                            ; Different signs: negative < positive always
                            ; (stand-pat + 900) negative means it's < alpha (if alpha positive)
   2661   98                GHI 8
   2662   fa 80             ANI $80
   2664   c2 26 6c          LBZ QS_NO_DELTA_PRUNE ; (stand-pat + 900) positive -> no prune
                        
   2667                 QS_DELTA_PRUNE:
                            ; Return alpha (in R7) - we're too far behind
   2667   97                GHI 7
   2668   b9                PHI 9
   2669   87                GLO 7
   266a   a9                PLO 9               ; R9 = alpha
   266b   d5                RETN
                        
   266c                 QS_NO_DELTA_PRUNE:
                            ; Generate all moves (use QS_MOVE_LIST to avoid clobbering parent's move list!)
   266c   68 c9 67 80       RLDI 9, QS_MOVE_LIST
   2670   d4 04 d7          CALL GENERATE_MOVES
                            ; D = move count
                        
                            ; Save move count to temp (must clear R15.1 to avoid DEC underflow!)
   2673   af                PLO 15              ; R15.0 = move count (temp)
   2674   f8 00             LDI 0
   2676   bf                PHI 15              ; R15.1 = 0 (prevents underflow when DEC 15)
                        
                            ; Save move list start pointer (big-endian: high byte first)
   2677   68 ca 64 1a       RLDI 10, QS_MOVE_PTR_HI
   267b   f8 67             LDI HIGH(QS_MOVE_LIST)
   267d   5a                STR 10
   267e   1a                INC 10
   267f   f8 80             LDI LOW(QS_MOVE_LIST)
   2681   5a                STR 10
                        
                            ; Initialize capture limit counter
   2682   f8 08             LDI 8                   ; QS_CAPTURE_LIMIT = 8 captures max
   2684   bb                PHI 11                  ; R11.1 = captures remaining
                        
   2685                 QS_LOOP:
   2685   3f 89             BN4  BRK_QS_LOOP      ; /EF4 break trap (DEBUG)
   2687   79                MARK
   2688   d1                SEP  1
   2689                 BRK_QS_LOOP:
                            ; Check if any moves left
   2689   8f                GLO 15
   268a   c2 28 49          LBZ QS_RETURN
                        
                            ; Load move list pointer (big-endian: high byte first)
   268d   68 ca 64 1a       RLDI 10, QS_MOVE_PTR_HI
   2691   4a                LDA 10              ; High byte
   2692   b9                PHI 9
   2693   0a                LDN 10              ; Low byte
   2694   a9                PLO 9               ; R9 = move pointer
                        
                            ; Load encoded move (big-endian: high byte first)
   2695   49                LDA 9
   2696   b8                PHI 8
   2697   49                LDA 9
   2698   a8                PLO 8               ; R8 = encoded move
                        
                            ; Save updated pointer (big-endian: high byte first)
   2699   68 ca 64 1a       RLDI 10, QS_MOVE_PTR_HI
   269d   99                GHI 9
   269e   5a                STR 10
   269f   1a                INC 10
   26a0   89                GLO 9
   26a1   5a                STR 10
                        
                            ; Decrement move count
   26a2   2f                DEC 15
                        
                            ; Decode move to get from/to squares
   26a3   d4 03 c7          CALL DECODE_MOVE_16BIT
                            ; R13.1 = from, R13.0 = to (R14.0 = flags - but we don't use it)
                        
                            ; Check if this is a capture: target square must have enemy piece
   26a6   f8 60             LDI HIGH(BOARD)
   26a8   ba                PHI 10
   26a9   8d                GLO 13              ; to square
   26aa   aa                PLO 10
   26ab   0a                LDN 10              ; piece at target
   26ac   c2 26 85          LBZ QS_LOOP         ; Empty = not a capture, skip
                        
                            ; Has piece - check if enemy color
   26af   fa 08             ANI COLOR_MASK      ; D = target piece color (0 or 8)
                            ; Use COMPARE_TEMP for XOR scratch (NEVER use STR 2!)
   26b1   68 ca 64 49       RLDI 10, COMPARE_TEMP
   26b5   ea                SEX 10
   26b6   5a                STR 10              ; Store target color to COMPARE_TEMP
   26b7   8c                GLO 12              ; D = our color (0 or 8, per COLOR_MASK)
   26b8   fa 08             ANI COLOR_MASK      ; D = our color masked (0 or 8)
   26ba   f3                XOR                 ; D = our_color XOR target_color
   26bb   e2                SEX 2
   26bc   c2 26 85          LBZ QS_LOOP         ; Same color (result 0) = own piece, skip
                        
                            ; -------------------------------------------------
                            ; Per-capture delta pruning:
                            ; If stand_pat + victim_value < alpha, skip capture
                            ; (Even capturing this piece won't raise score above alpha)
                            ; -------------------------------------------------
                            ; Reload victim piece and extract type
   26bf   f8 60             LDI HIGH(BOARD)
   26c1   ba                PHI 10
   26c2   8d                GLO 13              ; to square (preserved in R13.0)
   26c3   aa                PLO 10
   26c4   0a                LDN 10              ; piece at target
   26c5   fa 07             ANI $07             ; D = piece type (1-6)
                        
                            ; Look up value: PIECE_VALUES + type*2
   26c7   fe                SHL                 ; D = type * 2
   26c8   fc f3             ADI LOW(PIECE_VALUES)
   26ca   aa                PLO 10
   26cb   f8 0d             LDI HIGH(PIECE_VALUES)
   26cd   7c 00             ADCI 0
   26cf   ba                PHI 10              ; R10 = &PIECE_VALUES[type]
                        
   26d0   4a                LDA 10              ; victim value high
   26d1   b8                PHI 8
   26d2   0a                LDN 10              ; victim value low
   26d3   a8                PLO 8               ; R8 = victim_value
                        
                            ; Load stand_pat from QS_BEST
   26d4   68 ca 64 18       RLDI 10, QS_BEST_HI
   26d8   4a                LDA 10
   26d9   b7                PHI 7
   26da   0a                LDN 10
   26db   a7                PLO 7               ; R7 = stand_pat
                        
                            ; R7 = stand_pat + victim_value
   26dc   88                GLO 8
   26dd   52                STR 2               ; Use stack top as temp
   26de   87                GLO 7
   26df   f4                ADD
   26e0   a7                PLO 7
   26e1   98                GHI 8
   26e2   52                STR 2
   26e3   97                GHI 7
   26e4   74                ADC
   26e5   b7                PHI 7               ; R7 = stand_pat + victim_value
                        
                            ; Load alpha
   26e6   68 ca 64 42       RLDI 10, ALPHA_HI
   26ea   4a                LDA 10
   26eb   b8                PHI 8
   26ec   0a                LDN 10
   26ed   a8                PLO 8               ; R8 = alpha
                        
                            ; Compare: (stand_pat + victim) < alpha?
                            ; If R7 < R8, skip this capture
   26ee   68 ca 64 49       RLDI 10, COMPARE_TEMP
   26f2   ea                SEX 10
   26f3   97                GHI 7               ; (stand_pat + victim) high
   26f4   5a                STR 10
   26f5   98                GHI 8               ; alpha high
   26f6   f3                XOR
   26f7   fa 80             ANI $80             ; Check if different signs
   26f9   e2                SEX 2
   26fa   ca 27 0d          LBNZ QS_DELTA_DIFF_SIGN2
                        
                            ; Same sign: R7 < R8 means R7 - R8 has borrow
   26fd   ea                SEX 10
   26fe   88                GLO 8               ; alpha low
   26ff   5a                STR 10
   2700   87                GLO 7               ; (stand_pat + victim) low
   2701   f7                SM                  ; D = (sp+v)_lo - alpha_lo
   2702   98                GHI 8               ; alpha high
   2703   5a                STR 10
   2704   97                GHI 7               ; (stand_pat + victim) high
   2705   77                SMB                 ; D = (sp+v)_hi - alpha_hi - borrow
   2706   e2                SEX 2
   2707   cb 26 85          LBNF QS_LOOP        ; Borrow = (stand_pat + victim) < alpha, skip!
   270a   c0 27 13          LBR QS_DELTA_NO_PRUNE
                        
   270d                 QS_DELTA_DIFF_SIGN2:
                            ; Different signs: negative < positive always
                            ; (stand_pat + victim) negative means it's < alpha (if alpha positive)
   270d   97                GHI 7
   270e   fa 80             ANI $80
   2710   ca 26 85          LBNZ QS_LOOP        ; (stand_pat + victim) negative -> skip capture
                        
   2713                 QS_DELTA_NO_PRUNE:
                            ; -------------------------------------------------
                            ; End per-capture delta pruning
                            ; -------------------------------------------------
                        
                            ; It's a capture! Process it.
                            ; Save move count to stack (BOTH bytes! IS_IN_CHECK clobbers R15.1)
   2713   9f                GHI 15
   2714   73                STXD
   2715   8f                GLO 15
   2716   73                STXD
                        
                            ; ===============================================================
                            ; QSEARCH defender-check pre-filter (added 2026-05-07)
                            ; ===============================================================
                            ; QSEARCH lacks recursion: each capture is evaluated as if its
                            ; recapture won't happen. This causes phantom material wins when
                            ; we capture a defended piece with a more valuable attacker.
                            ;
                            ; Filter: if captor_value > victim_value AND target is defended
                            ; by enemy, skip this capture entirely. Single-level defender
                            ; check; doesn't see exchange chains, but catches the dominant
                            ; bug class (e.g., Bxg6 when h7-pawn defends).
                            ;
                            ; Empirical motivation (2026-05-07): post-Kxf7 d=1 returned +220cp
                            ; bestmove d3g6 (Bxg6) despite h7 pawn obviously recapturing —
                            ; QSEARCH saw bishop "win" but not the recapture.
                            ; ===============================================================
                        
                            ; Load victim_value from board[to_square]
   2717   f8 60             LDI HIGH(BOARD)
   2719   ba                PHI 10
   271a   8d                GLO 13                          ; to square
   271b   aa                PLO 10
   271c   0a                LDN 10
   271d   fa 07             ANI $07                         ; victim piece type 1-6
   271f   fe                SHL                             ; * 2 for 16-bit table
   2720   fc f3             ADI LOW(PIECE_VALUES)
   2722   aa                PLO 10
   2723   f8 0d             LDI HIGH(PIECE_VALUES)
   2725   7c 00             ADCI 0
   2727   ba                PHI 10
   2728   4a                LDA 10                          ; victim_value hi
   2729   b8                PHI 8
   272a   0a                LDN 10                          ; victim_value lo
   272b   a8                PLO 8                           ; R8 = victim_value
                        
                            ; Load captor_value from board[from_square]
   272c   f8 60             LDI HIGH(BOARD)
   272e   ba                PHI 10
   272f   9d                GHI 13                          ; from square
   2730   aa                PLO 10
   2731   0a                LDN 10
   2732   fa 07             ANI $07                         ; captor piece type 1-6
   2734   fe                SHL
   2735   fc f3             ADI LOW(PIECE_VALUES)
   2737   aa                PLO 10
   2738   f8 0d             LDI HIGH(PIECE_VALUES)
   273a   7c 00             ADCI 0
   273c   ba                PHI 10
   273d   4a                LDA 10                          ; captor_value hi
   273e   b7                PHI 7
   273f   0a                LDN 10                          ; captor_value lo
   2740   a7                PLO 7                           ; R7 = captor_value
                        
                            ; Compare: victim - captor (16-bit signed). DF=1 if victim >= captor.
   2741   87                GLO 7
   2742   52                STR 2                           ; M(R2) = captor_lo
   2743   88                GLO 8
   2744   f7                SM                              ; D = victim_lo - captor_lo
   2745   97                GHI 7
   2746   52                STR 2                           ; M(R2) = captor_hi
   2747   98                GHI 8
   2748   77                SMB                             ; D = victim_hi - captor_hi - borrow
   2749   c3 27 64          LBDF QS_DEF_OK                  ; victim >= captor: no filter
                        
                            ; Captor > victim. Check if target square is defended by enemy.
                            ; Save R11.1 (capture limit) and R13 (from/to) — IS_SQUARE_ATTACKED
                            ; restores R11.0 and R12.0 but clobbers everything else including
                            ; R13 and R15.0.
   274c   9b                GHI 11
   274d   73                STXD                            ; push capture limit
   274e   9d                GHI 13
   274f   73                STXD                            ; push from
   2750   8d                GLO 13
   2751   73                STXD                            ; push to
                        
                            ; Set R11.0 = target square, R12.0 already = our color
   2752   8d                GLO 13
   2753   ab                PLO 11
   2754   d4 01 a4          CALL IS_SQUARE_ATTACKED
   2757   a7                PLO 7                           ; R7.0 = result (0=safe, 1=attacked)
   2758   e2                SEX 2                           ; Defensive: ensure X=2 for following pop
                        
                            ; Restore saved state
   2759   60                IRX
   275a   72                LDXA                            ; pop to → R13.0
   275b   ad                PLO 13
   275c   72                LDXA                            ; pop from → R13.1
   275d   bd                PHI 13
   275e   f0                LDX                             ; pop capture limit → R11.1
   275f   bb                PHI 11
                        
   2760   87                GLO 7
   2761   ca 27 97          LBNZ QS_DEF_SKIP                ; defended: filter fires, skip capture
                        
   2764                 QS_DEF_OK:
                            ; ===============================================================
                            ; End QSEARCH defender-check pre-filter
                            ; ===============================================================
                        
                            ; Store from/to for MAKE_MOVE
   2764   68 ca 64 02       RLDI 10, MOVE_FROM
   2768   9d                GHI 13              ; from
   2769   5a                STR 10
   276a   1a                INC 10
   276b   8d                GLO 13              ; to
   276c   5a                STR 10
                        
                            ; Set UNDO_PROMOTION based on move flags (capture-promotions)
   276d   68 ca 64 04       RLDI 10, UNDO_PROMOTION
   2771   68 cd 64 05       RLDI 13, DECODED_FLAGS
   2775   0d                LDN 13              ; D = flags
   2776   fb 03             XRI MOVE_PROMOTION  ; == $03?
   2778   ca 27 80          LBNZ QS_NOT_PROMO
   277b   f8 05             LDI QUEEN_TYPE      ; Promote to queen ($05)
   277d   c0 27 82          LBR QS_SET_PROMO
   2780                 QS_NOT_PROMO:
   2780   f8 00             LDI 0               ; Not a promotion
   2782                 QS_SET_PROMO:
   2782   5a                STR 10              ; UNDO_PROMOTION = QUEEN_TYPE or 0
                        
                            ; Make move
   2783   d4 09 bb          CALL MAKE_MOVE
                        
                            ; -----------------------------------------------
                            ; LEGALITY CHECK: Does this capture leave our king in check?
                            ; MAKE_MOVE does NOT toggle R12 - only SIDE in memory.
                            ; R12 still contains our color (the side that just moved).
                            ; -----------------------------------------------
   2786   d4 01 8e          CALL IS_IN_CHECK
                            ; D = 1 if our king is in check (illegal), 0 if safe
                        
   2789   c2 27 9f          LBZ QS_CAPTURE_LEGAL  ; D=0 means not in check, capture is legal
                        
                            ; ILLEGAL CAPTURE: Unmake and skip to next capture
   278c   d4 0c 2e          CALL UNMAKE_MOVE
                        
                            ; R12 stays as our color (UNMAKE_MOVE doesn't toggle R12)
                        
                            ; Restore move count from stack and continue loop (both bytes)
   278f   60                IRX
   2790   72                LDXA
   2791   af                PLO 15              ; R15.0 = move count low
   2792   f0                LDX
   2793   bf                PHI 15              ; R15.1 = move count high (0)
   2794   c0 26 85          LBR QS_LOOP         ; Skip this illegal capture, try next
                        
   2797                 QS_DEF_SKIP:
                            ; Defender-check filter fired: skip capture WITHOUT make/unmake.
                            ; Pop R15 (saved before our filter ran) and continue.
   2797   60                IRX
   2798   72                LDXA
   2799   af                PLO 15              ; R15.0 = move count low
   279a   f0                LDX
   279b   bf                PHI 15              ; R15.1 = move count high (0)
   279c   c0 26 85          LBR QS_LOOP
                        
   279f                 QS_CAPTURE_LEGAL:
                            ; Check capture limit - decrement and bail if exhausted
   279f   9b                GHI 11                  ; D = captures remaining
   27a0   c2 28 41          LBZ QS_CAPTURE_LIMIT_HIT ; Already at 0, don't process more
   27a3   ff 01             SMI 1
   27a5   bb                PHI 11                  ; R11.1 = captures remaining - 1
                        
                            ; Evaluate position after capture
   27a6   d4 0e a7          CALL EVALUATE
                            ; Score in R9 (from white's perspective)
                        
                            ; Negate R9 if black to move (white-perspective → side-to-move)
   27a9   8c                GLO 12
   27aa   fa 08             ANI $08
   27ac   c2 27 b7          LBZ QS_NO_NEG
   27af   89                GLO 9               ; low byte
   27b0   fd 00             SDI 0               ; negate low
   27b2   a9                PLO 9
   27b3   99                GHI 9               ; high byte
   27b4   7d 00             SDBI 0              ; negate high with borrow
   27b6   b9                PHI 9
   27b7                 QS_NO_NEG:
                            ; Save score (R9) before UNMAKE_MOVE clobbers it
   27b7   99                GHI 9
   27b8   73                STXD
   27b9   89                GLO 9
   27ba   73                STXD
                        
                            ; Unmake move
   27bb   d4 0c 2e          CALL UNMAKE_MOVE
                        
                            ; Restore score (R9)
   27be   60                IRX
   27bf   72                LDXA
   27c0   a9                PLO 9
   27c1   f0                LDX
   27c2   b9                PHI 9
                        
                            ; Restore move count (both bytes)
   27c3   60                IRX
   27c4   72                LDXA
   27c5   af                PLO 15              ; R15.0 = move count low
   27c6   f0                LDX
   27c7   bf                PHI 15              ; R15.1 = move count high (0)
                        
                            ; Compare: if score (R9) > best (QS_BEST), update best
                            ; Load QS_BEST into R7 for comparison (big-endian: HI first)
   27c8   68 ca 64 18       RLDI 10, QS_BEST_HI
   27cc   4a                LDA 10              ; High byte
   27cd   b7                PHI 7
   27ce   0a                LDN 10              ; Low byte
   27cf   a7                PLO 7               ; R7 = QS_BEST
                        
                            ; Signed comparison: R9 > R7?
                            ; Use COMPARE_TEMP for scratch (NEVER use STR 2!)
   27d0   68 ca 64 49       RLDI 10, COMPARE_TEMP
   27d4   ea                SEX 10
   27d5   99                GHI 9
   27d6   5a                STR 10
   27d7   97                GHI 7
   27d8   f3                XOR
   27d9   fa 80             ANI $80
   27db   e2                SEX 2
   27dc   ca 27 fd          LBNZ QS_DIFF_SIGN
                        
                            ; Same sign - compare normally
   27df   ea                SEX 10
   27e0   97                GHI 7
   27e1   5a                STR 10
   27e2   99                GHI 9
   27e3   f5                SD
   27e4   e2                SEX 2
   27e5   ca 27 f7          LBNZ QS_HI_DIFF
                            ; High bytes equal, compare low
   27e8   ea                SEX 10
   27e9   87                GLO 7
   27ea   5a                STR 10
   27eb   89                GLO 9
   27ec   f5                SD
   27ed   e2                SEX 2
   27ee   c2 26 85          LBZ QS_LOOP         ; Equal, don't update
   27f1   cb 28 03          LBNF QS_UPDATE      ; Score > best
   27f4   c0 26 85          LBR QS_LOOP         ; Score < best
                        
   27f7                 QS_HI_DIFF:
   27f7   cb 28 03          LBNF QS_UPDATE      ; Score > best
   27fa   c0 26 85          LBR QS_LOOP         ; Score < best
                        
   27fd                 QS_DIFF_SIGN:
                            ; Different signs - positive is greater
   27fd   99                GHI 9
   27fe   fa 80             ANI $80
   2800   ca 26 85          LBNZ QS_LOOP        ; Score negative, best positive - don't update
                            ; Score positive, best negative - update
                        
   2803                 QS_UPDATE:
                            ; Update best = score (big-endian: HI first)
   2803   68 ca 64 18       RLDI 10, QS_BEST_HI
   2807   99                GHI 9               ; High byte first
   2808   5a                STR 10
   2809   1a                INC 10
   280a   89                GLO 9               ; Low byte second
   280b   5a                STR 10
                        
                            ; -----------------------------------------------
                            ; Beta cutoff check: if best >= beta, return beta
                            ; -----------------------------------------------
                            ; Load beta (big-endian: HI first)
   280c   68 ca 64 44       RLDI 10, BETA_HI
   2810   4a                LDA 10              ; beta high
   2811   b7                PHI 7
   2812   0a                LDN 10              ; beta low
   2813   a7                PLO 7               ; R7 = beta
                        
                            ; Compare: best (R9) >= beta (R7)?
   2814   68 ca 64 49       RLDI 10, COMPARE_TEMP
   2818   ea                SEX 10
   2819   99                GHI 9               ; best high
   281a   5a                STR 10
   281b   97                GHI 7               ; beta high
   281c   f3                XOR
   281d   fa 80             ANI $80
   281f   e2                SEX 2
   2820   ca 28 33          LBNZ QS_BETA_CUT_DIFF
                        
                            ; Same sign: best >= beta means best - beta >= 0 (no borrow)
   2823   ea                SEX 10
   2824   87                GLO 7               ; beta low
   2825   5a                STR 10
   2826   89                GLO 9               ; best low
   2827   f7                SM
   2828   97                GHI 7               ; beta high
   2829   5a                STR 10
   282a   99                GHI 9               ; best high
   282b   77                SMB
   282c   e2                SEX 2
   282d   c3 28 3c          LBDF QS_BETA_CUTOFF ; No borrow = best >= beta, cutoff!
   2830   c0 26 85          LBR QS_LOOP
                        
   2833                 QS_BETA_CUT_DIFF:
                            ; Different signs: positive >= negative
   2833   99                GHI 9               ; best high
   2834   fa 80             ANI $80
   2836   c2 28 3c          LBZ QS_BETA_CUTOFF  ; best positive, beta negative -> cutoff
   2839   c0 26 85          LBR QS_LOOP
                        
   283c                 QS_BETA_CUTOFF:
                            ; Return beta (fail-high)
   283c   97                GHI 7
   283d   b9                PHI 9
   283e   87                GLO 7
   283f   a9                PLO 9               ; R9 = beta
   2840   d5                RETN
                        
   2841                 QS_CAPTURE_LIMIT_HIT:
                            ; Hit capture limit - unmake the move and return best so far
   2841   d4 0c 2e          CALL UNMAKE_MOVE
                            ; Restore move count from stack (was pushed at capture processing start)
   2844   60                IRX
   2845   72                LDXA
   2846   af                PLO 15              ; R15.0 = move count low
   2847   f0                LDX
   2848   bf                PHI 15              ; R15.1 = move count high (0)
                            ; Fall through to QS_RETURN
                        
   2849                 QS_RETURN:
                            ; Return best score in R9 (big-endian: HI first)
   2849   68 ca 64 18       RLDI 10, QS_BEST_HI
   284d   4a                LDA 10              ; High byte
   284e   b9                PHI 9
   284f   0a                LDN 10              ; Low byte
   2850   a9                PLO 9
   2851   d5                RETN
                        
                        ; ------------------------------------------------------------------------------
                        ; Helper Functions - STUBS REMOVED (functions now in other modules)
                        ; ------------------------------------------------------------------------------
                        ; GENERATE_MOVES - implemented in movegen.asm
                        ; MAKE_MOVE - implemented in makemove.asm
                        ; UNMAKE_MOVE - implemented in makemove.asm
                        ; EVALUATE - implemented in evaluate.asm
                        ; IS_IN_CHECK - implemented in check.asm
                        
                        ; Only these helper functions remain here:
                        
                        ; ------------------------------------------------------------------------------
                        ; STORE_KILLER_MOVE - Store killer move for move ordering
                        ; ------------------------------------------------------------------------------
                        ; Input:  R11 = move that caused beta cutoff
                        ;         CURRENT_PLY = current ply (in memory)
                        ; Output: Killer move stored in table
                        ; Uses:   R10, R13, D
                        ; ------------------------------------------------------------------------------
   2852                 STORE_KILLER_MOVE:
                            ; Calculate killer table offset from CURRENT_PLY
                            ; (Use ply, not depth, so killers work across different search depths)
   2852   68 cd 64 48       RLDI 13, CURRENT_PLY
   2856   0d                LDN 13              ; D = current ply
   2857   fa 0f             ANI $0F             ; Limit to 16 plies
   2859   fe                SHL
   285a   fe                SHL                 ; × 4 (2 moves × 2 bytes each)
   285b   ad                PLO 13
                        
                            ; Point to killer table (offset in R13.0 is 0-60, won't overflow with ADI)
   285c   f8 64             LDI HIGH(KILLER_MOVES)
   285e   ba                PHI 10
   285f   8d                GLO 13              ; Get offset (0, 4, 8, ... 60)
   2860   fc 20             ADI LOW(KILLER_MOVES)  ; Add base address low byte
   2862   aa                PLO 10              ; R10 = KILLER_MOVES + offset
                        
                            ; Shift killers: killer2 = killer1
   2863   4a                LDA 10              ; Load killer1 low
   2864   ad                PLO 13
   2865   4a                LDA 10              ; Load killer1 high
   2866   bd                PHI 13              ; D = old killer1
                        
                            ; Store old killer1 as new killer2
   2867   8d                GLO 13
   2868   5a                STR 10
   2869   1a                INC 10
   286a   9d                GHI 13
   286b   5a                STR 10
                        
                            ; Reset pointer to killer1 position (R10 is at killer2_high, need killer1_low)
   286c   2a                DEC 10              ; killer2_low
   286d   2a                DEC 10              ; killer1_high
   286e   2a                DEC 10              ; killer1_low
                        
                            ; Store new killer1 (R11 = move that caused cutoff)
   286f   8b                GLO 11
   2870   5a                STR 10
   2871   1a                INC 10
   2872   9b                GHI 11
   2873   5a                STR 10
                        
   2874   d5                RETN
                        
                        ; ------------------------------------------------------------------------------
                        ; ORDER_TT_MOVE - Promote TT best move to front of move list
                        ; ------------------------------------------------------------------------------
                        ; Input:  R9 = start of move list
                        ;         D = move count
                        ; Output: Move list reordered with TT move at front (if found)
                        ; Uses:   R7, R8, R10, R11, R13
                        ; Note:   TT_MOVE_HI/LO must be populated by TT_PROBE before calling
                        ; ------------------------------------------------------------------------------
   2875                 ORDER_TT_MOVE:
   2875   a7                PLO 7               ; R7.0 = move count
   2876   c2 28 e0          LBZ OTM_DONE        ; No moves, return
                        
                            ; Load TT move (raw from/to squares)
   2879   68 ca 64 c0       RLDI 10, TT_MOVE_HI
   287d   4a                LDA 10              ; D = from
   287e   bd                PHI 13              ; R13.1 = from
   287f   0a                LDN 10              ; D = to
   2880   ad                PLO 13              ; R13.0 = to
                        
                            ; Check validity: both zero = no TT move
   2881   9d                GHI 13
   2882   ca 28 89          LBNZ OTM_VALID
   2885   8d                GLO 13
   2886   c2 28 e0          LBZ OTM_DONE
   2889                 OTM_VALID:
                        
                            ; Save move count (ENCODE clobbers R7)
   2889   87                GLO 7
   288a   73                STXD
                        
                            ; Set flags = 0 for encoding
   288b   68 ca 64 06       RLDI 10, MOVE_FLAGS_TEMP
   288f   f8 00             LDI 0
   2891   5a                STR 10
                        
                            ; Encode TT move to 16-bit format
   2892   d4 03 8d          CALL ENCODE_MOVE_16BIT
                            ; R8 = encoded TT move (flags=0 in top 2 bits)
                        
                            ; Save to R11 for comparison
   2895   98                GHI 8
   2896   bb                PHI 11
   2897   88                GLO 8
   2898   ab                PLO 11              ; R11 = encoded TT move
                        
                            ; Restore move count
   2899   60                IRX
   289a   f0                LDX                 ; D = move count
   289b   b7                PHI 7               ; R7.1 = loop counter
                        
                            ; Set up scan pointer
   289c   99                GHI 9
   289d   b8                PHI 8
   289e   89                GLO 9
   289f   a8                PLO 8               ; R8 = list start
                        
   28a0                 OTM_SCAN:
   28a0   97                GHI 7
   28a1   c2 28 e0          LBZ OTM_DONE        ; Scanned all, no match
                        
                            ; MOVE_LIST entries are stored HIGH byte first (ADD_MOVE_ENCODED
                            ; movegen-helpers.asm:221). Fixed 2026-05-13 — old code mistakenly
                            ; called LDA 8's read "low byte". Compare HIGH (mask flag bits 6-7)
                            ; first, then LOW.
   28a4   48                LDA 8               ; list move HIGH byte; R8 advances
   28a5   fa 3f             ANI $3F             ; mask off flag bits 6-7
   28a7   52                STR 2
   28a8   9b                GHI 11              ; TT encoded HIGH byte (flags=0)
   28a9   f3                XOR
   28aa   ca 28 b4          LBNZ OTM_NEXT       ; HIGH bytes differ
                        
                            ; HIGH match — compare LOW byte (no mask)
   28ad   08                LDN 8               ; list move LOW byte; R8 stays
   28ae   52                STR 2
   28af   8b                GLO 11              ; TT encoded LOW byte
   28b0   f3                XOR
   28b1   c2 28 bc          LBZ OTM_FOUND       ; Match!
                        
   28b4                 OTM_NEXT:
   28b4   18                INC 8               ; skip past LOW byte to next entry
   28b5   97                GHI 7
   28b6   ff 01             SMI 1
   28b8   b7                PHI 7
   28b9   c0 28 a0          LBR OTM_SCAN
                        
   28bc                 OTM_FOUND:
                            ; Match at R8-1 (LDA advanced). Swap with front (R9).
   28bc   28                DEC 8               ; R8 → matched move low byte
                        
                            ; Skip if already at front
   28bd   98                GHI 8
   28be   52                STR 2
   28bf   99                GHI 9
   28c0   f3                XOR
   28c1   ca 28 cb          LBNZ OTM_SWAP
   28c4   88                GLO 8
   28c5   52                STR 2
   28c6   89                GLO 9
   28c7   f3                XOR
   28c8   c2 28 e0          LBZ OTM_DONE        ; Already first
                        
   28cb                 OTM_SWAP:
                            ; Save front (R9) to stack
   28cb   49                LDA 9               ; front low, R9++
   28cc   73                STXD
   28cd   09                LDN 9               ; front high
   28ce   73                STXD
                        
                            ; Copy matched (R8) to front
   28cf   29                DEC 9               ; R9 back to front low
   28d0   48                LDA 8               ; src low, R8++
   28d1   59                STR 9
   28d2   19                INC 9
   28d3   08                LDN 8               ; src high
   28d4   59                STR 9
   28d5   19                INC 9               ; R9 = front + 2
                        
                            ; Copy saved front to matched position
   28d6   28                DEC 8               ; R8 back to src low
   28d7   60                IRX
   28d8   72                LDXA                ; saved high
   28d9   18                INC 8
   28da   58                STR 8               ; R8+1 = saved high
   28db   28                DEC 8
   28dc   f0                LDX                 ; saved low
   28dd   58                STR 8               ; R8 = saved low
                        
                            ; Reset R9 to front
   28de   29                DEC 9
   28df   29                DEC 9
                        
   28e0                 OTM_DONE:
   28e0   d5                RETN
                        
                        ; ------------------------------------------------------------------------------
                        ; ORDER_KILLER_MOVES - Promote killer moves to front of move list
                        ; ------------------------------------------------------------------------------
                        ; Input:  R9 = start of move list
                        ;         D = move count
                        ;         CURRENT_PLY = current ply (for killer table index)
                        ; Output: Move list reordered with killers at front
                        ; Uses:   R7, R8, R10, R11, R13
                        ; Note:   Call this right after GENERATE_MOVES, before move loop
                        ; ------------------------------------------------------------------------------
   28e1                 ORDER_KILLER_MOVES:
                            ; Save move count
   28e1   a7                PLO 7               ; R7.0 = move count
   28e2   c2 29 ab          LBZ OKM_DONE        ; No moves, nothing to order
                        
                            ; Calculate killer table offset from CURRENT_PLY
   28e5   68 ca 64 48       RLDI 10, CURRENT_PLY
   28e9   0a                LDN 10              ; D = ply
   28ea   fa 0f             ANI $0F             ; Limit to 16 plies
   28ec   fe                SHL
   28ed   fe                SHL                 ; × 4 (2 moves × 2 bytes each)
   28ee   ad                PLO 13              ; R13.0 = offset
                        
                            ; Point to killer table entry
   28ef   f8 64             LDI HIGH(KILLER_MOVES)
   28f1   ba                PHI 10
   28f2   8d                GLO 13
   28f3   fc 20             ADI LOW(KILLER_MOVES)
   28f5   aa                PLO 10              ; R10 = &killer1 for this ply
                        
                            ; Load killer1 (16-bit) into R11
   28f6   4a                LDA 10              ; killer1 low
   28f7   ab                PLO 11
   28f8   4a                LDA 10              ; killer1 high
   28f9   bb                PHI 11              ; R11 = killer1
                        
                            ; Load killer2 (16-bit) into R13
   28fa   4a                LDA 10              ; killer2 low
   28fb   ad                PLO 13
   28fc   0a                LDN 10              ; killer2 high
   28fd   bd                PHI 13              ; R13 = killer2
                        
                            ; Check if killers are zero (uninitialized)
   28fe   8b                GLO 11
   28ff   f1                OR
   2900   9b                GHI 11
   2901   c2 29 4a          LBZ OKM_TRY_KILLER2 ; killer1 is zero, skip
                        
                            ; === Search for killer1 in move list ===
                            ; R8 = scan pointer, start from R9
   2904   99                GHI 9
   2905   b8                PHI 8
   2906   89                GLO 9
   2907   a8                PLO 8               ; R8 = move list start
                        
   2908   87                GLO 7               ; D = move count
   2909   b7                PHI 7               ; R7.1 = loop counter
                        
   290a                 OKM_SCAN_K1:
   290a   97                GHI 7
   290b   c2 29 4a          LBZ OKM_TRY_KILLER2 ; No more moves to scan
                        
                            ; MOVE_LIST entries stored HIGH first (ADD_MOVE_ENCODED:221). Killer is
                            ; stored with flags=0 (see beta-cutoff store at line ~2042). Compare
                            ; HIGH (mask flag bits 6-7 from list entry), then LOW. Fixed 2026-05-13
                            ; — old code had reversed byte order, so the optimization never matched.
   290e   48                LDA 8               ; list move HIGH byte; R8 advances
   290f   fa 3f             ANI $3F             ; mask off flag bits
   2911   52                STR 2
   2912   9b                GHI 11              ; killer1 HIGH (flags=0)
   2913   f3                XOR
   2914   ca 29 1e          LBNZ OKM_K1_NEXT    ; HIGH bytes don't match
                        
   2917   08                LDN 8               ; list move LOW byte; R8 stays
   2918   52                STR 2
   2919   8b                GLO 11              ; killer1 LOW
   291a   f3                XOR
   291b   c2 29 26          LBZ OKM_K1_FOUND    ; Match! Swap to front
                        
   291e                 OKM_K1_NEXT:
   291e   18                INC 8               ; skip past LOW byte to next entry
   291f   97                GHI 7
   2920   ff 01             SMI 1
   2922   b7                PHI 7               ; Decrement counter
   2923   c0 29 0a          LBR OKM_SCAN_K1
                        
   2926                 OKM_K1_FOUND:
                            ; Killer1 found at R8-1 (we did LDA). Swap with first move.
   2926   28                DEC 8               ; R8 points to killer1_low in list
                        
                            ; Only swap if not already at front
   2927   98                GHI 8
   2928   52                STR 2
   2929   99                GHI 9
   292a   f3                XOR
   292b   ca 29 35          LBNZ OKM_K1_SWAP
   292e   88                GLO 8
   292f   52                STR 2
   2930   89                GLO 9
   2931   f3                XOR
   2932   c2 29 4a          LBZ OKM_TRY_KILLER2 ; Already at front, no swap needed
                        
   2935                 OKM_K1_SWAP:
                            ; Swap 2-byte entry at R8 with entry at R9
                            ; Save move at R9 to stack
   2935   49                LDA 9
   2936   73                STXD
   2937   09                LDN 9
   2938   73                STXD
                        
                            ; Copy killer from R8 to R9 (LDA advanced R9 by 1, undo it)
   2939   29                DEC 9
   293a   48                LDA 8               ; killer low
   293b   59                STR 9
   293c   19                INC 9
   293d   08                LDN 8               ; killer high
   293e   59                STR 9
   293f   19                INC 9               ; R9 back to +2
                        
                            ; Copy saved move from stack to R8
   2940   28                DEC 8               ; Back to low byte position
   2941   60                IRX
   2942   72                LDXA                ; Saved high byte
   2943   18                INC 8
   2944   58                STR 8               ; Store at R8+1
   2945   28                DEC 8
   2946   f0                LDX                 ; Saved low byte
   2947   58                STR 8               ; Store at R8
                        
                            ; Reset R9 to list start
   2948   29                DEC 9
   2949   29                DEC 9
                        
   294a                 OKM_TRY_KILLER2:
                            ; Check if killer2 is zero
   294a   8d                GLO 13
   294b   f1                OR
   294c   9d                GHI 13
   294d   c2 29 ab          LBZ OKM_DONE        ; killer2 is zero, skip
                        
                            ; Check if we have at least 2 moves
   2950   87                GLO 7               ; Original move count
   2951   ff 02             SMI 2
   2953   cb 29 ab          LBNF OKM_DONE       ; Less than 2 moves
                        
                            ; === Search for killer2 in move list (skip first entry) ===
   2956   99                GHI 9
   2957   b8                PHI 8
   2958   89                GLO 9
   2959   fc 02             ADI 2               ; Skip first entry
   295b   a8                PLO 8
   295c   99                GHI 9
   295d   7c 00             ADCI 0
   295f   b8                PHI 8               ; R8 = second entry
                        
   2960   87                GLO 7               ; move count
   2961   ff 01             SMI 1               ; Skip first
   2963   b7                PHI 7               ; R7.1 = counter
                        
   2964                 OKM_SCAN_K2:
   2964   97                GHI 7
   2965   c2 29 ab          LBZ OKM_DONE        ; No more moves
                        
                            ; Byte-order fix (2026-05-13) — HIGH first with mask, then LOW.
   2968   48                LDA 8               ; list move HIGH byte; R8 advances
   2969   fa 3f             ANI $3F             ; mask off flag bits 6-7
   296b   52                STR 2
   296c   9d                GHI 13              ; killer2 HIGH (flags=0)
   296d   f3                XOR
   296e   ca 29 78          LBNZ OKM_K2_NEXT    ; HIGH bytes don't match
                        
   2971   08                LDN 8               ; list move LOW byte; R8 stays
   2972   52                STR 2
   2973   8d                GLO 13              ; killer2 LOW
   2974   f3                XOR
   2975   c2 29 80          LBZ OKM_K2_FOUND    ; Match!
                        
   2978                 OKM_K2_NEXT:
   2978   18                INC 8               ; skip past LOW byte to next entry
   2979   97                GHI 7
   297a   ff 01             SMI 1
   297c   b7                PHI 7
   297d   c0 29 64          LBR OKM_SCAN_K2
                        
   2980                 OKM_K2_FOUND:
                            ; Killer2 found at R8-1. Swap with second move (R9+2).
   2980   28                DEC 8               ; R8 points to killer2_low
                        
                            ; Calculate second entry position
   2981   99                GHI 9
   2982   ba                PHI 10
   2983   89                GLO 9
   2984   fc 02             ADI 2
   2986   aa                PLO 10
   2987   99                GHI 9
   2988   7c 00             ADCI 0
   298a   ba                PHI 10              ; R10 = second entry
                        
                            ; Only swap if not already there
   298b   98                GHI 8
   298c   52                STR 2
   298d   9a                GHI 10
   298e   f3                XOR
   298f   ca 29 99          LBNZ OKM_K2_SWAP
   2992   88                GLO 8
   2993   52                STR 2
   2994   8a                GLO 10
   2995   f3                XOR
   2996   c2 29 ab          LBZ OKM_DONE        ; Already in position
                        
   2999                 OKM_K2_SWAP:
                            ; Swap 2-byte entry at R8 with entry at R10
   2999   4a                LDA 10              ; second entry low
   299a   73                STXD
   299b   0a                LDN 10              ; second entry high
   299c   73                STXD
                        
                            ; Copy killer to second position
   299d   2a                DEC 10
   299e   48                LDA 8               ; killer low
   299f   5a                STR 10
   29a0   1a                INC 10
   29a1   08                LDN 8               ; killer high
   29a2   5a                STR 10
                        
                            ; Copy saved to R8
   29a3   28                DEC 8
   29a4   60                IRX
   29a5   72                LDXA                ; high byte
   29a6   18                INC 8
   29a7   58                STR 8
   29a8   28                DEC 8
   29a9   f0                LDX                 ; low byte
   29aa   58                STR 8
                        
   29ab                 OKM_DONE:
   29ab   d5                RETN
                        
                        ; ------------------------------------------------------------------------------
                        ; ORDER_CAPTURES_FIRST - Move captures to front of move list, sorted by
                        ;                        victim piece-type value (queen first, pawn last).
                        ; ------------------------------------------------------------------------------
                        ; Input:  R9 = start of move list
                        ;         D = move count
                        ; Output: Move list reordered with captures at front, victim-value descending
                        ;         (Q-takes, R-takes, B-takes, N-takes, P-takes, then non-captures).
                        ; Uses:   R7, R8, R10, R11, R13
                        ; Note:   Call after GENERATE_MOVES, before move loop. Implements simplified
                        ;         victim-only sort (no attacker analysis): 5 passes filtering by
                        ;         piece-type value 5..1. Front pointer R8 persists across passes.
                        ; ------------------------------------------------------------------------------
   29ac                 ORDER_CAPTURES_FIRST:
                            ; Save move count
   29ac   a7                PLO 7               ; R7.0 = move count
   29ad   c2 2a 23          LBZ OCF_DONE        ; No moves
                        
                            ; R8 = front pointer (where to put next capture; persists across passes)
   29b0   99                GHI 9
   29b1   b8                PHI 8
   29b2   89                GLO 9
   29b3   a8                PLO 8               ; R8 = front = list start
                        
                            ; Initialize filter: start with QUEEN piece type (5), decrement each pass
   29b4   68 cd 64 49       RLDI 13, COMPARE_TEMP
   29b8   f8 05             LDI 5
   29ba   5d                STR 13              ; M(COMPARE_TEMP) = filter type
                        
   29bb                 OCF_PASS_LOOP:
                            ; R10 = scan pointer (re-init each pass)
   29bb   99                GHI 9
   29bc   ba                PHI 10
   29bd   89                GLO 9
   29be   aa                PLO 10              ; R10 = scan = list start
                        
                            ; R7.1 = remaining count to scan (re-init each pass)
   29bf   87                GLO 7
   29c0   b7                PHI 7
                        
   29c1                 OCF_SCAN_LOOP:
   29c1   97                GHI 7
   29c2   c2 2a 18          LBZ OCF_PASS_DONE   ; No more moves to scan in this pass
                        
                            ; Decode move at R10 to get target square
                            ; Move format: [flags:2][to:7][from:7]
                            ; Move list is big-endian: high byte first, low byte second
   29c5   4a                LDA 10              ; High byte (first in big-endian)
   29c6   bb                PHI 11              ; R11.1 = high byte
   29c7   0a                LDN 10              ; Low byte (second in big-endian)
   29c8   ab                PLO 11              ; R11.0 = low byte
                        
                            ; Extract 'to' square: (high & $3F) << 1 | (low >> 7)
   29c9   9b                GHI 11              ; D = high byte (LDN left D with low byte)
   29ca   fa 3f             ANI $3F
   29cc   fe                SHL
   29cd   ad                PLO 13              ; R13.0 = to bits 1-6
   29ce   8b                GLO 11              ; Low byte
   29cf   fa 80             ANI $80             ; Bit 7
   29d1   c2 29 d8          LBZ OCF_TO_BIT0_CLR
   29d4   8d                GLO 13
   29d5   f9 01             ORI $01
   29d7   ad                PLO 13
   29d8                 OCF_TO_BIT0_CLR:
                            ; R13.0 = to square, R11 = encoded move
                        
                            ; Check if target square has a piece (any piece = potential capture)
                            ; Calculate BOARD + to_square
                            ; BOARD is at $6000, so high byte is $60, low byte is to_square
   29d8   f8 60             LDI HIGH(BOARD)
   29da   bd                PHI 13
                            ; R13 now = $60xx where xx = to_square (already in R13.0)
                        
                            ; Load piece at target square
   29db   0d                LDN 13              ; D = piece at target
   29dc   2a                DEC 10              ; Reset R10 to low byte position
                        
                            ; If piece is 0 (empty), not a capture
   29dd   c2 2a 0f          LBZ OCF_NEXT_MOVE   ; Empty square, skip
                        
                            ; Check victim type against current pass filter.
                            ; D still holds piece byte; mask off color to get type (1-6).
   29e0   fa 07             ANI PIECE_MASK      ; D = victim type (1-5; king=6 can't actually be captured)
   29e2   52                STR 2               ; M(R2) = victim type (temp)
   29e3   68 cd 64 49       RLDI 13, COMPARE_TEMP
   29e7   0d                LDN 13              ; D = current pass filter type
   29e8   f3                XOR                 ; D = filter ^ victim (0 if match, since SEX 2 set globally)
   29e9   ca 2a 0f          LBNZ OCF_NEXT_MOVE  ; victim type doesn't match this pass — skip
                        
                            ; Match: capture with current filter type. Fall through to swap.
                        
   29ec                 OCF_IS_CAPTURE:
                            ; Move is a capture - swap to front if not already there
                            ; R10 points to current move, R8 points to front
   29ec   9a                GHI 10
   29ed   52                STR 2
   29ee   98                GHI 8
   29ef   f3                XOR
   29f0   ca 29 fa          LBNZ OCF_DO_SWAP
   29f3   8a                GLO 10
   29f4   52                STR 2
   29f5   88                GLO 8
   29f6   f3                XOR
   29f7   c2 2a 0d          LBZ OCF_ADVANCE_FRONT  ; Already at front
                        
   29fa                 OCF_DO_SWAP:
                            ; Swap 2-byte entries at R8 and R10
                            ; Save R8 entry to stack
   29fa   48                LDA 8
   29fb   73                STXD
   29fc   08                LDN 8
   29fd   73                STXD
   29fe   28                DEC 8               ; Reset R8
                        
                            ; Copy R10 to R8
   29ff   4a                LDA 10
   2a00   58                STR 8
   2a01   18                INC 8
   2a02   0a                LDN 10
   2a03   58                STR 8
   2a04   28                DEC 8
   2a05   2a                DEC 10              ; Reset both
                        
                            ; Copy stack to R10
   2a06   60                IRX
   2a07   72                LDXA                ; High byte
   2a08   1a                INC 10
   2a09   5a                STR 10
   2a0a   2a                DEC 10
   2a0b   f0                LDX                 ; Low byte
   2a0c   5a                STR 10
                        
   2a0d                 OCF_ADVANCE_FRONT:
                            ; Advance front pointer
   2a0d   18                INC 8
   2a0e   18                INC 8
                        
   2a0f                 OCF_NEXT_MOVE:
                            ; Advance scan pointer
   2a0f   1a                INC 10
   2a10   1a                INC 10
                            ; Decrement counter
   2a11   97                GHI 7
   2a12   ff 01             SMI 1
   2a14   b7                PHI 7
   2a15   c0 29 c1          LBR OCF_SCAN_LOOP
                        
   2a18                 OCF_PASS_DONE:
                            ; Decrement filter type for next pass; loop until filter reaches 0.
   2a18   68 cd 64 49       RLDI 13, COMPARE_TEMP
   2a1c   0d                LDN 13
   2a1d   ff 01             SMI 1
   2a1f   5d                STR 13              ; filter--
   2a20   ca 29 bb          LBNZ OCF_PASS_LOOP  ; continue if filter > 0
                        
   2a23                 OCF_DONE:
   2a23   d5                RETN
                        
                        ; ------------------------------------------------------------------------------
                        ; INC_NODE_COUNT - Increment 32-bit node counter (FULL VERSION)
                        ; ------------------------------------------------------------------------------
                        ; Input:  None
                        ; Output: NODES_SEARCHED incremented
                        ; Uses:   A, D
                        ; ------------------------------------------------------------------------------
   2a24                 INC_NODE_COUNT:
   2a24   68 ca 64 12       RLDI 10, NODES_SEARCHED
                        
                            ; Increment byte 0 (LSB)
   2a28   0a                LDN 10
   2a29   fc 01             ADI 1
   2a2b   5a                STR 10
   2a2c   ca 2a 44          LBNZ INC_NODE_DONE   ; No carry
                        
                            ; Carry to byte 1
   2a2f   1a                INC 10
   2a30   0a                LDN 10
   2a31   7c 00             ADCI 0
   2a33   5a                STR 10
   2a34   ca 2a 44          LBNZ INC_NODE_DONE
                        
                            ; Carry to byte 2
   2a37   1a                INC 10
   2a38   0a                LDN 10
   2a39   7c 00             ADCI 0
   2a3b   5a                STR 10
   2a3c   ca 2a 44          LBNZ INC_NODE_DONE
                        
                            ; Carry to byte 3 (MSB)
   2a3f   1a                INC 10
   2a40   0a                LDN 10
   2a41   7c 00             ADCI 0
   2a43   5a                STR 10
                        
   2a44                 INC_NODE_DONE:
   2a44   d5                RETN
                        
                        ; ==============================================================================
                        ; SEARCH_POSITION - Iterative Deepening Entry Point
                        ; ==============================================================================
                        ; Input:  SEARCH_DEPTH = target depth (stored in memory by UCI handler)
                        ; Output: R9 = best score (R6 is SCRT linkage - off limits!)
                        ;         BEST_MOVE = best move found
                        ; Searches depth 1, 2, ..., TARGET_DEPTH. If depth N exceeds node budget,
                        ; aborts and returns depth N-1's bestmove.
                        ; ==============================================================================
   2a45                 SEARCH_POSITION:
   2a45   e2                SEX 2
                        
                            ; --- Save TARGET_DEPTH from SEARCH_DEPTH (set by UCI handler) ---
   2a46   68 ca 64 17       RLDI 10, SEARCH_DEPTH + 1
   2a4a   0a                LDN 10                      ; D = target depth (low byte)
   2a4b   73                STXD                        ; Save depth on stack (LDI clobbers D!)
   2a4c   68 ca 64 c6       RLDI 10, TARGET_DEPTH
   2a50   60                IRX
   2a51   f0                LDX                         ; D = target depth (restored from stack)
   2a52   5a                STR 10                      ; TARGET_DEPTH = original depth
                        
                            ; --- Clear SEARCH_ABORTED flag ---
   2a53   68 ca 64 c4       RLDI 10, SEARCH_ABORTED
   2a57   f8 00             LDI 0
   2a59   5a                STR 10
                        
                            ; --- Clear ITER_BEST (no bestmove yet) ---
   2a5a   68 ca 64 c2       RLDI 10, ITER_BEST_FROM
   2a5e   f8 ff             LDI $FF
   2a60   5a                STR 10
   2a61   1a                INC 10
   2a62   5a                STR 10                      ; ITER_BEST_TO = $FF
                        
                            ; --- Set starting depth = 1 ---
   2a63   68 ca 64 c5       RLDI 10, CURRENT_MAX_DEPTH
   2a67   f8 01             LDI 1
   2a69   5a                STR 10
                        
                            ; --- Initialize RTC elapsed timer ---
                            ; Read current seconds from DS12887 RTC (binary mode)
                            ; Protocol: OUT port 2 = register select, INP port 3 = read data
   2a6a   f8 80             LDI $80                     ; $80 = seconds register
   2a6c   52                STR 2                       ; Store at M(R2) for OUT
   2a6d   62                OUT 2                       ; Send to port 2 (selects seconds), R2++
   2a6e   22                DEC 2                       ; Restore stack pointer
   2a6f   6b                INP 3                       ; D = seconds (binary 0-59), also M(R2)
   2a70   73                STXD                        ; Save seconds on stack (LDI clobbers D!)
   2a71   68 ca 64 ca       RLDI 10, SEARCH_PREV_SECS
   2a75   60                IRX
   2a76   f0                LDX                         ; D = seconds (restored)
   2a77   5a                STR 10                      ; SEARCH_PREV_SECS = current seconds
                        
                            ; Clear elapsed counter
   2a78   68 ca 64 cb       RLDI 10, SEARCH_ELAPSED
   2a7c   f8 00             LDI 0
   2a7e   5a                STR 10                      ; SEARCH_ELAPSED = 0
                        
                            ; --- Canary check (ported 2026-07-13): CANARY_ZONE $64F7-$64FC must be all
                            ; zero (no code owns it; the 7/3 v3-build crash dump found stray writes
                            ; there). Sticky-OR into CANARY_HIT once per search — a nonzero CANARY_HIT
                            ; in any post-crash dump = the stray writer struck this game.
   2a7f   68 ca 64 f7       RLDI 10, CANARY_ZONE
   2a83   f8 00             LDI 0
   2a85   52                STR 2                       ; M(2) = accumulator = 0
   2a86   f8 06             LDI 6
   2a88   ab                PLO 11                      ; R11.0 = byte counter (R11 reloaded below)
   2a89                 SP_CANARY_LP:
   2a89   4a                LDA 10
   2a8a   f1                OR                          ; D = zone byte | acc
   2a8b   52                STR 2                       ; acc back to M(2)
   2a8c   2b                DEC 11
   2a8d   8b                GLO 11
   2a8e   ca 2a 89          LBNZ SP_CANARY_LP
   2a91   68 ca 64 1e       RLDI 10, CANARY_HIT
   2a95   0a                LDN 10
   2a96   f1                OR                          ; D = CANARY_HIT | acc
   2a97   5a                STR 10                      ; sticky
                        
                            ; --- Clear node counter (once for entire search) ---
   2a98   68 cb 64 12       RLDI 11, NODES_SEARCHED
   2a9c   f8 00             LDI 0
   2a9e   5b                STR 11
   2a9f   1b                INC 11
   2aa0   5b                STR 11
   2aa1   1b                INC 11
   2aa2   5b                STR 11
   2aa3   1b                INC 11
   2aa4   5b                STR 11
                        
                            ; --- Zobrist hash: use the incremental hash from UCI parsing ---
                            ; Do NOT call HASH_INIT here! HASH_INIT includes castling/EP Zobrist
                            ; keys, but MAKE_MOVE doesn't XOR castling/EP changes. This creates a
                            ; mismatch between search hashes (from-scratch) and HASH_HIST entries
                            ; (incremental), which breaks repetition detection completely.
                            ; The hash left by UCI parsing is already correct and consistent.
                        
                        ; ======================================================================
                        ; ITERATIVE DEEPENING LOOP
                        ; ======================================================================
   2aa5                 ITER_LOOP:
                            ; --- Set SEARCH_DEPTH = CURRENT_MAX_DEPTH for this iteration ---
   2aa5   68 ca 64 16       RLDI 10, SEARCH_DEPTH
   2aa9   f8 00             LDI 0
   2aab   5a                STR 10                      ; SEARCH_DEPTH high = 0
   2aac   1a                INC 10
                            ; Load CURRENT_MAX_DEPTH
   2aad   68 cd 64 c5       RLDI 13, CURRENT_MAX_DEPTH
   2ab1   0d                LDN 13                      ; D = current depth
   2ab2   5a                STR 10                      ; SEARCH_DEPTH low = current depth
                        
                            ; --- Reset SEARCH_ABORTED for this iteration ---
   2ab3   68 ca 64 c4       RLDI 10, SEARCH_ABORTED
   2ab7   f8 00             LDI 0
   2ab9   5a                STR 10
                        
                            ; --- Capture iteration start time for iteration-time gate ---
   2aba   68 ca 64 cb       RLDI 10, SEARCH_ELAPSED
   2abe   0a                LDN 10
   2abf   68 ca 64 ed       RLDI 10, ITER_START_ELAPSED
   2ac3   5a                STR 10
                        
                            ; --- Standard search init ---
                            ; Alpha = -32767
   2ac4   68 ca 64 42       RLDI 10, ALPHA_HI
   2ac8   f8 80             LDI $80
   2aca   5a                STR 10                      ; ALPHA_HI = $80
   2acb   1a                INC 10
   2acc   f8 01             LDI $01
   2ace   5a                STR 10                      ; ALPHA_LO = $01
                        
                            ; Beta = +32767
   2acf   68 ca 64 44       RLDI 10, BETA_HI
   2ad3   f8 7f             LDI $7F
   2ad5   5a                STR 10                      ; BETA_HI = $7F
   2ad6   1a                INC 10
   2ad7   f8 ff             LDI $FF
   2ad9   5a                STR 10                      ; BETA_LO = $FF
                        
                            ; CURRENT_PLY = 0
   2ada   68 ca 64 48       RLDI 10, CURRENT_PLY
   2ade   f8 00             LDI 0
   2ae0   5a                STR 10
                        
                            ; NULL_MOVE_OK = 1
   2ae1   68 ca 64 a7       RLDI 10, NULL_MOVE_OK
   2ae5   f8 01             LDI 1
   2ae7   5a                STR 10
                        
                            ; Get side to move
   2ae8   d4 01 3e          CALL GET_SIDE_TO_MOVE
   2aeb   ac                PLO 12                      ; C.0 = color
                        
                            ; Board pointer
   2aec   68 ca 60 00       RLDI 10, BOARD
                        
                            ; Clear best move for this iteration
   2af0   68 cb 64 10       RLDI 11, BEST_MOVE
   2af4   f8 ff             LDI $FF
   2af6   5b                STR 11
   2af7   1b                INC 11
   2af8   5b                STR 11
                        
                            ; --- Run search for this depth ---
   2af9   d4 1b 58          CALL NEGAMAX
                        
                            ; --- Check if search was aborted ---
   2afc   68 ca 64 c4       RLDI 10, SEARCH_ABORTED
   2b00   0a                LDN 10
   2b01   ca 2b 76          LBNZ ITER_ABORTED           ; Aborted: use previous depth's bestmove
                        
                            ; --- Depth completed: save bestmove ---
                            ; Set up BOTH pointers first, then copy (LDI clobbers D!)
   2b04   68 ca 64 10       RLDI 10, BEST_MOVE
   2b08   68 cb 64 c2       RLDI 11, ITER_BEST_FROM
                            ; Now copy: R10→BEST_MOVE, R11→ITER_BEST
   2b0c   4a                LDA 10                      ; D = from square
   2b0d   5b                STR 11                      ; ITER_BEST_FROM = from
   2b0e   1b                INC 11
   2b0f   0a                LDN 10                      ; D = to square (BEST_MOVE+1)
   2b10   5b                STR 11                      ; ITER_BEST_TO = to
                        
                            ; --- Save score from this depth ---
   2b11   68 ca 64 c8       RLDI 10, ITER_SCORE_HI
   2b15   99                GHI 9
   2b16   5a                STR 10                      ; ITER_SCORE_HI = R9.hi
   2b17   1a                INC 10
   2b18   89                GLO 9
   2b19   5a                STR 10                      ; ITER_SCORE_LO = R9.lo
                        
                            ; --- Send UCI "info" for this depth ---
   2b1a   d4 2b 84          CALL SEND_UCI_INFO
                        
                            ; Stack-overflow handling moved to CHECK_STACK_OVERFLOW (2026-05-16):
                            ; it now traps via MARK/SEP 1 immediately on detection, so this
                            ; IDS-boundary report path is unreachable. STACK_OVERFLOW_FLAG remains
                            ; written by the guard for post-trap memory dump inspection.
   2b1d                 ITER_NO_SOVF:
                        
                            ; --- Iterative deepening termination decision ---
                            ; UCI semantics: TARGET_DEPTH is treated as a CAP (max depth we may reach),
                            ; not a fixed target. The engine self-decides whether to attempt the next
                            ; deeper iteration based on iteration-time prediction and a hard safety cap.
                            ;
                            ; Termination rules (stop if any are true; else continue to current+1):
                            ;   1. current >= TARGET_DEPTH   — respect UCI cap
                            ;   2. current >= 5              — hard safety cap (MOVE_LIST sized for 5 plies)
                            ;   3. current >= 3 AND predicted_next > remaining_budget — iter-time gate
                            ;
                            ; Iter-time gate (rule 3, replaces 60s/90s cumulative thresholds 2026-05-06):
                            ;   predicted_next = 3 * last_iter_seconds  (BF=3, conservative)
                            ;   remaining      = 180 - SEARCH_ELAPSED
                            ;   stop if predicted_next >= remaining
                            ; Rationale: closed positions branch ~3x at d>=4 (vs ~1.8x in open). Old
                            ; cumulative gate let d=5 start with insufficient budget in Hippo-class
                            ; positions, wasting 80-110s/move on incomplete d=5 (lost match 2026-05-06
                            ; move 5-9, all d=4 timeouts). Iteration-time gate uses the actual measured
                            ; iteration time so it adapts to position. RTC is 1s resolution; gate only
                            ; applies at d>=3 where iteration times are reliably multi-second.
                        
                            ; Rule 1: current >= TARGET_DEPTH?
   2b1d   68 ca 64 c5       RLDI 10, CURRENT_MAX_DEPTH
   2b21   0a                LDN 10
   2b22   52                STR 2                       ; M(R2) = current
   2b23   68 ca 64 c6       RLDI 10, TARGET_DEPTH
   2b27   0a                LDN 10                      ; D = target
   2b28   f7                SM                          ; D = target - current; DF=1 if target >= current
   2b29   cb 2b 83          LBNF ITER_DONE              ; target < current — defensive (shouldn't happen)
   2b2c   c2 2b 83          LBZ ITER_DONE               ; target == current — UCI cap reached
                        
                            ; Rule 2: current >= 5?
   2b2f   68 ca 64 c5       RLDI 10, CURRENT_MAX_DEPTH
   2b33   0a                LDN 10
   2b34   ff 05             SMI 5
   2b36   c3 2b 83          LBDF ITER_DONE              ; current >= 5 — hard safety cap
                        
                            ; Rule 3: iteration-time gate. Apply only at depth >= 3.
   2b39   68 ca 64 c5       RLDI 10, CURRENT_MAX_DEPTH
   2b3d   0a                LDN 10
   2b3e   ff 03             SMI 3
   2b40   cb 2b 6b          LBNF ITER_INCREMENT         ; current < 3 — always continue (RTC granularity)
                        
                            ; last_iter_seconds = SEARCH_ELAPSED - ITER_START_ELAPSED
   2b43   68 ca 64 ed       RLDI 10, ITER_START_ELAPSED
   2b47   0a                LDN 10
   2b48   52                STR 2                       ; M(R2) = iter_start
   2b49   68 ca 64 cb       RLDI 10, SEARCH_ELAPSED
   2b4d   0a                LDN 10                      ; D = elapsed
   2b4e   f7                SM                          ; D = elapsed - iter_start = last_iter
   2b4f   ad                PLO 13                      ; R13.0 = last_iter
                        
                            ; Fast path: last_iter > 60 → 3*last_iter overflows AND exceeds remaining
   2b50   ff 3d             SMI 61
   2b52   c3 2b 83          LBDF ITER_DONE              ; last_iter >= 61 — stop
                        
                            ; predicted = 3 * last_iter (no overflow: last_iter <= 60, so 3x <= 180)
   2b55   8d                GLO 13                      ; D = last_iter
   2b56   fe                SHL                         ; D = 2 * last_iter
   2b57   52                STR 2                       ; M(R2) = 2 * last_iter
   2b58   8d                GLO 13                      ; D = last_iter
   2b59   f4                ADD                         ; D = 3 * last_iter
   2b5a   ad                PLO 13                      ; R13.0 = predicted
                        
                            ; remaining = 180 - SEARCH_ELAPSED
   2b5b   68 ca 64 cb       RLDI 10, SEARCH_ELAPSED
   2b5f   0a                LDN 10
   2b60   fd b4             SDI 180                     ; D = 180 - elapsed
   2b62   cb 2b 83          LBNF ITER_DONE              ; elapsed > 180 (defensive; budget abort handles too)
                        
                            ; if predicted >= remaining: stop, else continue
   2b65   52                STR 2                       ; M(R2) = remaining
   2b66   8d                GLO 13                      ; D = predicted
   2b67   f7                SM                          ; D = predicted - remaining
   2b68   c3 2b 83          LBDF ITER_DONE              ; predicted >= remaining — stop
                        
   2b6b                 ITER_INCREMENT:
                            ; --- Increment depth and loop ---
   2b6b   68 ca 64 c5       RLDI 10, CURRENT_MAX_DEPTH
   2b6f   0a                LDN 10
   2b70   fc 01             ADI 1
   2b72   5a                STR 10                      ; CURRENT_MAX_DEPTH++
   2b73   c0 2a a5          LBR ITER_LOOP
                        
   2b76                 ITER_ABORTED:
                            ; Search at this depth was aborted — fall back to ITER_BEST
                            ; Set up BOTH pointers first, then copy (LDI clobbers D!)
   2b76   68 ca 64 c2       RLDI 10, ITER_BEST_FROM
   2b7a   68 cb 64 10       RLDI 11, BEST_MOVE
                            ; Now copy: R10→ITER_BEST, R11→BEST_MOVE
   2b7e   4a                LDA 10                      ; D = ITER_BEST_FROM
   2b7f   5b                STR 11                      ; BEST_MOVE[0] = from
   2b80   1b                INC 11
   2b81   0a                LDN 10                      ; D = ITER_BEST_TO
   2b82   5b                STR 11                      ; BEST_MOVE[1] = to
                        
   2b83                 ITER_DONE:
   2b83   d5                RETN
                        
                        ; ==============================================================================
                        ; SEND_UCI_INFO - Send "info depth N score cp S nodes NNNNN" after each iteration
                        ; ==============================================================================
                        ; Sends: "info depth N score cp S nodes NNNNN\r\n"
                        ;   N = CURRENT_MAX_DEPTH (ASCII digit)
                        ;   S = ITER_SCORE as signed decimal (centipawns)
                        ;   NNNNN = NODES_SEARCHED as decimal via F_UINTOUT (lower 16 bits)
                        ; ==============================================================================
   2b84                 SEND_UCI_INFO:
                            ; Send "info depth "
   2b84   68 cf 2c b2       RLDI 15, STR_INFO_DEPTH
   2b88   d4                SEP 4
   2b89   ff 09             DW F_MSG
                        
                            ; Send depth digit (1-9)
   2b8b   68 ca 64 c5       RLDI 10, CURRENT_MAX_DEPTH
   2b8f   0a                LDN 10                      ; D = depth (1-9)
   2b90   fc 30             ADI '0'                     ; Convert to ASCII
   2b92   d4 00 0b          CALL SERIAL_WRITE_CHAR
                        
                            ; Send " score cp "
   2b95   68 cf 2c be       RLDI 15, STR_SCORE_CP
   2b99   d4                SEP 4
   2b9a   ff 09             DW F_MSG
                        
                            ; Load score into R13 (big-endian: HI at $64C8, LO at $64C9)
   2b9c   68 ca 64 c8       RLDI 10, ITER_SCORE_HI
   2ba0   4a                LDA 10                      ; D = score high byte, R10 -> LO
   2ba1   bd                PHI 13
   2ba2   0a                LDN 10                      ; D = score low byte
   2ba3   ad                PLO 13                      ; R13 = signed 16-bit score
                        
                            ; Check if negative
   2ba4   9d                GHI 13
   2ba5   fa 80             ANI $80
   2ba7   c2 2b b7          LBZ SUCI_POSITIVE
                        
                            ; Negative: print '-' and negate R13 to get absolute value
   2baa   f8 2d             LDI '-'
   2bac   d4 00 0b          CALL SERIAL_WRITE_CHAR
   2baf   8d                GLO 13                      ; low byte
   2bb0   fd 00             SDI 0                       ; negate low
   2bb2   ad                PLO 13
   2bb3   9d                GHI 13                      ; high byte
   2bb4   7d 00             SDBI 0                      ; negate high with borrow
   2bb6   bd                PHI 13
                        
   2bb7                 SUCI_POSITIVE:
                            ; Convert R13 (now unsigned magnitude) to ASCII decimal
   2bb7   68 cf 64 cc       RLDI 15, UINT_BUFFER
   2bbb   d4                SEP 4
   2bbc   ff 60             DW F_UINTOUT
                        
                            ; Null-terminate (R15 points past last digit)
   2bbe   f8 00             LDI 0
   2bc0   5f                STR 15
                        
                            ; Print the score string
   2bc1   68 cf 64 cc       RLDI 15, UINT_BUFFER
   2bc5   d4                SEP 4
   2bc6   ff 09             DW F_MSG
                        
                            ; Send " nodes "
   2bc8   68 cf 2c c9       RLDI 15, STR_NODES
   2bcc   d4                SEP 4
   2bcd   ff 09             DW F_MSG
                        
                            ; Load NODES_SEARCHED (16-bit) into R13: high byte first, then low
   2bcf   68 ca 64 13       RLDI 10, NODES_SEARCHED + 1
   2bd3   0a                LDN 10                      ; D = high byte of node count
   2bd4   bd                PHI 13                      ; R13.1 = high byte
   2bd5   68 ca 64 12       RLDI 10, NODES_SEARCHED
   2bd9   0a                LDN 10                      ; D = low byte of node count
   2bda   ad                PLO 13                      ; R13.0 = low byte
                        
                            ; Point R15 at ASCII scratch buffer
   2bdb   68 cf 64 cc       RLDI 15, UINT_BUFFER
                        
                            ; Convert R13 to ASCII decimal at R15
   2bdf   d4                SEP 4
   2be0   ff 60             DW F_UINTOUT
                        
                            ; Null-terminate (R15 points past last digit)
   2be2   f8 00             LDI 0
   2be4   5f                STR 15
                        
                            ; Print the decimal string
   2be5   68 cf 64 cc       RLDI 15, UINT_BUFFER
   2be9   d4                SEP 4
   2bea   ff 09             DW F_MSG
                        
                            ; Send CR+LF
   2bec   f8 0d             LDI 13
   2bee   d4 00 0b          CALL SERIAL_WRITE_CHAR
   2bf1   f8 0a             LDI 10
   2bf3   d4 00 0b          CALL SERIAL_WRITE_CHAR
                        
   2bf6   d5                RETN
                        
                        ; ==============================================================================
                        ; End of Negamax Core
                        ; ==============================================================================
                        ; ==============================================================================
                        ; RCA 1802/1806 Chess Engine - UCI Protocol Implementation
                        ; ==============================================================================
                        ; Universal Chess Interface for communication with GUI
                        ; Implements minimal UCI subset for playability
                        ; ==============================================================================
                        
                        ; ------------------------------------------------------------------------------
                        ; UCI Command Buffer - defined in board.asm
                        ; ------------------------------------------------------------------------------
                        ; UCI_BUFFER ($7000, 2048 bytes) and UCI_STATE ($64B8) defined in board.asm
   07ff                 UCI_BUFFER_LEN  EQU 2047    ; Max chars (16-bit counter, 2048-byte buffer)
   0001                 UCI_READY       EQU 1       ; Ready state
                        
                        ; ------------------------------------------------------------------------------
                        ; UCI String Constants
                        ; ------------------------------------------------------------------------------
                        ; These would be defined as byte arrays in actual implementation
                        
   2bf7   75 63 69 00   STR_UCI         DB "uci", 0
   2bfb   69 73 72 65   STR_ISREADY     DB "isready", 0
   2bff   61 64 79 00   
   2c03   70 6f 73 69   STR_POSITION    DB "position", 0
   2c07   74 69 6f 6e   
   2c0b   00            
   2c0c   67 6f 00      STR_GO          DB "go", 0
   2c0f   71 75 69 74   STR_QUIT        DB "quit", 0
   2c13   00            
   2c14   75 63 69 6e   STR_UCINEWGAME  DB "ucinewgame", 0
   2c18   65 77 67 61   
   2c1c   6d 65 00      
   2c1f   73 74 6f 70   STR_STOP        DB "stop", 0
   2c23   00            
                        
                        ; Response strings (CR+LF for terminal display)
   2c24   69 64 20 6e   STR_ID_NAME     DB "id name RCA-Chess-1806", 13, 10, 0
   2c28   61 6d 65 20   
   2c2c   52 43 41 2d   
   2c30   43 68 65 73   
   2c34   73 2d 31 38   
   2c38   30 36 0d 0a   
   2c3c   00            
   2c3d   69 64 20 61   STR_ID_AUTHOR   DB "id author Mark Abene & Claude Code", 13, 10, 0
   2c41   75 74 68 6f   
   2c45   72 20 4d 61   
   2c49   72 6b 20 41   
   2c4d   62 65 6e 65   
   2c51   20 26 20 43   
   2c55   6c 61 75 64   
   2c59   65 20 43 6f   
   2c5d   64 65 0d 0a   
   2c61   00            
   2c62   6f 70 74 69   STR_OPTION_DEPTH DB "option name Depth type spin default 4 min 1 max 6", 13, 10, 0
   2c66   6f 6e 20 6e   
   2c6a   61 6d 65 20   
   2c6e   44 65 70 74   
   2c72   68 20 74 79   
   2c76   70 65 20 73   
   2c7a   70 69 6e 20   
   2c7e   64 65 66 61   
   2c82   75 6c 74 20   
   2c86   34 20 6d 69   
   2c8a   6e 20 31 20   
   2c8e   6d 61 78 20   
   2c92   36 0d 0a 00   
   2c96   75 63 69 6f   STR_UCIOK       DB "uciok", 13, 10, 0
   2c9a   6b 0d 0a 00   
   2c9e   72 65 61 64   STR_READYOK     DB "readyok", 13, 10, 0
   2ca2   79 6f 6b 0d   
   2ca6   0a 00         
   2ca8   62 65 73 74   STR_BESTMOVE    DB "bestmove ", 0
   2cac   6d 6f 76 65   
   2cb0   20 00         
   2cb2   69 6e 66 6f   STR_INFO_DEPTH  DB "info depth ", 0
   2cb6   20 64 65 70   
   2cba   74 68 20 00   
   2cbe   20 73 63 6f   STR_SCORE_CP    DB " score cp ", 0
   2cc2   72 65 20 63   
   2cc6   70 20 00      
   2cc9   20 6e 6f 64   STR_NODES       DB " nodes ", 0
   2ccd   65 73 20 00   
                        ; STR_INFO_SOVF removed 2026-05-16 — CHECK_STACK_OVERFLOW now hard-traps
                        ; via MARK/SEP 1 instead of emitting an info string via a corrupted stack.
   2cd1   69 6e 66 6f   STR_INFO_RMV    DB "info string ROOT_MOVE_INVALID_SUBSTITUTED", 13, 10, 0
   2cd5   20 73 74 72   
   2cd9   69 6e 67 20   
   2cdd   52 4f 4f 54   
   2ce1   5f 4d 4f 56   
   2ce5   45 5f 49 4e   
   2ce9   56 41 4c 49   
   2ced   44 5f 53 55   
   2cf1   42 53 54 49   
   2cf5   54 55 54 45   
   2cf9   44 0d 0a 00   
                        
                        ; ------------------------------------------------------------------------------
                        ; UCI_INIT - Initialize UCI interface
                        ; ------------------------------------------------------------------------------
   2cfd                 UCI_INIT:
                            ; Set up serial I/O (if needed)
                            ; TODO: Hardware-specific initialization
                        
                            ; Set initial state
   2cfd   f8 01             LDI UCI_READY
   2cff   ad                PLO 13
                        
   2d00   68 ca 64 b8       RLDI 10, UCI_STATE
                        
   2d04   8d                GLO 13
   2d05   5a                STR 10
                        
   2d06   d5                RETN
                        
                        ; ------------------------------------------------------------------------------
                        ; UCI_READ_LINE - Read a line of input
                        ; ------------------------------------------------------------------------------
                        ; Input:  None
                        ; Output: Line in UCI_BUFFER, null-terminated
                        ;         D = length
                        ; Uses:   A, D
                        ;
                        ; Reads characters until newline or max length
                        ; ------------------------------------------------------------------------------
   2d07                 UCI_READ_LINE:
   2d07   68 ca 70 00       RLDI 10, UCI_BUFFER
                        
   2d0b   f8 00             LDI 0
   2d0d   bd                PHI 13              ; R13.1 = count high byte = 0
   2d0e   ad                PLO 13              ; R13.0 = count low byte = 0
                        
   2d0f                 UCI_READ_LOOP:
                            ; Read character from serial input
   2d0f   d4 00 07          CALL SERIAL_READ_CHAR
                            ; Returns character in D
                        
                            ; Check for carriage return (CR = 13)
   2d12   ff 0d             SMI 13
   2d14   c2 2d 2f          LBZ UCI_READ_DONE
                        
                            ; Check for newline (LF = 10) - restore D first
   2d17   fc 0d             ADI 13              ; Restore: (D-13)+13 = D
   2d19   ff 0a             SMI 10              ; Check for LF
   2d1b   c2 2d 2f          LBZ UCI_READ_DONE
   2d1e   fc 0a             ADI 10              ; Restore D
                        
                            ; Store character
   2d20   5a                STR 10
   2d21   1a                INC 10
                        
                            ; Increment 16-bit count
   2d22   1d                INC 13
                        
                            ; Check buffer limit (16-bit: UCI_BUFFER_LEN = 2047 = $07FF)
   2d23   8d                GLO 13
   2d24   fb ff             XRI LOW(UCI_BUFFER_LEN)
   2d26   ca 2d 0f          LBNZ UCI_READ_LOOP
   2d29   9d                GHI 13
   2d2a   fb 07             XRI HIGH(UCI_BUFFER_LEN)
   2d2c   ca 2d 0f          LBNZ UCI_READ_LOOP
                            ; Count == UCI_BUFFER_LEN, buffer full
                        
                        
                        
   2d2f                 UCI_READ_DONE:
                            ; Null-terminate string
   2d2f   f8 00             LDI 0
   2d31   5a                STR 10
                        
                            ; Echo CR+LF
   2d32   f8 0d             LDI 13
   2d34   d4 00 0b          CALL SERIAL_WRITE_CHAR
   2d37   f8 0a             LDI 10
   2d39   d4 00 0b          CALL SERIAL_WRITE_CHAR
                        
                            ; Return length
   2d3c   8d                GLO 13
   2d3d   d5                RETN
                        
                        ; NOTE: UCI_WRITE_STRING removed - use F_MSG with R15 directly
                        ; The old UCI_WRITE_STRING used R10, which clobbered the negamax loop counter!
                        
                        ; ------------------------------------------------------------------------------
                        ; UCI_PROCESS_COMMAND - Process UCI command from buffer
                        ; ------------------------------------------------------------------------------
                        ; Input:  Command in UCI_BUFFER
                        ; Output: Appropriate action taken
                        ; ------------------------------------------------------------------------------
   2d3e                 UCI_PROCESS_COMMAND:
                            ; Compare command with known commands
                        
                            ; Check "uci"
   2d3e   68 ca 70 00       RLDI 10, UCI_BUFFER
                        
   2d42   68 cb 2b f7       RLDI 11, STR_UCI
                        
   2d46   d4 30 5a          CALL STRCMP
   2d49   c2 2d a1          LBZ UCI_CMD_UCI
                        
                            ; Check "isready"
   2d4c   68 ca 70 00       RLDI 10, UCI_BUFFER
                        
   2d50   68 cb 2b fb       RLDI 11, STR_ISREADY
                        
   2d54   d4 30 5a          CALL STRCMP
   2d57   c2 2d be          LBZ UCI_CMD_ISREADY
                        
                            ; Check "position"
   2d5a   68 ca 70 00       RLDI 10, UCI_BUFFER
                        
   2d5e   68 cb 2c 03       RLDI 11, STR_POSITION
                        
   2d62   d4 30 70          CALL STRNCMP        ; Compare first 8 chars
   2d65   c2 2d c6          LBZ UCI_CMD_POSITION
                        
                            ; Check "go"
   2d68   68 ca 70 00       RLDI 10, UCI_BUFFER
                        
   2d6c   68 cb 2c 0c       RLDI 11, STR_GO
                        
   2d70   d4 30 70          CALL STRNCMP
   2d73   c2 2e f5          LBZ UCI_CMD_GO
                        
                            ; Check "quit"
   2d76   68 ca 70 00       RLDI 10, UCI_BUFFER
                        
   2d7a   68 cb 2c 0f       RLDI 11, STR_QUIT
                        
   2d7e   d4 30 5a          CALL STRCMP
   2d81   c2 2f dd          LBZ UCI_CMD_QUIT
                        
                            ; Check "ucinewgame"
   2d84   68 ca 70 00       RLDI 10, UCI_BUFFER
                        
   2d88   68 cb 2c 14       RLDI 11, STR_UCINEWGAME
                        
   2d8c   d4 30 5a          CALL STRCMP
   2d8f   c2 2f e0          LBZ UCI_CMD_UCINEWGAME
                        
                            ; Check "stop"
   2d92   68 ca 70 00       RLDI 10, UCI_BUFFER
                        
   2d96   68 cb 2c 1f       RLDI 11, STR_STOP
                        
   2d9a   d4 30 5a          CALL STRCMP
   2d9d   c2 30 0b          LBZ UCI_CMD_STOP
                        
                            ; Unknown command - ignore
   2da0   d5                RETN
                        
                        ; ------------------------------------------------------------------------------
                        ; UCI Command Handlers
                        ; ------------------------------------------------------------------------------
                        
   2da1                 UCI_CMD_UCI:
                            ; Send identification
   2da1   68 cf 2c 24       RLDI 15, STR_ID_NAME
   2da5   d4                SEP 4
   2da6   ff 09             DW F_MSG
                        
   2da8   68 cf 2c 3d       RLDI 15, STR_ID_AUTHOR
   2dac   d4                SEP 4
   2dad   ff 09             DW F_MSG
                        
                            ; Send options
   2daf   68 cf 2c 62       RLDI 15, STR_OPTION_DEPTH
   2db3   d4                SEP 4
   2db4   ff 09             DW F_MSG
                        
                            ; Send uciok
   2db6   68 cf 2c 96       RLDI 15, STR_UCIOK
   2dba   d4                SEP 4
   2dbb   ff 09             DW F_MSG
                        
   2dbd   d5                RETN
                        
   2dbe                 UCI_CMD_ISREADY:
                            ; Send readyok
   2dbe   68 cf 2c 9e       RLDI 15, STR_READYOK
   2dc2   d4                SEP 4
   2dc3   ff 09             DW F_MSG
                        
   2dc5   d5                RETN
                        
   2dc6                 UCI_CMD_POSITION:
                            ; Parse position command
                            ; Format: "position startpos" or "position startpos moves e2e4 ..."
                        
                            ; Check if "startpos"
   2dc6   68 ca 70 09       RLDI 10, UCI_BUFFER + 9
                        
                            ; Check for "startpos"
   2dca   0a                LDN 10
   2dcb   fb 73             XRI 's'
   2dcd   ca 2e cf          LBNZ UCI_POS_DONE   ; Not startpos (FEN not supported yet)
                        
                            ; Initialize to starting position
   2dd0   d4 00 a6          CALL INIT_BOARD
   2dd3   d4 01 76          CALL INIT_MOVE_HISTORY
                        
                            ; --- Compute and store starting position hash for repetition detection ---
   2dd6   d4 55 e3          CALL HASH_INIT          ; Compute hash for starting position
   2dd9   68 ca 65 00       RLDI 10, HASH_HIST      ; R10 → first hash history entry
   2ddd   68 cd 64 b9       RLDI 13, HASH_HI
   2de1   4d                LDA 13                  ; D = HASH_HI, R13 → HASH_LO
   2de2   5a                STR 10
   2de3   1a                INC 10
   2de4   0d                LDN 13                  ; D = HASH_LO
   2de5   5a                STR 10
   2de6   68 ca 64 eb       RLDI 10, HASH_HIST_COUNT
   2dea   f8 01             LDI 1
   2dec   5a                STR 10                  ; count = 1 (starting position stored)
                        
                            ; Skip past "startpos" (8 chars) to check for " moves"
                            ; Buffer now at "startpos..." - need to find " moves "
   2ded   68 ca 70 11       RLDI 10, UCI_BUFFER + 17
                        
                            ; Check if there's more (should be space or null)
   2df1   0a                LDN 10
   2df2   c2 2e cf          LBZ UCI_POS_DONE    ; End of string, no moves
   2df5   fb 20             XRI ' '
   2df7   ca 2e cf          LBNZ UCI_POS_DONE   ; Not a space, unexpected
                        
                            ; Skip the space
   2dfa   1a                INC 10
                        
                            ; Check for "moves" (5 chars)
   2dfb   0a                LDN 10
   2dfc   fb 6d             XRI 'm'
   2dfe   ca 2e cf          LBNZ UCI_POS_DONE
   2e01   1a                INC 10
   2e02   0a                LDN 10
   2e03   fb 6f             XRI 'o'
   2e05   ca 2e cf          LBNZ UCI_POS_DONE
   2e08   1a                INC 10
   2e09   0a                LDN 10
   2e0a   fb 76             XRI 'v'
   2e0c   ca 2e cf          LBNZ UCI_POS_DONE
   2e0f   1a                INC 10
   2e10   0a                LDN 10
   2e11   fb 65             XRI 'e'
   2e13   ca 2e cf          LBNZ UCI_POS_DONE
   2e16   1a                INC 10
   2e17   0a                LDN 10
   2e18   fb 73             XRI 's'
   2e1a   ca 2e cf          LBNZ UCI_POS_DONE
   2e1d   1a                INC 10              ; R10 now past "moves"
                        
                            ; Now parse move list: " e2e4 e7e5 ..."
   2e1e                 UCI_POS_MOVE_LOOP:
                            ; Skip spaces
   2e1e   0a                LDN 10
   2e1f   c2 2e cf          LBZ UCI_POS_DONE    ; End of string
   2e22   fb 20             XRI ' '
   2e24   ca 2e 2b          LBNZ UCI_POS_PARSE_MOVE  ; Not a space, should be move
   2e27   1a                INC 10
   2e28   c0 2e 1e          LBR UCI_POS_MOVE_LOOP
                        
   2e2b                 UCI_POS_PARSE_MOVE:
                            ; R10 points to start of move (e.g., "e2e4")
                            ; Parse from square (2 chars)
   2e2b   d4 2e d0          CALL ALGEBRAIC_TO_SQUARE
   2e2e   fb ff             XRI $FF
   2e30   c2 2e cf          LBZ UCI_POS_DONE    ; Invalid square, abort
                        
                            ; Save from square
   2e33   fb ff             XRI $FF             ; Restore value (XRI is self-inverse)
   2e35   b7                PHI 7               ; R7.1 = from square
                        
                            ; Parse to square (2 chars)
   2e36   d4 2e d0          CALL ALGEBRAIC_TO_SQUARE
   2e39   fb ff             XRI $FF
   2e3b   c2 2e cf          LBZ UCI_POS_DONE    ; Invalid square, abort
   2e3e   fb ff             XRI $FF             ; Restore value
                        
                            ; Store from and to in MOVE_FROM/MOVE_TO
   2e40   a7                PLO 7               ; R7.0 = to square
                        
   2e41   68 c8 64 02       RLDI 8, MOVE_FROM
   2e45   97                GHI 7
   2e46   58                STR 8               ; MOVE_FROM = from
   2e47   18                INC 8
   2e48   87                GLO 7
   2e49   58                STR 8               ; MOVE_TO = to
                        
                            ; ---- Check for promotion suffix (5th char: q/r/b/n) ----
                            ; Clear UNDO_PROMOTION first (default: no promotion)
   2e4a   68 c8 64 04       RLDI 8, UNDO_PROMOTION
   2e4e   f8 00             LDI 0
   2e50   58                STR 8               ; UNDO_PROMOTION = 0
                        
                            ; Check next char for promotion piece
   2e51   0a                LDN 10              ; Peek next char
   2e52   fb 71             XRI 'q'
   2e54   c2 2e 69          LBZ UCI_PROMO_QUEEN
   2e57   fb 03             XRI $03             ; 'q'^'r' = $71^$72 = $03
   2e59   c2 2e 6e          LBZ UCI_PROMO_ROOK
   2e5c   fb 10             XRI $10             ; 'r'^'b' = $72^$62 = $10
   2e5e   c2 2e 73          LBZ UCI_PROMO_BISHOP
   2e61   fb 0c             XRI $0C             ; 'b'^'n' = $62^$6E = $0C
   2e63   c2 2e 78          LBZ UCI_PROMO_KNIGHT
   2e66   c0 2e 7c          LBR UCI_PROMO_DONE  ; Not a promotion char, don't advance
                        
   2e69                 UCI_PROMO_QUEEN:
   2e69   f8 05             LDI QUEEN_TYPE      ; $05
   2e6b   c0 2e 7a          LBR UCI_PROMO_STORE
   2e6e                 UCI_PROMO_ROOK:
   2e6e   f8 04             LDI ROOK_TYPE       ; $04
   2e70   c0 2e 7a          LBR UCI_PROMO_STORE
   2e73                 UCI_PROMO_BISHOP:
   2e73   f8 03             LDI BISHOP_TYPE     ; $03
   2e75   c0 2e 7a          LBR UCI_PROMO_STORE
   2e78                 UCI_PROMO_KNIGHT:
   2e78   f8 02             LDI KNIGHT_TYPE     ; $02
                        
   2e7a                 UCI_PROMO_STORE:
   2e7a   58                STR 8               ; UNDO_PROMOTION = piece type
   2e7b   1a                INC 10              ; Advance past promotion char
                        
   2e7c                 UCI_PROMO_DONE:
                        
                            ; ---- Record move in MOVE_HIST for opening book ----
                            ; Skip recording past book depth (prevents 8-bit GAME_PLY overflow)
   2e7c   68 c8 64 4d       RLDI 8, GAME_PLY
   2e80   08                LDN 8               ; D = GAME_PLY
   2e81   ff 0f             SMI BOOK_PLY_LIMIT  ; past book depth?
   2e83   c3 2e a1          LBDF UCI_HIST_DONE  ; skip recording + increment
                            ; Calculate offset: GAME_PLY * 2
   2e86   08                LDN 8               ; reload GAME_PLY (SMI clobbered D)
   2e87   fe                SHL                 ; D = GAME_PLY * 2
   2e88   a9                PLO 9               ; R9.0 = offset
                        
                            ; R9 = MOVE_HIST + offset
   2e89   f8 60             LDI HIGH(MOVE_HIST)
   2e8b   b9                PHI 9
   2e8c   f8 90             LDI LOW(MOVE_HIST)
   2e8e   e2                SEX 2
   2e8f   52                STR 2
   2e90   89                GLO 9               ; D = offset
   2e91   f4                ADD                 ; D = LOW(MOVE_HIST) + offset
   2e92   a9                PLO 9
   2e93   f8 60             LDI HIGH(MOVE_HIST)
   2e95   7c 00             ADCI 0              ; Add carry to high byte
   2e97   b9                PHI 9
                        
                            ; Store from square
   2e98   97                GHI 7               ; from square
   2e99   59                STR 9
   2e9a   19                INC 9
                            ; Store to square
   2e9b   87                GLO 7               ; to square
   2e9c   59                STR 9
                        
                            ; Increment GAME_PLY
   2e9d   08                LDN 8               ; R8 still points to GAME_PLY
   2e9e   fc 01             ADI 1
   2ea0   58                STR 8
   2ea1                 UCI_HIST_DONE:
                            ; ---- End of MOVE_HIST recording ----
                        
                            ; Apply the move (save R10 - MAKE_MOVE clobbers it!)
   2ea1   9a                GHI 10
   2ea2   73                STXD
   2ea3   8a                GLO 10
   2ea4   73                STXD
   2ea5   d4 09 bb          CALL MAKE_MOVE
   2ea8   60                IRX
   2ea9   72                LDXA
   2eaa   aa                PLO 10
   2eab   f0                LDX
   2eac   ba                PHI 10
                        
                            ; ---- Record hash for repetition detection ----
   2ead   68 cd 64 eb       RLDI 13, HASH_HIST_COUNT
   2eb1   0d                LDN 13              ; D = count
   2eb2   fb ff             XRI 255             ; Zero if count == 255 (table full)
   2eb4   c2 2e 1e          LBZ UCI_POS_MOVE_LOOP   ; Full, skip recording
   2eb7   0d                LDN 13              ; D = count (reload)
   2eb8   fe                SHL                 ; D = (count*2) & $FF, DF = carry for counts >= 128
   2eb9   a8                PLO 8               ; R8.0 = offset low byte
   2eba   f8 65             LDI HIGH(HASH_HIST) ; DF preserved (LDI doesn't affect DF)
   2ebc   7c 00             ADCI 0              ; D = HIGH(HASH_HIST) + carry from SHL
   2ebe   b8                PHI 8               ; R8 = &HASH_HIST[count] (correct for all counts)
   2ebf   68 c9 64 b9       RLDI 9, HASH_HI
   2ec3   49                LDA 9               ; D = HASH_HI
   2ec4   58                STR 8
   2ec5   18                INC 8
   2ec6   09                LDN 9               ; D = HASH_LO
   2ec7   58                STR 8
   2ec8   0d                LDN 13              ; count (R13 still at HASH_HIST_COUNT)
   2ec9   fc 01             ADI 1
   2ecb   5d                STR 13              ; count++
   2ecc   c0 2e 1e          LBR UCI_POS_MOVE_LOOP
                        
   2ecf                 UCI_POS_DONE:
   2ecf   d5                RETN
                        
                        ; ------------------------------------------------------------------------------
                        ; ALGEBRAIC_TO_SQUARE - Convert algebraic notation to 0x88 square
                        ; ------------------------------------------------------------------------------
                        ; Input:  R10 = pointer to 2-char string (e.g., "e2"), advanced by 2
                        ; Output: D = 0x88 square index, or $FF if invalid
                        ; Uses:   R7.0 for file temp
                        ; ------------------------------------------------------------------------------
   2ed0                 ALGEBRAIC_TO_SQUARE:
                            ; Get file character (a-h)
   2ed0   4a                LDA 10              ; Load file char, advance R10
   2ed1   ff 61             SMI 'a'             ; Convert to 0-7
   2ed3   cb 2e f1          LBNF ATS_INVALID    ; If DF=0 (borrow), char < 'a', invalid
   2ed6   a7                PLO 7               ; Save potential file in R7.0
   2ed7   ff 08             SMI 8               ; Check if >= 8
   2ed9   c3 2e f1          LBDF ATS_INVALID    ; If >= 8, invalid
                        
                            ; Get rank character (1-8)
   2edc   4a                LDA 10              ; Load rank char, advance R10
   2edd   ff 31             SMI '1'             ; Convert to 0-7
   2edf   cb 2e f1          LBNF ATS_INVALID    ; If DF=0 (borrow), char < '1', invalid
   2ee2   ff 08             SMI 8               ; Check if >= 8
   2ee4   c3 2e f1          LBDF ATS_INVALID    ; If >= 8, invalid
   2ee7   fc 08             ADI 8               ; Restore 0-7 value
                        
                            ; Calculate 0x88 square = rank * 16 + file
                            ; rank is in D (0-7), file in R7.0
   2ee9   fe                SHL                 ; D = rank * 2
   2eea   fe                SHL                 ; D = rank * 4
   2eeb   fe                SHL                 ; D = rank * 8
   2eec   fe                SHL                 ; D = rank * 16
   2eed   52                STR 2               ; Save rank*16 on stack
   2eee   87                GLO 7               ; Get file (0-7)
   2eef   f4                ADD                 ; D = rank*16 + file
   2ef0   d5                RETN
                        
   2ef1                 ATS_INVALID:
   2ef1   1a                INC 10              ; Skip second char even on error (keep R10 consistent)
   2ef2   f8 ff             LDI $FF
   2ef4   d5                RETN
                        
   2ef5                 UCI_CMD_GO:
                            ; Parse go command
                            ; Format: "go depth 6" or "go infinite", etc.
                            ; Default to depth 1, parse "depth N" if present
                            ; Store in memory (R5 is SRET in BIOS mode!)
                        
                            ; Default depth = 1
   2ef5   f8 01             LDI 1
   2ef7   a7                PLO 7               ; R7.0 = depth (default 1)
                        
                            ; Check for "depth " after "go "
                            ; Buffer: "go depth 3" or "go" or "go infinite"
   2ef8   68 ca 70 03       RLDI 10, UCI_BUFFER + 3
                        
                            ; Check if we have "depth"
   2efc   0a                LDN 10
   2efd   fb 64             XRI 'd'
   2eff   ca 2f 37          LBNZ UCI_GO_SET_DEPTH   ; Not "depth", use default
   2f02   1a                INC 10
   2f03   0a                LDN 10
   2f04   fb 65             XRI 'e'
   2f06   ca 2f 37          LBNZ UCI_GO_SET_DEPTH
   2f09   1a                INC 10
   2f0a   0a                LDN 10
   2f0b   fb 70             XRI 'p'
   2f0d   ca 2f 37          LBNZ UCI_GO_SET_DEPTH
   2f10   1a                INC 10
   2f11   0a                LDN 10
   2f12   fb 74             XRI 't'
   2f14   ca 2f 37          LBNZ UCI_GO_SET_DEPTH
   2f17   1a                INC 10
   2f18   0a                LDN 10
   2f19   fb 68             XRI 'h'
   2f1b   ca 2f 37          LBNZ UCI_GO_SET_DEPTH
   2f1e   1a                INC 10
   2f1f   0a                LDN 10
   2f20   fb 20             XRI ' '
   2f22   ca 2f 37          LBNZ UCI_GO_SET_DEPTH
   2f25   1a                INC 10              ; R10 now at the number
                        
                            ; Parse the depth number (1-9, single digit only)
                            ; Depths > 9 would take impractically long on the 1802 anyway
   2f26   0a                LDN 10
   2f27   ff 30             SMI '0'             ; Convert ASCII to value
   2f29   cb 2f 37          LBNF UCI_GO_SET_DEPTH ; Invalid (< '0'), use default
   2f2c   ff 0a             SMI 10              ; Check if >= 10
   2f2e   c3 2f 37          LBDF UCI_GO_SET_DEPTH ; >= 10, use default
   2f31   fc 0a             ADI 10              ; Restore 0-9 value
   2f33   c2 2f 37          LBZ UCI_GO_SET_DEPTH ; Depth 0 invalid, use default
   2f36   a7                PLO 7               ; R7.0 = parsed depth (1-9)
                        
   2f37                 UCI_GO_SET_DEPTH:
                            ; Set SEARCH_DEPTH from R7.0
   2f37   68 cd 64 16       RLDI 13, SEARCH_DEPTH
   2f3b   f8 00             LDI 0
   2f3d   5d                STR 13              ; SEARCH_DEPTH high = 0
   2f3e   1d                INC 13
   2f3f   87                GLO 7
   2f40   5d                STR 13              ; SEARCH_DEPTH low = depth
                        
                            ; ---- Check opening book first ----
   2f41   d4 30 93          CALL BOOK_LOOKUP
   2f44   c2 2f 57          LBZ UCI_GO_SEARCH   ; D=0: no book hit, do normal search
                        
                            ; Book hit! Copy BOOK_MOVE to BEST_MOVE
   2f47   68 c8 64 4e       RLDI 8, BOOK_MOVE_FROM
   2f4b   68 c9 64 10       RLDI 9, BEST_MOVE
                        
                            ; Store book move in BEST_MOVE (from in high, to in low)
   2f4f   48                LDA 8               ; BOOK_MOVE_FROM
   2f50   59                STR 9               ; BEST_MOVE high = from
   2f51   19                INC 9
   2f52   08                LDN 8               ; BOOK_MOVE_TO
   2f53   59                STR 9               ; BEST_MOVE low = to
   2f54   c0 2f 61          LBR UCI_GO_SEND_MOVE
                        
   2f57                 UCI_GO_SEARCH:
                            ; Clear stale promotion flag before search
                            ; (opponent's promotion move leaves UNDO_PROMOTION set, which would
                            ; corrupt every MAKE_MOVE during search)
   2f57   68 ca 64 04       RLDI 10, UNDO_PROMOTION
   2f5b   f8 00             LDI 0
   2f5d   5a                STR 10              ; UNDO_PROMOTION = 0
                        
                            ; Run search
   2f5e   d4 2a 45          CALL SEARCH_POSITION
                        
   2f61                 UCI_GO_SEND_MOVE:
                            ; Best move now at BEST_MOVE.
                            ;
                            ; --- Root-move validation (added 2026-05-12) ---
                            ; Defense against MOVE_LIST corruption causing illegal-move output.
                            ; Regenerate moves from current board; verify BEST_MOVE appears in
                            ; the regenerated list. If not, emit info string + substitute first
                            ; legal move. Catches the symptom of any state corruption affecting
                            ; root MOVE_LIST regardless of underlying cause.
                        
                            ; Encode BEST_MOVE for byte-by-byte comparison (mirrors ORDER_TT_MOVE)
   2f61   68 ca 64 10       RLDI 10, BEST_MOVE
   2f65   4a                LDA 10
   2f66   bd                PHI 13                      ; R13.1 = BEST_MOVE from (0x88)
   2f67   0a                LDN 10
   2f68   ad                PLO 13                      ; R13.0 = BEST_MOVE to (0x88)
                        
   2f69   68 ca 64 06       RLDI 10, MOVE_FLAGS_TEMP
   2f6d   f8 00             LDI 0
   2f6f   5a                STR 10                      ; flags=0 for the comparison encoding
                        
   2f70   d4 03 8d          CALL ENCODE_MOVE_16BIT
                            ; R8 = encoded BEST_MOVE (flags=0)
                        
                            ; Save encoded BEST_MOVE on stack across GENERATE_MOVES
                            ; (GENERATE_MOVES clobbers R11 — uses R11.1 as current-from-square)
   2f73   98                GHI 8
   2f74   73                STXD
   2f75   88                GLO 8
   2f76   73                STXD
                        
                            ; Regenerate legal moves into MOVE_LIST
   2f77   68 c9 78 00       RLDI 9, MOVE_LIST
   2f7b   d4 04 d7          CALL GENERATE_MOVES
                            ; D = move count
                        
   2f7e   a7                PLO 7                       ; R7.0 = move count
   2f7f   b7                PHI 7                       ; R7.1 = loop counter (D unchanged by PLO)
                        
                            ; Restore encoded BEST_MOVE to R11
   2f80   60                IRX
   2f81   72                LDXA
   2f82   ab                PLO 11                      ; R11.0 = LOW
   2f83   f0                LDX
   2f84   bb                PHI 11                      ; R11.1 = HIGH
                        
   2f85   97                GHI 7                       ; check count
   2f86   c2 2f c8          LBZ RMV_DONE                ; 0 moves (mate/stalemate) — leave as-is
                        
   2f89   68 c8 78 00       RLDI 8, MOVE_LIST           ; R8 = scan pointer
                        
   2f8d                 RMV_SCAN_LOOP:
   2f8d   97                GHI 7
   2f8e   c2 2f a9          LBZ RMV_NOT_FOUND
                        
                            ; MOVE_LIST stores HIGH byte first (per ADD_MOVE_ENCODED line 221):
                            ; entry layout in memory is [HIGH][LOW] for each 2-byte move.
                            ; Compare HIGH byte (with flag bits 6-7 masked off)
   2f91   48                LDA 8                       ; list move HIGH byte; R8++
   2f92   fa 3f             ANI $3F                     ; mask off flag bits
   2f94   52                STR 2
   2f95   9b                GHI 11                      ; encoded BEST_MOVE HIGH byte (flags=0)
   2f96   f3                XOR
   2f97   ca 2f a1          LBNZ RMV_NEXT
                        
                            ; HIGH bytes match — compare LOW byte (no masking needed)
   2f9a   08                LDN 8                       ; list move LOW byte; R8 stays
   2f9b   52                STR 2
   2f9c   8b                GLO 11                      ; encoded BEST_MOVE LOW byte
   2f9d   f3                XOR
   2f9e   c2 2f c8          LBZ RMV_DONE                ; Match — BEST_MOVE is legal, emit normally
                        
   2fa1                 RMV_NEXT:
   2fa1   18                INC 8                       ; skip past LOW byte to next entry
   2fa2   97                GHI 7
   2fa3   ff 01             SMI 1
   2fa5   b7                PHI 7
   2fa6   c0 2f 8d          LBR RMV_SCAN_LOOP
                        
   2fa9                 RMV_NOT_FOUND:
                            ; BEST_MOVE not in regenerated legal list — corruption symptom.
   2fa9   68 cf 2c d1       RLDI 15, STR_INFO_RMV
   2fad   d4                SEP 4
   2fae   ff 09             DW F_MSG
                        
                            ; Substitute first legal move from regenerated list
                            ; (memory order is [HIGH][LOW]; DECODE_MOVE_16BIT wants R8.0=LOW, R8.1=HIGH)
   2fb0   68 c8 78 00       RLDI 8, MOVE_LIST
   2fb4   48                LDA 8                       ; HIGH byte from memory
   2fb5   bb                PHI 11                      ; R11.1 = HIGH
   2fb6   08                LDN 8                       ; LOW byte from memory
   2fb7   ab                PLO 11                      ; R11.0 = LOW
                        
                            ; Now build R8 = [HIGH in .1, LOW in .0] for DECODE
   2fb8   9b                GHI 11
   2fb9   b8                PHI 8
   2fba   8b                GLO 11
   2fbb   a8                PLO 8
   2fbc   d4 03 c7          CALL DECODE_MOVE_16BIT
                            ; R13.1 = from, R13.0 = to
                        
                            ; Write back to BEST_MOVE
   2fbf   68 ca 64 10       RLDI 10, BEST_MOVE
   2fc3   9d                GHI 13
   2fc4   5a                STR 10
   2fc5   1a                INC 10
   2fc6   8d                GLO 13
   2fc7   5a                STR 10
                        
   2fc8                 RMV_DONE:
                            ; Send best move (validated or substituted)
   2fc8   68 cf 2c a8       RLDI 15, STR_BESTMOVE
   2fcc   d4                SEP 4
   2fcd   ff 09             DW F_MSG
                        
                            ; Convert best move to algebraic and send
                            ; TODO: Load best move and convert
   2fcf   d4 30 0c          CALL UCI_SEND_BEST_MOVE
                        
                            ; Send CR+LF
   2fd2   f8 0d             LDI 13
   2fd4   d4 00 0b          CALL SERIAL_WRITE_CHAR
   2fd7   f8 0a             LDI 10
   2fd9   d4 00 0b          CALL SERIAL_WRITE_CHAR
                        
   2fdc   d5                RETN
                        
   2fdd                 UCI_CMD_QUIT:
                            ; Return to monitor at $8000
   2fdd   c0 80 03          LBR $8003
                        
                        ; ------------------------------------------------------------------------------
                        ; UCI_CMD_UCINEWGAME - Prepare for a new game
                        ; ------------------------------------------------------------------------------
                        ; Clears transposition table and resets game state
                        ; ------------------------------------------------------------------------------
   2fe0                 UCI_CMD_UCINEWGAME:
                            ; Clear workspace RAM to prevent stale variable bugs
   2fe0   d4 5e ec          CALL WORKSPACE_CLEAR
                        
                            ; Clear transposition table
   2fe3   d4 56 f2          CALL TT_CLEAR
                        
                            ; Reset game ply counter
   2fe6   68 ca 64 4d       RLDI 10, GAME_PLY
   2fea   f8 00             LDI 0
   2fec   5a                STR 10
                        
                            ; Clear move history
   2fed   d4 01 76          CALL INIT_MOVE_HISTORY
                        
                            ; Initialize board to starting position
   2ff0   d4 00 a6          CALL INIT_BOARD
                        
                            ; Compute and store starting-position Zobrist hash + first HASH_HIST entry.
                            ; UCI_CMD_POSITION normally does this when parsing "position startpos",
                            ; but the first such command after ucinewgame is frequently dropped at
                            ; the start of every match since 2026-04-30 ("PARTIAL_ECHO 'sition
                            ; startpos'"). The bridge sends ucinewgame and position back-to-back,
                            ; and BIOS serial RX drops the first 1-2 bytes during the long
                            ; WORKSPACE_CLEAR/TT_CLEAR processing window. Without hash init here,
                            ; the first search runs with hash=0 and pollutes TT with mis-keyed
                            ; entries that persist for the entire match.
   2ff3   d4 55 e3          CALL HASH_INIT
   2ff6   68 ca 65 00       RLDI 10, HASH_HIST
   2ffa   68 cd 64 b9       RLDI 13, HASH_HI
   2ffe   4d                LDA 13                  ; D = HASH_HI, R13 → HASH_LO
   2fff   5a                STR 10
   3000   1a                INC 10
   3001   0d                LDN 13                  ; D = HASH_LO
   3002   5a                STR 10
   3003   68 ca 64 eb       RLDI 10, HASH_HIST_COUNT
   3007   f8 01             LDI 1
   3009   5a                STR 10                  ; HASH_HIST_COUNT = 1 (startpos stored)
                        
   300a   d5                RETN
                        
                        ; ------------------------------------------------------------------------------
                        ; UCI_CMD_STOP - Stop calculating (no-op for now)
                        ; ------------------------------------------------------------------------------
                        ; On a single-threaded system we cannot interrupt search.
                        ; GUI should wait for bestmove response.
                        ; This is here for protocol compatibility.
                        ; ------------------------------------------------------------------------------
   300b                 UCI_CMD_STOP:
                            ; No-op - search completes naturally
                            ; GUI will receive bestmove when search finishes
   300b   d5                RETN
                        
                        ; ------------------------------------------------------------------------------
                        ; UCI_SEND_BEST_MOVE - Send best move in algebraic notation
                        ; ------------------------------------------------------------------------------
   300c                 UCI_SEND_BEST_MOVE:
                            ; BEST_MOVE contains raw from/to squares (not encoded)
                            ; BEST_MOVE[0] = from square (0x88), BEST_MOVE[1] = to square (0x88)
   300c   68 ca 64 10       RLDI 10, BEST_MOVE
                        
   3010   4a                LDA 10              ; from square (raw 0x88)
   3011   bd                PHI 13              ; R13.1 = from
   3012   0a                LDN 10              ; to square (raw 0x88)
   3013   ad                PLO 13              ; R13.0 = to
                        
                            ; Convert to algebraic notation (e.g., "e2e4")
                            ; From square
   3014   9d                GHI 13              ; From square
   3015   d4 30 47          CALL SQUARE_TO_ALGEBRAIC
                            ; Sends two characters (file, rank)
                        
                            ; To square
   3018   8d                GLO 13              ; To square
   3019   d4 30 47          CALL SQUARE_TO_ALGEBRAIC
                        
                            ; Check if this is a promotion move (pawn reaching last rank)
                            ; Load piece at from square
   301c   f8 60             LDI HIGH(BOARD)
   301e   ba                PHI 10
   301f   9d                GHI 13              ; from square
   3020   aa                PLO 10
   3021   f8 00             LDI LOW(BOARD)
   3023   52                STR 2
   3024   8a                GLO 10
   3025   f4                ADD
   3026   aa                PLO 10
   3027   9a                GHI 10
   3028   7c 00             ADCI 0
   302a   ba                PHI 10              ; R10 = &BOARD[from]
   302b   0a                LDN 10              ; D = piece at from
   302c   fa 07             ANI PIECE_MASK      ; Get piece type
   302e   fb 01             XRI PAWN_TYPE       ; Is it a pawn?
   3030   ca 30 46          LBNZ UCI_BM_NO_PROMO
                        
                            ; It's a pawn - check if to square is on last rank
   3033   8d                GLO 13              ; to square
   3034   fa 70             ANI $70             ; Isolate rank
   3036   c2 30 41          LBZ UCI_BM_IS_PROMO ; Rank 0 = promotion for black
   3039   fb 70             XRI $70
   303b   c2 30 41          LBZ UCI_BM_IS_PROMO ; Rank 7 = promotion for white
   303e   c0 30 46          LBR UCI_BM_NO_PROMO
                        
   3041                 UCI_BM_IS_PROMO:
                            ; Append 'q' for queen promotion
   3041   f8 71             LDI 'q'
   3043   d4 00 0b          CALL SERIAL_WRITE_CHAR
                        
   3046                 UCI_BM_NO_PROMO:
   3046   d5                RETN
                        
                        ; ------------------------------------------------------------------------------
                        ; SQUARE_TO_ALGEBRAIC - Convert 0x88 square to algebraic notation
                        ; ------------------------------------------------------------------------------
                        ; Input:  D = square (0x88 format)
                        ; Output: Two characters sent (file letter, rank number)
                        ; ------------------------------------------------------------------------------
   3047                 SQUARE_TO_ALGEBRAIC:
   3047   a7                PLO 7               ; Save square in R7.0 (R13 used by caller!)
                        
                            ; Get file (0-7 → 'a'-'h')
   3048   fa 07             ANI $07             ; File bits
   304a   fc 61             ADI 'a'             ; Convert to ASCII
   304c   d4 00 0b          CALL SERIAL_WRITE_CHAR
                        
                            ; Get rank (0-7 → '1'-'8')
   304f   87                GLO 7               ; Get square from R7.0
   3050   f6                SHR
   3051   f6                SHR
   3052   f6                SHR
   3053   f6                SHR                 ; Rank bits
   3054   fc 31             ADI '1'             ; Convert to ASCII
   3056   d4 00 0b          CALL SERIAL_WRITE_CHAR
                        
   3059   d5                RETN
                        
                        ; ------------------------------------------------------------------------------
                        ; String Comparison Functions
                        ; ------------------------------------------------------------------------------
                        
                        ; STRCMP - Compare two null-terminated strings
                        ; Input:  A = string 1, B = string 2
                        ; Output: D = 0 if equal, non-zero if different
   305a                 STRCMP:
   305a   0a                LDN 10              ; D = char from string 1
   305b   52                STR 2               ; Save to stack
   305c   0b                LDN 11              ; D = char from string 2
   305d   f3                XOR                 ; D = char1 XOR char2 (0 if equal)
   305e   ca 30 6d          LBNZ STRCMP_DIFF     ; If XOR != 0, characters differ
                        
                            ; Characters are equal, check if end of both strings
   3061   0a                LDN 10
   3062   c2 30 6a          LBZ STRCMP_EQUAL     ; If null terminator, both ended - equal
                        
                            ; Continue comparing
   3065   1a                INC 10
   3066   1b                INC 11
   3067   c0 30 5a          LBR STRCMP
                        
   306a                 STRCMP_EQUAL:
   306a   f8 00             LDI 0
   306c   d5                RETN
                        
   306d                 STRCMP_DIFF:
   306d   f8 01             LDI 1
   306f   d5                RETN
                        
                        ; STRNCMP - Compare until space or null in string 1
                        ; Input:  R10 = string 1 (command buffer), R11 = string 2 (command name)
                        ; Output: D = 0 if equal, non-zero if different
   3070                 STRNCMP:
                            ; Check if string 1 hit space (end of command word)
   3070   0a                LDN 10
   3071   fb 20             XRI ' '
   3073   c2 30 86          LBZ STRNCMP_CHECK_END
                        
                            ; Check if string 1 hit null
   3076   0a                LDN 10
   3077   c2 30 86          LBZ STRNCMP_CHECK_END
                        
                            ; Compare characters
   307a   0a                LDN 10              ; D = char from string 1
   307b   52                STR 2               ; Save to stack
   307c   0b                LDN 11              ; D = char from string 2
   307d   f3                XOR                 ; D = char1 XOR char2 (0 if equal)
   307e   ca 30 90          LBNZ STRNCMP_DIFF   ; If different, not equal
                        
   3081   1a                INC 10
   3082   1b                INC 11
   3083   c0 30 70          LBR STRNCMP
                        
   3086                 STRNCMP_CHECK_END:
                            ; String 1 ended (space or null) - check if string 2 also ended
   3086   0b                LDN 11
   3087   c2 30 8d          LBZ STRNCMP_EQUAL   ; String 2 is null - match!
   308a   c0 30 90          LBR STRNCMP_DIFF    ; String 2 has more chars - no match
                        
   308d                 STRNCMP_EQUAL:
   308d   f8 00             LDI 0
   308f   d5                RETN
                        
   3090                 STRNCMP_DIFF:
   3090   f8 01             LDI 1
   3092   d5                RETN
                        
                        ; ==============================================================================
                        ; End of UCI Implementation
                        ; ==============================================================================
                        ; NOTE: SERIAL_READ_CHAR and SERIAL_WRITE_CHAR are provided by serial-io-9600.asm
                        ; ==============================================================================
                        ; ==============================================================================
                        ; Opening Book Lookup - Check if current position is in opening book
                        ; ==============================================================================
                        ;
                        ; Book format (from opening-book.asm):
                        ;   Each entry: [ply] [move1_from] [move1_to] ... [response_from] [response_to]
                        ;   Terminated with $FF
                        ;   Entries sorted by ply
                        ;
                        ; Uses: GAME_PLY - number of moves played since start
                        ;       MOVE_HIST - array of (from, to) pairs for game moves
                        ;       BOOK_MOVE_FROM/TO - output for book response
                        ;
                        ; ==============================================================================
                        
                        ; ==============================================================================
                        ; BOOK_LOOKUP - Search opening book for current position
                        ; ==============================================================================
                        ; Input:  GAME_PLY = number of moves played
                        ;         MOVE_HIST = game move history (2 bytes per move)
                        ; Output: D = 1 if book hit, 0 if no match
                        ;         BOOK_MOVE_FROM/TO = response move (if hit)
                        ; Uses:   R7, R8, R9, R10
                        ; ==============================================================================
   3093                 BOOK_LOOKUP:
                            ; R8 = pointer to current book entry
   3093   68 c8 31 01       RLDI 8, OPENING_BOOK
                        
                            ; Load GAME_PLY into R7.1 for quick comparison
   3097   68 ca 64 4d       RLDI 10, GAME_PLY
   309b   0a                LDN 10
   309c   b7                PHI 7               ; R7.1 = GAME_PLY
                        
   309d                 BL_ENTRY_LOOP:
                            ; Read entry ply byte
   309d   08                LDN 8               ; D = entry ply
   309e   fb ff             XRI $FF             ; Check for end marker
   30a0   c2 30 fe          LBZ BL_NO_MATCH     ; End of book, no match
                        
                            ; Restore ply value
   30a3   fb ff             XRI $FF
   30a5   a7                PLO 7               ; R7.0 = entry_ply
                        
                            ; Check if entry_ply > GAME_PLY (early exit - book sorted by ply)
   30a6   97                GHI 7               ; D = GAME_PLY
   30a7   52                STR 2               ; Store on stack
   30a8   87                GLO 7               ; D = entry_ply
   30a9   f5                SD                  ; D = GAME_PLY - entry_ply
   30aa   cb 30 fe          LBNF BL_NO_MATCH    ; If borrow (entry_ply > GAME_PLY), no match possible
                        
                            ; Check if entry_ply == GAME_PLY
   30ad   c2 30 bf          LBZ BL_CHECK_MOVES  ; If equal, check the moves
                        
                            ; entry_ply < GAME_PLY, skip to next entry
                            ; Entry length = 1 + entry_ply*2 + 2 = 3 + entry_ply*2
   30b0   87                GLO 7               ; D = entry_ply
   30b1   fe                SHL                 ; D = entry_ply * 2
   30b2   fc 03             ADI 3               ; D = 3 + entry_ply * 2
   30b4   52                STR 2               ; Save skip amount
   30b5   88                GLO 8
   30b6   f4                ADD
   30b7   a8                PLO 8
   30b8   98                GHI 8
   30b9   7c 00             ADCI 0
   30bb   b8                PHI 8
   30bc   c0 30 9d          LBR BL_ENTRY_LOOP
                        
   30bf                 BL_CHECK_MOVES:
                            ; entry_ply == GAME_PLY, compare all moves
                            ; R8 points to ply byte, moves start at R8+1
                            ; R9 = pointer to MOVE_HIST
   30bf   68 c9 60 90       RLDI 9, MOVE_HIST
                        
                            ; R10.0 = move counter (number of move pairs to compare)
   30c3   87                GLO 7               ; entry_ply = number of moves to compare
   30c4   aa                PLO 10
                        
                            ; Move past ply byte
   30c5   18                INC 8
                        
                            ; If ply == 0, no moves to compare - direct match!
   30c6   8a                GLO 10
   30c7   c2 30 e1          LBZ BL_MATCH_FOUND
                        
   30ca                 BL_COMPARE_LOOP:
                            ; Compare from square
   30ca   08                LDN 8               ; Book from
   30cb   52                STR 2
   30cc   09                LDN 9               ; History from
   30cd   f3                XOR                 ; Compare
   30ce   ca 30 ef          LBNZ BL_SKIP_ENTRY  ; Mismatch
                        
                            ; Compare to square
   30d1   18                INC 8
   30d2   19                INC 9
   30d3   08                LDN 8               ; Book to
   30d4   52                STR 2
   30d5   09                LDN 9               ; History to
   30d6   f3                XOR                 ; Compare
   30d7   ca 30 ed          LBNZ BL_SKIP_TO     ; TO mismatch - different skip path
                        
                            ; Move to next pair
   30da   18                INC 8
   30db   19                INC 9
   30dc   2a                DEC 10
   30dd   8a                GLO 10
   30de   ca 30 ca          LBNZ BL_COMPARE_LOOP
                        
   30e1                 BL_MATCH_FOUND:
                            ; All moves matched! R8 now points to response
                            ; Store response in BOOK_MOVE_FROM/TO
   30e1   68 c9 64 4e       RLDI 9, BOOK_MOVE_FROM
                        
   30e5   48                LDA 8               ; Response from
   30e6   59                STR 9
   30e7   19                INC 9
   30e8   08                LDN 8               ; Response to
   30e9   59                STR 9
                        
                            ; Return success
   30ea   f8 01             LDI 1
   30ec   d5                RETN
                        
   30ed                 BL_SKIP_TO:
                            ; TO byte mismatch: R8 points to TO byte (already past FROM via INC 8)
                            ; Advance past TO and count this pair as consumed, then fall through
   30ed   18                INC 8               ; Past TO byte -> R8 at start of next pair
   30ee   2a                DEC 10              ; This pair consumed
                            ; Fall through to BL_SKIP_ENTRY
                        
   30ef                 BL_SKIP_ENTRY:
                            ; FROM byte mismatch: R8 points to FROM byte of mismatched pair
                            ; R10.0 = remaining move pairs to skip (not yet compared)
                            ; Skip: remaining_moves*2 + 2 (response bytes)
   30ef   8a                GLO 10              ; Remaining moves
   30f0   fe                SHL                 ; * 2
   30f1   fc 02             ADI 2               ; + response
   30f3   52                STR 2
   30f4   88                GLO 8
   30f5   f4                ADD
   30f6   a8                PLO 8
   30f7   98                GHI 8
   30f8   7c 00             ADCI 0
   30fa   b8                PHI 8
                        
                            ; Reset book pointer past ply (we compared some moves already)
   30fb   c0 30 9d          LBR BL_ENTRY_LOOP
                        
   30fe                 BL_NO_MATCH:
                            ; No book match found
   30fe   f8 00             LDI 0
   3100   d5                RETN
                        
                        ; ==============================================================================
                        ; End of Opening Book Lookup
                        ; ==============================================================================
                        ; ==============================================================================
                        ; Combined Opening Book Data - Merged from multiple PGN sources
                        ; Total entries: 504, Total size: 9385 bytes
                        ; Duplicates removed: 6
                        ; Sources:
                        ;   giuoco-piano: 97 entries
                        ;   sicilian-rossolimo: 91 entries
                        ;   french-advance: 46 entries
                        ;   caro-kann-advance: 81 entries
                        ;   qgd-exchange: 62 entries
                        ;   alekhine-modern: 30 entries
                        ;   scandinavian: 31 entries
                        ;   pirc-austrian: 23 entries
                        ;   opponent-prep (manual, 2026-04-21): 10 entries targeting Stockfish Skill 2 sidelines
                        ;   krejcik-sacrifice (2026-04-22): 5 entries for 1.e4 Nf6 2.e5 Ne4 3.d3 Nxf2!? line
                        ;   krejcik-retreat (2026-04-22): 3 entries for 1.e4 Nf6 2.e5 Ne4 3.d3 Nc5 line
                        ;   opponent-prep (2026-04-27): 5 entries continuing existing 2026-04-21 lines past the engine's first searched move
                        ; ==============================================================================
                        
