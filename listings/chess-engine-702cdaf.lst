   23be   68 ca 64 09       RLDI 10, UNDO_FROM
   23c2   4a                LDA 10              ; UNDO_FROM
   23c3   b8                PHI 8               ; Temp in R8.1
   23c4   0a                LDN 10              ; UNDO_TO
   23c5   a8                PLO 8               ; R8 = from/to
                        
   23c6   68 ca 64 10       RLDI 10, BEST_MOVE
   23ca   98                GHI 8
   23cb   5a                STR 10              ; BEST_MOVE[0] = from
   23cc   1a                INC 10
   23cd   88                GLO 8
   23ce   5a                STR 10              ; BEST_MOVE[1] = to
                        
   23cf                 NEGAMAX_BETA_NOT_ROOT:
                            ; Decrement move count (in ply-indexed memory) before returning
   23cf   68 ca 64 48       RLDI 10, CURRENT_PLY
   23d3   0a                LDN 10
   23d4   fc ef             ADI LOW(LOOP_MOVE_CNT)
   23d6   aa                PLO 10
   23d7   f8 64             LDI HIGH(LOOP_MOVE_CNT)
   23d9   ba                PHI 10              ; R10 = &LOOP_MOVE_CNT[ply]
   23da   0a                LDN 10
   23db   ff 01             SMI 1
   23dd   5a                STR 10             ; LOOP_MOVE_CNT[ply]--
                        
