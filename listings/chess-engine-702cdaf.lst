   240d   4a                LDA 10              ; BEST_SCORE_HI
   240e   b8                PHI 8
   240f   0a                LDN 10              ; BEST_SCORE_LO
   2410   a8                PLO 8               ; R8 = best score from memory
                        
                            ; -----------------------------------------------
                            ; Update best score: if (score > maxScore) maxScore = score
                            ; -----------------------------------------------
