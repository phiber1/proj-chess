                        ; Total size: 8610 bytes
                        ; ==============================================================================
                        ; TRANSPOSITION TABLE FUNCTIONS
                        ; ==============================================================================
                        ; Provides Zobrist hashing and transposition table lookup/store.
                        ;
                        ; Functions:
                        ;   HASH_INIT   - Compute full hash from current board position
                        ;   TT_CLEAR    - Clear all TT entries
                        ;   TT_PROBE    - Look up position in TT
                        ;   TT_STORE    - Store position result in TT
                        ;
                        ; Hash is updated incrementally by MAKE_MOVE/UNMAKE_MOVE (in makemove.asm)
                        ; ==============================================================================
                        
                        ; ==============================================================================
                        ; HASH_INIT - Compute Zobrist hash from current board position
                        ; ==============================================================================
                        ; Scans the board and XORs all piece-square keys, plus side/castling/EP.
                        ; Result stored in HASH_HI/HASH_LO.
                        ;
                        ; Uses: R7 (hash accumulator), R8 (temp), R9 (square counter), R10 (pointer)
                        ; ==============================================================================
   55e3                 HASH_INIT:
                            ; Initialize hash to zero
   55e3   f8 00             LDI 0
   55e5   b7                PHI 7
   55e6   a7                PLO 7               ; R7 = 0 (hash accumulator)
                        
                            ; Scan all 64 valid squares (0x88 format)
   55e7   f8 00             LDI 0
   55e9   a9                PLO 9               ; R9.0 = square index (0x88 format)
                        
   55ea                 HASH_INIT_LOOP:
                            ; Check if square is valid (not off-board)
   55ea   89                GLO 9
   55eb   fa 88             ANI $88
   55ed   ca 56 4f          LBNZ HASH_INIT_NEXT_SQ  ; Off-board, skip
                        
                            ; Get piece at this square
   55f0   f8 60             LDI HIGH(BOARD)
   55f2   ba                PHI 10
   55f3   89                GLO 9
   55f4   aa                PLO 10              ; R10 = BOARD + square
   55f5   0a                LDN 10              ; D = piece at square
   55f6   c2 56 4f          LBZ HASH_INIT_NEXT_SQ   ; Empty square, skip
                        
                            ; Have a piece - compute Zobrist key offset
                            ; piece_index = (piece & 7) - 1 for white, + 6 for black
                            ; Piece encoding: 1-6 = white P/N/B/R/Q/K, 9-14 = black
   55f9   a8                PLO 8               ; R8.0 = piece
   55fa   fa 07             ANI $07             ; D = piece type (1-6)
   55fc   ff 01             SMI 1               ; D = piece_type - 1 (0-5)
   55fe   ad                PLO 13              ; R13.0 = piece index base
                        
   55ff   88                GLO 8               ; Get piece again
   5600   fa 08             ANI $08             ; Check color bit
   5602   c2 56 09          LBZ HASH_INIT_WHITE
                            ; Black piece - add 6 to index
   5605   8d                GLO 13
   5606   fc 06             ADI 6
   5608   ad                PLO 13
   5609                 HASH_INIT_WHITE:
                        
                            ; Now compute square index (0-63 from 0x88)
                            ; sq64 = (sq88 >> 4) * 8 + (sq88 & 7) = rank*8 + file
   5609   89                GLO 9               ; 0x88 square
   560a   fa 07             ANI $07             ; D = file (0-7)
   560c   a8                PLO 8               ; R8.0 = file
   560d   89                GLO 9
   560e   fa 70             ANI $70             ; D = rank * 16 (masked)
   5610   f6                SHR                 ; D = rank * 8
   5611   52                STR 2               ; Save rank*8
   5612   88                GLO 8               ; D = file
   5613   f4                ADD                 ; D = rank*8 + file = sq64
   5614   a8                PLO 8               ; R8.0 = sq64 (0-63)
                        
                            ; Compute Zobrist table offset:
                            ; offset = piece_index * 128 + sq64 * 2
                            ; R13.0 = piece_index (0-11)
                            ; R8.0 = sq64 (0-63)
                        
                            ; First: piece_index * 128 = piece_index << 7
                            ; Since piece_index is 0-11, result fits in 16 bits
   5615   8d                GLO 13              ; piece_index (0-11)
   5616   fe                SHL                 ; x2
   5617   fe                SHL                 ; x4
   5618   fe                SHL                 ; x8
   5619   fe                SHL                 ; x16
   561a   fe                SHL                 ; x32
   561b   fe                SHL                 ; x64
   561c   b8                PHI 8               ; R8.1 = (piece_index * 64) = high part of offset
   561d   f8 00             LDI 0
   561f   c7                LSNF                ; Skip if no carry from last SHL
   5620   f8 01             LDI 1               ; Carry into high byte
                            ; Actually, piece_index * 128: need one more shift
                            ; Let me reconsider: piece * 128 = piece << 7
                            ; For piece=11: 11 << 7 = 1408 = $580
                            ; High byte = piece >> 1, low byte = (piece & 1) << 7
                        
                            ; Restart: piece_index * 128
   5622   8d                GLO 13              ; piece_index (0-11)
   5623   f6                SHR                 ; D = piece_index >> 1
   5624   b8                PHI 8               ; R8.1 = high byte of piece*128
   5625   8d                GLO 13
   5626   fa 01             ANI $01             ; D = piece_index & 1
   5628   c2 56 30          LBZ HASH_INIT_EVEN_PIECE
   562b   f8 80             LDI $80
   562d   c0 56 32          LBR HASH_INIT_ADD_SQ
   5630                 HASH_INIT_EVEN_PIECE:
   5630   f8 00             LDI 0
   5632                 HASH_INIT_ADD_SQ:
                            ; D = low byte of piece*128 (0 or $80)
                            ; Now add sq64 * 2
   5632   ad                PLO 13              ; R13.0 = temp low
   5633   88                GLO 8               ; sq64
   5634   fe                SHL                 ; sq64 * 2
   5635   52                STR 2
   5636   8d                GLO 13
   5637   f4                ADD                 ; D = low + sq*2
   5638   ad                PLO 13              ; R13.0 = offset low
   5639   98                GHI 8               ; high byte of piece*128
   563a   7c 00             ADCI 0              ; add carry
   563c   bd                PHI 13              ; R13.1 = offset high
                        
                            ; Now add ZOBRIST_PIECE_SQ base address
   563d   8d                GLO 13
   563e   fc 8f             ADI LOW(ZOBRIST_PIECE_SQ)
   5640   aa                PLO 10
   5641   9d                GHI 13
   5642   7c 58             ADCI HIGH(ZOBRIST_PIECE_SQ)
   5644   ba                PHI 10              ; R10 = address of Zobrist key
                        
                            ; XOR the 16-bit key into hash (R7)
   5645   4a                LDA 10              ; High byte of key
   5646   52                STR 2
   5647   97                GHI 7
   5648   f3                XOR
   5649   b7                PHI 7               ; hash_hi ^= key_hi
   564a   0a                LDN 10              ; Low byte of key
   564b   52                STR 2
   564c   87                GLO 7
   564d   f3                XOR
   564e   a7                PLO 7               ; hash_lo ^= key_lo
                        
   564f                 HASH_INIT_NEXT_SQ:
                            ; Next square
   564f   19                INC 9               ; R9.0++
   5650   89                GLO 9
   5651   fb 80             XRI $80             ; Check if we've passed square $7F
   5653   ca 55 ea          LBNZ HASH_INIT_LOOP
                        
                            ; Done with pieces. Now XOR side to move.
   5656   68 ca 60 80       RLDI 10, GAME_STATE
   565a   0a                LDN 10              ; D = side to move (0=white, 8=black)
   565b   c2 56 6c          LBZ HASH_SIDE_DONE
                            ; Black to move - XOR side key
   565e   68 ca 5e 8f       RLDI 10, ZOBRIST_SIDE
   5662   4a                LDA 10
   5663   52                STR 2
   5664   97                GHI 7
   5665   f3                XOR
   5666   b7                PHI 7
   5667   0a                LDN 10
   5668   52                STR 2
   5669   87                GLO 7
   566a   f3                XOR
   566b   a7                PLO 7
   566c                 HASH_SIDE_DONE:
                        
                            ; XOR castling rights
                            ; Castling is at GAME_STATE + STATE_CASTLING ($6081)
   566c   68 ca 60 81       RLDI 10, GAME_STATE + STATE_CASTLING
   5670   0a                LDN 10              ; D = castling rights
   5671   a9                PLO 9               ; R9.0 = castling bits
                        
                            ; Check each castling bit
                            ; White kingside (bit 0)
   5672   89                GLO 9
   5673   fa 01             ANI CASTLE_WK
   5675   c2 56 7b          LBZ HASH_NO_WK
   5678   d4 56 c2          CALL HASH_XOR_CASTLE_0
   567b                 HASH_NO_WK:
                            ; White queenside (bit 1)
   567b   89                GLO 9
   567c   fa 02             ANI CASTLE_WQ
   567e   c2 56 84          LBZ HASH_NO_WQ
   5681   d4 56 c9          CALL HASH_XOR_CASTLE_1
   5684                 HASH_NO_WQ:
                            ; Black kingside (bit 2)
   5684   89                GLO 9
   5685   fa 04             ANI CASTLE_BK
   5687   c2 56 8d          LBZ HASH_NO_BK
   568a   d4 56 d2          CALL HASH_XOR_CASTLE_2
   568d                 HASH_NO_BK:
                            ; Black queenside (bit 3)
   568d   89                GLO 9
   568e   fa 08             ANI CASTLE_BQ
   5690   c2 56 96          LBZ HASH_NO_BQ
   5693   d4 56 dd          CALL HASH_XOR_CASTLE_3
   5696                 HASH_NO_BQ:
                        
                            ; XOR en passant file if set
   5696   68 ca 60 80       RLDI 10, GAME_STATE
   569a   1a                INC 10
   569b   1a                INC 10              ; Point to EP square
   569c   0a                LDN 10              ; D = EP square ($FF if none)
   569d   fb ff             XRI $FF
   569f   c2 56 b8          LBZ HASH_NO_EP      ; No EP square
                            ; Have EP - get file (bits 0-2 of 0x88 square)
   56a2   0a                LDN 10
   56a3   fa 07             ANI $07             ; D = file (0-7)
   56a5   fe                SHL                 ; D = file * 2 (offset into ZOBRIST_EP)
   56a6   fc 99             ADI LOW(ZOBRIST_EP)
   56a8   aa                PLO 10
   56a9   f8 5e             LDI HIGH(ZOBRIST_EP)
   56ab   7c 00             ADCI 0
   56ad   ba                PHI 10              ; R10 = address of EP file key
   56ae   4a                LDA 10
   56af   52                STR 2
   56b0   97                GHI 7
   56b1   f3                XOR
   56b2   b7                PHI 7
   56b3   0a                LDN 10
   56b4   52                STR 2
   56b5   87                GLO 7
   56b6   f3                XOR
   56b7   a7                PLO 7
   56b8                 HASH_NO_EP:
                        
                            ; Store final hash
   56b8   68 ca 64 b9       RLDI 10, HASH_HI
   56bc   97                GHI 7
   56bd   5a                STR 10
   56be   1a                INC 10
   56bf   87                GLO 7
   56c0   5a                STR 10
                        
   56c1   d5                RETN
                        
                        ; Helper functions to XOR castling keys (avoids code duplication)
   56c2                 HASH_XOR_CASTLE_0:
   56c2   68 ca 5e 91       RLDI 10, ZOBRIST_CASTLE
   56c6   c0 56 e7          LBR HASH_XOR_CASTLE_DO
   56c9                 HASH_XOR_CASTLE_1:
   56c9   68 ca 5e 91       RLDI 10, ZOBRIST_CASTLE
   56cd   1a                INC 10
   56ce   1a                INC 10
   56cf   c0 56 e7          LBR HASH_XOR_CASTLE_DO
   56d2                 HASH_XOR_CASTLE_2:
   56d2   68 ca 5e 91       RLDI 10, ZOBRIST_CASTLE
   56d6   1a                INC 10
   56d7   1a                INC 10
   56d8   1a                INC 10
   56d9   1a                INC 10
   56da   c0 56 e7          LBR HASH_XOR_CASTLE_DO
   56dd                 HASH_XOR_CASTLE_3:
   56dd   68 ca 5e 91       RLDI 10, ZOBRIST_CASTLE
   56e1   1a                INC 10
   56e2   1a                INC 10
   56e3   1a                INC 10
   56e4   1a                INC 10
   56e5   1a                INC 10
   56e6   1a                INC 10
   56e7                 HASH_XOR_CASTLE_DO:
   56e7   4a                LDA 10
   56e8   52                STR 2
   56e9   97                GHI 7
   56ea   f3                XOR
   56eb   b7                PHI 7
   56ec   0a                LDN 10
   56ed   52                STR 2
   56ee   87                GLO 7
   56ef   f3                XOR
   56f0   a7                PLO 7
   56f1   d5                RETN
                        
                        ; ==============================================================================
                        ; TT_CLEAR - Clear all transposition table entries
                        ; ==============================================================================
                        ; Sets all TT entries to flag=TT_FLAG_NONE (0)
                        ; Should be called at start of new game or new position.
                        ;
                        ; Uses: R9 (counter), R10 (pointer)
                        ; ==============================================================================
   56f2                 TT_CLEAR:
   56f2   68 ca 68 00       RLDI 10, TT_TABLE
                        
                            ; Clear 256 entries × 8 bytes = 2048 bytes
                            ; Use R9 as 16-bit counter
   56f6   68 c9 08 00       RLDI 9, TT_ENTRIES * TT_ENTRY_SIZE
                        
   56fa                 TT_CLEAR_LOOP:
   56fa   f8 00             LDI 0               ; BUGFIX 2026-07-24: reload EVERY iteration — GHI/GLO
                                                ; below clobber D, so the old loop filled the table
                                                ; with counter bytes ($07 bands...), not zeros. Found
                                                ; via the 7/23 crash-scene $6840 dump. Junk "cleared"
                                                ; entries = patterned fake hashes = a possible
                                                ; contributor to same-side TT false hits.
   56fc   5a                STR 10
   56fd   1a                INC 10
   56fe   29                DEC 9
   56ff   99                GHI 9
   5700   ca 56 fa          LBNZ TT_CLEAR_LOOP
   5703   89                GLO 9
   5704   ca 56 fa          LBNZ TT_CLEAR_LOOP
                        
   5707   d5                RETN
                        
                        ; ==============================================================================
                        ; TT_PROBE - Look up current position in transposition table
                        ; ==============================================================================
                        ; Checks if current position (HASH_HI/LO) exists in TT.
                        ; If found and depth >= required, copies entry data to TT_* variables.
                        ;
                        ; Input:  D = required depth
                        ; Output: D = 1 if usable hit, 0 if miss
                        ;         If hit: TT_SCORE, TT_DEPTH, TT_FLAG, TT_MOVE populated
                        ;
                        ; Uses: R7 (hash), R8 (required depth), R10 (pointer)
                        ; ==============================================================================
   5708                 TT_PROBE:
   5708   a8                PLO 8               ; R8.0 = required depth
                        
   5709   68 c9 64 1d       RLDI 9, TRACE_WHERE
   570d   f8 b1             LDI $B1
   570f   59                STR 9              ; tracer: in TT_PROBE
                        
                            ; Clear TT_MOVE (prevents stale data if hash misses)
   5710   68 c9 64 c0       RLDI 9, TT_MOVE_HI
   5714   f8 00             LDI 0
   5716   59                STR 9
   5717   19                INC 9
   5718   59                STR 9               ; TT_MOVE_HI/LO = 0
                        
                            ; Load current hash
   5719   68 ca 64 b9       RLDI 10, HASH_HI
   571d   4a                LDA 10
   571e   b7                PHI 7
   571f   0a                LDN 10
   5720   a7                PLO 7               ; R7 = current hash
                        
                            ; Calculate TT entry address: TT_TABLE + (index * 8)
                            ; XOR-fold indexing (2026-05-15): index = (hash_hi XOR hash_lo) & $FF.
   5721   97                GHI 7               ; hash_hi
   5722   52                STR 2
   5723   87                GLO 7               ; hash_lo
   5724   f3                XOR                 ; D = hash_hi XOR hash_lo
   5725   fa ff             ANI TT_INDEX_MASK   ; Mask to table size
   5727   fe                SHL                 ; x2, carry into DF
   5728   aa                PLO 10
   5729   f8 00             LDI 0
   572b   7e                SHLC                ; carry into D
   572c   ba                PHI 10              ; R10.1 = high so far
   572d   8a                GLO 10
   572e   fe                SHL                 ; x4
   572f   aa                PLO 10
   5730   9a                GHI 10
   5731   7e                SHLC
   5732   ba                PHI 10
   5733   8a                GLO 10
   5734   fe                SHL                 ; x8
   5735   aa                PLO 10
   5736   9a                GHI 10
   5737   7e                SHLC
   5738   ba                PHI 10              ; R10 = index * 8
                        
                            ; Add TT_TABLE base
   5739   8a                GLO 10
   573a   fc 00             ADI LOW(TT_TABLE)
   573c   aa                PLO 10
   573d   9a                GHI 10
   573e   7c 68             ADCI HIGH(TT_TABLE)
   5740   ba                PHI 10              ; R10 = TT entry address
                        
                            ; Check if entry matches (compare stored hash with current)
   5741   4a                LDA 10              ; Entry hash_hi
   5742   52                STR 2
   5743   97                GHI 7
   5744   f3                XOR
   5745   ca 57 9e          LBNZ TT_PROBE_MISS
   5748   4a                LDA 10              ; Entry hash_lo
   5749   52                STR 2
   574a   87                GLO 7
   574b   f3                XOR
   574c   ca 57 9e          LBNZ TT_PROBE_MISS
                        
                            ; Hash matches! Save move for ordering (even if depth insufficient)
                            ; R10 at offset 2 (score_hi). Move is at offset 6-7.
   574f   1a                INC 10              ; → 3
   5750   1a                INC 10              ; → 4 (depth)
   5751   1a                INC 10              ; → 5 (flag)
   5752   1a                INC 10              ; → 6 (move_hi)
   5753   4a                LDA 10              ; D = move_hi, R10 → 7
   5754   73                STXD                ; push move_hi
   5755   0a                LDN 10              ; D = move_lo
   5756   73                STXD                ; push move_lo
                        
                            ; Write to TT_MOVE_HI/LO
   5757   68 c9 64 c0       RLDI 9, TT_MOVE_HI
   575b   60                IRX
   575c   72                LDXA                ; D = move_lo
   575d   19                INC 9
   575e   59                STR 9               ; TT_MOVE_LO = move_lo
   575f   29                DEC 9
   5760   f0                LDX                 ; D = move_hi
   5761   59                STR 9               ; TT_MOVE_HI = move_hi
                        
                            ; Navigate back to depth (offset 4)
   5762   2a                DEC 10              ; → 6
   5763   2a                DEC 10              ; → 5
   5764   2a                DEC 10              ; → 4 (depth)
                        
                            ; Check depth
   5765   0a                LDN 10              ; Entry depth
   5766   52                STR 2
   5767   88                GLO 8               ; Required depth
   5768   f5                SD                  ; D = entry_depth - required_depth
   5769   cb 57 9e          LBNF TT_PROBE_MISS  ; Borrow → depth insufficient (but TT_MOVE saved!)
                        
                            ; --- side-bit verification (2026-07-15): a 16-bit hash match can be a
                            ; DIFFERENT position (proven: loss8's +2341 = a white-to-move entry
                            ; served to a black-to-move node = sign inversion). Reject the SCORE on
                            ; side mismatch; the ordering move above is already saved (benign — a
                            ; wrong-position move matches nothing in the generated list).
   576c   1a                INC 10              ; → 5 (flag)
   576d   0a                LDN 10              ; D = entry flag (bit 3 = storing side)
   576e   52                STR 2
   576f   8c                GLO 12              ; current side to move ($00/$08)
   5770   f3                XOR
   5771   fa 08             ANI $08
   5773   ca 57 9e          LBNZ TT_PROBE_MISS  ; cross-side entry -> treat as miss
   5776   2a                DEC 10              ; → 4 (depth), as the flow below expects
                        
                            ; Usable hit! Copy entry data to TT_* variables
                            ; Back up to start of entry
   5777   2a                DEC 10
   5778   2a                DEC 10
   5779   2a                DEC 10
   577a   2a                DEC 10              ; R10 at entry start
                        
                            ; Copy to TT result variables
   577b   68 c9 64 bc       RLDI 9, TT_SCORE_HI
                        
   577f   1a                INC 10
   5780   1a                INC 10              ; Skip hash verification bytes
   5781   4a                LDA 10              ; score_hi
   5782   59                STR 9
   5783   19                INC 9
   5784   4a                LDA 10              ; score_lo
   5785   59                STR 9
   5786   19                INC 9
   5787   4a                LDA 10              ; depth
   5788   59                STR 9
   5789   19                INC 9
   578a   4a                LDA 10              ; flag
   578b   fa 07             ANI $07             ; strip the side bit — consumers compare bound types
   578d   59                STR 9
   578e   19                INC 9
   578f   4a                LDA 10              ; move_hi
   5790   59                STR 9
   5791   19                INC 9
   5792   0a                LDN 10              ; move_lo
   5793   59                STR 9
                        
                            ; Set TT_HIT = 1
   5794   68 ca 64 bb       RLDI 10, TT_HIT
   5798   f8 01             LDI 1
   579a   5a                STR 10
                        
   579b   f8 01             LDI 1               ; Return hit
   579d   d5                RETN
                        
   579e                 TT_PROBE_MISS:
                            ; Set TT_HIT = 0
   579e   68 ca 64 bb       RLDI 10, TT_HIT
   57a2   f8 00             LDI 0
   57a4   5a                STR 10
                        
   57a5   f8 00             LDI 0               ; Return miss
   57a7   d5                RETN
                        
                        ; ==============================================================================
                        ; TT_STORE - Store position result in transposition table
                        ; ==============================================================================
                        ; Stores current position with score, depth, flag, and best move.
                        ; Always replaces existing entry (replace-always scheme).
                        ;
                        ; Input:  Stack contains (push order): score_hi, score_lo, depth, flag
                        ;         BEST_MOVE contains best move
                        ; Actually, let's use memory variables for simplicity:
                        ;         SCORE_HI/LO = score to store
                        ;         D = depth
                        ;         R8.0 = flag
                        ;
                        ; Uses: R7 (hash), R9 (temp), R10 (pointer)
                        ; ==============================================================================
   57a8                 TT_STORE:
                            ; Save depth and flag
   57a8   73                STXD                ; Push depth
   57a9   88                GLO 8
   57aa   73                STXD                ; Push flag
                        
   57ab   68 ca 64 1d       RLDI 10, TRACE_WHERE
   57af   f8 b2             LDI $B2
   57b1   5a                STR 10              ; tracer: in TT_STORE
                        
                            ; Load current hash
   57b2   68 ca 64 b9       RLDI 10, HASH_HI
   57b6   4a                LDA 10
   57b7   b7                PHI 7
   57b8   0a                LDN 10
   57b9   a7                PLO 7               ; R7 = current hash
                        
                            ; Calculate TT entry address: TT_TABLE + (index * 8) — XOR-fold (must match TT_PROBE)
   57ba   97                GHI 7               ; hash_hi
   57bb   52                STR 2
   57bc   87                GLO 7               ; hash_lo
   57bd   f3                XOR                 ; D = hash_hi XOR hash_lo
   57be   fa ff             ANI TT_INDEX_MASK
   57c0   fe                SHL                 ; x2, carry into DF
   57c1   aa                PLO 10
   57c2   f8 00             LDI 0
   57c4   7e                SHLC
   57c5   ba                PHI 10
   57c6   8a                GLO 10
   57c7   fe                SHL                 ; x4
   57c8   aa                PLO 10
   57c9   9a                GHI 10
   57ca   7e                SHLC
   57cb   ba                PHI 10
   57cc   8a                GLO 10
   57cd   fe                SHL                 ; x8
   57ce   aa                PLO 10
   57cf   9a                GHI 10
   57d0   7e                SHLC
   57d1   ba                PHI 10              ; R10 = index * 8
                        
                            ; Add TT_TABLE base
   57d2   8a                GLO 10
   57d3   fc 00             ADI LOW(TT_TABLE)
   57d5   aa                PLO 10
   57d6   9a                GHI 10
   57d7   7c 68             ADCI HIGH(TT_TABLE)
   57d9   ba                PHI 10              ; R10 = TT entry address
                        
                            ; Write entry
   57da   97                GHI 7               ; hash_hi
   57db   5a                STR 10
   57dc   1a                INC 10
   57dd   87                GLO 7               ; hash_lo
   57de   5a                STR 10
   57df   1a                INC 10
                        
                            ; Score from SCORE_HI/LO
   57e0   68 c9 64 46       RLDI 9, SCORE_HI
   57e4   49                LDA 9               ; score_hi
   57e5   5a                STR 10
   57e6   1a                INC 10
   57e7   09                LDN 9               ; score_lo
   57e8   5a                STR 10
   57e9   1a                INC 10
                        
                            ; Depth and flag from stack
   57ea   60                IRX
   57eb   72                LDXA                ; flag
   57ec   a8                PLO 8               ; Save temporarily
   57ed   f0                LDX                 ; depth
   57ee   5a                STR 10
   57ef   1a                INC 10
                            ; --- side-bit (2026-07-15, the $1B81 collision fix): fold the storing
                            ; side into flag bit 3 so a 16-bit false hit can't cross perspectives.
   57f0   8c                GLO 12
   57f1   fa 08             ANI $08
   57f3   52                STR 2               ; M(2) = side bit (spent stack slot, safe scratch)
   57f4   88                GLO 8               ; flag
   57f5   f1                OR                  ; flag | side
   57f6   5a                STR 10
   57f7   1a                INC 10
                        
                            ; Best move from NODE_BEST_MOVE[ply]
   57f8   68 c9 64 48       RLDI 9, CURRENT_PLY
   57fc   09                LDN 9               ; D = ply
   57fd   fe                SHL                 ; D = ply * 2
   57fe   a9                PLO 9               ; R9.0 = offset (NODE_BEST_MOVE base = $6700, low = $00)
   57ff   f8 67             LDI HIGH(NODE_BEST_MOVE)
   5801   b9                PHI 9               ; R9 = $6700 + ply*2
   5802   49                LDA 9               ; from
   5803   5a                STR 10
   5804   1a                INC 10
   5805   09                LDN 9               ; to
   5806   5a                STR 10
                        
   5807   d5                RETN
                        
                        ; ==============================================================================
                        ; HASH_XOR_PIECE_SQ - XOR piece-square key into current hash
                        ; ==============================================================================
                        ; Used for incremental hash updates in MAKE_MOVE/UNMAKE_MOVE.
                        ;
                        ; Input:  R8.0 = piece (1-6 white, 9-14 black, or EMPTY=0 for no-op)
                        ;         R8.1 = square (0x88 format)
                        ; Output: HASH_HI/LO updated
                        ; Uses:   R7, R9, R10, R11, R13
                        ; ==============================================================================
                        ; --- DIAG-3 RELOCATION PAD (2026-07-24, hang hunt): 4 x $D1 shifts every
                        ; HXPS fetch address by +4. Discriminator for the $5858 fetch-failure class:
                        ; post-pad crash with R3=$5859 = fault is ADDRESS-locked ($5858 itself);
                        ; R3=$585D = fault FOLLOWS the instruction pattern (LDA/XOR/PHI sequence).
                        ; The pad bytes are SEP 1 = instant breakpoint if anything ever lands here.
   5808   d1 d1 d1 d1       DB $D1, $D1, $D1, $D1
   580c                 HASH_XOR_PIECE_SQ:
                            ; Skip if piece is EMPTY
   580c   88                GLO 8
   580d   c2 58 6e          LBZ HXPS_DONE
                        
                            ; Load current hash into R7
   5810   68 ca 64 b9       RLDI 10, HASH_HI
   5814   4a                LDA 10
   5815   b7                PHI 7
   5816   0a                LDN 10
   5817   a7                PLO 7               ; R7 = current hash
                        
                            ; Compute piece index (0-11)
                            ; piece_index = (piece & 7) - 1 for white, + 6 for black
   5818   88                GLO 8               ; piece
   5819   fa 07             ANI $07             ; piece type (1-6)
   581b   ff 01             SMI 1               ; piece_type - 1 (0-5)
   581d   ad                PLO 13              ; R13.0 = base index
                        
   581e   88                GLO 8               ; piece again
   581f   fa 08             ANI $08             ; color bit
   5821   c2 58 28          LBZ HXPS_WHITE
                            ; Black - add 6
   5824   8d                GLO 13
   5825   fc 06             ADI 6
   5827   ad                PLO 13
   5828                 HXPS_WHITE:
                        
                            ; Compute square index (0-63 from 0x88)
                            ; sq64 = (sq88 >> 4) * 8 + (sq88 & 7)
   5828   98                GHI 8               ; 0x88 square
   5829   fa 07             ANI $07             ; file
   582b   a9                PLO 9               ; R9.0 = file
   582c   98                GHI 8
   582d   fa 70             ANI $70             ; rank * 16
   582f   f6                SHR                 ; rank * 8
   5830   ab                PLO 11              ; R11.0 = rank*8 (use R11, NOT R7 - R7 has hash!)
   5831   89                GLO 9               ; file
   5832   52                STR 2               ; temp store on stack
   5833   8b                GLO 11              ; rank*8
   5834   f4                ADD                 ; rank*8 + file = sq64
   5835   a9                PLO 9               ; R9.0 = sq64
                        
                            ; Compute Zobrist offset: piece_index * 128 + sq64 * 2
                            ; piece * 128: high = piece >> 1, low = (piece & 1) << 7
   5836   8d                GLO 13              ; piece_index
   5837   f6                SHR                 ; piece >> 1
   5838   bd                PHI 13              ; R13.1 = high byte of piece*128
   5839   8d                GLO 13
   583a   fe                SHL                 ; Restore, then check bit 0
   583b   f6                SHR                 ; Back to original
   583c   fa 01             ANI $01
   583e   c2 58 46          LBZ HXPS_EVEN
   5841   f8 80             LDI $80
   5843   c0 58 48          LBR HXPS_ADD_SQ
